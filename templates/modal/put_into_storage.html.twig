{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_submenu %}
        {{ include('submenu.html.twig') }}
    {% endblock %}

    {% block webwms_put_into_storage %}
        <div id="webwms-put-into-storage" class="wrapper-form" style="width: 80%; margin: auto">
            <div class="wrapper-form-content">
                <div class="card">
                    <div class="card-content">
                        <div class="card">
                            {{ form_start(stockInFinalForm, {'action' : path('stock_in')}) }}
                                {% block webwms_put_into_storage_table %}
                                    <table id="putIntoStorageTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                            <tr>
                                                <th scope="col" style="text-align: center">Lagereinheit</th>
                                                <th scope="col" style="text-align: center">Lagersystem</th>
                                                <th scope="col" style="text-align: center">Lagernummer</th>
                                                <th scope="col" style="text-align: center">Fachboden</th>
                                                <th scope="col" style="text-align: center">Stellplatz</th>
                                                <th scope="col" style="text-align: center">Tiefe</th>
                                                <th scope="col" style="text-align: center">Menge</th>
                                                <th scope="col" style="text-align: center">TBE</th>
                                                <th class="editor-edit text-center">Ändern</th> <!-- Logik hierfür muss noch implementiert werden -->
                                            </tr>
                                        </thead>
                                        <tbody id="myTable" style="text-align: center">
                                            <tr>
                                                <td>{{ form_row(stockInFinalForm.stock_su_id, {'value' : selectedStockLocations[0].su_id }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_system, {'value' : selectedStockLocations[0].system }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_ln, {'value' : selectedStockLocations[0].ln }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_fb, {'value' : selectedStockLocations[0].fb }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_sp, {'value' : selectedStockLocations[0].sp }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_tf, {'value' : selectedStockLocations[0].tf }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_quantity, {'value' : selectedStockLocations[0].quantity }) }}</td>
                                                <td>{{ form_row(stockInFinalForm.stock_tbe, {'value' : selectedStockLocations[0].quantity }) }}</td>
                                                <td class="editor-edit text-center" style="vertical-align: inherit;"><i class="mdi mdi-square-edit-outline"></i></td> <!-- Logik hierfür muss noch implementiert werden -->
                                                {% for key, selectedStockLocation in selectedStockLocations %}

                                                {% endfor %}
                                            </tr>
                                        </tbody>
                                    </table>
                                {% endblock %}
                                <div class="text-center">
                                    {{ form_widget(stockInFinalForm.stock_in_post_final) }}
                                    {{ form_widget(stockInFinalForm.stock_in_graphical) }}
                                    {{ form_widget(stockInFinalForm.stock_in_correction) }}
                                    {{ form_widget(stockInFinalForm.back_to_stock_in) }}
                                </div>
                        </div>
                    </div>
                </div>
                {{ form_end(stockInFinalForm) }}
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockInItemsAutofill.js') }}"></script>
{% endblock %}


