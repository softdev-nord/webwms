{# templates/modal/show_article_stock_details_modal.html.twig #}
{% block webwms_show_article_stock_details_modal %}
    <div id="showArticleStockDetails">
        <div class="modal-body">
            <div class="card p-3">
                <div id="stockListWrapper">
                    <table class="table table-striped table-hover">
                        <thead>
                        <tr>
                            <th class="text-center" data-sort="lagereinheit">Lagereinheit</th>
                            <th class="text-center" data-sort="lagerplatz">Lagerplatz</th>
                            <th class="text-center" data-sort="articleNr">Artikel‑Nr</th>
                            <th class="text-center" data-sort="bezeichnung">Bezeichnung</th>
                            <th class="text-center" data-sort="transEin">Zugang</th>
                            <th class="text-center" data-sort="transAus">Abgang</th>
                            <th class="text-center" data-sort="lpBestand">LP Bestand</th>
                            <th class="text-center" data-sort="letzterZugang">Letzter Zugang</th>
                            <th class="text-center" data-sort="letzterAbgang">Letzter Abgang</th>
                        </tr>
                        </thead>
                        <tbody class="list">
                        {# rows werden per JS befüllt #}
                        </tbody>
                    </table>
                    <div class="d-flex justify-content-end">
                        <div class="pagination-wrap hstack gap-2">
                            <a class="page-item pagination-prev disabled" href="#">
                                {{ 'main.pages.table.pagination.previous'|trans }}
                            </a>
                            <ul class="pagination listjs-pagination mb-0"></ul>
                            <a class="page-item pagination-next" href="#">
                                {{ 'main.pages.table.pagination.next'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}