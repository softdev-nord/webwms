{# templates/modal/show_article_stock_details_modal.html.twig #}

{% block webwms_show_article_stock_details_modal %}
    <div id="showArticleStockDetails">
        <div class="modal-body">
            <div class="card">
                <div id="flash-message-overlay">
                    <div class="col">
                    </div>
                </div>
                {% if articleStockDetails is empty %}
                    <div class="no-stock-details">{{ 'ui.modal.show_article_stock_details_modal.keine.details.fur.diesen.artikel.vorhanden'|trans }}</div>
                {% else %}
                <table id="showStockDetailTable" class="table table-striped table-bordered table-hover compact">
                    <thead>
                    <tr>
                        <th style="text-align: center; width: 7%;" scope="col">{{ 'ui.modal.put_into_storage.lagereinheit'|trans }}</th>
                        <th style="text-align: center; width: 7%;" scope="col">{{ 'ui.modal.show_article_stock_details_modal.lagerplatz'|trans }}</th>
                        <th style="text-align: center; width: 7%;" scope="col">{{ 'ui.article.article_input_fields.artikel.nr'|trans }}</th>
                        <th style="text-align: center; width: 35%;" scope="col">{{ 'ui.article.index.bezeichnung'|trans }}</th>
                        <th style="text-align: center; width: 7%;" scope="col">{{ 'ui.article.index.zugang'|trans }}</th>
                        <th style="text-align: center; width: 7%;" scope="col">{{ 'ui.modal.show_article_stock_details_modal.abgang'|trans }}</th>
                        <th style="text-align: center; width: 7%;" scope="col">{{ 'ui.modal.show_article_stock_details_modal.lp.bestand'|trans }}</th>
                        <th style="text-align: center; width: 10%;" scope="col">{{ 'ui.modal.show_article_stock_details_modal.letzter.zugang'|trans }}</th>
                        <th style="text-align: center; width: 10%;" scope="col">{{ 'ui.modal.show_article_stock_details_modal.letzter.abgang'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                        {% for articleStockDetail in articleStockDetails %}
                            <tr>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.lagereinheit }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.ln }}-{{ articleStockDetail.fb }}-{{ articleStockDetail.sp }}-{{ articleStockDetail.tf }}</th>
                                <th id="article_nr" style="text-align: center;" scope="col">{{ articleStockDetail.article_nr }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.bezeichnung }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.trans_ein }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.trans_aus }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.lp_bestand }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.letzter_zugang }}</th>
                                <th style="text-align: center;" scope="col">{{ articleStockDetail.letzter_abgang }}</th>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
            </div>
        </div>
        <div class="modal-footer">
            <br/>
        </div>
    </div>
{% endblock %}
