{# templates/modal/stock_in_into_dispatch_area_modal.html.twig #}

{% block webwms_stock_in_into_dispatch_area_modal %}
    <div class="modal" id="stock_in_into_dispatch_area_modal" tabindex="-1" role="dialog" aria-labelledby="stock_in_into_dispatch_area_modal"
         aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title"></h3>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'base.close'|trans }}">
                        <span aria-hidden="true" class="white-text">{{ 'base.and_times'|trans }}</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="text-center">
                        {{ 'modal.stock_in_for_supplier_order_modal.implement_logic_and_design'|trans }}
                    </div>
                    <input id="currentCoordinate" type="hidden">
                </div>
                <div class="modal-footer justify-content-center">
                </div>
            </div>
        </div>
    </div>
{% endblock %}
