{# templates/modal/show_stock_details_modal.html.twig #}

{% block webwms_show_stock_details_modal %}
    <div id="showStockDetails">
        <div class="modal-body">
            <div class="card">
                <div id="flash-message-overlay">
                    <div class="col">
                    </div>
                </div>
                    {% if stockDetails.info is defined %}
                        <div class="no-stock-details">{{ stockDetails.info }}</div>
                    {% else %}
                    <table id="showStockDetailTable" class="table table-striped table-bordered table-hover compact">
                        <thead>
                            <tr>
                                <th style="text-align: center; width: 7%;" scope="col">Lagereinheit</th>
                                <th style="text-align: center; width: 7%;" scope="col">Artikel-Nr</th>
                                <th style="text-align: center; width: 35%;" scope="col">Bezeichnung</th>
                                <th style="text-align: center; width: 7%;" scope="col">Zugang</th>
                                <th style="text-align: center; width: 7%;" scope="col">Abgang</th>
                                <th style="text-align: center; width: 7%;" scope="col">LP Bestand</th>
                                <th style="text-align: center; width: 10%;" scope="col">Letzter Zugang</th>
                                <th style="text-align: center; width: 10%;" scope="col">Letzter Abgang</th>
                            </tr>
                        </thead>
                        {% for key, stockDetail in stockDetails %}
                        <tbody>
                            <tr data-article-nr="{{ stockDetail.article_nr }}">
                                <th style="text-align: center;" scope="col">{{ stockDetail.lagereinheit }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.article_nr }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.bezeichnung }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.trans_ein }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.trans_aus }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.lp_bestand }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.letzter_zugang }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetail.letzter_abgang }}</th>
                            </tr>
                        </tbody>
                        {% endfor %}
                    </table>
                    {% endif %}
            </div>
        </div>
        <div class="modal-footer">
            <br/>
        </div>
    </div>
{% endblock %}
