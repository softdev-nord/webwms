<div id="showStockDetails">
    <div class="modal-body">
        <div class="card">
            <div id="flash-message-overlay">
                <div class="col">
                </div>
            </div>
            {% if stockDetails is empty %}
                <div class="no-stock-details">Keine Details vorhanden, da der Lagerplatz aktuell nicht belegt ist.</div>
            {% else %}
            <table id="showStockDetailTable" class="table table-striped table-bordered table-hover compact">
                <thead>
                <tr>
                    <th style="text-align: center; width: 7%;" scope="col">Lagereinheit</th>
                    <th style="text-align: center; width: 7%;" scope="col">Artikel-Nr</th>
                    <th style="text-align: center; width: 35%;" scope="col">Bezeichnung</th>
                    <th style="text-align: center; width: 7%;" scope="col">Zugang</th>
                    <th style="text-align: center; width: 7%;" scope="col">Abgang</th>
                    <th style="text-align: center; width: 7%;" scope="col">LP Bestand</th>
                    <th style="text-align: center; width: 10%;" scope="col">Letzter Zugang</th>
                    <th style="text-align: center; width: 10%;" scope="col">Letzter Abgang</th>
                </tr>
                </thead>
                <tbody>
                <tr data-article-nr="{{ stockDetails.article_nr }}">
                    <th style="text-align: center;" scope="col">{{ stockDetails.lagereinheit }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.article_nr }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.bezeichnung }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.trans_ein }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.trans_aus }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.lp_bestand }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.letzter_zugang }}</th>
                    <th style="text-align: center;" scope="col">{{ stockDetails.letzter_abgang }}</th>
                </tr>
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>
    <div class="modal-footer">
        <br/>
    </div>
</div>
