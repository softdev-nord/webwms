{# templates/modal/show_stock_details_modal.html.twig #}

{% block webwms_show_stock_details_modal %}
    <div id="showStockDetails">
        <div class="modal-body">
            <div class="card">
                <div id="flash-message-overlay">
                    <div class="col">
                    </div>
                </div>
                    {% if stockDetails.info is defined %}
                        <div class="no-stock-details">{{ stockDetails.info }}</div>
                    {% else %}
                    <table id="showStockDetailTable" class="table table-striped table-bordered table-hover compact">
                        <thead>
                            <tr>
                                <th style="text-align: center; width: 7%;" scope="col">{{ 'modal.show_stock_details_modal.coordinate'|trans }}</th>
                                <th style="text-align: center; width: 7%;" scope="col">{{ 'article.article_input_fields.item_no'|trans }}</th>
                                <th style="text-align: center; width: 25%;" scope="col">{{ 'article.index.description'|trans }}</th>
                                <th style="text-align: center; width: 7%;" scope="col">{{ 'article.index.stock'|trans }}</th>
                                <th style="text-align: center; width: 7%;" scope="col">{{ 'article.index.access'|trans }}</th>
                                <th style="text-align: center; width: 7%;" scope="col">{{ 'modal.show_article_stock_details_modal.outbound_movement'|trans }}</th>
                                <th style="text-align: center; width: 10%;" scope="col">{{ 'modal.show_article_stock_details_modal.last_inbound_movement'|trans }}</th>
                                <th style="text-align: center; width: 10%;" scope="col">{{ 'modal.show_article_stock_details_modal.last_outbound_movement'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-article-nr="{{ stockDetails.article_nr }}">
                                <th style="text-align: center;" scope="col">{{ stockDetails.stock_location_coordinate }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetails.article_nr }}</th>
                                <th style="text-align: center;" scope="col">{{ stockDetails.article_name }}</th>
                                <th style="text-align: center;" scope="col">{% if stockDetails.in_stock is not null %}{{ stockDetails.in_stock }}{% else %}0.00{% endif %}</th>
                                <th style="text-align: center;" scope="col">{% if stockDetails.incoming_stock is not null %}{{ stockDetails.incoming_stock }}{% else %}0.00{% endif %}</th>
                                <th style="text-align: center;" scope="col">{% if stockDetails.reserved_stock is not null %}{{ stockDetails.reserved_stock }}{% else %}0.00{% endif %}</th>
                                <th style="text-align: center;" scope="col">{% if stockDetails.last_incoming is not null %}{{ stockDetails.last_incoming }}{% else %}...{% endif %}</th>
                                <th style="text-align: center;" scope="col">{% if stockDetails.last_outgoing is not null %}{{ stockDetails.last_outgoing }}{% else %}...{% endif %}</th>
                            </tr>
                        </tbody>
                    </table>
                    {% endif %}
            </div>
        </div>
        <div class="modal-footer">
            <br/>
        </div>
    </div>
{% endblock %}
