{# templates/modal/stock_transfer_placeholder.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_transfer_placeholder %}
        <div id="webwms-stock-transfer-placeholder" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="alert alert-info" role="alert">
                                    <h4 class="alert-heading">{{ page }}</h4>
                                    <p>
                                        <strong>Buchungsmethode:</strong> {{ booking_method }}
                                    </p>
                                    <hr>
                                    <p class="mb-0">
                                        Diese Funktion wird in der nächsten Version vollständig implementiert.
                                        Bitte führen Sie diese Operation bis dahin manuell durch.
                                    </p>
                                </div>

                                <div class="text-center">
                                    <a href="{{ path('homepage') }}" class="btn btn-secondary">Zurück</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

