{% extends 'base.html.twig' %}
{% block body %}
    <div class="container">
        <ul class="list-group">
            {% for role in roles %}
                <li>
                    <a href="{{ path('role_edit', {id: role.id}) }}"
                       class="btn btn-link btn-xs pull-right js-remove-scientist-user"
                    >
                        {{ role.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}