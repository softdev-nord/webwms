{% extends 'base.html.twig' %}
        {% block stylesheets %}
            <style>
                table, th, td {
                    border: 1px solid;
                }
            </style>
        {% endblock %}
{% block body %}
    <div class="container">
        <div style="margin: 30px;">
            <a href="{{ path('group_list') }}"
               class="btn btn-link btn-xs pull-right js-remove-scientist-user">
                {{ group.name }}
            </a>

        </div>

        <form method="post" action="{{ path('group_features', {id: group.id}) }}" name="edit_feature_list_for_group">

        <ul class="list-group-feature">
            {% for feature in featureList %}
                <input type="checkbox"  name="{{ feature.name }}" value="{{ feature.id }}"
                    {% if feature.id in groupFeatures %}
                        checked
                    {% endif %}
                >

                <label for="{{ feature.name }}"> {{ feature.displayName }} </label><br>
            {% endfor %}
        </ul>
            <button type="submit" value="Submit">Submit</button>
        </form>
    </div>
{% endblock %}