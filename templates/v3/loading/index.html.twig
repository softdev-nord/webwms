{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h1 class="h3 mb-1">{{ 'ui.v3.integration.device.scan.verladung.76c8aa0'|trans }}</h1>
			<p class="text-muted mb-0">{{ 'ui.v3.loading.index.sendungen.nach.tour.und.fahrzeug.gruppieren.und.kontrol.9988fa1'|trans }}</p>
		</div>
		{% if is_granted('fulfillment.loading.write') %}
			<a class="btn btn-primary" href="{{ path('v3_loading_new') }}">{{ 'ui.v3.loading.index.lademanifest.anlegen.9653cea'|trans }}</a>
		{% endif %}
	</div>

	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'ui.v3.loading.index.manifest.e63e451'|trans }}</th>
						<th>{{ 'ui.v3.loading.index.tour.cd9e8f3'|trans }}</th>
						<th>{{ 'ui.v3.loading.index.fahrzeug.f3acd14'|trans }}</th>
						<th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th>
						<th>{{ 'ui.v3.inbound.control.fortschritt.8dc6820'|trans }}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for manifest in manifests %}
						<tr>
							<td class="fw-semibold">{{ manifest.code }}</td>
							<td>{{ manifest.tour_reference }}</td>
							<td>{{ manifest.vehicle_reference }}</td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ manifest.status }}</span></td>
							<td>{{ manifest.loaded_shipment_count }}/{{ manifest.shipment_count }}</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_loading_show', {manifestId: manifest.id}) }}">{{ 'ui.v3.inbound.index.offnen.fc718f8'|trans }}</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-5">{{ 'ui.v3.loading.index.noch.keine.lademanifeste.vorhanden.1f28a5d'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
