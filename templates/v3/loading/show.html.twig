{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
		<div>
			<a href="{{ path('v3_loading_index') }}" class="text-decoration-none">← Verladung</a>
			<h1 class="h3 mt-2 mb-1">{{ manifest.code }}</h1>
			<p class="text-muted mb-0">Tour {{ manifest.tour_reference }} · Fahrzeug {{ manifest.vehicle_reference }}</p>
		</div>
		<span class="badge bg-secondary align-self-start fs-6">{{ manifest.status }}</span>
	</div>

	{% set loadedShipments = 0 %}
	{% for shipment in manifest.shipments %}
		{% if shipment.status == 'loaded' %}
			{% set loadedShipments = loadedShipments + 1 %}
		{% endif %}
	{% endfor %}

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header d-flex justify-content-between align-items-center">
			<h2 class="h5 mb-0">Ladeliste</h2>
			<span>{{ loadedShipments }}/{{ manifest.shipments|length }} verladen</span>
		</div>
		<div class="table-responsive">
			<table class="table align-middle mb-0">
				<thead>
					<tr>
						<th>Sendung</th>
						<th>Carrier</th>
						<th>Tracking</th>
						<th>Status</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for shipment in manifest.shipments %}
						<tr>
							<td class="fw-semibold">{{ shipment.shipment_number }}</td>
							<td>{{ shipment.carrier }} {{ shipment.service }}</td>
							<td>{{ shipment.tracking_number }}</td>
							<td>
								<span class="badge bg-{{ shipment.status == 'loaded' ? 'success' : 'warning' }}-subtle text-{{ shipment.status == 'loaded' ? 'success' : 'warning' }}">
									{{ shipment.status }}
								</span>
							</td>
							<td class="text-end">
								{% if shipment.status == 'pending' and manifest.status in ['open', 'loading'] and is_granted('fulfillment.loading.execute') %}
									<form method="post" action="{{ path('v3_loading_confirm', {manifestId: manifest.id, shipmentId: shipment.shipment_id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('v3_loading_confirm_' ~ shipment.shipment_id) }}">
										<button class="btn btn-sm btn-primary">Verladung bestätigen</button>
									</form>
								{% elseif shipment.loaded_at %}
									<span class="text-muted">{{ shipment.loaded_at }}</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	{% if manifest.status in ['open', 'loading'] and loadedShipments == manifest.shipments|length and is_granted('fulfillment.loading.execute') %}
		<form method="post" action="{{ path('v3_loading_complete', {manifestId: manifest.id}) }}">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_loading_complete_' ~ manifest.id) }}">
			<button class="btn btn-success">Verladung abschließen</button>
		</form>
	{% endif %}
{% endblock %}
