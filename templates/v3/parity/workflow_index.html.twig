{% extends 'v3/base.html.twig' %}
{% block title %}{{ label }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">{{ label }}</h1><p class="text-muted mb-0">Operative Vorgänge</p></div>
    <div><a class="btn btn-outline-secondary me-2" href="{{ path('v3_parity_index') }}">Gesamtübersicht</a>{% if is_granted('platform.parity.execute') %}<a class="btn btn-primary" href="{{ path('v3_parity_work_item_new',{workflow:workflow}) }}">Vorgang starten</a>{% endif %}</div>
</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Referenz</th><th>Status</th><th>Erstellt</th><th>Geändert</th><th class="text-end">Aktion</th></tr></thead><tbody>
{% for item in workItems %}<tr><td>{{ item.reference }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ item.status }}</span></td><td>{{ item.created_at }}</td><td>{{ item.changed_at }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_parity_work_item_show',{id:item.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Vorgänge vorhanden.</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}
