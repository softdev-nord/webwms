{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.platform.index.platform.control.center'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.platform.index.shopfloor.kennzahlen.partner.automatisierung.abrechnung'|trans }}</p></div><form class="d-flex" method="get"><input class="form-control" name="q" value="{{ query }}" placeholder="{{ 'ui.v3.platform.index.systemweit.suchen'|trans }}"><button class="btn btn-primary ms-2">{{ 'ui.v3.documentation.index.suchen'|trans }}</button></form></div>
{% if query %}<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.platform.index.suchergebnisse.fur'|trans }}{{ query }}“</h2></div><div class="list-group list-group-flush">{% for result in searchResults %}<div class="list-group-item"><strong>{{ result.title }}</strong><span class="badge bg-secondary-subtle text-secondary ms-2">{{ result.document_type }}</span><div class="small text-muted text-truncate">{{ result.body }}</div></div>{% else %}<div class="list-group-item text-muted">{{ 'ui.v3.platform.index.keine.treffer'|trans }}</div>{% endfor %}</div></div>{% endif %}
<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">{% for id, label in {shopfloor:'Shopfloor',kpi:'KPI',portal:'Partnerportal',events:'Eventcenter',billing:'Abrechnung',media:'Medien & Druck'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#platform-{{ id }}" type="button">{{ label }}</button></li>{% endfor %}</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="platform-shopfloor"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.platform.index.aufgabe.planen'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_platform_create',{resource:'task'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_task') }}"><div class="col-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-8"><input class="form-control" name="title" placeholder="{{ 'ui.v3.platform.index.aufgabe'|trans }}" required></div><div class="col-6"><select class="form-select" name="task_type"><option value="putaway">{{ 'ui.v3.platform.index.einlagerung'|trans }}</option><option value="retrieval">{{ 'ui.v3.platform.index.auslagerung'|trans }}</option><option value="transport">{{ 'ui.v3.integration.wcs.command-new.transport'|trans }}</option><option value="inventory">{{ 'nav.inventory.headline'|trans }}</option></select></div><div class="col-3"><input class="form-control" type="number" name="priority" value="50" min="1" max="999"></div><div class="col-3"><input class="form-control" name="reference_type" placeholder="{{ 'ui.v3.integration.automation.command-new.referenztyp'|trans }}"></div><div class="col-6"><input class="form-control" name="reference_id" placeholder="{{ 'ui.v3.platform.index.referenz.id'|trans }}"></div><div class="col-6"><input class="form-control" type="datetime-local" name="planned_for"></div><div class="col-12"><select class="form-select" name="assigned_to"><option value="">{{ 'ui.v3.platform.index.nicht.zugewiesen'|trans }}</option>{% for user in platform.users %}<option value="{{ user.id }}">{{ user.email }}</option>{% endfor %}</select></div><button class="btn btn-primary">{{ 'ui.v3.platform.index.planen'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inventory.configuration_form.prioritat'|trans }}</th><th>{{ 'ui.v3.platform.index.aufgabe'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th>{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for task in platform.tasks %}<tr><td>{{ task.priority }}</td><td><strong>{{ task.code }}</strong><div class="small text-muted">{{ task.title }}</div></td><td>{{ task.task_type }}</td><td>{{ task.status }}</td><td>{% set next = task.status == 'planned' ? 'released' : (task.status == 'released' ? 'in_progress' : (task.status == 'in_progress' ? 'completed' : null)) %}{% if next %}<form method="post" action="{{ path('v3_platform_task_status',{taskId:task.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_task_'~task.id) }}"><input type="hidden" name="status" value="{{ next }}"><button class="btn btn-sm btn-outline-primary">{{ next }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.platform.index.keine.shopfloor.aufgaben'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="platform-kpi"><div class="row g-3 mb-3">{% for kpi in platform.kpis %}<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ kpi.name }}</div><div class="fs-3 fw-semibold">{{ kpi.value|default('–') }}</div><small>{{ 'ui.v3.platform.index.ziel'|trans }} {{ kpi.target_value|default('–') }}</small></div></div></div>{% endfor %}</div><div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.kpi.definieren'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'kpi'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_kpi') }}"><input type="hidden" name="active" value="1"><div class="col-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-8"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div class="col-8"><select class="form-select" name="metric"><option value="open_shopfloor_tasks">{{ 'ui.v3.platform.index.offene.shopfloor.aufgaben'|trans }}</option><option value="stock_quantity">{{ 'ui.v3.platform.index.bestandsmenge'|trans }}</option><option value="open_outbound_orders">{{ 'ui.v3.platform.index.offene.ausgangsauftrage'|trans }}</option><option value="open_inbound_deliveries">{{ 'ui.v3.platform.index.offene.eingange'|trans }}</option><option value="queued_print_jobs">{{ 'ui.v3.platform.index.offene.druckjobs'|trans }}</option></select></div><div class="col-4"><select class="form-select" name="aggregation"><option value="count">{{ 'ui.v3.platform.index.anzahl'|trans }}</option><option value="sum">{{ 'ui.v3.platform.index.summe'|trans }}</option><option value="average">{{ 'ui.v3.platform.index.mittelwert'|trans }}</option></select></div><div class="col-6"><input class="form-control" type="number" step="0.0001" name="target_value" placeholder="{{ 'ui.v3.platform.index.zielwert'|trans }}"></div><div class="col-6"><button class="btn btn-primary w-100">{{ 'button.save'|trans }}</button></div></form></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.dashboard.anlegen'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'dashboard'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_dashboard') }}"><div class="col-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-8"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div class="col-12"><textarea class="form-control font-monospace" name="layout_json" required>{{ 'ui.v3.platform.index.columns.4.kpis'|trans }}</textarea></div><button class="btn btn-primary">{{ 'ui.v3.platform.index.dashboard.speichern'|trans }}</button></form></div></div></div></div></div>
<div class="tab-pane fade" id="platform-portal"><div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.partnerzugang'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'partner_account'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_partner_account') }}"><input type="hidden" name="active" value="1"><div><select class="form-select" name="business_partner_id" required>{% for partner in platform.partners %}<option value="{{ partner.id }}">{{ partner.code }} · {{ partner.name }}</option>{% endfor %}</select></div><div><select class="form-select" name="user_id" required>{% for user in platform.users %}<option value="{{ user.id }}">{{ user.email }}</option>{% endfor %}</select></div><textarea class="form-control font-monospace" name="permissions">{{ 'ui.v3.platform.index.billing.read.media.read'|trans }}</textarea><button class="btn btn-primary">{{ 'ui.v3.platform.index.zugang.anlegen'|trans }}</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inventory.control.partner'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th><th>{{ 'ui.user.user_role.index.rechte'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th></tr></thead><tbody>{% for account in platform.partnerAccounts %}<tr><td>{{ account.partner_code }}</td><td>{{ account.email }}</td><td><code>{{ account.permissions }}</code></td><td>{{ (account.active ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.platform.index.keine.partnerzugange'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="platform-events"><div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.automationsregel'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'automation_rule'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_automation_rule') }}"><input type="hidden" name="active" value="1"><div class="col-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-8"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div><input class="form-control" name="event_name" placeholder="{{ 'ui.v3.platform.index.z.b.shipment.dispatched'|trans }}" required></div><div class="col-6"><textarea class="form-control font-monospace" name="conditions_json">{}</textarea></div><div class="col-6"><select class="form-select mb-2" name="action_type"><option value="print">{{ 'ui.v3.platform.index.drucken'|trans }}</option><option value="notification">{{ 'ui.logging.index.nachricht'|trans }}</option><option value="follow_up_task">{{ 'ui.v3.platform.index.folgeauftrag'|trans }}</option></select><textarea class="form-control font-monospace" name="action_config">{}</textarea></div><button class="btn btn-primary">{{ 'ui.v3.outbound.control.regel.aktivieren'|trans }}</button></form></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.event.testen'|trans }}</h2><form method="post" action="{{ path('v3_platform_event') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_event') }}"><input class="form-control" name="event_name" placeholder="{{ 'ui.v3.platform.index.eventname'|trans }}" required><textarea class="form-control font-monospace" name="payload">{}</textarea><button class="btn btn-outline-primary">{{ 'ui.v3.platform.index.regeln.auswerten'|trans }}</button></form><hr>{% for rule in platform.rules %}<div><strong>{{ rule.code }}</strong> · {{ rule.event_name }} → {{ rule.action_type }}</div>{% endfor %}</div></div></div></div></div>
<div class="tab-pane fade" id="platform-billing"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.lagergeldtarif'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'storage_fee_rule'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_storage_fee_rule') }}"><input type="hidden" name="active" value="1"><select class="form-select" name="business_partner_id">{% for partner in platform.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required><input class="form-control" name="name" placeholder="{{ 'ui.v3.platform.index.tarifname'|trans }}" required><div class="col-6"><input class="form-control" type="number" step="0.0001" name="price_per_unit_day" placeholder="{{ 'ui.v3.platform.index.preis.tag'|trans }}" required></div><div class="col-3"><input class="form-control" type="number" name="free_days" value="0"></div><div class="col-3"><input class="form-control" name="currency" value="EUR"></div><button class="btn btn-primary">{{ 'ui.v3.platform.index.tarif.speichern'|trans }}</button></form></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.zusatzleistung'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'service'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_service') }}"><input type="hidden" name="active" value="1"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required><input class="form-control" name="name" placeholder="{{ 'ui.v3.platform.index.leistung'|trans }}" required><div class="col-4"><input class="form-control" name="unit" placeholder="{{ 'ui.article.index.einheit'|trans }}" required></div><div class="col-4"><input class="form-control" type="number" step="0.0001" name="unit_price" placeholder="{{ 'ui.v3.platform.index.preis'|trans }}" required></div><div class="col-4"><input class="form-control" name="currency" value="EUR"></div><button class="btn btn-primary">{{ 'ui.v3.platform.index.leistung.speichern'|trans }}</button></form></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.abrechenbare.position'|trans }}</h2><form method="post" action="{{ path('v3_platform_bill_storage') }}" class="row g-2 mb-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_bill_storage') }}"><select class="form-select" name="rule_id">{% for rule in platform.storageFeeRules %}<option value="{{ rule.id }}">{{ rule.code }}</option>{% endfor %}</select><div class="col-4"><input class="form-control" name="quantity" type="number" step="0.0001" placeholder="{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}"></div><div class="col-4"><input class="form-control" name="days" type="number" placeholder="{{ 'ui.v3.platform.index.tage'|trans }}"></div><div class="col-4"><input class="form-control" name="reference" placeholder="{{ 'ui.stock.stock_rotation.referenz'|trans }}"></div><button class="btn btn-outline-primary">{{ 'nav.evaluations.submenu.headline4'|trans }}</button></form><form method="post" action="{{ path('v3_platform_bill_service') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_bill_service') }}"><select class="form-select" name="service_id">{% for service in platform.services %}<option value="{{ service.id }}">{{ service.code }}</option>{% endfor %}</select><select class="form-select" name="business_partner_id">{% for partner in platform.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="quantity" type="number" step="0.0001" placeholder="{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}"></div><div class="col-6"><input class="form-control" name="reference" placeholder="{{ 'ui.stock.stock_rotation.referenz'|trans }}"></div><button class="btn btn-outline-primary">{{ 'ui.v3.platform.index.vas.erfassen'|trans }}</button></form></div></div></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'templates.correspondence.created'|trans }}</th><th>{{ 'ui.v3.inventory.control.partner'|trans }}</th><th>{{ 'ui.v3.platform.index.leistung'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th><th>{{ 'ui.v3.platform.index.betrag'|trans }}</th></tr></thead><tbody>{% for line in platform.billableLines %}<tr><td>{{ line.service_date }}</td><td>{{ line.partner_code }}</td><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.amount }} {{ line.currency }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.platform.index.keine.abrechnungspositionen'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div>
<div class="tab-pane fade" id="platform-media"><div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.kamera.datei.zuordnen'|trans }}</h2><form method="post" enctype="multipart/form-data" action="{{ path('v3_platform_media') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_media') }}"><div class="col-4"><input class="form-control" name="aggregate_type" placeholder="{{ 'ui.v3.administration.workspace.objekttyp'|trans }}" required></div><div class="col-8"><input class="form-control" name="aggregate_id" placeholder="{{ 'ui.v3.platform.index.objekt.id'|trans }}" required></div><input class="form-control" type="file" name="file" accept="image/jpeg,image/png,image/webp,application/pdf" capture="environment" required><button class="btn btn-primary">{{ 'ui.v3.platform.index.aufnahme.speichern'|trans }}</button></form><div class="mt-3">{% for media in platform.media %}<a class="d-block" target="_blank" href="{{ path('v3_platform_media_show',{mediaId:media.id}) }}">{{ media.filename }} · {{ media.aggregate_type }}</a>{% endfor %}</div></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.platform.index.druckrouting'|trans }}</h2><form method="post" action="{{ path('v3_platform_create',{resource:'print_route'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_print_route') }}"><input type="hidden" name="active" value="1"><div class="col-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-8"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div class="col-6"><input class="form-control" name="document_type" placeholder="{{ 'ui.v3.integration.printing.job-new.dokumenttyp'|trans }}" required></div><div class="col-6"><select class="form-select" name="printer_id">{% for printer in platform.printers %}<option value="{{ printer.id }}">{{ printer.name }}</option>{% endfor %}</select></div><div class="col-4"><select class="form-select" name="site_id"><option value="">{{ 'ui.v3.platform.index.alle.standorte'|trans }}</option>{% for site in platform.sites %}<option value="{{ site.id }}">{{ site.code }}</option>{% endfor %}</select></div><div class="col-4"><input class="form-control" name="workstation" placeholder="{{ 'ui.v3.platform.index.arbeitsplatz'|trans }}"></div><div class="col-4"><input class="form-control" name="process_key" placeholder="{{ 'ui.v3.integration.device.index.prozess'|trans }}"></div><div class="col-4"><input class="form-control" name="priority" type="number" value="100"></div><div class="col-8"><button class="btn btn-primary w-100">{{ 'ui.v3.platform.index.routingregel.speichern'|trans }}</button></div></form><hr>{% for route in platform.printRoutes %}<div><strong>{{ route.code }}</strong> · {{ route.document_type }} → {{ route.printer_name }}</div>{% endfor %}</div></div></div></div></div>
</div>
{% endblock %}
