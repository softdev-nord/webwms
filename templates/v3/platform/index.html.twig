{% extends 'v3/base.html.twig' %}
{% block title %}Platform Control Center | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Platform Control Center</h1><p class="text-muted mb-0">Shopfloor, Kennzahlen, Partner, Automatisierung, Abrechnung, Suche, Medien und Druckrouting</p></div><form class="d-flex" method="get"><input class="form-control" name="q" value="{{ query }}" placeholder="Systemweit suchen…"><button class="btn btn-primary ms-2">Suchen</button></form></div>
{% if query %}<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Suchergebnisse für „{{ query }}“</h2></div><div class="list-group list-group-flush">{% for result in searchResults %}<div class="list-group-item"><strong>{{ result.title }}</strong><span class="badge bg-secondary-subtle text-secondary ms-2">{{ result.document_type }}</span><div class="small text-muted text-truncate">{{ result.body }}</div></div>{% else %}<div class="list-group-item text-muted">Keine Treffer.</div>{% endfor %}</div></div>{% endif %}
<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">{% for id, label in {shopfloor:'Shopfloor',kpi:'KPI',portal:'Partnerportal',events:'Eventcenter',billing:'Abrechnung',media:'Medien & Druck'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#platform-{{ id }}" type="button">{{ label }}</button></li>{% endfor %}</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="platform-shopfloor"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Aufgabe planen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_platform_create',{resource:'task'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_task') }}"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="title" placeholder="Aufgabe" required></div><div class="col-6"><select class="form-select" name="task_type"><option value="putaway">Einlagerung</option><option value="retrieval">Auslagerung</option><option value="transport">Transport</option><option value="inventory">Inventur</option></select></div><div class="col-3"><input class="form-control" type="number" name="priority" value="50" min="1" max="999"></div><div class="col-3"><input class="form-control" name="reference_type" placeholder="Referenztyp"></div><div class="col-6"><input class="form-control" name="reference_id" placeholder="Referenz-ID"></div><div class="col-6"><input class="form-control" type="datetime-local" name="planned_for"></div><div class="col-12"><select class="form-select" name="assigned_to"><option value="">Nicht zugewiesen</option>{% for user in platform.users %}<option value="{{ user.id }}">{{ user.email }}</option>{% endfor %}</select></div><button class="btn btn-primary">Planen</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Priorität</th><th>Aufgabe</th><th>Typ</th><th>Status</th><th>Aktion</th></tr></thead><tbody>{% for task in platform.tasks %}<tr><td>{{ task.priority }}</td><td><strong>{{ task.code }}</strong><div class="small text-muted">{{ task.title }}</div></td><td>{{ task.task_type }}</td><td>{{ task.status }}</td><td>{% set next = task.status == 'planned' ? 'released' : (task.status == 'released' ? 'in_progress' : (task.status == 'in_progress' ? 'completed' : null)) %}{% if next %}<form method="post" action="{{ path('v3_platform_task_status',{taskId:task.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_task_'~task.id) }}"><input type="hidden" name="status" value="{{ next }}"><button class="btn btn-sm btn-outline-primary">{{ next }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Shopfloor-Aufgaben.</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="platform-kpi"><div class="row g-3 mb-3">{% for kpi in platform.kpis %}<div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ kpi.name }}</div><div class="fs-3 fw-semibold">{{ kpi.value|default('–') }}</div><small>Ziel: {{ kpi.target_value|default('–') }}</small></div></div></div>{% endfor %}</div><div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">KPI definieren</h2><form method="post" action="{{ path('v3_platform_create',{resource:'kpi'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_kpi') }}"><input type="hidden" name="active" value="1"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-8"><select class="form-select" name="metric"><option value="open_shopfloor_tasks">Offene Shopfloor-Aufgaben</option><option value="stock_quantity">Bestandsmenge</option><option value="open_outbound_orders">Offene Ausgangsaufträge</option><option value="open_inbound_deliveries">Offene Eingänge</option><option value="queued_print_jobs">Offene Druckjobs</option></select></div><div class="col-4"><select class="form-select" name="aggregation"><option value="count">Anzahl</option><option value="sum">Summe</option><option value="average">Mittelwert</option></select></div><div class="col-6"><input class="form-control" type="number" step="0.0001" name="target_value" placeholder="Zielwert"></div><div class="col-6"><button class="btn btn-primary w-100">Speichern</button></div></form></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Dashboard anlegen</h2><form method="post" action="{{ path('v3_platform_create',{resource:'dashboard'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_dashboard') }}"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-12"><textarea class="form-control font-monospace" name="layout_json" required>{"columns":4,"kpis":[]}</textarea></div><button class="btn btn-primary">Dashboard speichern</button></form></div></div></div></div></div>
<div class="tab-pane fade" id="platform-portal"><div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Partnerzugang</h2><form method="post" action="{{ path('v3_platform_create',{resource:'partner_account'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_partner_account') }}"><input type="hidden" name="active" value="1"><div><select class="form-select" name="business_partner_id" required>{% for partner in platform.partners %}<option value="{{ partner.id }}">{{ partner.code }} · {{ partner.name }}</option>{% endfor %}</select></div><div><select class="form-select" name="user_id" required>{% for user in platform.users %}<option value="{{ user.id }}">{{ user.email }}</option>{% endfor %}</select></div><textarea class="form-control font-monospace" name="permissions">["billing.read","media.read"]</textarea><button class="btn btn-primary">Zugang anlegen</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Partner</th><th>Benutzer</th><th>Rechte</th><th>Status</th></tr></thead><tbody>{% for account in platform.partnerAccounts %}<tr><td>{{ account.partner_code }}</td><td>{{ account.email }}</td><td><code>{{ account.permissions }}</code></td><td>{{ account.active ? 'Aktiv':'Inaktiv' }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">Keine Partnerzugänge.</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="platform-events"><div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Automationsregel</h2><form method="post" action="{{ path('v3_platform_create',{resource:'automation_rule'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_automation_rule') }}"><input type="hidden" name="active" value="1"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div><div><input class="form-control" name="event_name" placeholder="z. B. shipment.dispatched" required></div><div class="col-6"><textarea class="form-control font-monospace" name="conditions_json">{}</textarea></div><div class="col-6"><select class="form-select mb-2" name="action_type"><option value="print">Drucken</option><option value="notification">Nachricht</option><option value="follow_up_task">Folgeauftrag</option></select><textarea class="form-control font-monospace" name="action_config">{}</textarea></div><button class="btn btn-primary">Regel aktivieren</button></form></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Event testen</h2><form method="post" action="{{ path('v3_platform_event') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_event') }}"><input class="form-control" name="event_name" placeholder="Eventname" required><textarea class="form-control font-monospace" name="payload">{}</textarea><button class="btn btn-outline-primary">Regeln auswerten</button></form><hr>{% for rule in platform.rules %}<div><strong>{{ rule.code }}</strong> · {{ rule.event_name }} → {{ rule.action_type }}</div>{% endfor %}</div></div></div></div></div>
<div class="tab-pane fade" id="platform-billing"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Lagergeldtarif</h2><form method="post" action="{{ path('v3_platform_create',{resource:'storage_fee_rule'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_storage_fee_rule') }}"><input type="hidden" name="active" value="1"><select class="form-select" name="business_partner_id">{% for partner in platform.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select><input class="form-control" name="code" placeholder="Code" required><input class="form-control" name="name" placeholder="Tarifname" required><div class="col-6"><input class="form-control" type="number" step="0.0001" name="price_per_unit_day" placeholder="Preis/Tag" required></div><div class="col-3"><input class="form-control" type="number" name="free_days" value="0"></div><div class="col-3"><input class="form-control" name="currency" value="EUR"></div><button class="btn btn-primary">Tarif speichern</button></form></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Zusatzleistung</h2><form method="post" action="{{ path('v3_platform_create',{resource:'service'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_service') }}"><input type="hidden" name="active" value="1"><input class="form-control" name="code" placeholder="Code" required><input class="form-control" name="name" placeholder="Leistung" required><div class="col-4"><input class="form-control" name="unit" placeholder="Einheit" required></div><div class="col-4"><input class="form-control" type="number" step="0.0001" name="unit_price" placeholder="Preis" required></div><div class="col-4"><input class="form-control" name="currency" value="EUR"></div><button class="btn btn-primary">Leistung speichern</button></form></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Abrechenbare Position</h2><form method="post" action="{{ path('v3_platform_bill_storage') }}" class="row g-2 mb-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_bill_storage') }}"><select class="form-select" name="rule_id">{% for rule in platform.storageFeeRules %}<option value="{{ rule.id }}">{{ rule.code }}</option>{% endfor %}</select><div class="col-4"><input class="form-control" name="quantity" type="number" step="0.0001" placeholder="Menge"></div><div class="col-4"><input class="form-control" name="days" type="number" placeholder="Tage"></div><div class="col-4"><input class="form-control" name="reference" placeholder="Referenz"></div><button class="btn btn-outline-primary">Lagergeld berechnen</button></form><form method="post" action="{{ path('v3_platform_bill_service') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_bill_service') }}"><select class="form-select" name="service_id">{% for service in platform.services %}<option value="{{ service.id }}">{{ service.code }}</option>{% endfor %}</select><select class="form-select" name="business_partner_id">{% for partner in platform.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="quantity" type="number" step="0.0001" placeholder="Menge"></div><div class="col-6"><input class="form-control" name="reference" placeholder="Referenz"></div><button class="btn btn-outline-primary">VAS erfassen</button></form></div></div></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Datum</th><th>Partner</th><th>Leistung</th><th>Menge</th><th>Betrag</th></tr></thead><tbody>{% for line in platform.billableLines %}<tr><td>{{ line.service_date }}</td><td>{{ line.partner_code }}</td><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.amount }} {{ line.currency }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Abrechnungspositionen.</td></tr>{% endfor %}</tbody></table></div></div></div>
<div class="tab-pane fade" id="platform-media"><div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Kamera / Datei zuordnen</h2><form method="post" enctype="multipart/form-data" action="{{ path('v3_platform_media') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_media') }}"><div class="col-4"><input class="form-control" name="aggregate_type" placeholder="Objekttyp" required></div><div class="col-8"><input class="form-control" name="aggregate_id" placeholder="Objekt-ID" required></div><input class="form-control" type="file" name="file" accept="image/jpeg,image/png,image/webp,application/pdf" capture="environment" required><button class="btn btn-primary">Aufnahme speichern</button></form><div class="mt-3">{% for media in platform.media %}<a class="d-block" target="_blank" href="{{ path('v3_platform_media_show',{mediaId:media.id}) }}">{{ media.filename }} · {{ media.aggregate_type }}</a>{% endfor %}</div></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Druckrouting</h2><form method="post" action="{{ path('v3_platform_create',{resource:'print_route'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_print_route') }}"><input type="hidden" name="active" value="1"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-6"><input class="form-control" name="document_type" placeholder="Dokumenttyp" required></div><div class="col-6"><select class="form-select" name="printer_id">{% for printer in platform.printers %}<option value="{{ printer.id }}">{{ printer.name }}</option>{% endfor %}</select></div><div class="col-4"><select class="form-select" name="site_id"><option value="">Alle Standorte</option>{% for site in platform.sites %}<option value="{{ site.id }}">{{ site.code }}</option>{% endfor %}</select></div><div class="col-4"><input class="form-control" name="workstation" placeholder="Arbeitsplatz"></div><div class="col-4"><input class="form-control" name="process_key" placeholder="Prozess"></div><div class="col-4"><input class="form-control" name="priority" type="number" value="100"></div><div class="col-8"><button class="btn btn-primary w-100">Routingregel speichern</button></div></form><hr>{% for route in platform.printRoutes %}<div><strong>{{ route.code }}</strong> · {{ route.document_type }} → {{ route.printer_name }}</div>{% endfor %}</div></div></div></div></div>
</div>
{% endblock %}
