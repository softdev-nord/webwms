{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms.5de7112'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.platform.portal.partnerportal.89695ab'|trans }}</h1><p class="text-muted">{{ portal.account.partner_code }} · {{ portal.account.partner_name }}</p></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.platform.portal.abrechenbare.leistungen.8d21702'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'templates.correspondence.created'|trans }}</th><th>{{ 'ui.stock.stock_rotation.referenz.1ac5c0e'|trans }}</th><th>{{ 'ui.v3.platform.index.leistung.4606f4f'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th><th>{{ 'ui.v3.platform.index.betrag.ff7324a'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th></tr></thead><tbody>{% for line in portal.billableLines %}<tr><td>{{ line.service_date }}</td><td>{{ line.source_reference }}</td><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.amount }} {{ line.currency }}</td><td>{{ line.status }}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.platform.portal.keine.leistungen.vorhanden.c891beb'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.platform.portal.dokumente.und.medien.40454d7'|trans }}</h2></div><div class="list-group list-group-flush">{% for media in portal.media %}<a class="list-group-item list-group-item-action" target="_blank" href="{{ path('v3_partner_portal_media',{mediaId:media.id}) }}">{{ media.filename }} <span class="text-muted">· {{ media.captured_at|date('d.m.Y H:i') }}</span></a>{% else %}<div class="list-group-item text-muted">{{ 'ui.v3.platform.portal.keine.medien.vorhanden.fec3f3d'|trans }}</div>{% endfor %}</div></div>
{% endblock %}
