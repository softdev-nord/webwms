{% extends 'v3/base.html.twig' %}
{% block title %}Auftrag {{ order.order_number }} | WebWMS 3.0{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a href="{{ path('v3_outbound_orders') }}" class="text-decoration-none">← Aufträge</a><h1 class="h3 mt-2 mb-1">{{ order.order_number }}</h1><p class="text-muted">Kundenreferenz {{ order.customer_reference }}</p></div><span class="badge bg-secondary fs-6">{{ order.status }}</span></div>
{% if order.status in ['created', 'imported'] and is_granted('outbound.order.release') %}<form method="post" action="{{ path('v3_outbound_order_release', {orderId: order.id}) }}" class="mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_order_release_' ~ order.id) }}"><button class="btn btn-primary">Auftrag freigeben und reservieren</button></form>{% endif %}
<div class="row g-3">
{% for item in order.items %}<div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><div><h2 class="h5 mb-1">{{ item.sku }}</h2><span class="text-muted">Angefordert: {{ item.requested_quantity }}</span></div><span class="badge bg-info-subtle text-info">{{ item.reservation_status ?: 'nicht reserviert' }}</span></div>
{% if item.reservation_id %}<div class="row mt-3"><div class="col-sm-4"><small class="text-muted d-block">Reserviert</small>{{ item.requested_quantity }}</div><div class="col-sm-4"><small class="text-muted d-block">Allokiert</small>{{ item.allocated_quantity }}</div><div class="col-sm-4"><small class="text-muted d-block">Erfüllt</small>{{ item.fulfilled_quantity }}</div></div>
{% set remaining = item.requested_quantity - item.allocated_quantity %}{% if remaining > 0 and is_granted('inventory.allocation.write') %}<form class="row g-2 mt-3 align-items-end" method="post" action="{{ path('v3_outbound_allocation', {orderId: order.id, reservationId: item.reservation_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_allocate_' ~ item.reservation_id) }}"><div class="col-md-8"><label class="form-label">Verfügbarer Lagerplatz</label><select class="form-select" name="location_id" required>{% for stock in item.stock %}<option value="{{ stock.location_id }}">{{ stock.location_code }} – verfügbar {{ stock.available_quantity }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label">Menge</label><input class="form-control" type="number" name="quantity" min="1" max="{{ remaining }}" value="{{ remaining }}" required></div><div class="col-md-2"><button class="btn btn-outline-primary w-100" {% if item.stock is empty %}disabled{% endif %}>Allokieren</button></div></form>{% endif %}{% endif %}
</div></div></div>{% endfor %}</div>
{% set fullyAllocated = true %}{% for item in order.items %}{% if not item.reservation_id or item.allocated_quantity < item.requested_quantity %}{% set fullyAllocated = false %}{% endif %}{% endfor %}
{% if order.pick_list_id %}<div class="mt-4"><a class="btn btn-primary" href="{{ path('v3_picking_show', {pickListId: order.pick_list_id}) }}">Pickliste {{ order.pick_list_code }} öffnen</a></div>{% elseif order.status == 'released' and fullyAllocated and is_granted('fulfillment.pick.write') %}<div class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5">Übergabe an Picking</h2><form method="post" action="{{ path('v3_outbound_pick_list_create', {orderId: order.id}) }}" class="d-flex gap-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_pick_list_' ~ order.id) }}"><input class="form-control" name="code" value="PICK-{{ order.order_number }}" required><button class="btn btn-primary text-nowrap">Pickliste erzeugen</button></form></div></div>{% endif %}
{% endblock %}
