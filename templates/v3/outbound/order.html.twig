{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
		<div>
			<a href="{{ path('v3_outbound_orders') }}" class="text-decoration-none">{{ 'ui.v3.outbound.order.auftrage'|trans }}</a>
			<h1 class="h3 mt-2 mb-1">{{ order.order_number }}</h1>
			<p class="text-muted">{{ 'ui.v3.outbound.order.kundenreferenz'|trans }} {{ order.customer_reference }}</p>
		</div>
		<span class="badge bg-secondary fs-6">{{ order.status }}</span>
	</div>

	{% if order.status in ['created', 'imported'] and is_granted('outbound.order.release') %}
		<form method="post" action="{{ path('v3_outbound_order_release', {orderId: order.id}) }}" class="mb-4">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_order_release_' ~ order.id) }}">
			<button class="btn btn-primary">{{ 'ui.v3.outbound.order.auftrag.freigeben.und.reservieren'|trans }}</button>
		</form>
	{% endif %}

	<div class="row g-3">
		{% for item in order.items %}
			<div class="col-12">
				<div class="card border-0 shadow-sm">
					<div class="card-body">
						<div class="d-flex justify-content-between">
							<div>
								<h2 class="h5 mb-1">{{ item.sku }}</h2>
								<span class="text-muted">{{ 'ui.v3.outbound.order.angefordert'|trans }} {{ item.requested_quantity }}</span>
							</div>
							<span class="badge bg-info-subtle text-info">{{ item.reservation_status ?: 'nicht reserviert' }}</span>
						</div>

						{% if item.reservation_id %}
							<div class="row mt-3">
								<div class="col-sm-4">
									<small class="text-muted d-block">{{ 'ui.article.index.reserviert'|trans }}</small>
									{{ item.requested_quantity }}
								</div>
								<div class="col-sm-4">
									<small class="text-muted d-block">{{ 'ui.v3.outbound.order.allokiert'|trans }}</small>
									{{ item.allocated_quantity }}
								</div>
								<div class="col-sm-4">
									<small class="text-muted d-block">{{ 'ui.v3.outbound.order.erfullt'|trans }}</small>
									{{ item.fulfilled_quantity }}
								</div>
							</div>

							{% set remaining = item.requested_quantity - item.allocated_quantity %}

							{% if remaining > 0 and is_granted('inventory.allocation.write') %}
								{% set applicableRules = selectionRules|filter(rule => rule.enabled and (not rule.product_id or rule.product_id == item.product_id)) %}
								{% if applicableRules|length > 0 and is_granted('inventory.selection.execute') %}
									<form class="row g-2 align-items-end mt-3 p-3 bg-light rounded" method="post" action="{{ path('v3_outbound_automatic_allocation', {orderId: order.id, reservationId: item.reservation_id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_auto_allocate_' ~ item.reservation_id) }}">
										<div class="col-md-8"><label class="form-label small fw-semibold">{{ 'ui.v3.outbound.order.automatische.entnahme'|trans }}</label><select class="form-select form-select-sm" name="rule_id" required>{% for rule in applicableRules %}<option value="{{ rule.id }}">{{ rule.code }} · {{ rule.strategy|upper }}{% if rule.warehouse_code %} · {{ rule.warehouse_code }}{% endif %}</option>{% endfor %}</select></div>
										<div class="col-md-4"><button class="btn btn-sm btn-primary w-100">{{ 'ui.v3.outbound.order.restmenge.automatisch.allokieren'|trans }}</button></div>
									</form>
								{% endif %}
								<div class="mt-3"><div class="small fw-semibold mb-2">{{ 'ui.v3.outbound.order.bestandsdimension.auswahlen'|trans }}</div>{% for stock in item.stock %}<form class="row g-2 align-items-center border-top py-2" method="post" action="{{ path('v3_outbound_allocation', {orderId: order.id, reservationId: item.reservation_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_allocate_' ~ item.reservation_id) }}"><input type="hidden" name="location_id" value="{{ stock.location_id }}"><input type="hidden" name="stock_status" value="{{ stock.stock_status }}"><input type="hidden" name="batch_number" value="{{ stock.batch_number }}"><input type="hidden" name="serial_number" value="{{ stock.serial_number }}"><input type="hidden" name="expires_at" value="{{ stock.expires_at }}"><div class="col-md-7"><strong>{{ stock.location_code }}</strong> · {{ stock.stock_status }}{% if stock.batch_number %} {{ 'ui.v3.outbound.order.charge'|trans }} {{ stock.batch_number }}{% endif %}{% if stock.serial_number %} {{ 'ui.v3.outbound.order.sn'|trans }} {{ stock.serial_number }}{% endif %}{% if stock.expires_at %} {{ 'ui.v3.outbound.order.mhd'|trans }} {{ stock.expires_at|date('d.m.Y') }}{% endif %}<div class="small text-muted">{{ 'ui.v3.outbound.order.verfugbar'|trans }} {{ stock.available_quantity }}</div></div><div class="col-md-2"><input class="form-control form-control-sm" type="number" name="quantity" min="1" max="{{ min(remaining, stock.available_quantity) }}" value="{{ stock.serial_number ? 1 : min(remaining, stock.available_quantity) }}" required></div><div class="col-md-3"><button class="btn btn-sm btn-outline-primary w-100">{{ 'ui.v3.outbound.order.allokieren'|trans }}</button></div></form>{% else %}<div class="alert alert-warning mb-0">{{ 'ui.v3.outbound.order.kein.passender.bestand.verfugbar'|trans }}</div>{% endfor %}</div>
							{% endif %}
						{% endif %}
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

	{% set fullyAllocated = true %}
	{% for item in order.items %}
		{% if not item.reservation_id or item.allocated_quantity < item.requested_quantity %}
			{% set fullyAllocated = false %}
		{% endif %}
	{% endfor %}

	{% if order.pick_list_id %}
		<div class="mt-4">
			<a class="btn btn-primary" href="{{ path('v3_picking_show', {pickListId: order.pick_list_id}) }}">
				{{ 'ui.v3.outbound.control.pickliste'|trans }} {{ order.pick_list_code }} {{ 'ui.v3.outbound.order.offnen'|trans }}
			</a>
		</div>
	{% elseif order.status == 'released' and fullyAllocated and is_granted('fulfillment.pick.write') %}
		<div class="card border-0 shadow-sm mt-4">
			<div class="card-body">
				<h2 class="h5">{{ 'ui.v3.outbound.order.ubergabe.an.picking'|trans }}</h2>
				<form method="post" action="{{ path('v3_outbound_pick_list_create', {orderId: order.id}) }}" class="d-flex gap-2">
					<input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_pick_list_' ~ order.id) }}">
					<input class="form-control" name="code" value="PICK-{{ order.order_number }}" required>
					<button class="btn btn-primary text-nowrap">{{ 'ui.v3.outbound.order.pickliste.erzeugen'|trans }}</button>
				</form>
			</div>
		</div>
	{% endif %}
{% endblock %}
