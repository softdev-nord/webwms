{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.outbound.orders.ausgangsauftrage'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.outbound.orders.auftragsfreigabe.reservierung.und.ubergabe.an.das.picki'|trans }}</p></div>{% if is_granted('outbound.order.write') %}<a class="btn btn-primary" href="{{ path('v3_outbound_order_new') }}">{{ 'ui.v3.outbound.order_new.auftrag.anlegen'|trans }}</a>{% endif %}</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>{{ 'ui.v3.inbound.control.auftrag'|trans }}</th><th>{{ 'ui.v3.outbound.order.kundenreferenz'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th class="text-end">{{ 'ui.v3.inbound.control.positionen'|trans }}</th><th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th><th>{{ 'ui.v3.outbound.control.pickliste'|trans }}</th><th></th></tr></thead><tbody>
{% for order in orders %}<tr><td class="fw-semibold">{{ order.order_number }}</td><td>{{ order.customer_reference }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ order.status }}</span></td><td class="text-end">{{ order.item_count }}</td><td class="text-end">{{ order.requested_quantity }}</td><td>{{ order.pick_list_code ?: '–' }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_outbound_order', {orderId: order.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a></td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-5">{{ 'ui.v3.outbound.orders.noch.keine.ausgangsauftrage.vorhanden'|trans }}</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}
