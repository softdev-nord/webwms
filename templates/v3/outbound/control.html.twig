{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Warenausgangsleitstand</h1><p class="text-muted mb-0">Bedarf, Ausgangs-QS, Versandregeln, Dokumente, Tracking und Touren zentral steuern</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="{{ path('v3_outbound_orders') }}">Aufträge</a><a class="btn btn-primary" href="{{ path('v3_packing_index') }}">Packen</a></div></div>
	<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">{% for id, label in {forecast: 'Vorschau & Aufträge', quality: 'Ausgangs-QS', shipping: 'Versand & Tracking', tours: 'Touren & Dokumente'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#outbound-{{ id }}" type="button">{{ label }}</button></li>{% endfor %}</ul>
	<div class="tab-content">
		<div class="tab-pane fade show active" id="outbound-forecast">
			<div class="row g-3 mb-4">{% set shortage = 0 %}{% set demand = 0 %}{% for item in control.forecast %}{% set shortage = shortage + item.shortage_quantity %}{% set demand = demand + item.demand_quantity %}{% endfor %}<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Offene Bedarfsmenge</div><div class="fs-3 fw-semibold">{{ demand }}</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Engpassmenge</div><div class="fs-3 fw-semibold text-danger">{{ shortage }}</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Offene Aufträge</div><div class="fs-3 fw-semibold">{{ orders|filter(order => order.status in ['imported', 'released'])|length }}</div></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Bedarfsvorschau</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Artikel</th><th>Bedarf</th><th>Bestand</th><th>Engpass</th></tr></thead><tbody>{% for item in control.forecast %}<tr><td><strong>{{ item.sku }}</strong><div class="small text-muted">{{ item.product_name }}</div></td><td>{{ item.demand_quantity }}</td><td>{{ item.stock_quantity }}</td><td><span class="badge {{ item.shortage_quantity > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' }}">{{ item.shortage_quantity }}</span></td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Kein offener Bedarf.</td></tr>{% endfor %}</tbody></table></div></div></div>
			<div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Auftragsprüfung</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Auftrag</th><th>Kunde</th><th>Status</th><th></th></tr></thead><tbody>{% for order in orders %}<tr><td><a href="{{ path('v3_outbound_order', {orderId: order.id}) }}"><code>{{ order.order_number }}</code></a></td><td>{{ order.customer_reference }}</td><td>{{ order.status }}</td><td class="text-end">{% if order.status == 'imported' %}<form method="post" action="{{ path('v3_outbound_control_cancel_order', {orderId: order.id}) }}" class="d-flex gap-1 justify-content-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_cancel_' ~ order.id) }}"><input class="form-control form-control-sm w-auto" name="reason" placeholder="Stornogrund" required><button class="btn btn-sm btn-outline-danger">Stornieren</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
		<div class="tab-pane fade" id="outbound-quality">
			<div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Pickliste prüfen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_quality') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_quality') }}"><select class="form-select mb-3" name="pick_list_id" required><option value="">Abgeschlossene Pickliste</option>{% for list in control.qualityCandidates %}<option value="{{ list.id }}">{{ list.code }} · {{ list.order_number }}</option>{% endfor %}</select>{% for name, label in {completeness_passed: 'Vollständigkeit bestätigt', condition_passed: 'Zustand einwandfrei', customer_check_passed: 'Kundenvorgaben erfüllt'} %}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="{{ name }}" value="1" id="{{ name }}"><label class="form-check-label" for="{{ name }}">{{ label }}</label></div>{% endfor %}<textarea class="form-control my-3" name="note" placeholder="Prüf- oder Sperrnotiz"></textarea><button class="btn btn-primary">QS abschließen</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Prüfhistorie</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Pickliste</th><th>Auftrag</th><th>Entscheidung</th><th>Notiz</th><th>Zeitpunkt</th></tr></thead><tbody>{% for check in control.qualityChecks %}<tr><td>{{ check.pick_list_code }}</td><td>{{ check.order_number }}</td><td><span class="badge {{ check.decision == 'released' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">{{ check.decision }}</span></td><td>{{ check.note|default('–') }}</td><td>{{ check.checked_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine QS-Prüfung.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
		<div class="tab-pane fade" id="outbound-shipping">
			<div class="row g-3 mb-4"><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Versandregel</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_shipping_rule') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_shipping_rule') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="Bezeichnung" required></div><div class="col-md-6"><input class="form-control" name="carrier" placeholder="Carrier" required></div><div class="col-md-6"><input class="form-control" name="service" placeholder="Service" required></div><div class="col-md-4"><input class="form-control" type="number" min="0" name="min_weight_grams" value="0" title="Mindestgewicht"></div><div class="col-md-4"><input class="form-control" type="number" min="1" name="max_weight_grams" value="31500" title="Maximalgewicht"></div><div class="col-md-4"><input class="form-control" type="number" name="priority" value="100" title="Priorität"></div><div><button class="btn btn-primary">Regel aktivieren</button></div></form></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Trackingereignis</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_tracking') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_tracking') }}"><div class="col-12"><select class="form-select" name="shipment_id" required>{% for shipment in shipments %}<option value="{{ shipment.id }}">{{ shipment.shipment_number }} · {{ shipment.carrier }}</option>{% endfor %}</select></div><div class="col-md-6"><input class="form-control" name="status" placeholder="Status" required></div><div class="col-md-6"><input class="form-control" name="location" placeholder="Ort"></div><div class="col-md-6"><input class="form-control" type="datetime-local" name="occurred_at" required></div><div class="col-md-6"><input class="form-control" name="description" placeholder="Beschreibung" required></div><div><button class="btn btn-primary">Ereignis speichern</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Versandarten</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Regel</th><th>Carrier / Service</th><th>Gewicht</th></tr></thead><tbody>{% for rule in control.shippingRules %}<tr><td>{{ rule.code }}<div class="small text-muted">{{ rule.name }}</div></td><td>{{ rule.carrier }} · {{ rule.service }}</td><td>{{ rule.min_weight_grams }}–{{ rule.max_weight_grams }} g</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">Keine Versandregel.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Trackingverlauf</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Sendung</th><th>Status</th><th>Ort</th><th>Zeitpunkt</th></tr></thead><tbody>{% for event in control.trackingEvents %}<tr><td>{{ event.shipment_number }}</td><td>{{ event.status }}</td><td>{{ event.location|default('–') }}</td><td>{{ event.occurred_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Keine Trackingevents.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
		<div class="tab-pane fade" id="outbound-tours">
			<div class="row g-3 mb-4"><div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Tour planen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_tour') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_tour') }}"><div class="col-6"><input class="form-control" name="code" placeholder="Tourcode" required></div><div class="col-6"><input class="form-control" name="carrier" placeholder="Carrier" required></div><div><input class="form-control" name="vehicle_reference" placeholder="Fahrzeug" required></div><div><input class="form-control" type="number" min="1" name="max_weight_grams" value="12000000" title="Maximalgewicht"></div><div><input class="form-control" type="datetime-local" name="departure_at" required></div><div><select class="form-select" name="shipment_id"><option value="">Stop ohne Sendung</option>{% for shipment in shipments %}<option value="{{ shipment.id }}">{{ shipment.shipment_number }}</option>{% endfor %}</select></div><div><input class="form-control" name="destination_name" placeholder="Empfänger" required></div><div><textarea class="form-control" name="destination_address" placeholder="Zieladresse" required></textarea></div><div><button class="btn btn-primary">Tour anlegen</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Gewichtsgrenze</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_weight_constraint') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_weight') }}"><div><select class="form-select" name="scope"><option value="package">Paket</option><option value="carrier">Carrier</option><option value="vehicle">Fahrzeug</option><option value="tour">Tour</option></select></div><div><input class="form-control" name="reference_code" placeholder="Optionale Referenz"></div><div><input class="form-control" type="number" min="1" name="max_weight_grams" placeholder="Maximalgewicht in g" required></div><div><button class="btn btn-primary">Grenze aktivieren</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Versanddokument</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_document') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_document') }}"><div><select class="form-select" name="document_type"><option value="delivery_note">Lieferschein</option><option value="packing_list">Packliste</option><option value="loading_list">Ladeliste</option><option value="cmr">CMR-Frachtbrief</option></select></div><div><select class="form-select" name="aggregate_type"><option value="shipment">Sendung</option><option value="loading_manifest">Lademanifest</option><option value="tour">Tour</option></select></div><div><input class="form-control" name="aggregate_id" placeholder="Vorgangs-ID" required></div><div><input class="form-control" name="document_number" placeholder="Dokumentnummer" required></div><div><input class="form-control" name="title" placeholder="Titel" required></div><div><textarea class="form-control" name="body" placeholder="Dokumentinhalt" required></textarea></div><div><button class="btn btn-primary">Dokument erzeugen</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Touren</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Tour</th><th>Fahrzeug</th><th>Last</th></tr></thead><tbody>{% for tour in control.tours %}<tr><td>{{ tour.code }}<div class="small text-muted">{{ tour.carrier }} · {{ tour.stop_count }} Stopps</div></td><td>{{ tour.vehicle_reference }}</td><td>{{ tour.planned_weight_grams }} / {{ tour.max_weight_grams }} g</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">Keine Tour.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Gewichtsrestriktionen</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bereich</th><th>Referenz</th><th>Maximum</th></tr></thead><tbody>{% for item in control.weightConstraints %}<tr><td>{{ item.scope }}</td><td>{{ item.reference_code|default('Alle') }}</td><td>{{ item.max_weight_grams }} g</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">Keine Grenze.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Dokumentenarchiv</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Dokument</th><th>Typ</th><th>Prüfsumme</th></tr></thead><tbody>{% for document in control.documents %}<tr><td><a target="_blank" href="{{ path('v3_outbound_control_document_show', {documentId: document.id}) }}">{{ document.document_number }}</a></td><td>{{ document.document_type }}</td><td><code>{{ document.checksum|slice(0, 10) }}…</code></td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">Keine Dokumente.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
	</div>
{% endblock %}
