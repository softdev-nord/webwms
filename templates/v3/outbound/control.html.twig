{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.outbound.control.warenausgangsleitstand.895c7d6'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.outbound.control.bedarf.ausgangs.qs.versandregeln.dokumente.tracking.und.cf6320f'|trans }}</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="{{ path('v3_outbound_orders') }}">{{ 'nav.customer_order.headline'|trans }}</a><a class="btn btn-primary" href="{{ path('v3_packing_index') }}">{{ 'ui.v3.integration.device.scan.packen.9993811'|trans }}</a></div></div>
	<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">{% for id, label in {forecast: 'ui.outbound.tab.forecast', quality: 'ui.outbound.tab.quality', shipping: 'ui.outbound.tab.shipping', tours: 'ui.outbound.tab.tours'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#outbound-{{ id }}" type="button">{{ label|trans }}</button></li>{% endfor %}</ul>
	<div class="tab-content">
		<div class="tab-pane fade show active" id="outbound-forecast">
			<div class="row g-3 mb-4">{% set shortage = 0 %}{% set demand = 0 %}{% for item in control.forecast %}{% set shortage = shortage + item.shortage_quantity %}{% set demand = demand + item.demand_quantity %}{% endfor %}<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.outbound.control.offene.bedarfsmenge.270e9b6'|trans }}</div><div class="fs-3 fw-semibold">{{ demand }}</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.outbound.control.engpassmenge.60ac761'|trans }}</div><div class="fs-3 fw-semibold text-danger">{{ shortage }}</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.outbound.control.offene.auftrage.d99433e'|trans }}</div><div class="fs-3 fw-semibold">{{ orders|filter(order => order.status in ['imported', 'released'])|length }}</div></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.bedarfsvorschau.ba24cc3'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.outbound.control.bedarf.ecbb330'|trans }}</th><th>{{ 'ui.article.index.bestand.6e8cf3e'|trans }}</th><th>{{ 'ui.v3.outbound.control.engpass.f55cfff'|trans }}</th></tr></thead><tbody>{% for item in control.forecast %}<tr><td><strong>{{ item.sku }}</strong><div class="small text-muted">{{ item.product_name }}</div></td><td>{{ item.demand_quantity }}</td><td>{{ item.stock_quantity }}</td><td><span class="badge {{ item.shortage_quantity > 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' }}">{{ item.shortage_quantity }}</span></td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.kein.offener.bedarf.e59bc45'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div>
			<div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.auftragsprufung.13f6b78'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.auftrag.4ec1a90'|trans }}</th><th>{{ 'ui.v3.administration.workspace.kunde.b2306ee'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th></th></tr></thead><tbody>{% for order in orders %}<tr><td><a href="{{ path('v3_outbound_order', {orderId: order.id}) }}"><code>{{ order.order_number }}</code></a></td><td>{{ order.customer_reference }}</td><td>{{ order.status }}</td><td class="text-end">{% if order.status == 'imported' %}<form method="post" action="{{ path('v3_outbound_control_cancel_order', {orderId: order.id}) }}" class="d-flex gap-1 justify-content-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_cancel_' ~ order.id) }}"><input class="form-control form-control-sm w-auto" name="reason" placeholder="{{ 'ui.v3.outbound.control.stornogrund.abd7962'|trans }}" required><button class="btn btn-sm btn-outline-danger">{{ 'ui.v3.outbound.control.stornieren.ccef98c'|trans }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
		<div class="tab-pane fade" id="outbound-quality">
			<div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.pickliste.prufen.dde91b6'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_quality') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_quality') }}"><select class="form-select mb-3" name="pick_list_id" required><option value="">{{ 'ui.v3.outbound.control.abgeschlossene.pickliste.357fbb6'|trans }}</option>{% for list in control.qualityCandidates %}<option value="{{ list.id }}">{{ list.code }} · {{ list.order_number }}</option>{% endfor %}</select>{% for name, label in {completeness_passed: 'ui.outbound.quality.completeness', condition_passed: 'ui.outbound.quality.condition', customer_check_passed: 'ui.outbound.quality.customer'} %}<div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="{{ name }}" value="1" id="{{ name }}"><label class="form-check-label" for="{{ name }}">{{ label|trans }}</label></div>{% endfor %}<textarea class="form-control my-3" name="note" placeholder="{{ 'ui.v3.outbound.control.pruf.oder.sperrnotiz.64e17c4'|trans }}"></textarea><button class="btn btn-primary">{{ 'ui.v3.inbound.planned.qs.abschliessen.1c13f71'|trans }}</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.prufhistorie.b6de4f1'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.outbound.control.pickliste.77bddf1'|trans }}</th><th>{{ 'ui.v3.inbound.control.auftrag.4ec1a90'|trans }}</th><th>{{ 'ui.v3.outbound.control.entscheidung.6e8d5b0'|trans }}</th><th>{{ 'ui.v3.inventory.control.notiz.b6c4417'|trans }}</th><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th></tr></thead><tbody>{% for check in control.qualityChecks %}<tr><td>{{ check.pick_list_code }}</td><td>{{ check.order_number }}</td><td><span class="badge {{ check.decision == 'released' ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">{{ check.decision }}</span></td><td>{{ check.note|default('–') }}</td><td>{{ check.checked_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.keine.qs.prufung.b9b82bf'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
		<div class="tab-pane fade" id="outbound-shipping">
			<div class="row g-3 mb-4"><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.versandregel.cb14f07'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_shipping_rule') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_shipping_rule') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code.adac693'|trans }}" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="carrier" placeholder="{{ 'ui.v3.administration.workspace.carrier.91b0ba2'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="service" placeholder="{{ 'ui.v3.outbound.control.service.329cb8b'|trans }}" required></div><div class="col-md-4"><input class="form-control" type="number" min="0" name="min_weight_grams" value="0" title="{{ 'ui.v3.outbound.control.mindestgewicht.d053c4b'|trans }}"></div><div class="col-md-4"><input class="form-control" type="number" min="1" name="max_weight_grams" value="31500" title="{{ 'ui.v3.outbound.control.maximalgewicht.37411ec'|trans }}"></div><div class="col-md-4"><input class="form-control" type="number" name="priority" value="100" title="{{ 'ui.v3.inventory.configuration_form.prioritat.c3ae74d'|trans }}"></div><div><button class="btn btn-primary">{{ 'ui.v3.outbound.control.regel.aktivieren.6a5d904'|trans }}</button></div></form></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.trackingereignis.7a09210'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_tracking') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_tracking') }}"><div class="col-12"><select class="form-select" name="shipment_id" required>{% for shipment in shipments %}<option value="{{ shipment.id }}">{{ shipment.shipment_number }} · {{ shipment.carrier }}</option>{% endfor %}</select></div><div class="col-md-6"><input class="form-control" name="status" placeholder="{{ 'ui.transport_request.index.status.bae7d5b'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="location" placeholder="{{ 'ui.customer.customer_input_fields.ort.d95f9e6'|trans }}"></div><div class="col-md-6"><input class="form-control" type="datetime-local" name="occurred_at" required></div><div class="col-md-6"><input class="form-control" name="description" placeholder="{{ 'ui.user.user_group.index.beschreibung.b3c8def'|trans }}" required></div><div><button class="btn btn-primary">{{ 'ui.v3.outbound.control.ereignis.speichern.2096a30'|trans }}</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.versandarten.4ad77e1'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inventory.selection_rules.regel.fe56804'|trans }}</th><th>{{ 'ui.v3.outbound.control.carrier.service.cfd82e1'|trans }}</th><th>{{ 'ui.article.article_input_fields.gewicht.b80121b'|trans }}</th></tr></thead><tbody>{% for rule in control.shippingRules %}<tr><td>{{ rule.code }}<div class="small text-muted">{{ rule.name }}</div></td><td>{{ rule.carrier }} · {{ rule.service }}</td><td>{{ rule.min_weight_grams }}–{{ rule.max_weight_grams }} {{ 'ui.v3.outbound.control.g.54fd171'|trans }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.keine.versandregel.58d2adc'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.trackingverlauf.146832e'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.integration.device.scan.sendung.fdd2800'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th>{{ 'ui.customer.customer_input_fields.ort.d95f9e6'|trans }}</th><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th></tr></thead><tbody>{% for event in control.trackingEvents %}<tr><td>{{ event.shipment_number }}</td><td>{{ event.status }}</td><td>{{ event.location|default('–') }}</td><td>{{ event.occurred_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.keine.trackingevents.80f3487'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
		<div class="tab-pane fade" id="outbound-tours">
			<div class="row g-3 mb-4"><div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.tour.planen.08fa7fb'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_tour') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_tour') }}"><div class="col-6"><input class="form-control" name="code" placeholder="{{ 'ui.v3.outbound.control.tourcode.04794af'|trans }}" required></div><div class="col-6"><input class="form-control" name="carrier" placeholder="{{ 'ui.v3.administration.workspace.carrier.91b0ba2'|trans }}" required></div><div><input class="form-control" name="vehicle_reference" placeholder="{{ 'ui.v3.loading.index.fahrzeug.f3acd14'|trans }}" required></div><div><input class="form-control" type="number" min="1" name="max_weight_grams" value="12000000" title="{{ 'ui.v3.outbound.control.maximalgewicht.37411ec'|trans }}"></div><div><input class="form-control" type="datetime-local" name="departure_at" required></div><div><select class="form-select" name="shipment_id"><option value="">{{ 'ui.v3.outbound.control.stop.ohne.sendung.56ead84'|trans }}</option>{% for shipment in shipments %}<option value="{{ shipment.id }}">{{ shipment.shipment_number }}</option>{% endfor %}</select></div><div><input class="form-control" name="destination_name" placeholder="{{ 'templates.recipient'|trans }}" required></div><div><textarea class="form-control" name="destination_address" placeholder="{{ 'ui.v3.outbound.control.zieladresse.7dc4487'|trans }}" required></textarea></div><div><button class="btn btn-primary">{{ 'ui.v3.outbound.control.tour.anlegen.2d2f3ab'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.gewichtsgrenze.eaa919d'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_weight_constraint') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_weight') }}"><div><select class="form-select" name="scope"><option value="package">{{ 'ui.v3.integration.measurement.capture.paket.3c97ce0'|trans }}</option><option value="carrier">{{ 'ui.v3.administration.workspace.carrier.91b0ba2'|trans }}</option><option value="vehicle">{{ 'ui.v3.loading.index.fahrzeug.f3acd14'|trans }}</option><option value="tour">{{ 'ui.v3.loading.index.tour.cd9e8f3'|trans }}</option></select></div><div><input class="form-control" name="reference_code" placeholder="{{ 'ui.v3.outbound.control.optionale.referenz.838a885'|trans }}"></div><div><input class="form-control" type="number" min="1" name="max_weight_grams" placeholder="{{ 'ui.v3.outbound.control.maximalgewicht.in.g.1d40675'|trans }}" required></div><div><button class="btn btn-primary">{{ 'ui.v3.outbound.control.grenze.aktivieren.750f814'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.versanddokument.9110749'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_outbound_control_document') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_outbound_document') }}"><div><select class="form-select" name="document_type"><option value="delivery_note">{{ 'ui.v3.inbound.control.lieferschein.78d0017'|trans }}</option><option value="packing_list">{{ 'ui.v3.outbound.control.packliste.f599c47'|trans }}</option><option value="loading_list">{{ 'ui.v3.loading.show.ladeliste.6a0866e'|trans }}</option><option value="cmr">{{ 'ui.v3.outbound.control.cmr.frachtbrief.9f64348'|trans }}</option></select></div><div><select class="form-select" name="aggregate_type"><option value="shipment">{{ 'ui.v3.integration.device.scan.sendung.fdd2800'|trans }}</option><option value="loading_manifest">{{ 'ui.v3.integration.printing.job-new.lademanifest.0009ebe'|trans }}</option><option value="tour">{{ 'ui.v3.loading.index.tour.cd9e8f3'|trans }}</option></select></div><div><input class="form-control" name="aggregate_id" placeholder="{{ 'ui.v3.inbound.control.vorgangs.id.d9b1e91'|trans }}" required></div><div><input class="form-control" name="document_number" placeholder="{{ 'ui.v3.outbound.control.dokumentnummer.824c118'|trans }}" required></div><div><input class="form-control" name="title" placeholder="{{ 'ui.v3.outbound.control.titel.950701e'|trans }}" required></div><div><textarea class="form-control" name="body" placeholder="{{ 'ui.v3.outbound.control.dokumentinhalt.6bade93'|trans }}" required></textarea></div><div><button class="btn btn-primary">{{ 'ui.v3.outbound.control.dokument.erzeugen.35ed49f'|trans }}</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.touren.a71ca91'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.loading.index.tour.cd9e8f3'|trans }}</th><th>{{ 'ui.v3.loading.index.fahrzeug.f3acd14'|trans }}</th><th>{{ 'ui.v3.outbound.control.last.d1c69a8'|trans }}</th></tr></thead><tbody>{% for tour in control.tours %}<tr><td>{{ tour.code }}<div class="small text-muted">{{ tour.carrier }} · {{ tour.stop_count }} {{ 'ui.v3.outbound.control.stopps.16c4cdb'|trans }}</div></td><td>{{ tour.vehicle_reference }}</td><td>{{ tour.planned_weight_grams }} / {{ tour.max_weight_grams }} {{ 'ui.v3.outbound.control.g.54fd171'|trans }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.keine.tour.4d3a515'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.gewichtsrestriktionen.8d63c26'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.bereich.7a3ac9a'|trans }}</th><th>{{ 'ui.stock.stock_rotation.referenz.1ac5c0e'|trans }}</th><th>{{ 'ui.v3.outbound.control.maximum.a8df2fe'|trans }}</th></tr></thead><tbody>{% for item in control.weightConstraints %}<tr><td>{{ item.scope }}</td><td>{{ item.reference_code|default('ui.v3.inventory.movements.alle.4c7a986'|trans) }}</td><td>{{ item.max_weight_grams }} {{ 'ui.v3.outbound.control.g.54fd171'|trans }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.keine.grenze.ee921a4'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.outbound.control.dokumentenarchiv.f0e912f'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.integration.printing.index.dokument.2ccbe16'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ.edcaf9a'|trans }}</th><th>{{ 'ui.v3.outbound.control.prufsumme.6a33611'|trans }}</th></tr></thead><tbody>{% for document in control.documents %}<tr><td><a target="_blank" href="{{ path('v3_outbound_control_document_show', {documentId: document.id}) }}">{{ document.document_number }}</a></td><td>{{ document.document_type }}</td><td><code>{{ document.checksum|slice(0, 10) }}…</code></td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'ui.v3.outbound.control.keine.dokumente.559abcd'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>
	</div>
{% endblock %}
