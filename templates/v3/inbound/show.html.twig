{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_inbound_index') }}" class="text-decoration-none">← Wareneingang</a><h1 class="h3 mt-2">{{ receipt.code }}</h1></div>
	<div class="card border-0 shadow-sm mb-4"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Lieferant</dt><dd class="col-sm-9">{{ receipt.supplier_code }} · {{ receipt.supplier_name }}</dd><dt class="col-sm-3">Lieferschein</dt><dd class="col-sm-9">{{ receipt.delivery_note|default('–') }}</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">{{ receipt.status }}</dd><dt class="col-sm-3">Angenommen</dt><dd class="col-sm-9">{{ receipt.accepted_at }}</dd></dl></div></div>
	<div class="card border-0 shadow-sm mb-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Artikel</th><th>Lagerplatz</th><th>Menge</th><th>Status</th><th>Charge/Serie</th></tr></thead><tbody>{% for item in receipt.items %}<tr><td>{{ item.sku }} · {{ item.product_name }}</td><td><code>{{ item.location_code }}</code></td><td>{{ item.quantity }}</td><td>{{ item.stock_status }}</td><td>{{ item.batch_number|default('–') }} / {{ item.serial_number|default('–') }}</td></tr>{% endfor %}</tbody></table></div></div>
	{% if receipt.status == 'accepted' and is_granted('inbound.receipt.book') %}<form method="post" action="{{ path('v3_inbound_book', {receiptId: receipt.id}) }}" class="text-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_book_' ~ receipt.id) }}"><button class="btn btn-primary">In Bestand buchen</button></form>{% endif %}
{% endblock %}
