{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div><h1 class="h3 mb-1">{{ 'ui.v3.inbound.control.wareneingang'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inbound.index.ungeplante.eingange.annehmen.und.buchen'|trans }}</p></div>
		<div class="d-flex gap-2">{% if is_granted('inbound.planned.read') %}<a class="btn btn-outline-primary" href="{{ path('v3_inbound_planned') }}">{{ 'ui.v3.inbound.index.geplante.eingange'|trans }}</a>{% endif %}{% if is_granted('inbound.receipt.write') %}<a class="btn btn-primary" href="{{ path('v3_inbound_unplanned_new') }}">{{ 'ui.v3.inbound.index.ungeplanten.eingang.erfassen'|trans }}</a>{% endif %}</div>
	</div>
	<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
		<thead><tr><th>{{ 'ui.v3.inbound.index.nummer'|trans }}</th><th>{{ 'ui.v3.administration.workspace.lieferant'|trans }}</th><th>{{ 'ui.v3.inbound.control.lieferschein'|trans }}</th><th>{{ 'ui.v3.inbound.control.positionen'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th></th></tr></thead>
		<tbody>{% for receipt in receipts %}<tr><td><code>{{ receipt.code }}</code></td><td>{{ receipt.supplier_code }} · {{ receipt.supplier_name }}</td><td>{{ receipt.delivery_note|default('–') }}</td><td>{{ receipt.item_count }}</td><td>{{ receipt.total_quantity }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ receipt.status }}</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inbound_show', {receiptId: receipt.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a></td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-5">{{ 'ui.v3.inbound.index.noch.keine.ungeplanten.wareneingange.vorhanden'|trans }}</td></tr>{% endfor %}</tbody>
	</table></div></div>
{% endblock %}
