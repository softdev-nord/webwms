{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div><h1 class="h3 mb-1">{{ 'ui.v3.inbound.control.wareneingangsleitstand.36b128f'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inbound.control.bestellung.bis.einlagerung.cross.docking.produktion.und.2faffa6'|trans }}</p></div>
		<a class="btn btn-outline-primary" href="{{ path('v3_inbound_planned') }}">{{ 'ui.v3.inbound.control.operative.annahme.30daa30'|trans }}</a>
	</div>
	<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">
		{% for id, label in {documents: 'ui.inbound.tab.documents', quality: 'ui.inbound.tab.quality', logistics: 'ui.inbound.tab.logistics', returns: 'ui.inbound.tab.returns'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#inbound-{{ id }}" type="button">{{ label|trans }}</button></li>{% endfor %}
	</ul>
	<div class="tab-content">
		<div class="tab-pane fade show active" id="inbound-documents">
			<div class="row g-3 mb-4">
				<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.bestellung.erfassen.4756d3f'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_purchase_order') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_purchase_order') }}"><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.bestellnummer.e1cb251'|trans }}</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.lieferantenreferenz.b5e7d34'|trans }}</label><input class="form-control" name="supplier_reference" required></div><div class="col-md-8"><label class="form-label">{{ 'nav.master_data.submenu.headline1'|trans }}</label><select class="form-select" name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.bestellung.anlegen.02f1bc0'|trans }}</button></div></form></div></div></div>
				<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.lieferavis.lieferschein.e5f00d7'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_delivery') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_delivery') }}"><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.avisnummer.cfa0313'|trans }}</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.lieferschein.78d0017'|trans }}</label><input class="form-control" name="delivery_note" required></div><div class="col-12"><label class="form-label">{{ 'ui.v3.inbound.control.offene.bestellposition.8ef096a'|trans }}</label><select class="form-select" name="purchase_order_item_id" required>{% for item in control.purchaseOrderItems %}<option value="{{ item.id }}" data-order="{{ item.purchase_order_id }}">{{ item.order_code }} · {{ item.sku }} {{ 'ui.v3.inbound.control.offen.312a10a'|trans }} {{ item.ordered_quantity - item.advised_quantity }}</option>{% endfor %}</select><input type="hidden" name="purchase_order_id" value="{{ control.purchaseOrderItems|first ? (control.purchaseOrderItems|first).purchase_order_id : '' }}"></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.avisierte.menge.234fcfb'|trans }}</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.erwartet.8435e4e'|trans }}</label><input class="form-control" type="datetime-local" name="expected_at" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.avis.ubernehmen.90db06b'|trans }}</button></div></form></div></div></div>
			</div>
			<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'nav.supplier_order.headline'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.bestellung.d27dbfd'|trans }}</th><th>{{ 'ui.v3.administration.workspace.lieferant.e50f822'|trans }}</th><th>{{ 'ui.v3.inbound.control.positionen.834a902'|trans }}</th><th>{{ 'ui.v3.inbound.control.fortschritt.8dc6820'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th></tr></thead><tbody>{% for order in control.purchaseOrders %}<tr><td><code>{{ order.code }}</code></td><td>{{ order.supplier_reference }}</td><td>{{ order.item_count }}</td><td>{{ order.received_quantity }} / {{ order.ordered_quantity }}</td><td><span class="badge bg-primary-subtle text-primary">{{ order.status }}</span></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inbound.control.keine.bestellungen.vorhanden.6d6ceb8'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-quality">
			<div class="row g-3 mb-4"><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.qs.checkliste.konfigurieren.96a4ea6'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_checklist') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_checklist') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code.adac693'|trans }}" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}" required></div><div><textarea class="form-control" name="questions" rows="4" placeholder="{{ 'ui.v3.inbound.control.eine.pruffrage.je.zeile.d283cc3'|trans }}" required></textarea></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.checkliste.aktivieren.d003f3f'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.foto.oder.anhang.ablegen.ba1aecf'|trans }}</h2></div><div class="card-body"><form method="post" enctype="multipart/form-data" action="{{ path('v3_inbound_control_attachment') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_attachment') }}"><div class="col-md-5"><select class="form-select" name="aggregate_type"><option value="inbound_receipt">{{ 'ui.v3.inbound.control.geplanter.eingang.8ef4ac8'|trans }}</option><option value="unplanned_receipt">{{ 'ui.v3.inbound.control.ungeplanter.eingang.d1602a5'|trans }}</option><option value="return_receipt">{{ 'ui.v3.inbound.control.retoure.7031a6f'|trans }}</option><option value="production_receipt">{{ 'ui.v3.inbound.control.produktion.b0a8a1b'|trans }}</option></select></div><div class="col-md-7"><input class="form-control" name="aggregate_id" placeholder="{{ 'ui.v3.inbound.control.vorgangs.id.d9b1e91'|trans }}" required></div><div class="col-md-4"><select class="form-select" name="category"><option value="photo">{{ 'ui.v3.inbound.control.foto.0f5e4f0'|trans }}</option><option value="delivery_note">{{ 'ui.v3.inbound.control.lieferschein.78d0017'|trans }}</option><option value="quality">{{ 'ui.v3.inbound.control.qs.nachweis.885fcf1'|trans }}</option><option value="other">{{ 'ui.v3.inbound.control.sonstiges.aafe075'|trans }}</option></select></div><div class="col-md-8"><input class="form-control" type="file" name="file" accept="image/*,.pdf,.txt,.csv" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.sicher.ablegen.f978503'|trans }}</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.aktive.checklisten.4a8de36'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.v3.inbound.control.prufpunkte.3f6fdc2'|trans }}</th></tr></thead><tbody>{% for list in control.checklists %}<tr><td><code>{{ list.code }}</code></td><td>{{ list.name }}</td><td>{{ list.question_count }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.checkliste.4d5bda7'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.prozessnachweise.6ebe9a4'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.datei.e9e7baf'|trans }}</th><th>{{ 'ui.article.article_input_fields.kategorie.3582103'|trans }}</th><th>{{ 'ui.v3.extensions.work_item_show.vorgang.791dd84'|trans }}</th><th>{{ 'ui.v3.inbound.control.grosse.d9130ae'|trans }}</th></tr></thead><tbody>{% for file in control.attachments %}<tr><td><a href="{{ path('v3_inbound_control_attachment_download', {attachmentId: file.id}) }}">{{ file.original_name }}</a></td><td>{{ file.category }}</td><td><code>{{ file.aggregate_id }}</code></td><td>{{ (file.byte_size / 1024)|number_format(1, ',', '.') }} {{ 'ui.v3.inbound.control.kb.315b39a'|trans }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.nachweise.83aff50'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-logistics">
			<div class="row g-3 mb-4"><div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.etikett.anfordern.d56ac38'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_label') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_label') }}"><div><select class="form-select" name="aggregate_type"><option value="inbound_receipt">{{ 'ui.v3.inbound.control.wareneingang.ed46dae'|trans }}</option><option value="production_receipt">{{ 'ui.v3.inbound.control.produktion.b0a8a1b'|trans }}</option><option value="return_receipt">{{ 'ui.v3.inbound.control.retoure.7031a6f'|trans }}</option></select></div><div><input class="form-control" name="aggregate_id" placeholder="{{ 'ui.v3.inbound.control.vorgangs.id.d9b1e91'|trans }}" required></div><div class="col-8"><select class="form-select" name="label_type"><option value="receipt">{{ 'ui.v3.inbound.control.wareneingang.ed46dae'|trans }}</option><option value="product">{{ 'nav.master_data.submenu.headline1'|trans }}</option><option value="handling_unit">{{ 'ui.v3.inbound.control.ladeeinheit.acdf148'|trans }}</option></select></div><div class="col-4"><input class="form-control" type="number" min="1" max="100" name="copies" value="1"></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.druckauftrag.anlegen.fae70fa'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.cross.docking.b391148'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_cross_dock') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_cross_dock') }}"><div><select class="form-select" name="receipt_id" required><option value="">{{ 'ui.v3.inbound.control.geprufter.eingang.fab270b'|trans }}</option>{% for item in worklist if item.receipt_status == 'inspected' %}<option value="{{ item.receipt_id }}">{{ item.delivery_code }} · {{ item.sku }} · {{ item.receipt_quantity }}</option>{% endfor %}</select></div><div><select class="form-select" name="outbound_item_id" required><option value="">{{ 'ui.v3.inbound.control.ausgangsbedarf.f265a78'|trans }}</option>{% for demand in control.outboundDemand %}<option value="{{ demand.id }}">{{ demand.order_code }} · {{ demand.sku }} · {{ demand.requested_quantity }}</option>{% endfor %}</select></div><div><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.direkt.bereitstellen.7fc0310'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'nav.logistics.submenu.headline1.entry3'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_production') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_production') }}"><div><input class="form-control" name="production_order" placeholder="{{ 'ui.v3.inbound.control.fertigungsauftrag.24c3d6c'|trans }}" required></div><div><select class="form-select" name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div><select class="form-select" name="location_id" required>{% for location in locations %}<option value="{{ location.id }}">{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-6"><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-6"><input class="form-control" name="batch_number" placeholder="{{ 'ui.modal.stock_in_modal.charge.d4e1aee'|trans }}"></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.fertigmeldung.buchen.bb0f3c7'|trans }}</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.cross.docking.bereitstellungen.5c2f657'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.ausgang.64137e7'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th></tr></thead><tbody>{% for item in control.crossDock %}<tr><td>{{ item.sku }}</td><td>{{ item.outbound_order_code }}</td><td>{{ item.quantity }}</td><td>{{ item.status }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.bereitstellung.f83f662'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.produktionszugange.75fef0e'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.auftrag.4ec1a90'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.platz.6ea3f73'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th></tr></thead><tbody>{% for item in control.productionReceipts %}<tr><td><code>{{ item.production_order }}</code></td><td>{{ item.sku }}</td><td>{{ item.location_code }}</td><td>{{ item.quantity }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.produktionszugange.7be4ec5'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-returns">
			<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.retoure.ankundigen.43e3058'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_return') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="{{ 'ui.v3.inbound.control.retourennummer.f77eec8'|trans }}" required></div><div class="col-md-2"><input class="form-control" name="order_reference" placeholder="{{ 'ui.v3.inbound.control.auftragsreferenz.de83030'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="product_id">{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-1"><input class="form-control" type="number" min="1" name="quantity" value="1"></div><div class="col-md-3"><input class="form-control" name="reason" placeholder="{{ 'ui.v3.inbound.control.retourengrund.d5e4bd8'|trans }}" required></div><div class="col-md-1"><button class="btn btn-primary w-100">{{ 'ui.v3.administration.workspace.anlegen.846460c'|trans }}</button></div></form></div></div>
			<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.retoure.referenz.cd81493'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.menge.grund.f4cb2d4'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th class="text-end">{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for item in control.returns %}<tr><td><code>{{ item.code }}</code><div class="small text-muted">{{ item.order_reference }}</div></td><td>{{ item.sku }}<div class="small text-muted">{{ item.product_name }}</div></td><td>{{ item.expected_quantity }}<div class="small text-muted">{{ item.reason }}</div></td><td><span class="badge bg-primary-subtle text-primary">{{ item.receipt_status|default(item.item_status) }}</span></td><td class="text-end">{% if item.receipt_id is null %}<form method="post" action="{{ path('v3_inbound_control_return_receive', {orderId: item.order_id, itemId: item.item_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return_receive_' ~ item.item_id) }}"><button class="btn btn-sm btn-primary">{{ 'ui.v3.inbound.control.vereinnahmen.e931432'|trans }}</button></form>{% elseif item.receipt_status == 'pending_inspection' %}<form method="post" action="{{ path('v3_inbound_control_return_inspect', {receiptId: item.receipt_id}) }}" class="d-flex gap-1 justify-content-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return_inspect_' ~ item.receipt_id) }}"><select class="form-select form-select-sm w-auto" name="location_id">{% for location in locations %}<option value="{{ location.id }}">{{ location.code }}</option>{% endfor %}</select><select class="form-select form-select-sm w-auto" name="decision"><option value="restock">{{ 'nav.logistics.submenu.headline1'|trans }}</option><option value="quarantine">{{ 'ui.v3.inbound.control.sperren.1210909'|trans }}</option></select><input class="form-control form-control-sm w-auto" name="note" placeholder="{{ 'ui.v3.inbound.control.prufnotiz.cac9033'|trans }}" required><button class="btn btn-sm btn-success">{{ 'ui.v3.inbound.control.prufen.5af98a0'|trans }}</button></form>{% else %}{{ item.quality_decision }}{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-muted text-center py-5">{{ 'ui.v3.inbound.control.keine.retouren.vorhanden.7bdd976'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}{{ parent() }}<script>document.addEventListener('DOMContentLoaded',function(){const item=document.querySelector('[name="purchase_order_item_id"]'),order=document.querySelector('[name="purchase_order_id"]');if(item&&order){item.addEventListener('change',function(){order.value=item.options[item.selectedIndex].dataset.order||'';});}});</script>{% endblock %}
