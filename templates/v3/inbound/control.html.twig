{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div><h1 class="h3 mb-1">Wareneingangsleitstand</h1><p class="text-muted mb-0">Bestellung bis Einlagerung, Cross-Docking, Produktion und Retoure in einer Prozessakte</p></div>
		<a class="btn btn-outline-primary" href="{{ path('v3_inbound_planned') }}">Operative Annahme</a>
	</div>
	<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">
		{% for id, label in {documents: 'Bestellung & Avis', quality: 'QS & Nachweise', logistics: 'Bereitstellung', returns: 'Retouren'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#inbound-{{ id }}" type="button">{{ label }}</button></li>{% endfor %}
	</ul>
	<div class="tab-content">
		<div class="tab-pane fade show active" id="inbound-documents">
			<div class="row g-3 mb-4">
				<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Bestellung erfassen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_purchase_order') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_purchase_order') }}"><div class="col-md-6"><label class="form-label">Bestellnummer</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">Lieferantenreferenz</label><input class="form-control" name="supplier_reference" required></div><div class="col-md-8"><label class="form-label">Artikel</label><select class="form-select" name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">Menge</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div><button class="btn btn-primary">Bestellung anlegen</button></div></form></div></div></div>
				<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Lieferavis / Lieferschein</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_delivery') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_delivery') }}"><div class="col-md-6"><label class="form-label">Avisnummer</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">Lieferschein</label><input class="form-control" name="delivery_note" required></div><div class="col-12"><label class="form-label">Offene Bestellposition</label><select class="form-select" name="purchase_order_item_id" required>{% for item in control.purchaseOrderItems %}<option value="{{ item.id }}" data-order="{{ item.purchase_order_id }}">{{ item.order_code }} · {{ item.sku }} · offen {{ item.ordered_quantity - item.advised_quantity }}</option>{% endfor %}</select><input type="hidden" name="purchase_order_id" value="{{ control.purchaseOrderItems|first ? (control.purchaseOrderItems|first).purchase_order_id : '' }}"></div><div class="col-md-6"><label class="form-label">Avisierte Menge</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-md-6"><label class="form-label">Erwartet</label><input class="form-control" type="datetime-local" name="expected_at" required></div><div><button class="btn btn-primary">Avis übernehmen</button></div></form></div></div></div>
			</div>
			<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Bestellungen</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Bestellung</th><th>Lieferant</th><th>Positionen</th><th>Fortschritt</th><th>Status</th></tr></thead><tbody>{% for order in control.purchaseOrders %}<tr><td><code>{{ order.code }}</code></td><td>{{ order.supplier_reference }}</td><td>{{ order.item_count }}</td><td>{{ order.received_quantity }} / {{ order.ordered_quantity }}</td><td><span class="badge bg-primary-subtle text-primary">{{ order.status }}</span></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Bestellungen vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-quality">
			<div class="row g-3 mb-4"><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">QS-Checkliste konfigurieren</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_checklist') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_checklist') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="Bezeichnung" required></div><div><textarea class="form-control" name="questions" rows="4" placeholder="Eine Prüffrage je Zeile" required></textarea></div><div><button class="btn btn-primary">Checkliste aktivieren</button></div></form></div></div></div>
			<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Foto oder Anhang ablegen</h2></div><div class="card-body"><form method="post" enctype="multipart/form-data" action="{{ path('v3_inbound_control_attachment') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_attachment') }}"><div class="col-md-5"><select class="form-select" name="aggregate_type"><option value="inbound_receipt">Geplanter Eingang</option><option value="unplanned_receipt">Ungeplanter Eingang</option><option value="return_receipt">Retoure</option><option value="production_receipt">Produktion</option></select></div><div class="col-md-7"><input class="form-control" name="aggregate_id" placeholder="Vorgangs-ID" required></div><div class="col-md-4"><select class="form-select" name="category"><option value="photo">Foto</option><option value="delivery_note">Lieferschein</option><option value="quality">QS-Nachweis</option><option value="other">Sonstiges</option></select></div><div class="col-md-8"><input class="form-control" type="file" name="file" accept="image/*,.pdf,.txt,.csv" required></div><div><button class="btn btn-primary">Sicher ablegen</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Aktive Checklisten</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Name</th><th>Prüfpunkte</th></tr></thead><tbody>{% for list in control.checklists %}<tr><td><code>{{ list.code }}</code></td><td>{{ list.name }}</td><td>{{ list.question_count }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted text-center py-4">Keine Checkliste.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Prozessnachweise</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Datei</th><th>Kategorie</th><th>Vorgang</th><th>Größe</th></tr></thead><tbody>{% for file in control.attachments %}<tr><td><a href="{{ path('v3_inbound_control_attachment_download', {attachmentId: file.id}) }}">{{ file.original_name }}</a></td><td>{{ file.category }}</td><td><code>{{ file.aggregate_id }}</code></td><td>{{ (file.byte_size / 1024)|number_format(1, ',', '.') }} KB</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">Keine Nachweise.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-logistics">
			<div class="row g-3 mb-4"><div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Etikett anfordern</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_label') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_label') }}"><div><select class="form-select" name="aggregate_type"><option value="inbound_receipt">Wareneingang</option><option value="production_receipt">Produktion</option><option value="return_receipt">Retoure</option></select></div><div><input class="form-control" name="aggregate_id" placeholder="Vorgangs-ID" required></div><div class="col-8"><select class="form-select" name="label_type"><option value="receipt">Wareneingang</option><option value="product">Artikel</option><option value="handling_unit">Ladeeinheit</option></select></div><div class="col-4"><input class="form-control" type="number" min="1" max="100" name="copies" value="1"></div><div><button class="btn btn-primary">Druckauftrag anlegen</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Cross-Docking</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_cross_dock') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_cross_dock') }}"><div><select class="form-select" name="receipt_id" required><option value="">Geprüfter Eingang</option>{% for item in worklist if item.receipt_status == 'inspected' %}<option value="{{ item.receipt_id }}">{{ item.delivery_code }} · {{ item.sku }} · {{ item.receipt_quantity }}</option>{% endfor %}</select></div><div><select class="form-select" name="outbound_item_id" required><option value="">Ausgangsbedarf</option>{% for demand in control.outboundDemand %}<option value="{{ demand.id }}">{{ demand.order_code }} · {{ demand.sku }} · {{ demand.requested_quantity }}</option>{% endfor %}</select></div><div><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div><button class="btn btn-primary">Direkt bereitstellen</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Zugang aus Produktion</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_production') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_production') }}"><div><input class="form-control" name="production_order" placeholder="Fertigungsauftrag" required></div><div><select class="form-select" name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div><select class="form-select" name="location_id" required>{% for location in locations %}<option value="{{ location.id }}">{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-6"><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-6"><input class="form-control" name="batch_number" placeholder="Charge"></div><div><button class="btn btn-primary">Fertigmeldung buchen</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Cross-Docking-Bereitstellungen</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Artikel</th><th>Ausgang</th><th>Menge</th><th>Status</th></tr></thead><tbody>{% for item in control.crossDock %}<tr><td>{{ item.sku }}</td><td>{{ item.outbound_order_code }}</td><td>{{ item.quantity }}</td><td>{{ item.status }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">Keine Bereitstellung.</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Produktionszugänge</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Auftrag</th><th>Artikel</th><th>Platz</th><th>Menge</th></tr></thead><tbody>{% for item in control.productionReceipts %}<tr><td><code>{{ item.production_order }}</code></td><td>{{ item.sku }}</td><td>{{ item.location_code }}</td><td>{{ item.quantity }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">Keine Produktionszugänge.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-returns">
			<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Retoure ankündigen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_return') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="Retourennummer" required></div><div class="col-md-2"><input class="form-control" name="order_reference" placeholder="Auftragsreferenz" required></div><div class="col-md-3"><select class="form-select" name="product_id">{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-1"><input class="form-control" type="number" min="1" name="quantity" value="1"></div><div class="col-md-3"><input class="form-control" name="reason" placeholder="Retourengrund" required></div><div class="col-md-1"><button class="btn btn-primary w-100">Anlegen</button></div></form></div></div>
			<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Retoure / Referenz</th><th>Artikel</th><th>Menge / Grund</th><th>Status</th><th class="text-end">Aktion</th></tr></thead><tbody>{% for item in control.returns %}<tr><td><code>{{ item.code }}</code><div class="small text-muted">{{ item.order_reference }}</div></td><td>{{ item.sku }}<div class="small text-muted">{{ item.product_name }}</div></td><td>{{ item.expected_quantity }}<div class="small text-muted">{{ item.reason }}</div></td><td><span class="badge bg-primary-subtle text-primary">{{ item.receipt_status|default(item.item_status) }}</span></td><td class="text-end">{% if item.receipt_id is null %}<form method="post" action="{{ path('v3_inbound_control_return_receive', {orderId: item.order_id, itemId: item.item_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return_receive_' ~ item.item_id) }}"><button class="btn btn-sm btn-primary">Vereinnahmen</button></form>{% elseif item.receipt_status == 'pending_inspection' %}<form method="post" action="{{ path('v3_inbound_control_return_inspect', {receiptId: item.receipt_id}) }}" class="d-flex gap-1 justify-content-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return_inspect_' ~ item.receipt_id) }}"><select class="form-select form-select-sm w-auto" name="location_id">{% for location in locations %}<option value="{{ location.id }}">{{ location.code }}</option>{% endfor %}</select><select class="form-select form-select-sm w-auto" name="decision"><option value="restock">Einlagern</option><option value="quarantine">Sperren</option></select><input class="form-control form-control-sm w-auto" name="note" placeholder="Prüfnotiz" required><button class="btn btn-sm btn-success">Prüfen</button></form>{% else %}{{ item.quality_decision }}{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-muted text-center py-5">Keine Retouren vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}{{ parent() }}<script>document.addEventListener('DOMContentLoaded',function(){const item=document.querySelector('[name="purchase_order_item_id"]'),order=document.querySelector('[name="purchase_order_id"]');if(item&&order){item.addEventListener('change',function(){order.value=item.options[item.selectedIndex].dataset.order||'';});}});</script>{% endblock %}
