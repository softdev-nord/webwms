{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div><h1 class="h3 mb-1">{{ 'ui.v3.inbound.control.wareneingangsleitstand'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inbound.control.bestellung.bis.einlagerung.cross.docking.produktion.und'|trans }}</p></div>
		<a class="btn btn-outline-primary" href="{{ path('v3_inbound_planned') }}">{{ 'ui.v3.inbound.control.operative.annahme'|trans }}</a>
	</div>
	<ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">
		{% for id, label in {documents: 'ui.inbound.tab.documents', quality: 'ui.inbound.tab.quality', logistics: 'ui.inbound.tab.logistics', returns: 'ui.inbound.tab.returns'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#inbound-{{ id }}" type="button">{{ label|trans }}</button></li>{% endfor %}
	</ul>
	<div class="tab-content">
		<div class="tab-pane fade show active" id="inbound-documents">
			<div class="row g-3 mb-4">
				<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.bestellung.erfassen'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_purchase_order') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_purchase_order') }}"><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.bestellnummer'|trans }}</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.lieferantenreferenz'|trans }}</label><input class="form-control" name="supplier_reference" required></div><div class="col-md-8"><label class="form-label">{{ 'nav.master_data.submenu.headline1'|trans }}</label><select class="form-select" name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.bestellung.anlegen'|trans }}</button></div></form></div></div></div>
				<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.lieferavis.lieferschein'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_delivery') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_delivery') }}"><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.avisnummer'|trans }}</label><input class="form-control" name="code" required></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.lieferschein'|trans }}</label><input class="form-control" name="delivery_note" required></div><div class="col-12"><label class="form-label">{{ 'ui.v3.inbound.control.offene.bestellposition'|trans }}</label><select class="form-select" name="purchase_order_item_id" required>{% for item in control.purchaseOrderItems %}<option value="{{ item.id }}" data-order="{{ item.purchase_order_id }}">{{ item.order_code }} · {{ item.sku }} {{ 'ui.v3.inbound.control.offen'|trans }} {{ item.ordered_quantity - item.advised_quantity }}</option>{% endfor %}</select><input type="hidden" name="purchase_order_id" value="{{ control.purchaseOrderItems|first ? (control.purchaseOrderItems|first).purchase_order_id : '' }}"></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.avisierte.menge'|trans }}</label><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-md-6"><label class="form-label">{{ 'ui.v3.inbound.control.erwartet'|trans }}</label><input class="form-control" type="datetime-local" name="expected_at" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.avis.ubernehmen'|trans }}</button></div></form></div></div></div>
			</div>
			<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'nav.supplier_order.headline'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.bestellung'|trans }}</th><th>{{ 'ui.v3.administration.workspace.lieferant'|trans }}</th><th>{{ 'ui.v3.inbound.control.positionen'|trans }}</th><th>{{ 'ui.v3.inbound.control.fortschritt'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th></tr></thead><tbody>{% for order in control.purchaseOrders %}<tr><td><code>{{ order.code }}</code></td><td>{{ order.supplier_reference }}</td><td>{{ order.item_count }}</td><td>{{ order.received_quantity }} / {{ order.ordered_quantity }}</td><td><span class="badge bg-primary-subtle text-primary">{{ order.status }}</span></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inbound.control.keine.bestellungen.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-quality">
			<div class="row g-3 mb-4"><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.qs.checkliste.konfigurieren'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_checklist') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_checklist') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung'|trans }}" required></div><div><textarea class="form-control" name="questions" rows="4" placeholder="{{ 'ui.v3.inbound.control.eine.pruffrage.je.zeile'|trans }}" required></textarea></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.checkliste.aktivieren'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.foto.oder.anhang.ablegen'|trans }}</h2></div><div class="card-body"><form method="post" enctype="multipart/form-data" action="{{ path('v3_inbound_control_attachment') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_attachment') }}"><div class="col-md-5"><select class="form-select" name="aggregate_type"><option value="inbound_receipt">{{ 'ui.v3.inbound.control.geplanter.eingang'|trans }}</option><option value="unplanned_receipt">{{ 'ui.v3.inbound.control.ungeplanter.eingang'|trans }}</option><option value="return_receipt">{{ 'ui.v3.inbound.control.retoure'|trans }}</option><option value="production_receipt">{{ 'ui.v3.inbound.control.produktion'|trans }}</option></select></div><div class="col-md-7"><input class="form-control" name="aggregate_id" placeholder="{{ 'ui.v3.inbound.control.vorgangs.id'|trans }}" required></div><div class="col-md-4"><select class="form-select" name="category"><option value="photo">{{ 'ui.v3.inbound.control.foto'|trans }}</option><option value="delivery_note">{{ 'ui.v3.inbound.control.lieferschein'|trans }}</option><option value="quality">{{ 'ui.v3.inbound.control.qs.nachweis'|trans }}</option><option value="other">{{ 'ui.v3.inbound.control.sonstiges'|trans }}</option></select></div><div class="col-md-8"><input class="form-control" type="file" name="file" accept="image/*,.pdf,.txt,.csv" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.sicher.ablegen'|trans }}</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.aktive.checklisten'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.v3.inbound.control.prufpunkte'|trans }}</th></tr></thead><tbody>{% for list in control.checklists %}<tr><td><code>{{ list.code }}</code></td><td>{{ list.name }}</td><td>{{ list.question_count }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.checkliste'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.prozessnachweise'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.datei'|trans }}</th><th>{{ 'ui.article.article_input_fields.kategorie'|trans }}</th><th>{{ 'ui.v3.extensions.work_item_show.vorgang'|trans }}</th><th>{{ 'ui.v3.inbound.control.grosse'|trans }}</th></tr></thead><tbody>{% for file in control.attachments %}<tr><td><a href="{{ path('v3_inbound_control_attachment_download', {attachmentId: file.id}) }}">{{ file.original_name }}</a></td><td>{{ file.category }}</td><td><code>{{ file.aggregate_id }}</code></td><td>{{ (file.byte_size / 1024)|number_format(1, ',', '.') }} {{ 'ui.v3.inbound.control.kb'|trans }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.nachweise'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-logistics">
			<div class="row g-3 mb-4"><div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.etikett.anfordern'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_label') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_label') }}"><div><select class="form-select" name="aggregate_type"><option value="inbound_receipt">{{ 'ui.v3.inbound.control.wareneingang'|trans }}</option><option value="production_receipt">{{ 'ui.v3.inbound.control.produktion'|trans }}</option><option value="return_receipt">{{ 'ui.v3.inbound.control.retoure'|trans }}</option></select></div><div><input class="form-control" name="aggregate_id" placeholder="{{ 'ui.v3.inbound.control.vorgangs.id'|trans }}" required></div><div class="col-8"><select class="form-select" name="label_type"><option value="receipt">{{ 'ui.v3.inbound.control.wareneingang'|trans }}</option><option value="product">{{ 'nav.master_data.submenu.headline1'|trans }}</option><option value="handling_unit">{{ 'ui.v3.inbound.control.ladeeinheit'|trans }}</option></select></div><div class="col-4"><input class="form-control" type="number" min="1" max="100" name="copies" value="1"></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.druckauftrag.anlegen'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.cross.docking'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_cross_dock') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_cross_dock') }}"><div><select class="form-select" name="receipt_id" required><option value="">{{ 'ui.v3.inbound.control.geprufter.eingang'|trans }}</option>{% for item in worklist if item.receipt_status == 'inspected' %}<option value="{{ item.receipt_id }}">{{ item.delivery_code }} · {{ item.sku }} · {{ item.receipt_quantity }}</option>{% endfor %}</select></div><div><select class="form-select" name="outbound_item_id" required><option value="">{{ 'ui.v3.inbound.control.ausgangsbedarf'|trans }}</option>{% for demand in control.outboundDemand %}<option value="{{ demand.id }}">{{ demand.order_code }} · {{ demand.sku }} · {{ demand.requested_quantity }}</option>{% endfor %}</select></div><div><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.direkt.bereitstellen'|trans }}</button></div></form></div></div></div>
			<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'nav.logistics.submenu.headline1.entry3'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_production') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_production') }}"><div><input class="form-control" name="production_order" placeholder="{{ 'ui.v3.inbound.control.fertigungsauftrag'|trans }}" required></div><div><select class="form-select" name="product_id" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div><select class="form-select" name="location_id" required>{% for location in locations %}<option value="{{ location.id }}">{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-6"><input class="form-control" type="number" min="1" name="quantity" value="1" required></div><div class="col-6"><input class="form-control" name="batch_number" placeholder="{{ 'ui.modal.stock_in_modal.charge'|trans }}"></div><div><button class="btn btn-primary">{{ 'ui.v3.inbound.control.fertigmeldung.buchen'|trans }}</button></div></form></div></div></div></div>
			<div class="row g-3"><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.cross.docking.bereitstellungen'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.ausgang'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th></tr></thead><tbody>{% for item in control.crossDock %}<tr><td>{{ item.sku }}</td><td>{{ item.outbound_order_code }}</td><td>{{ item.quantity }}</td><td>{{ item.status }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.bereitstellung'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div><div class="col-xl-6"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.produktionszugange'|trans }}</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.auftrag'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.platz'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th></tr></thead><tbody>{% for item in control.productionReceipts %}<tr><td><code>{{ item.production_order }}</code></td><td>{{ item.sku }}</td><td>{{ item.location_code }}</td><td>{{ item.quantity }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted text-center py-4">{{ 'ui.v3.inbound.control.keine.produktionszugange'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
		</div>

		<div class="tab-pane fade" id="inbound-returns">
			<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inbound.control.retoure.ankundigen'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_inbound_control_return') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="{{ 'ui.v3.inbound.control.retourennummer'|trans }}" required></div><div class="col-md-2"><input class="form-control" name="order_reference" placeholder="{{ 'ui.v3.inbound.control.auftragsreferenz'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="product_id">{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-1"><input class="form-control" type="number" min="1" name="quantity" value="1"></div><div class="col-md-3"><input class="form-control" name="reason" placeholder="{{ 'ui.v3.inbound.control.retourengrund'|trans }}" required></div><div class="col-md-1"><button class="btn btn-primary w-100">{{ 'ui.v3.administration.workspace.anlegen'|trans }}</button></div></form></div></div>
			<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inbound.control.retoure.referenz'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.menge.grund'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th class="text-end">{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for item in control.returns %}<tr><td><code>{{ item.code }}</code><div class="small text-muted">{{ item.order_reference }}</div></td><td>{{ item.sku }}<div class="small text-muted">{{ item.product_name }}</div></td><td>{{ item.expected_quantity }}<div class="small text-muted">{{ item.reason }}</div></td><td><span class="badge bg-primary-subtle text-primary">{{ item.receipt_status|default(item.item_status) }}</span></td><td class="text-end">{% if item.receipt_id is null %}<form method="post" action="{{ path('v3_inbound_control_return_receive', {orderId: item.order_id, itemId: item.item_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return_receive_' ~ item.item_id) }}"><button class="btn btn-sm btn-primary">{{ 'ui.v3.inbound.control.vereinnahmen'|trans }}</button></form>{% elseif item.receipt_status == 'pending_inspection' %}<form method="post" action="{{ path('v3_inbound_control_return_inspect', {receiptId: item.receipt_id}) }}" class="d-flex gap-1 justify-content-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_return_inspect_' ~ item.receipt_id) }}"><select class="form-select form-select-sm w-auto" name="location_id">{% for location in locations %}<option value="{{ location.id }}">{{ location.code }}</option>{% endfor %}</select><select class="form-select form-select-sm w-auto" name="decision"><option value="restock">{{ 'nav.logistics.submenu.headline1'|trans }}</option><option value="quarantine">{{ 'ui.v3.inbound.control.sperren'|trans }}</option></select><input class="form-control form-control-sm w-auto" name="note" placeholder="{{ 'ui.v3.inbound.control.prufnotiz'|trans }}" required><button class="btn btn-sm btn-success">{{ 'ui.v3.inbound.control.prufen'|trans }}</button></form>{% else %}{{ item.quality_decision }}{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-muted text-center py-5">{{ 'ui.v3.inbound.control.keine.retouren.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}{{ parent() }}<script>document.addEventListener('DOMContentLoaded',function(){const item=document.querySelector('[name="purchase_order_item_id"]'),order=document.querySelector('[name="purchase_order_id"]');if(item&&order){item.addEventListener('change',function(){order.value=item.options[item.selectedIndex].dataset.order||'';});}});</script>{% endblock %}
