            <div id="two-column-menu"></div>
            <ul class="navbar-nav" id="navbar-nav">
                {% set currentRoute = app.request.attributes.get('_route')|default('') %}
                {% set inventoryOpen = currentRoute == 'v3_stock' or currentRoute starts with 'v3_inventory_' %}
                {% set inboundOpen = currentRoute starts with 'v3_inbound_' %}
                {% set outboundOpen = currentRoute starts with 'v3_outbound_' or currentRoute starts with 'v3_picking_' or currentRoute starts with 'v3_packing_' or currentRoute starts with 'v3_shipping_' or currentRoute starts with 'v3_loading_' or currentRoute starts with 'v3_internal_transport_' %}
                {% set integrationOpen = currentRoute starts with 'v3_outbox_' or currentRoute starts with 'v3_erp_connection_' or currentRoute starts with 'v3_carrier_connection_' or currentRoute starts with 'v3_printing_' or currentRoute starts with 'v3_device_' or currentRoute starts with 'v3_measurement_' or currentRoute starts with 'v3_automation_' or currentRoute starts with 'v3_wcs_' or currentRoute starts with 'v3_transport_' %}
                {% set administrationOpen = currentRoute starts with 'v3_administration_' %}
                {% set documentationOpen = currentRoute starts with 'v3_documentation_' %}

                <li class="menu-title"><span>Navigation</span></li>
                <li class="nav-item">
                    <a class="nav-link menu-link {{ currentRoute == 'v3_dashboard' ? 'active' : '' }}" href="{{ path('v3_dashboard') }}">
                        <i class="ri-dashboard-2-line"></i><span>Dashboard</span>
                    </a>
                </li>
                {% if is_granted('platform.read') %}<li class="nav-item"><a class="nav-link menu-link {{ currentRoute starts with 'v3_platform_' ? 'active' : '' }}" href="{{ path('v3_platform_index') }}"><i class="ri-apps-2-line"></i><span>Platform Control Center</span></a></li>{% endif %}

                {% if is_granted('inventory.stock.read') or is_granted('inventory.topology.read') or is_granted('inventory.overview.read') or is_granted('inventory.stock.movement.read') or is_granted('inventory.traceability.read') or is_granted('inventory.special_stock.read') or is_granted('inventory.selection_rule.read') or is_granted('inventory.stock_block.read') %}
                    <li class="nav-item">
                        <a class="nav-link menu-link {{ inventoryOpen ? '' : 'collapsed' }}" href="#sidebarInventory" data-bs-toggle="collapse" role="button" aria-expanded="{{ inventoryOpen ? 'true' : 'false' }}" aria-controls="sidebarInventory">
                            <i class="ri-store-2-line"></i><span>Lager &amp; Bestand</span>
                        </a>
                        <div class="collapse menu-dropdown {{ inventoryOpen ? 'show' : '' }}" id="sidebarInventory">
                            <ul class="nav nav-sm flex-column">
                                {% if is_granted('inventory.overview.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute == 'v3_inventory_overview' ? 'active' : '' }}" href="{{ path('v3_inventory_overview') }}">Lagerübersicht</a></li>{% endif %}
                                {% if is_granted('inventory.overview.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute == 'v3_inventory_occupancy' ? 'active' : '' }}" href="{{ path('v3_inventory_occupancy') }}">Grafische Lagebelegung</a></li>{% endif %}
                                {% if is_granted('inventory.topology.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_inventory_topology' ? 'active' : '' }}" href="{{ path('v3_inventory_topology') }}">Lagertopologie</a></li>{% endif %}
                                {% if is_granted('inventory.stock.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute == 'v3_stock' ? 'active' : '' }}" href="{{ path('v3_stock') }}">Echtzeitbestand</a></li>{% endif %}
                                {% if is_granted('inventory.stock.movement.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute == 'v3_inventory_movements' ? 'active' : '' }}" href="{{ path('v3_inventory_movements') }}">Bewegungshistorie</a></li>{% endif %}
                                {% if is_granted('inventory.traceability.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute == 'v3_inventory_traceability' ? 'active' : '' }}" href="{{ path('v3_inventory_traceability') }}">Rückverfolgung</a></li>{% endif %}
                                {% if is_granted('inventory.special_stock.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_inventory_special_stock' ? 'active' : '' }}" href="{{ path('v3_inventory_special_stock') }}">Sonderbestände</a></li>{% endif %}
                                {% if is_granted('inventory.selection_rule.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_inventory_selection_rule' ? 'active' : '' }}" href="{{ path('v3_inventory_selection_rules') }}">Entnahmestrategien</a></li>{% endif %}
                                {% if is_granted('inventory.stock_block.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_inventory_stock_block' ? 'active' : '' }}" href="{{ path('v3_inventory_stock_blocks') }}">Bestandssperren</a></li>{% endif %}
                            </ul>
                        </div>
                    </li>
                {% endif %}

                {% if is_granted('inbound.receipt.read') or is_granted('inbound.planned.read') %}
                    <li class="nav-item">
                        <a class="nav-link menu-link {{ inboundOpen ? '' : 'collapsed' }}" href="#sidebarInbound" data-bs-toggle="collapse" role="button" aria-expanded="{{ inboundOpen ? 'true' : 'false' }}" aria-controls="sidebarInbound">
                            <i class="ri-inbox-archive-line"></i><span>Wareneingang</span>
                        </a>
                        <div class="collapse menu-dropdown {{ inboundOpen ? 'show' : '' }}" id="sidebarInbound"><ul class="nav nav-sm flex-column">
                            {% if is_granted('inbound.planned.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_inbound_control_' ? 'active' : '' }}" href="{{ path('v3_inbound_control_index') }}">Wareneingangsleitstand</a></li>{% endif %}
                            {% if is_granted('inbound.planned.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_inbound_planned' ? 'active' : '' }}" href="{{ path('v3_inbound_planned') }}">Geplante Eingänge</a></li>{% endif %}
                            {% if is_granted('inbound.receipt.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute == 'v3_inbound_index' or currentRoute starts with 'v3_inbound_unplanned' or currentRoute == 'v3_inbound_show' ? 'active' : '' }}" href="{{ path('v3_inbound_index') }}">Ungeplante Eingänge</a></li>{% endif %}
                        </ul></div>
                    </li>
                {% endif %}

                {% if is_granted('outbound.order.read') or is_granted('fulfillment.pick.read') or is_granted('fulfillment.pick.control') or is_granted('fulfillment.transport.read') or is_granted('fulfillment.pack.read') or is_granted('fulfillment.ship.read') or is_granted('fulfillment.loading.read') %}
                    <li class="nav-item">
                        <a class="nav-link menu-link {{ outboundOpen ? '' : 'collapsed' }}" href="#sidebarOutbound" data-bs-toggle="collapse" role="button" aria-expanded="{{ outboundOpen ? 'true' : 'false' }}" aria-controls="sidebarOutbound">
                            <i class="ri-truck-line"></i><span>Warenausgang</span>
                        </a>
                        <div class="collapse menu-dropdown {{ outboundOpen ? 'show' : '' }}" id="sidebarOutbound"><ul class="nav nav-sm flex-column">
                            {% if is_granted('outbound.order.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_outbound_control_' ? 'active' : '' }}" href="{{ path('v3_outbound_control_index') }}">Warenausgangsleitstand</a></li>{% endif %}
                            {% if is_granted('outbound.order.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_outbound_' and not (currentRoute starts with 'v3_outbound_control_') ? 'active' : '' }}" href="{{ path('v3_outbound_orders') }}">Aufträge</a></li>{% endif %}
                            {% if is_granted('fulfillment.pick.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_picking_' and not (currentRoute starts with 'v3_picking_control_') ? 'active' : '' }}" href="{{ path('v3_picking_index') }}">Kommissionierung</a></li>{% endif %}
                            {% if is_granted('fulfillment.pick.control') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_picking_control_' ? 'active' : '' }}" href="{{ path('v3_picking_control_index') }}">Kommissionierleitstand</a></li>{% endif %}
                            {% if is_granted('fulfillment.transport.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_internal_transport_' ? 'active' : '' }}" href="{{ path('v3_internal_transport_index') }}">Interner Transport</a></li>{% endif %}
                            {% if is_granted('fulfillment.pack.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_packing_' ? 'active' : '' }}" href="{{ path('v3_packing_index') }}">Packen</a></li>{% endif %}
                            {% if is_granted('fulfillment.ship.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_shipping_' ? 'active' : '' }}" href="{{ path('v3_shipping_index') }}">Versand</a></li>{% endif %}
                            {% if is_granted('fulfillment.loading.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_loading_' ? 'active' : '' }}" href="{{ path('v3_loading_index') }}">Verladung</a></li>{% endif %}
                        </ul></div>
                    </li>
                {% endif %}

                {% if is_granted('integration.outbox.read') or is_granted('integration.erp_connection.read') or is_granted('integration.carrier_connection.read') or is_granted('integration.print_job.read') or is_granted('integration.device.read') or is_granted('integration.measurement.read') or is_granted('integration.automation.read') or is_granted('integration.wcs.read') or is_granted('integration.transport.read') %}
                    <li class="nav-item">
                        <a class="nav-link menu-link {{ integrationOpen ? '' : 'collapsed' }}" href="#sidebarIntegration" data-bs-toggle="collapse" role="button" aria-expanded="{{ integrationOpen ? 'true' : 'false' }}" aria-controls="sidebarIntegration">
