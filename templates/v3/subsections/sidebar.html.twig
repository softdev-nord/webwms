                        </a>
                        <div class="collapse menu-dropdown {{ integrationOpen ? 'show' : '' }}" id="sidebarIntegration"><ul class="nav nav-sm flex-column">
                            {% if is_granted('integration.outbox.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_outbox_' ? 'active' : '' }}" href="{{ path('v3_outbox_index') }}">Integrations-Outbox</a></li>{% endif %}
                            {% if is_granted('integration.erp_connection.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_erp_connection_' ? 'active' : '' }}" href="{{ path('v3_erp_connection_index') }}">ERP-Verbindungen</a></li>{% endif %}
                            {% if is_granted('integration.carrier_connection.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_carrier_connection_' ? 'active' : '' }}" href="{{ path('v3_carrier_connection_index') }}">Carrier-Verbindungen</a></li>{% endif %}
                            {% if is_granted('integration.print_job.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_printing_' ? 'active' : '' }}" href="{{ path('v3_printing_index') }}">Druckwarteschlange</a></li>{% endif %}
                            {% if is_granted('integration.device.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_device_' ? 'active' : '' }}" href="{{ path('v3_device_index') }}">Scanner &amp; MDE</a></li>{% endif %}
                            {% if is_granted('integration.measurement.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_measurement_' ? 'active' : '' }}" href="{{ path('v3_measurement_index') }}">Waagen &amp; Volumen</a></li>{% endif %}
                            {% if is_granted('integration.automation.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_automation_' ? 'active' : '' }}" href="{{ path('v3_automation_index') }}">Lagerautomation</a></li>{% endif %}
                            {% if is_granted('integration.wcs.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_wcs_' ? 'active' : '' }}" href="{{ path('v3_wcs_index') }}">WCS &amp; MFR</a></li>{% endif %}
                            {% if is_granted('integration.transport.read') %}<li class="nav-item"><a class="nav-link {{ currentRoute starts with 'v3_transport_' ? 'active' : '' }}" href="{{ path('v3_transport_index') }}">Transportprotokolle</a></li>{% endif %}
                        </ul></div>
                    </li>
                {% endif %}

                {% if is_granted('administration.user.read') or is_granted('administration.role.read') or is_granted('administration.api_client.read') or is_granted('administration.configuration.read') %}
                    <li class="nav-item">
                        <a class="nav-link menu-link {{ administrationOpen ? '' : 'collapsed' }}" href="#sidebarAdministration" data-bs-toggle="collapse" role="button" aria-expanded="{{ administrationOpen ? 'true' : 'false' }}" aria-controls="sidebarAdministration">
