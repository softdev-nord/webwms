            <div id="two-column-menu"></div>
            <ul class="navbar-nav" id="navbar-nav">
                {% set currentRoute = app.request.attributes.get('_route')|default('') %}

                <li class="menu-title"><span>Übersicht</span></li>

                <li class="nav-item">
                    <a class="nav-link {% if currentRoute == 'v3_dashboard' %}active{% endif %}" href="{{ path('v3_dashboard') }}">Dashboard</a>
                </li>

                {% if is_granted('inventory.stock.read') %}
                    <li class="menu-title"><span>Lager</span></li>
                    <li class="nav-item">
                        <a class="nav-link {% if currentRoute == 'v3_stock' %}active{% endif %}" href="{{ path('v3_stock') }}">Bestand</a>
                    </li>
                {% endif %}

                {% if is_granted('outbound.order.read') or is_granted('fulfillment.pick.read') or is_granted('fulfillment.pack.read') or is_granted('fulfillment.ship.read') or is_granted('fulfillment.loading.read') %}
                    <li class="menu-title"><span>Auftragsabwicklung</span></li>

                    {% if is_granted('outbound.order.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_outbound_' %}active{% endif %}" href="{{ path('v3_outbound_orders') }}">Aufträge</a>
                        </li>
                    {% endif %}

                    {% if is_granted('fulfillment.pick.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_picking_' %}active{% endif %}" href="{{ path('v3_picking_index') }}">Kommissionierung</a>
                        </li>
                    {% endif %}

                    {% if is_granted('fulfillment.pack.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_packing_' %}active{% endif %}" href="{{ path('v3_packing_index') }}">Packen</a>
                        </li>
                    {% endif %}

                    {% if is_granted('fulfillment.ship.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_shipping_' %}active{% endif %}" href="{{ path('v3_shipping_index') }}">Versand</a>
                        </li>
                    {% endif %}

                    {% if is_granted('fulfillment.loading.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_loading_' %}active{% endif %}" href="{{ path('v3_loading_index') }}">Verladung</a>
                        </li>
                    {% endif %}
                {% endif %}

                {% if is_granted('integration.outbox.read') or is_granted('integration.erp_connection.read') or is_granted('integration.carrier_connection.read') or is_granted('integration.print_job.read') or is_granted('integration.device.read') or is_granted('integration.measurement.read') %}
                    <li class="menu-title"><span>Integration &amp; Technik</span></li>

                    {% if is_granted('integration.outbox.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_outbox_' %}active{% endif %}" href="{{ path('v3_outbox_index') }}">Integrations-Outbox</a>
                        </li>
                    {% endif %}

                    {% if is_granted('integration.erp_connection.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_erp_connection_' %}active{% endif %}" href="{{ path('v3_erp_connection_index') }}">ERP-Verbindungen</a>
                        </li>
                    {% endif %}

                    {% if is_granted('integration.carrier_connection.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_carrier_connection_' %}active{% endif %}" href="{{ path('v3_carrier_connection_index') }}">Carrier-Verbindungen</a>
                        </li>
                    {% endif %}

                    {% if is_granted('integration.print_job.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_printing_' %}active{% endif %}" href="{{ path('v3_printing_index') }}">Druckwarteschlange</a>
                        </li>
                    {% endif %}

                    {% if is_granted('integration.device.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_device_' %}active{% endif %}" href="{{ path('v3_device_index') }}">Scanner und MDE</a>
                        </li>
                    {% endif %}

                    {% if is_granted('integration.measurement.read') %}
                        <li class="nav-item">
                            <a class="nav-link {% if currentRoute starts with 'v3_measurement_' %}active{% endif %}" href="{{ path('v3_measurement_index') }}">Waagen und Volumenmessung</a>
                        </li>
                    {% endif %}
                {% endif %}

                {% if is_granted('administration.user.read') or is_granted('administration.role.read') or is_granted('administration.api_client.read') %}
                    <li class="menu-title"><span>System</span></li>
                    <li class="nav-item">
                        <a class="nav-link {% if currentRoute starts with 'v3_administration_' %}active{% endif %}" href="{{ path('v3_administration_index') }}">Administration</a>
                    </li>
                {% endif %}

