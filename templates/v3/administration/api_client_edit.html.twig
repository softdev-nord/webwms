{% extends 'v3/base.html.twig' %}
{% block title %}API-Client bearbeiten | WebWMS 3.0{% endblock %}
{% block webwms_content %}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">API-Client bearbeiten</h1><p class="text-muted mb-0">{{ client.name }} · {{ client.id }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_administration_api_clients') }}">Zur Übersicht</a></div><div class="row"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_api_client_edit_'~client.id) }}"><div class="col-12"><label class="form-label">Ausführender Benutzer</label><input class="form-control" value="{{ client.acting_user_email }}" disabled></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="active" value="1" id="active" {{ client.active ? 'checked':'' }}><label class="form-check-label" for="active">API-Client aktiv</label></div></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_administration_api_clients') }}">Abbrechen</a><button class="btn btn-primary">Änderungen speichern</button></div></form></div></div></div></div>{% endblock %}
