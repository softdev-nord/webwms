{% extends 'v3/base.html.twig' %}
{% block title %}Benutzer bearbeiten | WebWMS 3.0{% endblock %}
{% block webwms_content %}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Benutzer bearbeiten</h1><p class="text-muted mb-0">{{ user.display_name }} · {{ user.email }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_administration_users') }}">Zur Übersicht</a></div><div class="row"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_user_edit_'~user.id) }}"><div class="col-12"><label class="form-label">Rollen</label><select class="form-select" name="role_ids[]" multiple size="8">{% set assigned = user.role_codes ? user.role_codes|split(', ') : [] %}{% for role in roles %}<option value="{{ role.id }}" {{ role.code in assigned ? 'selected':'' }}>{{ role.code }} · {{ role.name }}</option>{% endfor %}</select></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="active" value="1" id="active" {{ user.status == 'active' ? 'checked':'' }}><label class="form-check-label" for="active">Benutzer aktiv</label></div></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_administration_users') }}">Abbrechen</a><button class="btn btn-primary">Änderungen speichern</button></div></form></div></div></div></div>{% endblock %}
