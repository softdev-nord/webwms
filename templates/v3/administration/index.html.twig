{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<h1 class="h3 mb-1">Administration</h1>
		<p class="text-muted mb-0">Mandantenbezogene Benutzer, Rollen und API-Zugänge</p>
	</div>

	{% if is_granted('administration.user.read') %}
		<div class="card border-0 shadow-sm mb-4">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h2 class="h5 mb-0">Benutzer</h2>
				{% if is_granted('administration.user.write') %}
					<a class="btn btn-sm btn-primary" href="{{ path('v3_administration_user_new') }}">Benutzer anlegen</a>
				{% endif %}
			</div>

			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead>
						<tr>
							<th>Name</th>
							<th>E-Mail</th>
							<th>Rollen</th>
							<th>Status</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for user in users %}
							<tr>
								<td>{{ user.display_name }}</td>
								<td>{{ user.email }}</td>
								<td>{% if is_granted('administration.user.write') %}<form method="post" action="{{ path('v3_administration_user_roles', {userId: user.id}) }}" class="d-flex gap-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_user_roles_' ~ user.id) }}"><select class="form-select form-select-sm" name="role_ids[]" multiple>{% set assigned = user.role_codes ? user.role_codes|split(', ') : [] %}{% for role in roles %}<option value="{{ role.id }}" {{ role.code in assigned ? 'selected' : '' }}>{{ role.code }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-primary">Speichern</button></form>{% else %}{{ user.role_codes ?: '–' }}{% endif %}</td>
								<td>{{ user.status }}</td>
								<td class="text-end">
									{% if is_granted('administration.user.write') %}
										<form method="post" action="{{ path('v3_administration_user_status', {userId: user.id}) }}">
											<input type="hidden" name="_token" value="{{ csrf_token('v3_administration_user_status_' ~ user.id) }}">
											<input type="hidden" name="active" value="{{ user.status == 'active' ? '0' : '1' }}">
											<button class="btn btn-sm btn-outline-{{ user.status == 'active' ? 'danger' : 'success' }}">
												{{ user.status == 'active' ? 'Deaktivieren' : 'Aktivieren' }}
											</button>
										</form>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% endif %}

	{% if is_granted('administration.role.read') %}
		<div class="card border-0 shadow-sm mb-4">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h2 class="h5 mb-0">Rollen</h2>
				{% if is_granted('administration.role.write') %}
					<a class="btn btn-sm btn-primary" href="{{ path('v3_administration_role_new') }}">Rolle anlegen</a>
				{% endif %}
			</div>

			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead>
						<tr>
							<th>Code</th>
							<th>Name</th>
							<th class="text-end">Benutzer</th>
							<th>Berechtigungen</th>
						</tr>
					</thead>
					<tbody>
						{% for role in roles %}
							<tr>
								<td class="fw-semibold">{{ role.code }}</td>
								<td>{{ role.name }}</td>
								<td class="text-end">{{ role.user_count }}</td>
								<td>
									<span class="text-muted">{{ role.permissions|split(',')|length }} Berechtigungen</span>
									{% if is_granted('administration.role.write') %}<a class="btn btn-sm btn-link" href="{{ path('v3_administration_role_edit', {roleId: role.id}) }}">Bearbeiten</a>{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% endif %}

	{% if is_granted('administration.api_client.read') %}
		<div class="card border-0 shadow-sm">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h2 class="h5 mb-0">API-Clients</h2>
				{% if is_granted('administration.api_client.write') %}
					<a class="btn btn-sm btn-primary" href="{{ path('v3_administration_api_client_new') }}">API-Client anlegen</a>
				{% endif %}
			</div>

			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead>
						<tr>
							<th>Name</th>
							<th>Client-ID</th>
							<th>Ausführender Benutzer</th>
							<th>Letzte Nutzung</th>
							<th>Status</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for client in apiClients %}
							<tr>
								<td>{{ client.name }}</td>
								<td><code>{{ client.id }}</code></td>
								<td>{{ client.acting_user_email }}</td>
								<td>{{ client.last_used_at ?: 'Nie' }}</td>
								<td>{{ client.active ? 'Aktiv' : 'Inaktiv' }}</td>
								<td class="text-end">
									{% if is_granted('administration.api_client.write') %}
										<form method="post" action="{{ path('v3_administration_api_client_status', {clientId: client.id}) }}">
											<input type="hidden" name="_token" value="{{ csrf_token('v3_administration_api_client_status_' ~ client.id) }}">
											<input type="hidden" name="active" value="{{ client.active ? '0' : '1' }}">
											<button class="btn btn-sm btn-outline-{{ client.active ? 'danger' : 'success' }}">
												{{ client.active ? 'Deaktivieren' : 'Aktivieren' }}
											</button>
										</form>
									{% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="text-center text-muted py-4">Noch keine API-Clients vorhanden.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% endif %}
{% endblock %}
