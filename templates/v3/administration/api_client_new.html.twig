{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
    <div class="mb-4">
        <a href="{{ path('v3_administration_index') }}" class="text-decoration-none">{{ 'ui.v3.administration.api_client_new.administration.bd67f16'|trans }}</a>
        <h1 class="h3 mt-2">{{ 'ui.v3.administration.api_client_new.api.client.anlegen.14780ab'|trans }}</h1>
    </div>
    <form method="post" class="card border-0 shadow-sm">
        <div class="card-body">
            <input type="hidden" name="_token" value="{{ csrf_token('v3_administration_api_client_create') }}">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">{{ 'templates.correspondence.name'|trans }}</label>
                    <input class="form-control" name="name" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label">{{ 'ui.v3.administration.api_client_edit.ausfuhrender.benutzer.9ce5092'|trans }}</label>
                    <select class="form-select" name="acting_user_id" required>
                        {% for user in users %}
                            {% if user.status == 'active' %}
                                <option value="{{ user.id }}">{{ user.display_name }} – {{ user.email }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </div>
            <h2 class="h5">{{ 'ui.v3.administration.api_client_new.api.berechtigungen.d49f8a6'|trans }}</h2>
            <div class="row g-2">
                {% for permission in permissions %}
                    <div class="col-md-6 col-xl-4">
                        <div class="form-check">
                            <input class="form-check-input ms-2" type="checkbox" name="permissions[]" value="{{ permission }}" id="api-permission-{{ loop.index }}">
                            <label class="form-check-label" for="api-permission-{{ loop.index }}">{{ permission }}</label>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="card-footer text-end">
            <button class="btn btn-primary">{{ 'ui.v3.administration.api_client_new.zugang.erzeugen.44d0cca'|trans }}</button>
        </div>
    </form>
{% endblock %}
