{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="alert alert-warning">
				<h1 class="h4">API-Zugang jetzt sichern</h1>
				<p>Dieses Secret wird nur einmal angezeigt und kann nicht wiederhergestellt werden.</p>

				<div class="input-group">
					<input class="form-control font-monospace" id="api-credential" value="{{ credential }}" readonly>
					<button
						class="btn btn-dark"
						type="button"
						onclick="navigator.clipboard.writeText(document.getElementById('api-credential').value)"
					>
						Kopieren
					</button>
				</div>
			</div>

			<a class="btn btn-primary" href="{{ path('v3_administration_index') }}">Zur Administration</a>
		</div>
	</div>
{% endblock %}
