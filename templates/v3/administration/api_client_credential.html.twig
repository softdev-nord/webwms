{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="row justify-content-center">
		<div class="col-lg-8">
			<div class="alert alert-warning">
				<h1 class="h4">{{ 'ui.v3.administration.api_client_credential.api.zugang.jetzt.sichern'|trans }}</h1>
				<p>{{ 'ui.v3.administration.api_client_credential.dieses.secret.wird.nur.einmal.angezeigt.und.kann.nicht.'|trans }}</p>

				<div class="input-group">
					<input class="form-control font-monospace" id="api-credential" value="{{ credential }}" readonly>
					<button
						class="btn btn-dark"
						type="button"
						onclick="navigator.clipboard.writeText(document.getElementById('api-credential').value)"
					>
						{{ 'copy.text'|trans }}
					</button>
				</div>
			</div>

			<a class="btn btn-primary" href="{{ path('v3_administration_index') }}">{{ 'ui.v3.administration.api_client_credential.zur.administration'|trans }}</a>
		</div>
	</div>
{% endblock %}
