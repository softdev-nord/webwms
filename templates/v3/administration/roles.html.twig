{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.user.index.rollen'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.administration.roles.berechtigungsrollen.im.uberblick'|trans }}</p></div>{% if is_granted('administration.role.write') %}<a class="btn btn-primary" href="{{ path('v3_administration_role_new') }}"><i class="ri-add-line me-1"></i>{{ 'ui.v3.administration.role_new.rolle.anlegen'|trans }}</a>{% endif %}</div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th><th>{{ 'ui.v3.administration.role_edit.berechtigungen'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen'|trans }}</th></tr></thead><tbody>{% for role in roles %}<tr><td><strong>{{ role.code }}</strong></td><td>{{ role.name }}</td><td>{{ role.user_count }}</td><td>{{ role.permissions|split(',')|length }}</td><td class="text-end">{% if is_granted('administration.role.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_administration_role_edit',{roleId:role.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-5">{{ 'ui.v3.administration.roles.keine.rollen.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
