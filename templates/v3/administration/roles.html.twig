{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'user.index.roles'|trans }}</h1><p class="text-muted mb-0">{{ 'administration.roles.permission_roles_overview'|trans }}</p></div>{% if is_granted('administration.role.write') %}<a class="btn btn-primary" href="{{ path('v3_administration_role_new') }}"><i class="ri-add-line me-1"></i>{{ 'administration.role_new.create_role'|trans }}</a>{% endif %}</div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'administration.role_new.code'|trans }}</th><th>{{ 'common.template.correspondence.name'|trans }}</th><th>{{ 'navigation.user.user'|trans }}</th><th>{{ 'administration.role_edit.permissions'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'administration.api_clients.actions'|trans }}</th></tr></thead><tbody>{% for role in roles %}<tr><td><strong>{{ role.code }}</strong></td><td>{{ role.name }}</td><td>{{ role.user_count }}</td><td>{{ role.permissions|split(',')|length }}</td><td class="text-end">{% if is_granted('administration.role.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_administration_role_edit',{roleId:role.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'common.button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-5">{{ 'administration.roles.no_roles_available'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
