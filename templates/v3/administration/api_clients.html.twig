{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.administration.api_clients.api.clients'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.administration.api_clients.technische.zugange.im.uberblick'|trans }}</p></div>{% if is_granted('administration.api_client.write') %}<a class="btn btn-primary" href="{{ path('v3_administration_api_client_new') }}"><i class="ri-add-line me-1"></i>{{ 'ui.v3.administration.api_client_new.api.client.anlegen'|trans }}</a>{% endif %}</div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.v3.administration.api_clients.client.id'|trans }}</th><th>{{ 'ui.v3.administration.api_client_edit.ausfuhrender.benutzer'|trans }}</th><th>{{ 'ui.v3.administration.api_clients.letzte.nutzung'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen'|trans }}</th></tr></thead><tbody>{% for client in clients %}<tr><td>{{ client.name }}</td><td><code>{{ client.id }}</code></td><td>{{ client.acting_user_email }}</td><td>{{ client.last_used_at ?: ('ui.v3.administration.api_clients.choice.nie'|trans) }}</td><td>{{ (client.active ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</td><td class="text-end">{% if is_granted('administration.api_client.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_administration_api_client_edit',{clientId:client.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-5">{{ 'ui.v3.administration.api_clients.keine.api.clients.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}
