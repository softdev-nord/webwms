{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.administration.workspace.mandant.amp.konfiguration'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.administration.workspace.geschaftspartner.datenraume.sso.nummernkreise.prozesse.'|trans }}</p></div>

	<div class="row g-4">
		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.geschaftspartner.amp.datenraume'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}
				<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'partner'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_partner') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-md-4"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="partner_type"><option value="customer">{{ 'ui.v3.administration.workspace.kunde'|trans }}</option><option value="supplier">{{ 'ui.v3.administration.workspace.lieferant'|trans }}</option><option value="carrier">{{ 'ui.v3.administration.workspace.carrier'|trans }}</option><option value="owner">{{ 'ui.v3.administration.workspace.bestandseigner'|trans }}</option></select></div><input type="hidden" name="active" value="1"><div class="col-md-2"><button class="btn btn-primary w-100">{{ 'ui.v3.administration.workspace.anlegen'|trans }}</button></div></form>
			{% endif %}
			<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th></tr></thead><tbody>{% for partner in workspace.partners %}<tr><td class="fw-semibold">{{ partner.code }}</td><td>{{ partner.name }}</td><td>{{ partner.partner_type }}</td><td>{{ (partner.active ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">{{ 'ui.v3.administration.workspace.noch.keine.geschaftspartner'|trans }}</td></tr>{% endfor %}</tbody></table></div>
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'context'}) }}" class="row g-2 mt-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_context') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.workspace.datenraum.code'|trans }}" required></div><div class="col-md-4"><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="business_partner_id"><option value="">{{ 'ui.v3.administration.workspace.ohne.partner'|trans }}</option>{% for partner in workspace.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select></div><input type="hidden" name="active" value="1"><div class="col-md-2"><button class="btn btn-outline-primary w-100">{{ 'ui.v3.administration.workspace.anlegen'|trans }}</button></div></form>{% endif %}
			<div class="mt-3">{% for context in workspace.contexts %}<span class="badge bg-primary-subtle text-primary me-1">{{ context.code }} · {{ context.partner_code ?: ('ui.v3.administration.workspace.choice.mandant'|trans) }}</span>{% endfor %}</div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.standorte.amp.lager'|trans }}</h2></div><div class="card-body"><p class="text-muted">{{ 'ui.v3.administration.workspace.die.operative.topologie.wird.im.lagerbereich.gepflegt.h'|trans }}</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>{{ 'ui.v3.administration.workspace.standort'|trans }}</th><th>{{ 'nav.master_data.submenu.headline4'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th></tr></thead><tbody>{% for warehouse in workspace.warehouses %}<tr><td>{{ warehouse.site_code }}</td><td class="fw-semibold">{{ warehouse.code }}</td><td>{{ warehouse.name }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted">{{ 'ui.v3.administration.workspace.noch.keine.lager'|trans }}</td></tr>{% endfor %}</tbody></table></div><a class="btn btn-outline-primary" href="{{ path('v3_inventory_topology') }}">{{ 'ui.v3.administration.workspace.lagertopologie.offnen'|trans }}</a></div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.single.sign.on'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'identity_provider'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_identity_provider') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="protocol"><option value="oidc">{{ 'ui.v3.administration.workspace.openid.connect'|trans }}</option><option value="saml">{{ 'ui.v3.administration.workspace.saml.2.0'|trans }}</option></select></div><div class="col-md-9"><input class="form-control" type="url" name="issuer_url" placeholder="{{ 'ui.v3.administration.workspace.issuer.metadata.url'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="client_id" placeholder="{{ 'ui.v3.administration.api_clients.client.id'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="client_secret_env" placeholder="{{ 'ui.v3.administration.workspace.umgebungsvariable.fur.secret'|trans }}" required></div><div class="col-md-9"><input class="form-control" name="scopes" value="openid profile email" required></div><input type="hidden" name="enabled" value="1"><div class="col-md-3"><button class="btn btn-primary w-100">{{ 'ui.v3.administration.workspace.idp.anlegen'|trans }}</button></div></form>{% endif %}
			<div class="mt-3">{% for provider in workspace.identityProviders %}<div class="d-flex justify-content-between border-top py-2"><span><strong>{{ provider.name }}</strong><small class="text-muted d-block">{{ provider.protocol|upper }} · {{ provider.issuer_url }}</small></span><span class="badge bg-{{ provider.enabled ? 'success' : 'secondary' }}-subtle text-{{ provider.enabled ? 'success' : 'secondary' }} align-self-center">{{ (provider.enabled ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</span></div>{% else %}<span class="text-muted">{{ 'ui.v3.administration.workspace.noch.kein.identity.provider.konfiguriert'|trans }}</span>{% endfor %}</div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.nummernkreise'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'number_range'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_number_range') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="{{ 'templates.correspondence.name'|trans }}" required></div><div class="col-md-4"><input class="form-control" name="object_type" placeholder="{{ 'ui.v3.administration.workspace.objekttyp'|trans }}" required></div><div class="col-md-3"><input class="form-control" name="prefix" placeholder="{{ 'ui.v3.administration.workspace.prafix'|trans }}"></div><div class="col-md-2"><input class="form-control" type="number" name="padding" value="8" min="1" max="18" required></div><div class="col-md-3"><input class="form-control" type="number" name="next_value" value="1" min="1" required></div><div class="col-md-4"><input class="form-control" name="gs1_company_prefix" placeholder="{{ 'ui.v3.administration.workspace.gs1.unternehmensprafix'|trans }}"></div><input type="hidden" name="suffix" value=""><input type="hidden" name="maximum_value" value=""><input type="hidden" name="enabled" value="1"><div class="col-12"><button class="btn btn-primary">{{ 'ui.v3.administration.workspace.nummernkreis.anlegen'|trans }}</button></div></form>{% endif %}
			<div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'ui.v3.administration.workspace.objekt'|trans }}</th><th>{{ 'ui.v3.administration.workspace.nachster.wert'|trans }}</th><th></th></tr></thead><tbody>{% for range in workspace.numberRanges %}<tr><td>{{ range.code }}</td><td>{{ range.object_type }}</td><td>{{ range.prefix }}{{ range.next_value }}{{ range.suffix }} <small class="text-muted">({{ range.padding }} {{ 'ui.v3.administration.workspace.stellen'|trans }}</small></td><td class="text-end">{% if is_granted('administration.number_range.use') %}<form method="post" action="{{ path('v3_administration_number_range_next', {code: range.code}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_number_range_next_' ~ range.code) }}"><button class="btn btn-sm btn-outline-primary">{{ 'ui.v3.administration.workspace.testnummer'|trans }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">{{ 'ui.v3.administration.workspace.noch.keine.nummernkreise'|trans }}</td></tr>{% endfor %}</tbody></table></div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.aktivierbare.prozesse'|trans }}</h2></div><div class="card-body">{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_process_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_process_configure') }}"><div class="col-md-4"><input class="form-control" name="process_key" placeholder="{{ 'ui.v3.administration.workspace.z.b.inbound.quality'|trans }}" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung'|trans }}" required></div><div class="col-md-3"><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" name="enabled" value="1" checked><label class="form-check-label">{{ 'ui.user.user_input_fields.aktiv'|trans }}</label></div></div><div class="col-12"><textarea class="form-control font-monospace" name="configuration" rows="2">{}</textarea></div><div class="col-12"><button class="btn btn-primary">{{ 'ui.v3.administration.workspace.prozess.speichern'|trans }}</button></div></form>{% endif %}<div class="mt-3">{% for process in workspace.processes %}<div class="d-flex justify-content-between border-top py-2"><span><strong>{{ process.name }}</strong><small class="d-block text-muted">{{ process.process_key }}</small></span><span class="badge bg-{{ process.enabled ? 'success' : 'secondary' }}-subtle text-{{ process.enabled ? 'success' : 'secondary' }} align-self-center">{{ (process.enabled ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</span></div>{% else %}<span class="text-muted">{{ 'ui.v3.administration.workspace.noch.keine.prozessschalter'|trans }}</span>{% endfor %}</div></div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.web.scanner.amp.betriebsprofil'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'device_profile'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_device_profile') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="{{ 'ui.v3.administration.workspace.profilname'|trans }}" required></div><div class="col-md-4"><select class="form-select" name="device_type"><option value="desktop">{{ 'ui.v3.administration.workspace.desktop'|trans }}</option><option value="tablet">{{ 'ui.v3.administration.workspace.tablet'|trans }}</option><option value="scanner">{{ 'ui.v3.administration.workspace.scanner.mde'|trans }}</option></select></div><div class="col-md-7"><input class="form-control" name="start_route" value="/v3" required></div><div class="col-md-3"><input class="form-control" name="scan_suffix" value="Enter" placeholder="{{ 'ui.v3.administration.workspace.scan.suffix'|trans }}"></div><input type="hidden" name="fullscreen" value="1"><input type="hidden" name="enabled" value="1"><div class="col-md-2"><button class="btn btn-outline-primary w-100">{{ 'ui.v3.administration.workspace.anlegen'|trans }}</button></div></form>
			<div class="mb-3">{% for profile in workspace.deviceProfiles %}<span class="badge bg-info-subtle text-info me-1">{{ profile.code }} · {{ profile.device_type }}</span>{% endfor %}</div>{% set deployment = workspace.deployments|first %}<form method="post" action="{{ path('v3_administration_deployment_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_deployment_configure') }}"><div class="col-md-4"><select class="form-select" name="deployment_mode"><option value="saas" {{ deployment and deployment.deployment_mode == 'saas' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.saas'|trans }}</option><option value="on_premises" {{ deployment and deployment.deployment_mode == 'on_premises' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.on.premises'|trans }}</option><option value="hybrid" {{ deployment and deployment.deployment_mode == 'hybrid' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.hybrid'|trans }}</option></select></div><div class="col-md-8"><input class="form-control" type="url" name="public_url" value="{{ deployment.public_url|default(app.request.schemeAndHttpHost) }}" required></div><div class="col-md-4"><select class="form-select" name="storage_driver"><option value="local" {{ deployment and deployment.storage_driver == 'local' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.lokaler.speicher'|trans }}</option><option value="s3" {{ deployment and deployment.storage_driver == 's3' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.s3'|trans }}</option><option value="azure" {{ deployment and deployment.storage_driver == 'azure' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.azure.blob'|trans }}</option></select></div><div class="col-md-4"><select class="form-select" name="queue_transport"><option value="sync" {{ deployment and deployment.queue_transport == 'sync' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.synchron'|trans }}</option><option value="doctrine" {{ deployment and deployment.queue_transport == 'doctrine' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.doctrine'|trans }}</option><option value="rabbitmq" {{ deployment and deployment.queue_transport == 'rabbitmq' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.rabbitmq'|trans }}</option></select></div><div class="col-md-4"><select class="form-select" name="release_channel"><option value="stable" {{ deployment and deployment.release_channel == 'stable' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.stable'|trans }}</option><option value="preview" {{ deployment and deployment.release_channel == 'preview' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.preview'|trans }}</option></select></div><div class="col-12"><button class="btn btn-primary">{{ 'ui.v3.administration.workspace.betriebsprofil.speichern'|trans }}</button></div></form>{% endif %}
		</div></div></div>
	</div>

	<div class="card border-0 shadow-sm mt-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.anderungsjournal'|trans }}</h2></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt'|trans }}</th><th>{{ 'ui.v3.administration.workspace.bereich'|trans }}</th><th>{{ 'ui.v3.administration.workspace.ereignis'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th></tr></thead><tbody>{% for event in workspace.events %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.aggregate_type }}</td><td>{{ event.event_type }}</td><td>{{ event.performed_by_email }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-3">{{ 'ui.v3.administration.workspace.noch.keine.anderungen.protokolliert'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
