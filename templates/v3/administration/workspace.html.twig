			<div class="mb-3">{% for profile in workspace.deviceProfiles %}<span class="badge bg-info-subtle text-info me-1">{{ profile.code }} · {{ profile.device_type }}</span>{% endfor %}</div>{% set deployment = workspace.deployments|first %}<form method="post" action="{{ path('v3_administration_deployment_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_deployment_configure') }}"><div class="col-md-4"><select class="form-select" name="deployment_mode"><option value="saas" {{ deployment and deployment.deployment_mode == 'saas' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.saas.5c278c2'|trans }}</option><option value="on_premises" {{ deployment and deployment.deployment_mode == 'on_premises' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.on.premises.9a5a77b'|trans }}</option><option value="hybrid" {{ deployment and deployment.deployment_mode == 'hybrid' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.hybrid.8e01f6b'|trans }}</option></select></div><div class="col-md-8"><input class="form-control" type="url" name="public_url" value="{{ deployment.public_url|default(app.request.schemeAndHttpHost) }}" required></div><div class="col-md-4"><select class="form-select" name="storage_driver"><option value="local" {{ deployment and deployment.storage_driver == 'local' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.lokaler.speicher.818ee57'|trans }}</option><option value="s3" {{ deployment and deployment.storage_driver == 's3' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.s3.37a81d7'|trans }}</option><option value="azure" {{ deployment and deployment.storage_driver == 'azure' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.azure.blob.f17e69c'|trans }}</option></select></div><div class="col-md-4"><select class="form-select" name="queue_transport"><option value="sync" {{ deployment and deployment.queue_transport == 'sync' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.synchron.8603896'|trans }}</option><option value="doctrine" {{ deployment and deployment.queue_transport == 'doctrine' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.doctrine.e7e37a9'|trans }}</option><option value="rabbitmq" {{ deployment and deployment.queue_transport == 'rabbitmq' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.rabbitmq.aa974d6'|trans }}</option></select></div><div class="col-md-4"><select class="form-select" name="release_channel"><option value="stable" {{ deployment and deployment.release_channel == 'stable' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.stable.d96e5b2'|trans }}</option><option value="preview" {{ deployment and deployment.release_channel == 'preview' ? 'selected' : '' }}>{{ 'ui.v3.administration.workspace.preview.f1fbb2b'|trans }}</option></select></div><div class="col-12"><button class="btn btn-primary">{{ 'ui.v3.administration.workspace.betriebsprofil.speichern.c8503f3'|trans }}</button></div></form>{% endif %}
		</div></div></div>
	</div>

	<div class="card border-0 shadow-sm mt-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.administration.workspace.anderungsjournal.8e21bd7'|trans }}</h2></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th><th>{{ 'ui.v3.administration.workspace.bereich.7a3ac9a'|trans }}</th><th>{{ 'ui.v3.administration.workspace.ereignis.9cd7d14'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th></tr></thead><tbody>{% for event in workspace.events %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.aggregate_type }}</td><td>{{ event.event_type }}</td><td>{{ event.performed_by_email }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-3">{{ 'ui.v3.administration.workspace.noch.keine.anderungen.protokolliert.e0c8c7a'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
