	<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.administration.workspace.mandant.amp.konfiguration.166be48'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.administration.workspace.geschaftspartner.datenraume.sso.nummernkreise.prozesse..c51372f'|trans }}</p></div>

