{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><h1 class="h3 mb-1">Mandant &amp; Konfiguration</h1><p class="text-muted mb-0">Geschäftspartner, Datenräume, SSO, Nummernkreise, Prozesse und Betriebsprofile zentral verwalten.</p></div>

	<div class="row g-4">
		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Geschäftspartner &amp; Datenräume</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}
				<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'partner'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_partner') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-4"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-md-3"><select class="form-select" name="partner_type"><option value="customer">Kunde</option><option value="supplier">Lieferant</option><option value="carrier">Carrier</option><option value="owner">Bestandseigner</option></select></div><input type="hidden" name="active" value="1"><div class="col-md-2"><button class="btn btn-primary w-100">Anlegen</button></div></form>
			{% endif %}
			<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Code</th><th>Name</th><th>Typ</th><th>Status</th></tr></thead><tbody>{% for partner in workspace.partners %}<tr><td class="fw-semibold">{{ partner.code }}</td><td>{{ partner.name }}</td><td>{{ partner.partner_type }}</td><td>{{ partner.active ? 'Aktiv' : 'Inaktiv' }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">Noch keine Geschäftspartner.</td></tr>{% endfor %}</tbody></table></div>
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'context'}) }}" class="row g-2 mt-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_context') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="Datenraum-Code" required></div><div class="col-md-4"><input class="form-control" name="name" placeholder="Bezeichnung" required></div><div class="col-md-3"><select class="form-select" name="business_partner_id"><option value="">Ohne Partner</option>{% for partner in workspace.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select></div><input type="hidden" name="active" value="1"><div class="col-md-2"><button class="btn btn-outline-primary w-100">Anlegen</button></div></form>{% endif %}
			<div class="mt-3">{% for context in workspace.contexts %}<span class="badge bg-primary-subtle text-primary me-1">{{ context.code }} · {{ context.partner_code ?: 'Mandant' }}</span>{% endfor %}</div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Standorte &amp; Lager</h2></div><div class="card-body"><p class="text-muted">Die operative Topologie wird im Lagerbereich gepflegt. Hier ist die Organisationszuordnung sichtbar.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Standort</th><th>Lager</th><th>Name</th></tr></thead><tbody>{% for warehouse in workspace.warehouses %}<tr><td>{{ warehouse.site_code }}</td><td class="fw-semibold">{{ warehouse.code }}</td><td>{{ warehouse.name }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted">Noch keine Lager.</td></tr>{% endfor %}</tbody></table></div><a class="btn btn-outline-primary" href="{{ path('v3_inventory_topology') }}">Lagertopologie öffnen</a></div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Single Sign-on</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'identity_provider'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_identity_provider') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-md-3"><select class="form-select" name="protocol"><option value="oidc">OpenID Connect</option><option value="saml">SAML 2.0</option></select></div><div class="col-md-9"><input class="form-control" type="url" name="issuer_url" placeholder="Issuer-/Metadata-URL" required></div><div class="col-md-6"><input class="form-control" name="client_id" placeholder="Client-ID" required></div><div class="col-md-6"><input class="form-control" name="client_secret_env" placeholder="Umgebungsvariable für Secret" required></div><div class="col-md-9"><input class="form-control" name="scopes" value="openid profile email" required></div><input type="hidden" name="enabled" value="1"><div class="col-md-3"><button class="btn btn-primary w-100">IdP anlegen</button></div></form>{% endif %}
			<div class="mt-3">{% for provider in workspace.identityProviders %}<div class="d-flex justify-content-between border-top py-2"><span><strong>{{ provider.name }}</strong><small class="text-muted d-block">{{ provider.protocol|upper }} · {{ provider.issuer_url }}</small></span><span class="badge bg-{{ provider.enabled ? 'success' : 'secondary' }}-subtle text-{{ provider.enabled ? 'success' : 'secondary' }} align-self-center">{{ provider.enabled ? 'Aktiv' : 'Inaktiv' }}</span></div>{% else %}<span class="text-muted">Noch kein Identity Provider konfiguriert.</span>{% endfor %}</div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Nummernkreise</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'number_range'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_number_range') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-md-4"><input class="form-control" name="object_type" placeholder="Objekttyp" required></div><div class="col-md-3"><input class="form-control" name="prefix" placeholder="Präfix"></div><div class="col-md-2"><input class="form-control" type="number" name="padding" value="8" min="1" max="18" required></div><div class="col-md-3"><input class="form-control" type="number" name="next_value" value="1" min="1" required></div><div class="col-md-4"><input class="form-control" name="gs1_company_prefix" placeholder="GS1-Unternehmenspräfix"></div><input type="hidden" name="suffix" value=""><input type="hidden" name="maximum_value" value=""><input type="hidden" name="enabled" value="1"><div class="col-12"><button class="btn btn-primary">Nummernkreis anlegen</button></div></form>{% endif %}
			<div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Code</th><th>Objekt</th><th>Nächster Wert</th><th></th></tr></thead><tbody>{% for range in workspace.numberRanges %}<tr><td>{{ range.code }}</td><td>{{ range.object_type }}</td><td>{{ range.prefix }}{{ range.next_value }}{{ range.suffix }} <small class="text-muted">({{ range.padding }} Stellen)</small></td><td class="text-end">{% if is_granted('administration.number_range.use') %}<form method="post" action="{{ path('v3_administration_number_range_next', {code: range.code}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_number_range_next_' ~ range.code) }}"><button class="btn btn-sm btn-outline-primary">Testnummer</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">Noch keine Nummernkreise.</td></tr>{% endfor %}</tbody></table></div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Aktivierbare Prozesse</h2></div><div class="card-body">{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_process_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_process_configure') }}"><div class="col-md-4"><input class="form-control" name="process_key" placeholder="z. B. inbound.quality" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="Bezeichnung" required></div><div class="col-md-3"><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" name="enabled" value="1" checked><label class="form-check-label">Aktiv</label></div></div><div class="col-12"><textarea class="form-control font-monospace" name="configuration" rows="2">{}</textarea></div><div class="col-12"><button class="btn btn-primary">Prozess speichern</button></div></form>{% endif %}<div class="mt-3">{% for process in workspace.processes %}<div class="d-flex justify-content-between border-top py-2"><span><strong>{{ process.name }}</strong><small class="d-block text-muted">{{ process.process_key }}</small></span><span class="badge bg-{{ process.enabled ? 'success' : 'secondary' }}-subtle text-{{ process.enabled ? 'success' : 'secondary' }} align-self-center">{{ process.enabled ? 'Aktiv' : 'Inaktiv' }}</span></div>{% else %}<span class="text-muted">Noch keine Prozessschalter.</span>{% endfor %}</div></div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Web-, Scanner- &amp; Betriebsprofil</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'device_profile'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_device_profile') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="Profilname" required></div><div class="col-md-4"><select class="form-select" name="device_type"><option value="desktop">Desktop</option><option value="tablet">Tablet</option><option value="scanner">Scanner/MDE</option></select></div><div class="col-md-7"><input class="form-control" name="start_route" value="/v3" required></div><div class="col-md-3"><input class="form-control" name="scan_suffix" value="Enter" placeholder="Scan-Suffix"></div><input type="hidden" name="fullscreen" value="1"><input type="hidden" name="enabled" value="1"><div class="col-md-2"><button class="btn btn-outline-primary w-100">Anlegen</button></div></form>
			<div class="mb-3">{% for profile in workspace.deviceProfiles %}<span class="badge bg-info-subtle text-info me-1">{{ profile.code }} · {{ profile.device_type }}</span>{% endfor %}</div>{% set deployment = workspace.deployments|first %}<form method="post" action="{{ path('v3_administration_deployment_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_deployment_configure') }}"><div class="col-md-4"><select class="form-select" name="deployment_mode"><option value="saas" {{ deployment and deployment.deployment_mode == 'saas' ? 'selected' : '' }}>SaaS</option><option value="on_premises" {{ deployment and deployment.deployment_mode == 'on_premises' ? 'selected' : '' }}>On-Premises</option><option value="hybrid" {{ deployment and deployment.deployment_mode == 'hybrid' ? 'selected' : '' }}>Hybrid</option></select></div><div class="col-md-8"><input class="form-control" type="url" name="public_url" value="{{ deployment.public_url|default(app.request.schemeAndHttpHost) }}" required></div><div class="col-md-4"><select class="form-select" name="storage_driver"><option value="local" {{ deployment and deployment.storage_driver == 'local' ? 'selected' : '' }}>Lokaler Speicher</option><option value="s3" {{ deployment and deployment.storage_driver == 's3' ? 'selected' : '' }}>S3</option><option value="azure" {{ deployment and deployment.storage_driver == 'azure' ? 'selected' : '' }}>Azure Blob</option></select></div><div class="col-md-4"><select class="form-select" name="queue_transport"><option value="sync" {{ deployment and deployment.queue_transport == 'sync' ? 'selected' : '' }}>Synchron</option><option value="doctrine" {{ deployment and deployment.queue_transport == 'doctrine' ? 'selected' : '' }}>Doctrine</option><option value="rabbitmq" {{ deployment and deployment.queue_transport == 'rabbitmq' ? 'selected' : '' }}>RabbitMQ</option></select></div><div class="col-md-4"><select class="form-select" name="release_channel"><option value="stable" {{ deployment and deployment.release_channel == 'stable' ? 'selected' : '' }}>Stable</option><option value="preview" {{ deployment and deployment.release_channel == 'preview' ? 'selected' : '' }}>Preview</option></select></div><div class="col-12"><button class="btn btn-primary">Betriebsprofil speichern</button></div></form>{% endif %}
		</div></div></div>
	</div>

	<div class="card border-0 shadow-sm mt-4"><div class="card-header"><h2 class="h5 mb-0">Änderungsjournal</h2></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Zeitpunkt</th><th>Bereich</th><th>Ereignis</th><th>Benutzer</th></tr></thead><tbody>{% for event in workspace.events %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.aggregate_type }}</td><td>{{ event.event_type }}</td><td>{{ event.performed_by_email }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-3">Noch keine Änderungen protokolliert.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
