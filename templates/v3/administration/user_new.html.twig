{% extends 'v3/base.html.twig' %}
{% block title %}Benutzer anlegen | WebWMS 3.0{% endblock %}
{% block body %}<div class="mb-4"><a href="{{ path('v3_administration_index') }}" class="text-decoration-none">← Administration</a><h1 class="h3 mt-2">Benutzer anlegen</h1></div><form method="post" class="card border-0 shadow-sm"><div class="card-body"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_user_create') }}"><div class="row g-3"><div class="col-md-6"><label class="form-label">Anzeigename</label><input class="form-control" name="display_name" required></div><div class="col-md-6"><label class="form-label">E-Mail</label><input class="form-control" type="email" name="email" required></div><div class="col-md-6"><label class="form-label">Initiales Passwort</label><input class="form-control" type="password" minlength="12" name="password" autocomplete="new-password" required><div class="form-text">Mindestens 12 Zeichen.</div></div><div class="col-md-6"><label class="form-label">Rollen</label><select class="form-select" name="role_ids[]" multiple size="5">{% for role in roles %}<option value="{{ role.id }}">{{ role.code }} – {{ role.name }}</option>{% endfor %}</select></div></div></div><div class="card-footer bg-white text-end"><button class="btn btn-primary">Benutzer anlegen</button></div></form>{% endblock %}
