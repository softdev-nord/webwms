{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<h1 class="h3 mb-1">Integrations-Outbox</h1>
		<p class="text-muted mb-0">Statusereignisse überwachen und fehlgeschlagene Zustellungen bearbeiten</p>
	</div>

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body">
			<form method="get" class="row g-2 align-items-end">
				<div class="col-md-5 col-lg-3">
					<label class="form-label" for="status">Status</label>
					<select class="form-select" id="status" name="status">
						{% for status in statuses %}
							<option value="{{ status }}" {% if status == selectedStatus %}selected{% endif %}>{{ status }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="col-auto">
					<button class="btn btn-primary">Filtern</button>
				</div>
			</form>
		</div>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>Ereignis</th>
						<th>Aggregat</th>
						<th>Status</th>
						<th class="text-end">Versuche</th>
						<th>Zeitpunkt</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for message in messages %}
						<tr>
							<td class="fw-semibold">{{ message.event_name }}</td>
							<td>
								<div>{{ message.aggregate_type }}</div>
								<code>{{ message.aggregate_id }}</code>
							</td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ message.status }}</span></td>
							<td class="text-end">{{ message.attempt_count }}</td>
							<td>{{ message.occurred_at }}</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_outbox_show', {messageId: message.id}) }}">Öffnen</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-5">Keine Nachrichten mit diesem Status vorhanden.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	{% if nextCursor %}
		<div class="mt-3 text-end">
			<a class="btn btn-outline-primary" href="{{ path('v3_outbox_index', {status: selectedStatus, cursor: nextCursor}) }}">Weitere Nachrichten</a>
		</div>
	{% endif %}
{% endblock %}
