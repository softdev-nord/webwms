{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_wcs_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.wcs.command-new.wcs.mfr.und.fordertechnik.cc0ecc3'|trans }}</a><h1 class="h3 mt-2">{{ 'ui.v3.integration.wcs.status-new.maschinenstatus.erfassen.71c0460'|trans }}</h1></div>
	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_wcs_status_create') }}"><input type="hidden" name="external_event_id" value="{{ eventId }}">
			<div class="row g-3">
				<div class="col-md-6"><label class="form-label" for="connection_id">{{ 'ui.v3.integration.wcs.command-new.verbindung.5fbdf27'|trans }}</label><select class="form-select" id="connection_id" name="connection_id" required>{% for connection in connections %}<option value="{{ connection.id }}">{{ connection.code }} · {{ connection.name }}</option>{% endfor %}</select></div>
				<div class="col-md-6"><label class="form-label" for="command_id">{{ 'ui.v3.integration.wcs.status-new.transportbefehl.optional.d5c5104'|trans }}</label><select class="form-select" id="command_id" name="command_id"><option value="">{{ 'ui.v3.integration.wcs.status-new.ohne.befehlsbezug.18ec110'|trans }}</option>{% for command in commands %}<option value="{{ command.id }}">{{ command.load_unit }} · {{ command.source }} → {{ command.destination }}</option>{% endfor %}</select></div>
				<div class="col-md-4"><label class="form-label" for="machine_code">{{ 'ui.v3.integration.wcs.status-new.maschinencode.39b545d'|trans }}</label><input class="form-control font-monospace text-uppercase" id="machine_code" name="machine_code" maxlength="100" required></div>
				<div class="col-md-3"><label class="form-label" for="status">{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</label><select class="form-select" id="status" name="status"><option value="ready">{{ 'ui.v3.integration.wcs.status-new.bereit.22bea83'|trans }}</option><option value="busy">{{ 'ui.v3.integration.wcs.status-new.beschaftigt.f527edb'|trans }}</option><option value="blocked">{{ 'ui.transport_request.index.blockiert.8465c4e'|trans }}</option><option value="fault">{{ 'ui.v3.integration.wcs.status-new.storung.58a9a88'|trans }}</option><option value="offline">{{ 'ui.v3.integration.wcs.status-new.offline.e01fa71'|trans }}</option></select></div>
				<div class="col-md-5"><label class="form-label" for="message">{{ 'ui.v3.integration.wcs.command-show.meldung.60bc5b8'|trans }}</label><input class="form-control" id="message" name="message" maxlength="500"></div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_wcs_index') }}">{{ 'button.cancel'|trans }}</a><button class="btn btn-primary" {% if connections is empty %}disabled{% endif %}>{{ 'ui.v3.integration.wcs.index.status.erfassen.e242bef'|trans }}</button></div>
	</form>
{% endblock %}
