{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_wcs_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.wcs.command-new.wcs.mfr.und.fordertechnik.cc0ecc3'|trans }}</a><h1 class="h3 mt-2">{{ 'ui.v3.integration.wcs.command-new.maschinenbefehl.anlegen.3850248'|trans }}</h1></div>
	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_wcs_command_create') }}">
			<input type="hidden" name="request_id" value="{{ requestId }}">
			<div class="row g-3">
				<div class="col-md-6"><label class="form-label" for="connection_id">{{ 'ui.v3.integration.wcs.command-new.verbindung.5fbdf27'|trans }}</label><select class="form-select" id="connection_id" name="connection_id" required>{% for connection in connections %}<option value="{{ connection.id }}">{{ connection.code }} · {{ connection.name }}</option>{% endfor %}</select></div>
				<div class="col-md-6"><label class="form-label" for="command_type">{{ 'ui.v3.integration.automation.command-new.befehl.8090759'|trans }}</label><select class="form-select" id="command_type" name="command_type"><option value="transport">{{ 'ui.v3.integration.wcs.command-new.transport.c10d76c'|trans }}</option><option value="route">{{ 'ui.v3.integration.wcs.command-new.route.setzen.65f16c4'|trans }}</option><option value="cancel">{{ 'ui.v3.integration.wcs.command-new.abbruchauftrag.4e905d8'|trans }}</option></select></div>
				<div class="col-md-4"><label class="form-label" for="source">{{ 'ui.v3.integration.wcs.command-new.quelle.f707c32'|trans }}</label><input class="form-control font-monospace" id="source" name="source" maxlength="100" required></div>
				<div class="col-md-4"><label class="form-label" for="destination">{{ 'ui.v3.inbound.planned.ziel.44d1262'|trans }}</label><input class="form-control font-monospace" id="destination" name="destination" maxlength="100" required></div>
				<div class="col-md-4"><label class="form-label" for="load_unit">{{ 'ui.v3.inbound.control.ladeeinheit.acdf148'|trans }}</label><input class="form-control font-monospace" id="load_unit" name="load_unit" maxlength="100" required></div>
			</div>
			{% if connections is empty %}<div class="alert alert-warning mt-3 mb-0">{{ 'ui.v3.integration.wcs.command-new.es.ist.keine.aktive.wcs.verbindung.vorhanden.5b7a4e0'|trans }}</div>{% endif %}
		</div>
		<div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_wcs_index') }}">{{ 'button.cancel'|trans }}</a><button class="btn btn-primary" {% if connections is empty %}disabled{% endif %}>{{ 'ui.v3.integration.automation.command-new.befehl.einreihen.dc3e5db'|trans }}</button></div>
	</form>
{% endblock %}
