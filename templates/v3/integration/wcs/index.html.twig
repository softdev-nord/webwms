{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<div>
			<h1 class="h3 mb-1">{{ 'ui.v3.integration.wcs.index.wcs.mfr.und.fordertechnik'|trans }}</h1>
			<p class="text-muted mb-0">{{ 'ui.v3.integration.wcs.index.transportbefehle.und.maschinenruckmeldungen.uberwachen'|trans }}</p>
		</div>
		<div class="d-flex gap-2">
			{% if is_granted('integration.wcs.write') %}
				<a class="btn btn-outline-primary" href="{{ path('v3_wcs_connection_new') }}">{{ 'ui.v3.integration.wcs.connection-new.verbindung.anlegen'|trans }}</a>
			{% endif %}
			{% if is_granted('integration.wcs.execute') %}
				<a class="btn btn-outline-primary" href="{{ path('v3_wcs_status_new') }}">{{ 'ui.v3.integration.wcs.index.status.erfassen'|trans }}</a>
				<a class="btn btn-primary" href="{{ path('v3_wcs_command_new') }}">{{ 'ui.v3.integration.automation.index.befehl.anlegen'|trans }}</a>
			{% endif %}
		</div>
	</div>

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.wcs.index.verbindungen'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.configuration.tabs.systeminformation.system'|trans }}</th><th>{{ 'ui.v3.integration.automation.index.endpoint'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th></th></tr></thead>
				<tbody>
					{% for connection in connections %}
						<tr>
							<td><code>{{ connection.code }}</code></td>
							<td class="fw-semibold">{{ connection.name }}</td>
							<td>{{ connection.system_type }}</td>
							<td><code>{{ connection.endpoint_url }}</code></td>
							<td><span class="badge bg-{{ connection.active ? 'success' : 'secondary' }}-subtle text-{{ connection.active ? 'success' : 'secondary' }}">{{ (connection.active ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.integration.carrier-connection.index.pausiert')|trans }}</span></td>
							<td class="text-end">
								{% if is_granted('integration.wcs.write') %}
									<form method="post" action="{{ path('v3_wcs_connection_status', {connectionId: connection.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('v3_wcs_connection_status_' ~ connection.id) }}">
										<button class="btn btn-sm btn-outline-secondary">{{ (connection.active ? 'ui.v3.integration.automation.index.choice.pausieren' : 'ui.v3.integration.automation.index.choice.aktivieren')|trans }}</button>
									</form>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.integration.wcs.index.noch.keine.wcs.verbindung.vorhanden'|trans }}</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.wcs.index.transportbefehle'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead><tr><th>{{ 'ui.v3.integration.wcs.command-new.verbindung'|trans }}</th><th>{{ 'ui.v3.inbound.control.ladeeinheit'|trans }}</th><th>{{ 'ui.logging.index.route'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th></th></tr></thead>
				<tbody>
					{% for command in commands %}
						<tr>
							<td>{{ command.connection_code }}</td>
							<td><code>{{ command.load_unit }}</code></td>
							<td>{{ command.source }} → {{ command.destination }}</td>
							<td>{{ command.command_type }}</td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ command.status }}</span></td>
							<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_wcs_command_show', {commandId: command.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a></td>
						</tr>
					{% else %}
						<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.integration.wcs.index.noch.keine.transportbefehle.vorhanden'|trans }}</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.wcs.index.maschinenstatus'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead><tr><th>{{ 'ui.v3.integration.wcs.command-new.verbindung'|trans }}</th><th>{{ 'ui.v3.integration.wcs.index.maschine'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th>{{ 'ui.v3.integration.wcs.command-show.meldung'|trans }}</th><th>{{ 'ui.v3.administration.workspace.zeitpunkt'|trans }}</th></tr></thead>
				<tbody>
					{% for machineStatus in statuses %}
						<tr>
							<td>{{ machineStatus.connection_code }}</td>
							<td><code>{{ machineStatus.machine_code }}</code></td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ machineStatus.status }}</span></td>
							<td>{{ machineStatus.message|default('–') }}</td>
							<td>{{ machineStatus.recorded_at }}</td>
						</tr>
					{% else %}
						<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.integration.wcs.index.noch.keine.maschinenruckmeldungen.vorhanden'|trans }}</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
