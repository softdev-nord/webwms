{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_wcs_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.wcs.command-new.wcs.mfr.und.fordertechnik.cc0ecc3'|trans }}</a><h1 class="h3 mt-2">{{ 'ui.v3.integration.wcs.command-show.maschinenbefehl.4c31388'|trans }}</h1></div>
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header bg-transparent d-flex justify-content-between"><h2 class="h5 mb-0">{{ command.connection_code }} · {{ command.load_unit }}</h2><span class="badge bg-secondary-subtle text-secondary">{{ command.status }}</span></div>
		<div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">{{ 'ui.v3.administration.workspace.typ.edcaf9a'|trans }}</dt><dd class="col-sm-9">{{ command.command_type }}</dd><dt class="col-sm-3">{{ 'ui.logging.index.route.4999528'|trans }}</dt><dd class="col-sm-9"><code>{{ command.source }}</code> → <code>{{ command.destination }}</code></dd><dt class="col-sm-3">{{ 'ui.v3.integration.automation.command-show.request.id.8c562f0'|trans }}</dt><dd class="col-sm-9"><code>{{ command.request_id }}</code></dd><dt class="col-sm-3">{{ 'ui.v3.integration.wcs.command-show.meldung.60bc5b8'|trans }}</dt><dd class="col-sm-9">{{ command.message|default('–') }}</dd></dl></div>
	</div>
	{% if command.status not in ['completed', 'failed', 'cancelled'] and is_granted('integration.wcs.execute') %}
		<form method="post" action="{{ path('v3_wcs_command_status', {commandId: command.id}) }}" class="card border-0 shadow-sm">
			<div class="card-body"><input type="hidden" name="_token" value="{{ csrf_token('v3_wcs_command_status_' ~ command.id) }}"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="status">{{ 'ui.v3.integration.wcs.command-show.neuer.status.d4547f5'|trans }}</label><select class="form-select" id="status" name="status">{% if command.status == 'queued' %}<option value="dispatched">{{ 'ui.v3.integration.wcs.command-show.ubermittelt.062e6af'|trans }}</option>{% elseif command.status == 'dispatched' %}<option value="accepted">{{ 'ui.v3.inbound.show.angenommen.187cf38'|trans }}</option>{% elseif command.status == 'accepted' %}<option value="completed">{{ 'ui.v3.integration.printing.job-show.abgeschlossen.be274c6'|trans }}</option>{% endif %}<option value="failed">{{ 'ui.v3.integration.automation.command-show.fehlgeschlagen.f7b1b15'|trans }}</option><option value="cancelled">{{ 'ui.v3.integration.wcs.command-show.abgebrochen.4a206f7'|trans }}</option></select></div><div class="col-md-8"><label class="form-label" for="message">{{ 'ui.v3.integration.wcs.command-show.meldung.60bc5b8'|trans }}</label><input class="form-control" id="message" name="message" maxlength="500"></div></div></div>
			<div class="card-footer text-end"><button class="btn btn-primary">{{ 'ui.v3.integration.wcs.command-show.status.verarbeiten.87b960d'|trans }}</button></div>
		</form>
	{% endif %}
{% endblock %}
