{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_automation_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.automation.command-new.lagerlifte.und.paternoster'|trans }}</a>
		<h1 class="h3 mt-2">{{ 'ui.v3.integration.automation.command-show.geratebefehl'|trans }}</h1>
	</div>

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header bg-transparent d-flex justify-content-between">
			<h2 class="h5 mb-0">{{ command.device_code }} · {{ command.command_type }}</h2>
			<span class="badge bg-secondary-subtle text-secondary">{{ command.status }}</span>
		</div>
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-sm-3">{{ 'ui.modal.show_article_stock_details_modal.lagerplatz'|trans }}</dt><dd class="col-sm-9"><code>{{ command.location_code }}</code></dd>
				<dt class="col-sm-3">{{ 'ui.stock.stock_rotation.referenz'|trans }}</dt><dd class="col-sm-9">{{ command.reference_type }} · <code>{{ command.reference_id }}</code></dd>
				<dt class="col-sm-3">{{ 'ui.v3.integration.automation.command-show.request.id'|trans }}</dt><dd class="col-sm-9"><code>{{ command.request_id }}</code></dd>
				<dt class="col-sm-3">{{ 'ui.v3.integration.automation.command-show.ruckmeldung'|trans }}</dt><dd class="col-sm-9">{{ command.message|default('–') }}</dd>
				<dt class="col-sm-3">{{ 'ui.user.index.erstellt'|trans }}</dt><dd class="col-sm-9">{{ command.created_at }}</dd>
				<dt class="col-sm-3">{{ 'ui.v3.extensions.configuration_index.geandert'|trans }}</dt><dd class="col-sm-9">{{ command.changed_at|default('–') }}</dd>
			</dl>
		</div>
	</div>

	{% if command.status in ['queued', 'dispatched'] and is_granted('integration.automation.execute') %}
		<form method="post" action="{{ path('v3_automation_command_status', {commandId: command.id}) }}" class="card border-0 shadow-sm">
			<div class="card-body">
				<input type="hidden" name="_token" value="{{ csrf_token('v3_automation_command_status_' ~ command.id) }}">
				<div class="row g-3">
					<div class="col-md-4">
						<label class="form-label" for="status">{{ 'ui.v3.integration.automation.command-show.ruckmeldung'|trans }}</label>
						<select class="form-select" id="status" name="status">
							{% if command.status == 'queued' %}
								<option value="dispatched">{{ 'ui.v3.integration.automation.command-show.an.gerat.ubermittelt'|trans }}</option>
							{% else %}
								<option value="completed">{{ 'ui.v3.integration.automation.command-show.erfolgreich.abgeschlossen'|trans }}</option>
							{% endif %}
							<option value="failed">{{ 'ui.v3.integration.automation.command-show.fehlgeschlagen'|trans }}</option>
						</select>
					</div>
					<div class="col-md-8">
						<label class="form-label" for="message">{{ 'ui.v3.integration.automation.command-show.geratemeldung'|trans }}</label>
						<input class="form-control" id="message" name="message" maxlength="500">
					</div>
				</div>
			</div>
			<div class="card-footer text-end"><button class="btn btn-primary">{{ 'ui.v3.integration.automation.command-show.ruckmeldung.verarbeiten'|trans }}</button></div>
		</form>
	{% endif %}
{% endblock %}
