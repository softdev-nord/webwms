{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_automation_index') }}" class="text-decoration-none">{{ 'integration.automation.command_new.storage_lifts_and_paternoster_systems'|trans }}</a>
		<h1 class="h3 mt-2">{{ 'integration.automation.device_new.create_automation_device'|trans }}</h1>
	</div>

	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_automation_device_create') }}">
			<div class="row g-3">
				<div class="col-md-3">
					<label class="form-label" for="code">{{ 'integration.automation.device_new.device_code'|trans }}</label>
					<input class="form-control font-monospace text-uppercase" id="code" name="code" maxlength="40" pattern="[A-Z0-9][A-Z0-9_-]{1,39}" required placeholder="{{ 'integration.automation.device_new.lift_01'|trans }}">
				</div>
				<div class="col-md-5">
					<label class="form-label" for="name">{{ 'common.template.correspondence.name'|trans }}</label>
					<input class="form-control" id="name" name="name" maxlength="100" required placeholder="{{ 'integration.automation.device_new.storage_lift_hall_1'|trans }}">
				</div>
				<div class="col-md-4">
					<label class="form-label" for="device_type">{{ 'integration.automation.device_new.device_type'|trans }}</label>
					<select class="form-select" id="device_type" name="device_type">
						<option value="storage_lift">{{ 'integration.automation.device_new.storage_lift'|trans }}</option>
						<option value="paternoster">{{ 'integration.automation.device_new.paternoster'|trans }}</option>
						<option value="logimat">{{ 'integration.automation.device_new.logimat'|trans }}</option>
					</select>
				</div>
				<div class="col-md-7">
					<label class="form-label" for="endpoint_url">{{ 'integration.automation.device_new.https_endpoint'|trans }}</label>
					<input class="form-control" type="url" id="endpoint_url" name="endpoint_url" required placeholder="{{ 'integration.automation.device_new.https_lift_internal_example_commands'|trans }}">
				</div>
				<div class="col-md-5">
					<label class="form-label" for="credential_env">{{ 'integration.automation.device_new.credential_environment_variable'|trans }}</label>
					<input class="form-control font-monospace text-uppercase" id="credential_env" name="credential_env" required placeholder="{{ 'integration.automation.device_new.lift_01_token'|trans }}">
				</div>
				<div class="col-12">
					<div class="form-check form-switch">
						<input class="form-check-input" type="checkbox" id="active" name="active" value="1" checked>
						<label class="form-check-label" for="active">{{ 'integration.automation.device_new.activate_device_immediately'|trans }}</label>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-light" href="{{ path('v3_automation_index') }}">{{ 'common.button.cancel'|trans }}</a>
			<button class="btn btn-primary">{{ 'integration.automation.device_new.create_device'|trans }}</button>
		</div>
	</form>
{% endblock %}
