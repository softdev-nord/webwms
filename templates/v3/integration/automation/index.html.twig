{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<div>
			<h1 class="h3 mb-1">{{ 'ui.v3.integration.automation.index.lagerlifte.und.paternoster.9ece714'|trans }}</h1>
			<p class="text-muted mb-0">{{ 'ui.v3.integration.automation.index.automationsgerate.aufgaben.und.ruckmeldungen.verwalten.ac5a64d'|trans }}</p>
		</div>
		<div class="d-flex gap-2">
			{% if is_granted('integration.automation.write') %}
				<a class="btn btn-outline-primary" href="{{ path('v3_automation_device_new') }}">{{ 'ui.v3.integration.automation.device-new.gerat.anlegen.805c743'|trans }}</a>
			{% endif %}
			{% if is_granted('integration.automation.execute') %}
				<a class="btn btn-primary" href="{{ path('v3_automation_command_new') }}">{{ 'ui.v3.integration.automation.index.befehl.anlegen.5c9356d'|trans }}</a>
			{% endif %}
		</div>
	</div>

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.automation.index.automationsgerate.0c9493c'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead><tr><th>{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ.edcaf9a'|trans }}</th><th>{{ 'ui.v3.integration.automation.index.endpoint.92ec635'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th></th></tr></thead>
				<tbody>
					{% for device in devices %}
						<tr>
							<td><code>{{ device.code }}</code></td>
							<td class="fw-semibold">{{ device.name }}</td>
							<td>{{ device.device_type }}</td>
							<td><code>{{ device.endpoint_url }}</code></td>
							<td><span class="badge bg-{{ device.active ? 'success' : 'secondary' }}-subtle text-{{ device.active ? 'success' : 'secondary' }}">{{ (device.active ? 'ui.user.user_input_fields.aktiv.16a766c' : 'ui.v3.integration.carrier-connection.index.pausiert.09b952c')|trans }}</span></td>
							<td class="text-end">
								{% if is_granted('integration.automation.write') %}
									<form method="post" action="{{ path('v3_automation_device_status', {deviceId: device.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('v3_automation_device_status_' ~ device.id) }}">
										<button class="btn btn-sm btn-outline-secondary">{{ (device.active ? 'ui.v3.integration.automation.index.choice.pausieren.95175c7' : 'ui.v3.integration.automation.index.choice.aktivieren.3cc7932')|trans }}</button>
									</form>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.integration.automation.index.noch.keine.automationsgerate.vorhanden.32061fb'|trans }}</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.automation.index.geratebefehle.ff9bce5'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead><tr><th>{{ 'ui.v3.integration.automation.command-new.gerat.945d2bc'|trans }}</th><th>{{ 'ui.v3.integration.automation.command-new.befehl.8090759'|trans }}</th><th>{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</th><th>{{ 'ui.stock.stock_rotation.referenz.1ac5c0e'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th><th></th></tr></thead>
				<tbody>
					{% for command in commands %}
						<tr>
							<td>{{ command.device_code }}</td>
							<td>{{ command.command_type }}</td>
							<td><code>{{ command.location_code }}</code></td>
							<td>{{ command.reference_type }}<br><code>{{ command.reference_id }}</code></td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ command.status }}</span></td>
							<td>{{ command.created_at }}</td>
							<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_automation_command_show', {commandId: command.id}) }}">{{ 'ui.v3.inbound.index.offnen.fc718f8'|trans }}</a></td>
						</tr>
					{% else %}
						<tr><td colspan="7" class="text-center text-muted py-5">{{ 'ui.v3.integration.automation.index.noch.keine.geratebefehle.vorhanden.7a738bd'|trans }}</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
