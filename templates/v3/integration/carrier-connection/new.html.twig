{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_carrier_connection_index') }}" class="text-decoration-none">← Carrier-Verbindungen</a>
		<h1 class="h3 mt-2">Carrier-Verbindung anlegen</h1>
		<p class="text-muted mb-0">Das Secret bleibt in der Laufzeitumgebung; WebWMS speichert nur dessen Referenz.</p>
	</div>

	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_carrier_connection_create') }}">
			<div class="row g-3">
				<div class="col-md-6">
					<label class="form-label" for="name">Name</label>
					<input class="form-control" id="name" name="name" maxlength="100" required placeholder="DHL Produktion">
				</div>
				<div class="col-md-6">
					<label class="form-label" for="carrier_code">Carrier-Code</label>
					<input class="form-control font-monospace text-uppercase" id="carrier_code" name="carrier_code" maxlength="40" pattern="[A-Z0-9][A-Z0-9_-]{1,39}" required placeholder="DHL">
				</div>
				<div class="col-12">
					<label class="form-label" for="endpoint_url">HTTPS-Basis-URL</label>
					<input class="form-control font-monospace" type="url" id="endpoint_url" name="endpoint_url" maxlength="500" pattern="https://.*" required placeholder="https://carrier.example.com/api">
				</div>
				<div class="col-md-6">
					<label class="form-label" for="credential_env">Credential-Umgebungsvariable</label>
					<input class="form-control font-monospace" id="credential_env" name="credential_env" maxlength="101" pattern="[A-Z][A-Z0-9_]{2,100}" required placeholder="DHL_API_TOKEN">
				</div>
				<div class="col-md-6 d-flex align-items-end pb-2">
					<div class="form-check form-switch">
						<input class="form-check-input" type="checkbox" role="switch" id="active" name="active" value="1" checked>
						<label class="form-check-label" for="active">Verbindung sofort aktivieren</label>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-light" href="{{ path('v3_carrier_connection_index') }}">Abbrechen</a>
			<button class="btn btn-primary">Carrier-Verbindung anlegen</button>
		</div>
	</form>
{% endblock %}
