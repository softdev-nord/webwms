{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_carrier_connection_show', {connectionId: connection.id}) }}" class="text-decoration-none">← {{ connection.name }}</a>
		<h1 class="h3 mt-2 mb-1">{{ 'integration.carrier_connection.products.shipping_products'|trans }}</h1>
		<p class="text-muted mb-0">{{ 'integration.carrier_connection.products.live_from_carrier'|trans }} {{ connection.carrier_code }} {{ 'integration.carrier_connection.products.retrieved'|trans }}</p>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'integration.carrier_connection.products.product_code'|trans }}</th>
						<th>{{ 'article.index.description'|trans }}</th>
					</tr>
				</thead>
				<tbody>
					{% for product in products %}
						<tr>
							<td><code>{{ product.code }}</code></td>
							<td>{{ product.name }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="2" class="text-center text-muted py-5">{{ 'integration.carrier_connection.products.carrier_did_not_provide_any_shipping_products'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
