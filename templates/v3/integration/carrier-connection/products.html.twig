{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_carrier_connection_show', {connectionId: connection.id}) }}" class="text-decoration-none">← {{ connection.name }}</a>
		<h1 class="h3 mt-2 mb-1">{{ 'ui.v3.integration.carrier-connection.products.versandprodukte.3439ce1'|trans }}</h1>
		<p class="text-muted mb-0">{{ 'ui.v3.integration.carrier-connection.products.live.vom.carrier.5224d3f'|trans }} {{ connection.carrier_code }} {{ 'ui.v3.integration.carrier-connection.products.abgerufen.a249062'|trans }}</p>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'ui.v3.integration.carrier-connection.products.produktcode.2c37391'|trans }}</th>
						<th>{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}</th>
					</tr>
				</thead>
				<tbody>
					{% for product in products %}
						<tr>
							<td><code>{{ product.code }}</code></td>
							<td>{{ product.name }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="2" class="text-center text-muted py-5">{{ 'ui.v3.integration.carrier-connection.products.der.carrier.hat.keine.versandprodukte.geliefert.e1fc4bb'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
