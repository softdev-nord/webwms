{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_printing_index') }}" class="text-decoration-none">← Druckwarteschlange</a>
		<h1 class="h3 mt-2">Drucker anlegen</h1>
		<p class="text-muted mb-0">Das Zugangstoken bleibt in der Laufzeitumgebung; WebWMS speichert nur dessen Referenz.</p>
	</div>

	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_printing_printer_create') }}">
			<div class="row g-3">
				<div class="col-md-6">
					<label class="form-label" for="name">Name</label>
					<input class="form-control" id="name" name="name" maxlength="100" required placeholder="Packplatz 1 ZPL">
				</div>
				<div class="col-md-6">
					<label class="form-label" for="credential_env">Credential-Umgebungsvariable</label>
					<input class="form-control font-monospace" id="credential_env" name="credential_env" maxlength="101" pattern="[A-Z][A-Z0-9_]{2,100}" required placeholder="PRINTER_PACK_1_TOKEN">
				</div>
				<div class="col-12">
					<label class="form-label" for="endpoint_url">HTTPS-Endpunkt</label>
					<input class="form-control font-monospace" type="url" id="endpoint_url" name="endpoint_url" maxlength="500" pattern="https://.*" required placeholder="https://print.example.com/printers/pack-1">
				</div>
				<div class="col-12">
					<div class="form-check form-switch">
						<input class="form-check-input" type="checkbox" role="switch" id="active" name="active" value="1" checked>
						<label class="form-check-label" for="active">Drucker sofort aktivieren</label>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-light" href="{{ path('v3_printing_index') }}">Abbrechen</a>
			<button class="btn btn-primary">Drucker anlegen</button>
		</div>
	</form>
{% endblock %}
