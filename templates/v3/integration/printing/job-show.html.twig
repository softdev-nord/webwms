{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start mb-4">
		<div>
			<a href="{{ path('v3_printing_index') }}" class="text-decoration-none">← Druckwarteschlange</a>
			<h1 class="h3 mt-2 mb-1">Druckauftrag</h1>
			<code>{{ job.id }}</code>
		</div>
		<span class="badge bg-secondary-subtle text-secondary fs-6">{{ job.status }}</span>
	</div>
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-md-3">Drucker</dt>
				<dd class="col-md-9"><a href="{{ path('v3_printing_printer_show', {printerId: job.printer_id}) }}">{{ job.printer_name }}</a></dd>
				<dt class="col-md-3">Dokument</dt>
				<dd class="col-md-9">{{ job.document_type }} · <code>{{ job.document_reference }}</code></dd>
				<dt class="col-md-3">Format</dt>
				<dd class="col-md-9">{{ job.format }} · {{ job.copies }} Exemplar(e)</dd>
				<dt class="col-md-3">Versuche</dt>
				<dd class="col-md-9">{{ job.attempts }}</dd>
				<dt class="col-md-3">Angelegt</dt>
				<dd class="col-md-9">{{ job.created_at }} · <code>{{ job.created_by }}</code></dd>
				{% if job.external_reference %}
					<dt class="col-md-3">Externe Referenz</dt>
					<dd class="col-md-9"><code>{{ job.external_reference }}</code></dd>
				{% endif %}
				{% if job.completed_at %}
					<dt class="col-md-3">Abgeschlossen</dt>
					<dd class="col-md-9">{{ job.completed_at }}</dd>
				{% endif %}
			</dl>
		</div>
	</div>
	{% if job.last_error %}
		<div class="alert alert-danger">
			<strong>Letzter Fehler</strong>
			<div>{{ job.last_error }}</div>
		</div>
	{% endif %}
	{% if job.status in ['queued', 'failed'] and is_granted('integration.print_job.execute') %}
		<form method="post" action="{{ path('v3_printing_job_execute', {jobId: job.id}) }}">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_printing_job_execute_' ~ job.id) }}">
			<button class="btn btn-primary">{{ job.status == 'failed' ? 'Erneut drucken' : 'Druckauftrag ausführen' }}</button>
		</form>
	{% endif %}
{% endblock %}
