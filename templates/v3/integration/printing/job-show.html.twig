{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start mb-4">
		<div>
			<a href="{{ path('v3_printing_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.printing.job-new.druckwarteschlange.5fdae01'|trans }}</a>
			<h1 class="h3 mt-2 mb-1">{{ 'ui.v3.integration.printing.job-show.druckauftrag.1ef8bb3'|trans }}</h1>
			<code>{{ job.id }}</code>
		</div>
		<span class="badge bg-secondary-subtle text-secondary fs-6">{{ job.status }}</span>
	</div>
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-md-3">{{ 'ui.configuration.index.drucker.4b3d759'|trans }}</dt>
				<dd class="col-md-9"><a href="{{ path('v3_printing_printer_show', {printerId: job.printer_id}) }}">{{ job.printer_name }}</a></dd>
				<dt class="col-md-3">{{ 'ui.v3.integration.printing.index.dokument.2ccbe16'|trans }}</dt>
				<dd class="col-md-9">{{ job.document_type }} · <code>{{ job.document_reference }}</code></dd>
				<dt class="col-md-3">{{ 'ui.v3.integration.printing.index.format.041a5de'|trans }}</dt>
				<dd class="col-md-9">{{ job.format }} · {{ job.copies }} {{ 'ui.v3.integration.printing.job-show.exemplar.e.982a350'|trans }}</dd>
				<dt class="col-md-3">{{ 'ui.v3.integration.outbox.index.versuche.b924bff'|trans }}</dt>
				<dd class="col-md-9">{{ job.attempts }}</dd>
				<dt class="col-md-3">{{ 'ui.v3.integration.carrier-connection.show.angelegt.6cf261d'|trans }}</dt>
				<dd class="col-md-9">{{ job.created_at }} · <code>{{ job.created_by }}</code></dd>
				{% if job.external_reference %}
					<dt class="col-md-3">{{ 'ui.v3.integration.printing.job-show.externe.referenz.a993452'|trans }}</dt>
					<dd class="col-md-9"><code>{{ job.external_reference }}</code></dd>
				{% endif %}
				{% if job.completed_at %}
					<dt class="col-md-3">{{ 'ui.v3.integration.printing.job-show.abgeschlossen.be274c6'|trans }}</dt>
					<dd class="col-md-9">{{ job.completed_at }}</dd>
				{% endif %}
			</dl>
		</div>
	</div>
	{% if job.last_error %}
		<div class="alert alert-danger">
			<strong>{{ 'ui.v3.integration.printing.job-show.letzter.fehler.b9a32ed'|trans }}</strong>
			<div>{{ job.last_error }}</div>
		</div>
	{% endif %}
	{% if job.status in ['queued', 'failed'] and is_granted('integration.print_job.execute') %}
		<form method="post" action="{{ path('v3_printing_job_execute', {jobId: job.id}) }}">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_printing_job_execute_' ~ job.id) }}">
			<button class="btn btn-primary">{{ (job.status == 'failed' ? 'ui.v3.integration.printing.job-show.choice.erneut.drucken.4bf5d2f' : 'ui.v3.integration.printing.job-show.choice.druckauftrag.ausfuhren.084178c')|trans }}</button>
		</form>
	{% endif %}
{% endblock %}
