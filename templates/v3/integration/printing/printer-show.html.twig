{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start mb-4">
		<div>
			<a href="{{ path('v3_printing_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.printing.job-new.druckwarteschlange'|trans }}</a>
			<h1 class="h3 mt-2 mb-1">{{ printer.name }}</h1>
			{% if printer.active %}
				<span class="badge bg-success-subtle text-success">{{ 'ui.user.user_input_fields.aktiv'|trans }}</span>
			{% else %}
				<span class="badge bg-secondary-subtle text-secondary">{{ 'ui.v3.integration.carrier-connection.index.pausiert'|trans }}</span>
			{% endif %}
		</div>
		{% if is_granted('integration.printer.write') %}
			<form method="post" action="{{ path('v3_printing_printer_status', {printerId: printer.id}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('v3_printing_printer_status_' ~ printer.id) }}">
				<button class="btn {{ printer.active ? 'btn-outline-warning' : 'btn-success' }}">
					{{ (printer.active ? 'ui.v3.integration.printing.printer-show.choice.drucker.pausieren' : 'ui.v3.integration.printing.printer-show.choice.drucker.aktivieren')|trans }}
				</button>
			</form>
		{% endif %}
	</div>

	<div class="row g-4 mb-4">
		<div class="col-lg-8">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.carrier-connection.show.verbindungsdaten'|trans }}</h2></div>
				<div class="card-body">
					<dl class="row mb-0">
						<dt class="col-sm-4">{{ 'ui.v3.integration.printing.printer-new.https.endpunkt'|trans }}</dt>
						<dd class="col-sm-8"><code>{{ printer.endpoint_url }}</code></dd>
						<dt class="col-sm-4">{{ 'ui.v3.integration.carrier-connection.show.credential.referenz'|trans }}</dt>
						<dd class="col-sm-8"><code>{{ printer.credential_env }}</code></dd>
					</dl>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="card border-0 shadow-sm h-100">
				<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.carrier-connection.show.audit'|trans }}</h2></div>
				<div class="card-body">
					<strong>{{ 'ui.v3.integration.carrier-connection.show.angelegt'|trans }}</strong>
					<div>{{ printer.created_at }}</div>
					<code>{{ printer.created_by }}</code>
					{% if printer.changed_at %}
						<hr>
						<strong>{{ 'ui.v3.extensions.configuration_index.geandert'|trans }}</strong>
						<div>{{ printer.changed_at }}</div>
						<code>{{ printer.changed_by }}</code>
					{% endif %}
				</div>
			</div>
		</div>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.printing.printer-show.druckauftrage'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'ui.v3.integration.printing.index.dokument'|trans }}</th>
						<th>{{ 'ui.transport_request.index.status'|trans }}</th>
						<th>{{ 'ui.v3.integration.outbox.index.versuche'|trans }}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for job in jobs %}
						<tr>
							<td>{{ job.document_type }}<br><code>{{ job.document_reference }}</code></td>
							<td>{{ job.status }}</td>
							<td>{{ job.attempts }}</td>
							<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_printing_job_show', {jobId: job.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a></td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.integration.printing.printer-show.keine.druckauftrage.fur.diesen.drucker'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
