{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_printing_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.printing.job-new.druckwarteschlange.5fdae01'|trans }}</a>
		<h1 class="h3 mt-2">{{ 'ui.v3.inbound.control.druckauftrag.anlegen.fae70fa'|trans }}</h1>
	</div>
	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_printing_job_create') }}">
			<input type="hidden" name="request_id" value="{{ requestId }}">
			<div class="row g-3">
				<div class="col-md-6">
					<label class="form-label" for="printer_id">{{ 'ui.configuration.index.drucker.4b3d759'|trans }}</label>
					<select class="form-select" id="printer_id" name="printer_id" required>
						{% for printer in printers %}
							<option value="{{ printer.id }}">{{ printer.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="col-md-3">
					<label class="form-label" for="document_type">{{ 'ui.v3.integration.printing.job-new.dokumenttyp.33078b7'|trans }}</label>
					<select class="form-select" id="document_type" name="document_type">
						<option value="carrier_label">{{ 'ui.v3.integration.printing.job-new.carrier.label.16e5b18'|trans }}</option>
						<option value="document">{{ 'ui.v3.integration.printing.index.dokument.2ccbe16'|trans }}</option>
						<option value="loading_manifest">{{ 'ui.v3.integration.printing.job-new.lademanifest.0009ebe'|trans }}</option>
					</select>
				</div>
				<div class="col-md-3">
					<label class="form-label" for="format">{{ 'ui.v3.integration.printing.index.format.041a5de'|trans }}</label>
					<select class="form-select" id="format" name="format">
						<option value="ZPL">{{ 'ui.v3.integration.printing.job-new.zpl.059035d'|trans }}</option>
						<option value="PDF">{{ 'ui.v3.integration.printing.job-new.pdf.d613d88'|trans }}</option>
					</select>
				</div>
				<div class="col-md-9">
					<label class="form-label" for="document_reference">{{ 'ui.v3.integration.printing.job-new.dokumentreferenz.68691ea'|trans }}</label>
					<input class="form-control" id="document_reference" name="document_reference" maxlength="500" required>
				</div>
				<div class="col-md-3">
					<label class="form-label" for="copies">{{ 'ui.v3.integration.printing.job-new.exemplare.8be8e1b'|trans }}</label>
					<input class="form-control" type="number" id="copies" name="copies" min="1" max="99" value="1" required>
				</div>
			</div>
			{% if printers is empty %}
				<div class="alert alert-warning mt-3 mb-0">{{ 'ui.v3.integration.printing.job-new.es.ist.kein.aktiver.drucker.vorhanden.4f90bde'|trans }}</div>
			{% endif %}
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-light" href="{{ path('v3_printing_index') }}">{{ 'button.cancel'|trans }}</a>
			<button class="btn btn-primary" {% if printers is empty %}disabled{% endif %}>{{ 'ui.v3.inbound.control.druckauftrag.anlegen.fae70fa'|trans }}</button>
		</div>
	</form>
{% endblock %}
