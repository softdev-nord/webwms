{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<div>
			<h1 class="h3 mb-1">{{ 'ui.v3.integration.printing.index.druckwarteschlange'|trans }}</h1>
			<p class="text-muted mb-0">{{ 'ui.v3.integration.printing.index.drucker.verwalten.und.etiketten.sowie.dokumentenauftrag'|trans }}</p>
		</div>
		<div class="d-flex gap-2">
			{% if is_granted('integration.printer.write') %}
				<a class="btn btn-outline-primary" href="{{ path('v3_printing_printer_new') }}">{{ 'ui.v3.integration.printing.index.drucker.anlegen'|trans }}</a>
			{% endif %}
			{% if is_granted('integration.print_job.write') %}
				<a class="btn btn-primary" href="{{ path('v3_printing_job_new') }}">{{ 'ui.v3.inbound.control.druckauftrag.anlegen'|trans }}</a>
			{% endif %}
		</div>
	</div>

	{% if is_granted('integration.printer.read') %}
		<div class="card border-0 shadow-sm mb-4">
			<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.configuration.index.drucker'|trans }}</h2></div>
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead>
						<tr>
							<th>{{ 'templates.correspondence.name'|trans }}</th>
							<th>{{ 'ui.v3.integration.carrier-connection.index.endpunkt'|trans }}</th>
							<th>{{ 'ui.transport_request.index.status'|trans }}</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for printer in printers %}
							<tr>
								<td class="fw-semibold">{{ printer.name }}</td>
								<td><code>{{ printer.endpoint_url }}</code></td>
								<td>
									{% if printer.active %}
										<span class="badge bg-success-subtle text-success">{{ 'ui.user.user_input_fields.aktiv'|trans }}</span>
									{% else %}
										<span class="badge bg-secondary-subtle text-secondary">{{ 'ui.v3.integration.carrier-connection.index.pausiert'|trans }}</span>
									{% endif %}
								</td>
								<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_printing_printer_show', {printerId: printer.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a></td>
							</tr>
						{% else %}
							<tr>
								<td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.integration.printing.index.noch.keine.drucker.vorhanden'|trans }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% endif %}

	<div class="card border-0 shadow-sm">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.printing.index.letzte.druckauftrage'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'ui.v3.integration.printing.index.dokument'|trans }}</th>
						<th>{{ 'ui.configuration.index.drucker'|trans }}</th>
						<th>{{ 'ui.v3.integration.printing.index.format'|trans }}</th>
						<th>{{ 'ui.transport_request.index.status'|trans }}</th>
						<th>{{ 'ui.v3.integration.outbox.index.versuche'|trans }}</th>
						<th>{{ 'ui.v3.administration.workspace.zeitpunkt'|trans }}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for job in jobs %}
						<tr>
							<td><div class="fw-semibold">{{ job.document_type }}</div><code>{{ job.document_reference }}</code></td>
							<td>{{ job.printer_name }}</td>
							<td>{{ job.format }} · {{ job.copies }}×</td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ job.status }}</span></td>
							<td>{{ job.attempts }}</td>
							<td>{{ job.created_at }}</td>
							<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_printing_job_show', {jobId: job.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a></td>
						</tr>
					{% else %}
						<tr>
							<td colspan="7" class="text-center text-muted py-5">{{ 'ui.v3.integration.printing.index.noch.keine.druckauftrage.vorhanden'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
