{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start mb-4">
		<div>
			<a href="{{ path('v3_device_index') }}" class="text-decoration-none">← Scanner und MDE</a>
			<h1 class="h3 mt-2 mb-1">Scanereignis</h1>
			<code>{{ event.id }}</code>
		</div>
		<span class="badge bg-{{ event.status == 'accepted' ? 'success' : 'danger' }}-subtle text-{{ event.status == 'accepted' ? 'success' : 'danger' }} fs-6">{{ event.status }}</span>
	</div>
	<div class="card border-0 shadow-sm">
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-md-3">Gerät</dt>
				<dd class="col-md-9"><a href="{{ path('v3_device_show', {deviceId: event.device_id}) }}">{{ event.device_code }} · {{ event.device_name }}</a></dd>
				<dt class="col-md-3">Prozess</dt>
				<dd class="col-md-9">{{ event.process_type }} · <code>{{ event.context_reference }}</code></dd>
				<dt class="col-md-3">Scantyp</dt>
				<dd class="col-md-9">{{ event.scan_type }}</dd>
				<dt class="col-md-3">Scanwert</dt>
				<dd class="col-md-9"><code>{{ event.scan_value }}</code></dd>
				<dt class="col-md-3">Request-ID</dt>
				<dd class="col-md-9"><code>{{ event.request_id }}</code></dd>
				<dt class="col-md-3">Erfasst</dt>
				<dd class="col-md-9">{{ event.scanned_at }} · <code>{{ event.scanned_by }}</code></dd>
				{% if event.message %}
					<dt class="col-md-3">Prüfhinweis</dt>
					<dd class="col-md-9">{{ event.message }}</dd>
				{% endif %}
			</dl>
		</div>
	</div>
{% endblock %}
