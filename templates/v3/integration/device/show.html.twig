{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start mb-4">
		<div>
			<a href="{{ path('v3_device_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.device.new.scanner.und.mde.2f34617'|trans }}</a>
			<h1 class="h3 mt-2 mb-1">{{ device.name }}</h1>
			<code>{{ device.code }}</code>
		</div>
		{% if is_granted('integration.device.write') %}
			<form method="post" action="{{ path('v3_device_status', {deviceId: device.id}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('v3_device_status_' ~ device.id) }}">
				<button class="btn {{ device.active ? 'btn-outline-warning' : 'btn-success' }}">
					{{ (device.active ? 'ui.v3.integration.device.show.choice.gerat.pausieren.3b7e6fc' : 'ui.v3.integration.device.show.choice.gerat.aktivieren.12d7806')|trans }}
				</button>
			</form>
		{% endif %}
	</div>
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body">
			<dl class="row mb-0">
				<dt class="col-md-3">{{ 'ui.v3.integration.automation.device-new.geratetyp.b09e80e'|trans }}</dt>
				<dd class="col-md-9">{{ device.device_type }}</dd>
				<dt class="col-md-3">{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</dt>
				<dd class="col-md-9">{{ (device.active ? 'ui.user.user_input_fields.aktiv.16a766c' : 'ui.v3.integration.carrier-connection.index.pausiert.09b952c')|trans }}</dd>
				<dt class="col-md-3">{{ 'ui.v3.integration.carrier-connection.show.angelegt.6cf261d'|trans }}</dt>
				<dd class="col-md-9">{{ device.created_at }} · <code>{{ device.created_by }}</code></dd>
				{% if device.changed_at %}
					<dt class="col-md-3">{{ 'ui.v3.extensions.configuration_index.geandert.01de835'|trans }}</dt>
					<dd class="col-md-9">{{ device.changed_at }} · <code>{{ device.changed_by }}</code></dd>
				{% endif %}
			</dl>
		</div>
	</div>
	<div class="card border-0 shadow-sm">
		<div class="card-header bg-transparent"><h2 class="h5 mb-0">{{ 'ui.v3.integration.device.show.scanereignisse.972645c'|trans }}</h2></div>
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'ui.v3.integration.device.index.prozess.beb029c'|trans }}</th>
						<th>{{ 'ui.v3.integration.device.index.scantyp.6f85cf4'|trans }}</th>
						<th>{{ 'ui.v3.integration.device.index.wert.9d3fb5b'|trans }}</th>
						<th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th>
						<th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for event in scanEvents %}
						<tr>
							<td>{{ event.process_type }}<br><code>{{ event.context_reference }}</code></td>
							<td>{{ event.scan_type }}</td>
							<td><code>{{ event.scan_value }}</code></td>
							<td>{{ event.status }}</td>
							<td>{{ event.scanned_at }}</td>
							<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_device_scan_show', {eventId: event.id}) }}">{{ 'ui.v3.inbound.index.offnen.fc718f8'|trans }}</a></td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.integration.device.show.keine.scanereignisse.fur.dieses.gerat.2494bd9'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
