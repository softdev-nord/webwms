{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_transport_index') }}" class="text-decoration-none">{{ 'ui.v3.integration.transport.new.tcp.ip.und.webservice.7c182ae'|trans }}</a>
		<h1 class="h3 mt-2">{{ 'ui.v3.integration.transport.new.transport.endpunkt.anlegen.9e44881'|trans }}</h1>
	</div>
	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_transport_create') }}">
			<div class="row g-3">
				<div class="col-md-3"><label class="form-label" for="code">{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</label><input class="form-control font-monospace text-uppercase" id="code" name="code" maxlength="40" required></div>
				<div class="col-md-5"><label class="form-label" for="name">{{ 'templates.correspondence.name'|trans }}</label><input class="form-control" id="name" name="name" maxlength="100" required></div>
				<div class="col-md-4"><label class="form-label" for="adapter_type">{{ 'ui.v3.integration.transport.index.adapter.e6b4616'|trans }}</label><select class="form-select" id="adapter_type" name="adapter_type"><option value="tcp_client">{{ 'ui.v3.integration.transport.new.tcp.client.91502bf'|trans }}</option><option value="http_webservice">{{ 'ui.v3.integration.transport.new.http.webservice.c6861f0'|trans }}</option></select></div>
				<div class="col-md-7"><label class="form-label" for="address">{{ 'ui.v3.integration.transport.index.adresse.522e146'|trans }}</label><input class="form-control font-monospace" id="address" name="address" required placeholder="{{ 'ui.v3.integration.transport.new.tcp.host.9100.oder.https.host.api.449f787'|trans }}"></div>
				<div class="col-md-5"><label class="form-label" for="credential_env">{{ 'ui.v3.integration.automation.device-new.credential.umgebungsvariable.9feb046'|trans }}</label><input class="form-control font-monospace text-uppercase" id="credential_env" name="credential_env" required></div>
				<div class="col-md-4"><label class="form-label" for="protocol">{{ 'ui.v3.integration.transport.index.protokoll.440c156'|trans }}</label><select class="form-select" id="protocol" name="protocol"><option value="raw_tcp">{{ 'ui.v3.integration.transport.new.raw.tcp.0815302'|trans }}</option><option value="rest_json">{{ 'ui.v3.integration.transport.new.rest.json.407c44b'|trans }}</option><option value="soap_xml">{{ 'ui.v3.integration.transport.new.soap.xml.b9f36fb'|trans }}</option></select></div>
				<div class="col-md-4"><label class="form-label" for="framing">{{ 'ui.v3.integration.transport.new.framing.5318b91'|trans }}</label><select class="form-select" id="framing" name="framing"><option value="stx_etx">{{ 'ui.v3.integration.transport.new.stx.etx.3b03fdc'|trans }}</option><option value="newline">{{ 'ui.v3.integration.transport.new.newline.d706a7f'|trans }}</option><option value="none">{{ 'ui.v3.integration.transport.new.ohne.f09dc50'|trans }}</option><option value="http">{{ 'ui.v3.integration.transport.new.http.f40b27d'|trans }}</option></select></div>
				<div class="col-md-2"><label class="form-label" for="connect_timeout_ms">{{ 'ui.v3.integration.transport.new.connect.ms.42d0fcd'|trans }}</label><input class="form-control" type="number" id="connect_timeout_ms" name="connect_timeout_ms" min="100" max="60000" value="3000" required></div>
				<div class="col-md-2"><label class="form-label" for="read_timeout_ms">{{ 'ui.v3.integration.transport.new.read.ms.ad479cb'|trans }}</label><input class="form-control" type="number" id="read_timeout_ms" name="read_timeout_ms" min="100" max="300000" value="10000" required></div>
				<div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="active" name="active" value="1" checked><label class="form-check-label" for="active">{{ 'ui.v3.integration.transport.new.endpunkt.sofort.aktivieren.5ba64f7'|trans }}</label></div></div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_transport_index') }}">{{ 'button.cancel'|trans }}</a><button class="btn btn-primary">{{ 'ui.v3.integration.transport.index.endpunkt.anlegen.16bdac3'|trans }}</button></div>
	</form>
{% endblock %}
