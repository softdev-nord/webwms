te', {policyId: policy.id}) }}" class="d-inline-block me-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_replenishment_order_create_' ~ policy.id) }}"><button class="btn btn-sm btn-light">{{ policy.code }} {{ 'ui.v3.transport.index.auslosen.9e046d9'|trans }}</button></form>{% endfor %}</div></div>{% endif %}<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>{{ 'ui.v3.inventory.selection_rules.regel.fe56804'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.logging.index.route.4999528'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th></th></tr></thead><tbody>{% for order in workspace.replenishments %}<tr><td>{{ order.policy_code }}</td><td>{{ order.sku }}</td><td>{{ order.source_code }} → {{ order.target_code }}</td><td>{{ order.quantity }}</td><td>{{ order.status }}</td><td>{% if order.status == 'open' and is_granted('fulfillment.replenishment.execute') %}<form method="post" action="{{ path('v3_internal_transport_replenishment_complete', {orderId: order.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_replenishment_complete_' ~ order.id) }}"><button class="btn btn-sm btn-success">{{ 'ui.v3.transport.index.quittieren.6af09fe'|trans }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-muted text-center py-3">{{ 'ui.v3.transport.index.keine.nachschubauftrage.3ea893b'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
