{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><h1 class="h3 mb-1">Interner Transport</h1><p class="text-muted mb-0">Fahrbefehle, Stapler, Regeln, Vorholung, Materialfluss und Routenzüge.</p></div>
	{% if is_granted('fulfillment.transport.write') %}<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Fahrbefehl anlegen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_internal_transport_order_create') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_order_create') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-2"><select class="form-select" name="transport_type"><option value="relocation">Umlagerung</option><option value="replenishment">Nachschub</option><option value="prepositioning">Vorholung</option><option value="material_flow">Materialfluss</option><option value="milk_run">Routenzug</option></select></div><div class="col-md-3"><select class="form-select" name="source_location_id" required><option value="">Quellplatz</option>{% for location in workspace.locations %}<option value="{{ location.id }}">{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-md-3"><select class="form-select" name="target_location_id" required><option value="">Zielplatz</option>{% for location in workspace.locations %}<option value="{{ location.id }}">{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-md-2"><input class="form-control" type="number" name="priority" value="50" min="1" max="999"></div><div class="col-md-4"><select class="form-select" name="product_id"><option value="">Ohne Bestandsbuchung</option>{% for product in workspace.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select></div><div class="col-md-2"><input class="form-control" type="number" name="quantity" min="1" placeholder="Menge"></div><div class="col-md-2"><input class="form-control" name="stock_status" value="available"></div><div class="col-md-2"><input class="form-control" name="batch_number" placeholder="Charge"></div><div class="col-md-2"><input class="form-control" name="serial_number" placeholder="Seriennummer"></div><div class="col-12"><button class="btn btn-primary">Fahrbefehl anlegen</button></div></form></div></div>{% endif %}
	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Transportleitstand</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Fahrbefehl</th><th>Typ</th><th>Route</th><th>Artikel/Menge</th><th>Ressource</th><th>Status</th><th></th></tr></thead><tbody>{% for order in workspace.orders %}<tr><td><strong>{{ order.code }}</strong><div class="small text-muted">Priorität {{ order.priority }}</div></td><td>{{ order.transport_type }}</td><td>{{ order.source_code }} → {{ order.target_code }}</td><td>{{ order.sku ?: 'Ladehilfsmittel' }}{% if order.quantity %} · {{ order.quantity }}{% endif %}</td><td>{{ order.forklift_code ?: 'Nicht zugewiesen' }}</td><td><span class="badge bg-secondary-subtle text-body">{{ order.status }}</span></td><td class="text-end">{% if order.status == 'open' and is_granted('fulfillment.transport.assign') %}<form method="post" action="{{ path('v3_internal_transport_assign', {orderId: order.id}) }}" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_assign_' ~ order.id) }}"><select class="form-select form-select-sm" name="forklift_id" required>{% for forklift in workspace.forklifts|filter(f => f.status == 'available') %}<option value="{{ forklift.id }}">{{ forklift.code }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-primary">Zuweisen</button></form>{% elseif order.status == 'assigned' and is_granted('fulfillment.transport.execute') %}<form method="post" action="{{ path('v3_internal_transport_start', {orderId: order.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_start_' ~ order.id) }}"><button class="btn btn-sm btn-primary">Starten</button></form>{% elseif order.status == 'started' and is_granted('fulfillment.transport.execute') %}<form method="post" action="{{ path('v3_internal_transport_complete', {orderId: order.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_complete_' ~ order.id) }}"><button class="btn btn-sm btn-success">Quittieren</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-3">Keine Fahrbefehle.</td></tr>{% endfor %}</tbody></table></div></div>
	{% if is_granted('fulfillment.transport.configure') %}<div class="row g-4"><div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Ressourcen &amp; Regeln</h2></div><div class="card-body"><form method="post" action="{{ path('v3_internal_transport_resource_create', {resource: 'forklift'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_resource_create_forklift') }}"><div class="col-3"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-4"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-3"><select class="form-select" name="warehouse_id">{% for warehouse in workspace.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select></div><div class="col-2"><select class="form-select" name="resource_type"><option value="forklift">Stapler</option><option value="tugger_train">Routenzug</option><option value="agv">FTS</option></select></div><div class="col-12"><button class="btn btn-outline-primary">Ressource anlegen</button></div></form><form method="post" action="{{ path('v3_internal_transport_resource_create', {resource: 'rule'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_resource_create_rule') }}"><div class="col-3"><input class="form-control" name="code" placeholder="Regelcode" required></div><div class="col-5"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-4"><select class="form-select" name="trigger_type"><option value="manual">Manuell</option><option value="replenishment">Nachschub</option><option value="prepositioning">Vorholung</option><option value="material_flow">Materialfluss</option></select></div><div class="col-3"><input class="form-control" name="source_prefix" placeholder="Quellpräfix" required></div><div class="col-3"><input class="form-control" name="target_prefix" placeholder="Zielpräfix" required></div><div class="col-3"><select class="form-select" name="transport_type"><option value="relocation">Umlagerung</option><option value="replenishment">Nachschub</option><option value="prepositioning">Vorholung</option><option value="material_flow">Materialfluss</option></select></div><div class="col-2"><select class="form-select" name="resource_type"><option value="forklift">Stapler</option><option value="tugger_train">Routenzug</option><option value="agv">FTS</option></select></div><div class="col-1"><input class="form-control" type="number" name="priority" value="50"></div><div class="col-12"><button class="btn btn-outline-primary">Regel anlegen</button></div></form></div></div></div>
	<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Materialfluss &amp; Routenzug</h2></div><div class="card-body"><form method="post" action="{{ path('v3_internal_transport_resource_create', {resource: 'station'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_resource_create_station') }}"><div class="col-2"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-3"><input class="form-control" name="name" placeholder="Station" required></div><div class="col-2"><select class="form-select" name="warehouse_id">{% for warehouse in workspace.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select></div><div class="col-3"><select class="form-select" name="location_id">{% for location in workspace.locations %}<option value="{{ location.id }}">{{ location.code }}</option>{% endfor %}</select></div><div class="col-2"><input class="form-control" type="number" name="sequence_number" value="10"><input type="hidden" name="station_type" value="buffer"></div><div class="col-12"><button class="btn btn-outline-primary">Station anlegen</button></div></form><form method="post" action="{{ path('v3_internal_transport_resource_create', {resource: 'milk_run'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_resource_create_milk_run') }}"><div class="col-3"><input class="form-control" name="code" placeholder="Tourcode" required></div><div class="col-4"><input class="form-control" name="name" placeholder="Tourname" required></div><div class="col-3"><select class="form-select" name="warehouse_id">{% for warehouse in workspace.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select></div><div class="col-2"><select class="form-select" name="schedule_type"><option value="fixed">Fest</option><option value="dynamic">Dynamisch</option></select></div><div class="col-3"><input class="form-control" type="number" name="interval_minutes" value="60" min="1"></div><div class="col-12"><button class="btn btn-outline-primary">Routenzug anlegen</button></div></form><div class="mt-3">{% for run in workspace.milkRuns %}<div class="border-top py-2"><div class="d-flex justify-content-between"><span><strong>{{ run.code }}</strong> · {{ run.stop_count }} Stopps</span>{% if run.stop_count >= 2 %}<form method="post" action="{{ path('v3_internal_transport_milk_run_dispatch', {milkRunId: run.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_milk_run_dispatch_' ~ run.id) }}"><button class="btn btn-sm btn-primary">Tour auslösen</button></form>{% endif %}</div><form method="post" action="{{ path('v3_internal_transport_milk_run_stop', {milkRunId: run.id}) }}" class="d-flex gap-1 mt-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_transport_milk_run_stop_' ~ run.id) }}"><select class="form-select form-select-sm" name="station_id">{% for station in workspace.stations %}<option value="{{ station.id }}">{{ station.code }}</option>{% endfor %}</select><input class="form-control form-control-sm" type="number" name="sequence_number" value="{{ run.stop_count + 1 }}" min="1"><input class="form-control form-control-sm" type="number" name="dwell_minutes" value="5" min="0"><button class="btn btn-sm btn-outline-primary">Stopp</button></form></div>{% endfor %}</div></div></div></div></div>{% endif %}
	<div class="card border-0 shadow-sm mt-4"><div class="card-header"><h2 class="h5 mb-0">Nachschubsteuerung</h2></div>{% if is_granted('fulfillment.replenishment.write') %}<div class="card-body border-bottom"><form method="post" action="{{ path('v3_internal_transport_replenishment_policy_create') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_replenishment_policy_create') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="Regelcode" required></div><div class="col-md-2"><select class="form-select" name="warehouse_id">{% for warehouse in workspace.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select></div><div class="col-md-3"><select class="form-select" name="product_id">{% for product in workspace.products %}<option value="{{ product.id }}">{{ product.sku }}</option>{% endfor %}</select></div><div class="col-md-3"><select class="form-select" name="target_location_id">{% for location in workspace.locations %}<option value="{{ location.id }}">{{ location.code }}</option>{% endfor %}</select></div><div class="col-md-2"><input class="form-control" name="source_location_prefix" placeholder="Quellpräfix" required></div><div class="col-md-2"><input class="form-control" type="number" name="minimum_quantity" value="10" min="0"></div><div class="col-md-2"><input class="form-control" type="number" name="target_quantity" value="50" min="1"></div><div class="col-md-2"><input class="form-control" type="number" name="priority" value="50" min="1"></div><div class="col-md-3"><button class="btn btn-outline-primary">Nachschubregel anlegen</button></div></form><div class="mt-3">{% for policy in workspace.replenishmentPolicies %}<form method="post" action="{{ path('v3_internal_transport_replenishment_order_create', {policyId: policy.id}) }}" class="d-inline-block me-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_replenishment_order_create_' ~ policy.id) }}"><button class="btn btn-sm btn-light">{{ policy.code }} auslösen</button></form>{% endfor %}</div></div>{% endif %}<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Regel</th><th>Artikel</th><th>Route</th><th>Menge</th><th>Status</th><th></th></tr></thead><tbody>{% for order in workspace.replenishments %}<tr><td>{{ order.policy_code }}</td><td>{{ order.sku }}</td><td>{{ order.source_code }} → {{ order.target_code }}</td><td>{{ order.quantity }}</td><td>{{ order.status }}</td><td>{% if order.status == 'open' and is_granted('fulfillment.replenishment.execute') %}<form method="post" action="{{ path('v3_internal_transport_replenishment_complete', {orderId: order.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_replenishment_complete_' ~ order.id) }}"><button class="btn btn-sm btn-success">Quittieren</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-muted text-center py-3">Keine Nachschubaufträge.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
