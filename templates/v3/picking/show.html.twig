{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
		<div>
			<a href="{{ path('v3_picking_index') }}" class="text-decoration-none">{{ 'picking.show.picking'|trans }}</a>
			<h1 class="h3 mt-2 mb-1">{{ pickList.code }}</h1>
			<p class="text-muted mb-0">{{ 'inbound.control.order'|trans }} {{ pickList.order_number }}</p>
		</div>
		<span class="badge bg-secondary align-self-start fs-6">{{ pickList.status }}</span>
	</div>

	{% if not pickList.assigned_to and is_granted('fulfillment.pick.assign') %}
		<form method="post" action="{{ path('v3_picking_assign', {pickListId: pickList.id}) }}" class="mb-4">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_pick_assign_' ~ pickList.id) }}">
			<button class="btn btn-primary">{{ 'picking.show.assign_to_me_and_start'|trans }}</button>
		</form>
	{% endif %}
	{% if pickList.status in ['open', 'assigned'] and is_granted('fulfillment.pick.optimize') %}<form method="post" action="{{ path('v3_picking_optimize', {pickListId: pickList.id}) }}" class="mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_optimize_' ~ pickList.id) }}"><button class="btn btn-outline-primary">{{ 'picking.show.optimize_route_based_on_warehouse_layout'|trans }}</button></form>{% endif %}

	<div class="row g-3">
		{% for task in pickList.tasks %}
			<div class="col-12">
				<div class="card border-0 shadow-sm {% if task.status != 'open' %}border-start border-success border-4{% endif %}">
					<div class="card-body">
						<div class="row align-items-center g-3">
							<div class="col-md-2">
								<div class="display-6">{{ task.sequence_number }}</div>
							</div>
							<div class="col-md-4">
								<small class="text-muted">{{ 'modal.show_article_stock_details_modal.storage_bin'|trans }}</small>
								<div class="h4 mb-1">{{ task.location_code }}</div>
								<div>{{ task.sku }}</div>
							</div>
							<div class="col-md-2">
								<small class="text-muted">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</small>
								<div class="h3">{{ task.quantity }}</div>
							</div>
							<div class="col-md-4">
								{% if task.status != 'open' %}
									<span class="badge bg-success">{{ task.status }}</span>
								{% elseif pickList.assigned_to == app.user.actorId and is_granted('fulfillment.pick.execute') %}
									<form method="post" action="{{ path('v3_picking_scan', {pickListId: pickList.id, taskId: task.id}) }}">
										<input type="hidden" name="_token" value="{{ csrf_token('v3_pick_scan_' ~ task.id) }}">
										<div class="row g-2"><div class="col-6"><input class="form-control" name="location" value="{{ task.location_code }}" placeholder="{{ 'picking.show.scan_storage_location'|trans }}" required autofocus></div><div class="col-6"><input class="form-control" name="product" value="{{ task.sku }}" placeholder="{{ 'picking.show.scan_item'|trans }}" required></div>{% if task.batch_number %}<div class="col-6"><input class="form-control" name="batch" placeholder="Charge {{ task.batch_number }}" required></div>{% endif %}{% if task.serial_number %}<div class="col-6"><input class="form-control" name="serial" placeholder="{{ 'inbound.new.serial_number'|trans }}" required></div>{% endif %}<div class="col-4"><input class="form-control" type="number" name="quantity" value="{{ task.quantity }}" min="1" required></div><div class="col-8"><button class="btn btn-success w-100">{{ 'picking.show.scan_to_pick_and_amp'|trans }}</button></div></div>
									</form>
									<form method="post" action="{{ path('v3_picking_confirm', {pickListId: pickList.id, taskId: task.id}) }}" class="mt-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_confirm_' ~ task.id) }}"><input type="hidden" name="note" value="Fehlbestand per MDE"><button class="btn btn-sm btn-outline-danger" name="outcome" value="shortage">{{ 'picking.show.report_stock_shortage'|trans }}</button></form>
								{% else %}
									<span class="text-muted">{{ 'picking.show.assign_pick_list_to_yourself_first'|trans }}</span>
								{% endif %}
							</div>
						</div>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

	{% if pickList.packing_order_id %}
		<div class="mt-4">
			<a class="btn btn-primary" href="{{ path('v3_packing_show', {packingOrderId: pickList.packing_order_id}) }}">
				{{ 'picking.show.packing_order'|trans }} {{ pickList.packing_order_code }} {{ 'outbound.order.open'|trans }}
			</a>
		</div>
	{% elseif pickList.status == 'completed' and is_granted('fulfillment.pack.write') %}
		<div class="card border-0 shadow-sm mt-4">
			<div class="card-body">
				<h2 class="h5">{{ 'picking.show.hand_over_to_packing_station'|trans }}</h2>
				<form class="d-flex gap-2" method="post" action="{{ path('v3_packing_create', {pickListId: pickList.id}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('v3_packing_create_' ~ pickList.id) }}">
					<input class="form-control" name="code" value="PACK-{{ pickList.code }}" required>
					<button class="btn btn-primary text-nowrap">{{ 'picking.show.create_packing_order'|trans }}</button>
				</form>
			</div>
		</div>
	{% endif %}
{% endblock %}
