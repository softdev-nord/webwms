{% extends 'v3/base.html.twig' %}
{% block title %}Picking | WebWMS 3.0{% endblock %}
{% block body %}
<div class="mb-4"><h1 class="h3 mb-1">Picking</h1><p class="text-muted mb-0">Picklisten zuweisen und mobil bearbeiten</p></div>
<div class="row g-3">{% for list in pickLists %}<div class="col-md-6 col-xl-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">{{ list.code }}</h2><span class="badge bg-secondary-subtle text-secondary">{{ list.status }}</span></div><p class="mb-2">Auftrag {{ list.order_number }}</p><div class="text-muted">{{ list.completed_task_count }}/{{ list.task_count }} Positionen erledigt</div><div class="text-muted">{{ list.assigned_to_name ?: 'Nicht zugewiesen' }}</div></div><div class="card-footer bg-white"><a class="btn btn-primary w-100" href="{{ path('v3_picking_show', {pickListId: list.id}) }}">Pickliste öffnen</a></div></div></div>{% else %}<div class="col-12"><div class="alert alert-light border">Noch keine Picklisten vorhanden.</div></div>{% endfor %}</div>
{% endblock %}
