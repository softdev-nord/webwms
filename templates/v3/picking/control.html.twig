{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.picking.control.kommissionierleitstand'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.picking.control.single.und.multi.order.picks.planen.bundeln.und.uberwac'|trans }}</p></div></div>
	{% if is_granted('fulfillment.pick.wave.write') %}<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.picking.control.pickwelle.planen'|trans }}</h2></div><div class="card-body"><form method="post" action="{{ path('v3_picking_control_wave_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_wave_create') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-md-3"><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung'|trans }}" required></div><div class="col-md-2"><select class="form-select" name="strategy"><option value="single_order">{{ 'ui.v3.picking.control.single.order'|trans }}</option><option value="multi_order">{{ 'ui.v3.picking.control.multi.order'|trans }}</option><option value="two_stage">{{ 'ui.v3.picking.control.zweistufig'|trans }}</option></select></div><div class="col-md-2"><select class="form-select" name="selection_type"><option value="manual">{{ 'ui.v3.integration.automation.command-new.manuell'|trans }}</option><option value="time">{{ 'ui.v3.picking.control.zeit'|trans }}</option><option value="tour">{{ 'ui.v3.loading.index.tour'|trans }}</option><option value="carrier">{{ 'ui.v3.administration.workspace.carrier'|trans }}</option><option value="priority">{{ 'ui.v3.inventory.configuration_form.prioritat'|trans }}</option></select></div><div class="col-md-2"><input class="form-control" name="selection_value" placeholder="{{ 'ui.v3.picking.control.filterwert'|trans }}"></div><div class="col-md-1"><input class="form-control" type="number" name="priority" value="50" min="1" max="999"></div><div class="col-md-4"><input class="form-control" type="datetime-local" name="planned_start_at"></div><div class="col-md-8"><select class="form-select" name="pick_list_ids[]" multiple size="5" required>{% for list in workspace.availablePickLists %}<option value="{{ list.id }}">{{ list.code }} {{ 'ui.v3.picking.control.auftrag'|trans }} {{ list.order_number }}</option>{% endfor %}</select></div><div class="col-12"><button class="btn btn-primary">{{ 'ui.v3.picking.control.welle.planen'|trans }}</button></div></form></div></div>{% endif %}
	<div class="row g-3 mb-4">{% for wave in workspace.waves %}<div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">{{ wave.code }}</h2><span class="badge bg-{{ wave.status == 'released' ? 'success' : (wave.status == 'completed' ? 'primary' : 'secondary') }}-subtle text-body">{{ wave.status }}</span></div><p class="mb-2">{{ wave.name }}</p><div class="text-muted">{{ wave.strategy }} · {{ wave.order_count }} {{ 'ui.v3.picking.control.auftrage'|trans }} {{ wave.pick_list_count }} {{ 'ui.v3.picking.control.picklisten'|trans }}</div><div class="progress mt-3" style="height: 6px"><div class="progress-bar" style="width: {{ wave.pick_list_count > 0 ? (wave.completed_pick_lists / wave.pick_list_count * 100)|round : 0 }}%"></div></div></div>{% if wave.status == 'planned' and is_granted('fulfillment.pick.wave.write') %}<div class="card-footer"><form method="post" action="{{ path('v3_picking_control_wave_release', {waveId: wave.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_wave_release_' ~ wave.id) }}"><button class="btn btn-primary w-100">{{ 'ui.v3.picking.control.welle.freigeben'|trans }}</button></form></div>{% endif %}</div></div>{% else %}<div class="col-12"><div class="alert alert-light border">{{ 'ui.v3.picking.control.noch.keine.pickwellen.vorhanden'|trans }}</div></div>{% endfor %}</div>
	<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.picking.control.live.leitstand'|trans }}</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'ui.v3.outbound.control.pickliste'|trans }}</th><th>{{ 'ui.v3.inbound.control.auftrag'|trans }}</th><th>{{ 'ui.v3.picking.control.welle.behalter'|trans }}</th><th>{{ 'ui.v3.picking.control.mitarbeiter'|trans }}</th><th>{{ 'ui.v3.inbound.control.fortschritt'|trans }}</th><th>{{ 'ui.v3.picking.control.storungen'|trans }}</th><th></th></tr></thead><tbody>{% for pick in workspace.controlTower %}<tr><td><strong>{{ pick.code }}</strong><div class="small text-muted">{{ pick.status }}</div></td><td>{{ pick.order_number }}</td><td>{{ pick.wave_code ?: ('ui.v3.picking.control.choice.einzelauftrag'|trans) }}<div class="small text-muted">{{ pick.container_code ?: '–' }}</div></td><td>{{ pick.assigned_to_name ?: ('ui.v3.platform.index.nicht.zugewiesen'|trans) }}</td><td>{{ pick.task_count - pick.open_task_count }}/{{ pick.task_count }}</td><td><span class="badge bg-{{ pick.shortage_count > 0 ? 'danger' : 'success' }}-subtle text-{{ pick.shortage_count > 0 ? 'danger' : 'success' }}">{{ pick.shortage_count }}</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_picking_show', {pickListId: pick.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a>{% if pick.wave_strategy == 'two_stage' and pick.wave_status == 'released' and pick.status == 'completed' and pick.consolidation_status == 'pending' %}<form method="post" action="{{ path('v3_picking_control_consolidate', {waveId: pick.wave_id, pickListId: pick.id}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_consolidate_' ~ pick.wave_id ~ '_' ~ pick.id) }}"><button class="btn btn-sm btn-outline-success" type="submit">{{ 'ui.v3.picking.control.konsolidieren'|trans }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
