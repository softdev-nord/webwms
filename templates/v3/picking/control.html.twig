{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h3 mb-1">Kommissionierleitstand</h1><p class="text-muted mb-0">Single- und Multi-Order-Picks planen, bündeln und überwachen.</p></div></div>
	{% if is_granted('fulfillment.pick.wave.write') %}<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Pickwelle planen</h2></div><div class="card-body"><form method="post" action="{{ path('v3_picking_control_wave_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_wave_create') }}"><div class="col-md-2"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-md-3"><input class="form-control" name="name" placeholder="Bezeichnung" required></div><div class="col-md-2"><select class="form-select" name="strategy"><option value="single_order">Single Order</option><option value="multi_order">Multi Order</option><option value="two_stage">Zweistufig</option></select></div><div class="col-md-2"><select class="form-select" name="selection_type"><option value="manual">Manuell</option><option value="time">Zeit</option><option value="tour">Tour</option><option value="carrier">Carrier</option><option value="priority">Priorität</option></select></div><div class="col-md-2"><input class="form-control" name="selection_value" placeholder="Filterwert"></div><div class="col-md-1"><input class="form-control" type="number" name="priority" value="50" min="1" max="999"></div><div class="col-md-4"><input class="form-control" type="datetime-local" name="planned_start_at"></div><div class="col-md-8"><select class="form-select" name="pick_list_ids[]" multiple size="5" required>{% for list in workspace.availablePickLists %}<option value="{{ list.id }}">{{ list.code }} · Auftrag {{ list.order_number }}</option>{% endfor %}</select></div><div class="col-12"><button class="btn btn-primary">Welle planen</button></div></form></div></div>{% endif %}
	<div class="row g-3 mb-4">{% for wave in workspace.waves %}<div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">{{ wave.code }}</h2><span class="badge bg-{{ wave.status == 'released' ? 'success' : (wave.status == 'completed' ? 'primary' : 'secondary') }}-subtle text-body">{{ wave.status }}</span></div><p class="mb-2">{{ wave.name }}</p><div class="text-muted">{{ wave.strategy }} · {{ wave.order_count }} Aufträge · {{ wave.pick_list_count }} Picklisten</div><div class="progress mt-3" style="height: 6px"><div class="progress-bar" style="width: {{ wave.pick_list_count > 0 ? (wave.completed_pick_lists / wave.pick_list_count * 100)|round : 0 }}%"></div></div></div>{% if wave.status == 'planned' and is_granted('fulfillment.pick.wave.write') %}<div class="card-footer"><form method="post" action="{{ path('v3_picking_control_wave_release', {waveId: wave.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_wave_release_' ~ wave.id) }}"><button class="btn btn-primary w-100">Welle freigeben</button></form></div>{% endif %}</div></div>{% else %}<div class="col-12"><div class="alert alert-light border">Noch keine Pickwellen vorhanden.</div></div>{% endfor %}</div>
	<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Live-Leitstand</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Pickliste</th><th>Auftrag</th><th>Welle / Behälter</th><th>Mitarbeiter</th><th>Fortschritt</th><th>Störungen</th><th></th></tr></thead><tbody>{% for pick in workspace.controlTower %}<tr><td><strong>{{ pick.code }}</strong><div class="small text-muted">{{ pick.status }}</div></td><td>{{ pick.order_number }}</td><td>{{ pick.wave_code ?: 'Einzelauftrag' }}<div class="small text-muted">{{ pick.container_code ?: '–' }}</div></td><td>{{ pick.assigned_to_name ?: 'Nicht zugewiesen' }}</td><td>{{ pick.task_count - pick.open_task_count }}/{{ pick.task_count }}</td><td><span class="badge bg-{{ pick.shortage_count > 0 ? 'danger' : 'success' }}-subtle text-{{ pick.shortage_count > 0 ? 'danger' : 'success' }}">{{ pick.shortage_count }}</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_picking_show', {pickListId: pick.id}) }}">Öffnen</a>{% if pick.wave_strategy == 'two_stage' and pick.wave_status == 'released' and pick.status == 'completed' and pick.consolidation_status == 'pending' %}<form method="post" action="{{ path('v3_picking_control_consolidate', {waveId: pick.wave_id, pickListId: pick.id}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('v3_pick_consolidate_' ~ pick.wave_id ~ '_' ~ pick.id) }}"><button class="btn btn-sm btn-outline-success" type="submit">Konsolidieren</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
