{% extends 'v3/base.html.twig' %}
{% block title %}Bewegungshistorie | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h3 mb-1">Bewegungshistorie</h1><p class="text-muted mb-0">Unveränderliches Journal aller Lagerbewegungen</p></div><form method="get" class="row g-2 align-items-end"><div class="col-auto"><label class="form-label small">Artikel</label><select class="form-select" name="product"><option value="">Alle</option>{% for product in products %}<option value="{{ product.id }}" {{ filters.product == product.id ? 'selected' : '' }}>{{ product.sku }}</option>{% endfor %}</select></div><div class="col-auto"><label class="form-label small">Lagerplatz</label><select class="form-select" name="location"><option value="">Alle</option>{% for location in locations %}<option value="{{ location.id }}" {{ filters.location == location.id ? 'selected' : '' }}>{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-auto"><label class="form-label small">Bewegung</label><input class="form-control" name="movement_type" value="{{ filters.movement_type }}" placeholder="z. B. inbound_receipt"></div><div class="col-auto"><button class="btn btn-primary">Filtern</button></div></form></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Zeitpunkt</th><th>Artikel</th><th>Lagerplatz</th><th>Bewegung</th><th>Status / Dimension</th><th>Grund</th><th>Benutzer</th><th class="text-end">Änderung</th><th class="text-end">Bestand</th></tr></thead><tbody>{% for movement in movements %}<tr><td class="text-nowrap">{{ movement.occurred_at|date('d.m.Y H:i:s') }}</td><td><strong>{{ movement.sku }}</strong></td><td>{{ movement.location_code }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ movement.movement_type }}</span></td><td>{{ movement.stock_status }}{% if movement.batch_number %}<div class="small text-muted">Charge {{ movement.batch_number }}</div>{% endif %}{% if movement.serial_number %}<div class="small text-muted">SN {{ movement.serial_number }}</div>{% endif %}</td><td>{{ movement.reason }}</td><td>{{ movement.performed_by_name }}</td><td class="text-end {{ movement.quantity_delta >= 0 ? 'text-success' : 'text-danger' }}">{{ movement.quantity_delta > 0 ? '+' : '' }}{{ movement.quantity_delta }}</td><td class="text-end fw-semibold">{{ movement.resulting_quantity }}</td></tr>{% else %}<tr><td colspan="9" class="text-center text-muted py-5">Keine Bewegungen für diesen Filter vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
