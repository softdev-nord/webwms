{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms.5de7112'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.movements.bewegungshistorie.dd7b58d'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.movements.unveranderliches.journal.aller.lagerbewegungen.255f6e5'|trans }}</p></div><form method="get" class="row g-2 align-items-end"><div class="col-auto"><label class="form-label small">{{ 'nav.master_data.submenu.headline1'|trans }}</label><select class="form-select" name="product"><option value="">{{ 'ui.v3.inventory.movements.alle.4c7a986'|trans }}</option>{% for product in products %}<option value="{{ product.id }}" {{ filters.product == product.id ? 'selected' : '' }}>{{ product.sku }}</option>{% endfor %}</select></div><div class="col-auto"><label class="form-label small">{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</label><select class="form-select" name="location"><option value="">{{ 'ui.v3.inventory.movements.alle.4c7a986'|trans }}</option>{% for location in locations %}<option value="{{ location.id }}" {{ filters.location == location.id ? 'selected' : '' }}>{{ location.warehouse_code }} · {{ location.code }}</option>{% endfor %}</select></div><div class="col-auto"><label class="form-label small">{{ 'ui.v3.inventory.movements.bewegung.2f02389'|trans }}</label><input class="form-control" name="movement_type" value="{{ filters.movement_type }}" placeholder="{{ 'ui.v3.inventory.movements.z.b.inbound.receipt.a336dd3'|trans }}"></div><div class="col-auto"><button class="btn btn-primary">{{ 'ui.v3.integration.outbox.index.filtern.bfc80a7'|trans }}</button></div></form></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</th><th>{{ 'ui.v3.inventory.movements.bewegung.2f02389'|trans }}</th><th>{{ 'ui.v3.inventory.movements.status.dimension.dc6abd2'|trans }}</th><th>{{ 'ui.v3.inventory.movements.grund.aaa19ad'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th><th class="text-end">{{ 'ui.v3.inventory.movements.anderung.4bfa056'|trans }}</th><th class="text-end">{{ 'ui.article.index.bestand.6e8cf3e'|trans }}</th></tr></thead><tbody>{% for movement in movements %}<tr><td class="text-nowrap">{{ movement.occurred_at|date('d.m.Y H:i:s') }}</td><td><strong>{{ movement.sku }}</strong></td><td>{{ movement.location_code }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ movement.movement_type }}</span></td><td>{{ movement.stock_status }}{% if movement.batch_number %}<div class="small text-muted">{{ 'ui.modal.stock_in_modal.charge.d4e1aee'|trans }} {{ movement.batch_number }}</div>{% endif %}{% if movement.serial_number %}<div class="small text-muted">{{ 'ui.v3.inventory.movements.sn.c9d50d9'|trans }} {{ movement.serial_number }}</div>{% endif %}</td><td>{{ movement.reason }}</td><td>{{ movement.performed_by_name }}</td><td class="text-end {{ movement.quantity_delta >= 0 ? 'text-success' : 'text-danger' }}">{{ movement.quantity_delta > 0 ? '+' : '' }}{{ movement.quantity_delta }}</td><td class="text-end fw-semibold">{{ movement.resulting_quantity }}</td></tr>{% else %}<tr><td colspan="9" class="text-center text-muted py-5">{{ 'ui.v3.inventory.movements.keine.bewegungen.fur.diesen.filter.vorhanden.1546e5e'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
