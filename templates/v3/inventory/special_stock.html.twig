{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.special_stock.sonderbestande'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.special_stock.bestande.nach.eigentum.status.oder.sonderart.kennzeichn'|trans }}</p></div>{% if is_granted('inventory.special_stock.write') %}<a class="btn btn-primary" href="{{ path('v3_inventory_special_stock_type_new') }}"><i class="ri-add-line me-1"></i>{{ 'ui.v3.inventory.special_stock.kennzeichen.anlegen'|trans }}</a>{% endif %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.special_stock.sonderbestandskennzeichen'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'ui.article.index.bezeichnung'|trans }}</th><th>{{ 'ui.v3.inventory.configuration_form.art'|trans }}</th><th>{{ 'ui.v3.inventory.configuration_form.allokierbar'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen'|trans }}</th></tr></thead><tbody>{% for type in types %}<tr><td><strong>{{ type.code }}</strong></td><td>{{ type.name }}</td><td>{{ type.classification_kind }}</td><td>{{ (type.allocatable ? 'ui.v3.inventory.special_stock.choice.ja' : 'ui.v3.inventory.special_stock.choice.nein')|trans }}</td><td><span class="badge bg-{{ type.active ? 'success':'secondary' }}-subtle text-{{ type.active ? 'success':'secondary' }}">{{ (type.active ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</span></td><td class="text-end">{% if is_granted('inventory.special_stock.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_special_stock_type_edit',{typeId:type.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.inventory.special_stock.keine.kennzeichen.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.special_stock.bestande'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.article.index.bestand'|trans }}</th><th>{{ 'ui.v3.inventory.special_stock.dimension'|trans }}</th><th>{{ 'ui.v3.inventory.special_stock.kennzeichen'|trans }}</th><th>{{ 'ui.v3.inventory.special_stock.eigentumer'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen'|trans }}</th></tr></thead><tbody>{% for row in stock %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }} · {{ row.quantity }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small">{{ 'ui.modal.stock_in_modal.charge'|trans }} {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small">{{ 'ui.v3.inventory.movements.sn'|trans }} {{ row.serial_number }}</div>{% endif %}</td><td>{% if row.special_stock_code %}<span class="badge bg-info-subtle text-info">{{ row.special_stock_code }}</span><div class="small text-muted">{{ row.special_stock_name }}</div>{% else %}–{% endif %}</td><td>{{ row.owner_reference ?: '–' }}</td><td class="text-end">{% if is_granted('inventory.special_stock.write') and types is not empty %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_special_stock_classify_form',{product:row.product_id,location:row.location_id,stock_key:row.stock_key}) }}"><i class="ri-pencil-line me-1"></i>{{ 'ui.v3.inventory.control.klassifizieren'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-5">{{ 'ui.v3.inventory.special_stock.kein.bestand.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
