{% extends 'v3/base.html.twig' %}
{% block title %}Sonderbestände | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">Sonderbestände</h1><p class="text-muted mb-0">Bestände nach Eigentum, Status oder Sonderart kennzeichnen</p></div>
{% if is_granted('inventory.special_stock.write') %}<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Kennzeichen anlegen</h2><form method="post" action="{{ path('v3_inventory_special_stock_type_create') }}" class="row g-2 align-items-end"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_special_stock_type_create') }}"><div class="col-md-2"><label class="form-label">Code</label><input class="form-control" name="code" required></div><div class="col-md-4"><label class="form-label">Bezeichnung</label><input class="form-control" name="name" required></div><div class="col-md-3"><label class="form-label">Art</label><select class="form-select" name="classification_kind"><option value="owner">Eigentum</option><option value="status">Status</option><option value="special">Sonderart</option></select></div><div class="col-md-2"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="allocatable" value="1" id="allocatable"><label class="form-check-label" for="allocatable">Allokierbar</label></div></div><div class="col-md-1"><button class="btn btn-primary">Speichern</button></div></form></div></div>{% endif %}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Artikel</th><th>Bestand</th><th>Dimension</th><th>Kennzeichen</th><th>Eigentümer</th><th>Grund / Aktion</th></tr></thead><tbody>{% for row in stock %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }} · {{ row.quantity }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small">Charge {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small">SN {{ row.serial_number }}</div>{% endif %}</td><td>{% if row.special_stock_code %}<span class="badge bg-info-subtle text-info">{{ row.special_stock_code }}</span><div class="small text-muted">{{ row.special_stock_name }}</div>{% else %}–{% endif %}</td><td>{{ row.owner_reference ?: '–' }}</td><td>{% if is_granted('inventory.special_stock.write') and types is not empty %}<form method="post" action="{{ path('v3_inventory_special_stock_classify') }}" class="row g-1"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_special_stock_classify') }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="location_id" value="{{ row.location_id }}"><input type="hidden" name="stock_key" value="{{ row.stock_key }}"><div class="col-4"><select class="form-select form-select-sm" name="special_stock_type_id" required>{% for type in types %}<option value="{{ type.id }}" {{ type.id == row.special_stock_type_id ? 'selected' : '' }}>{{ type.code }}</option>{% endfor %}</select></div><div class="col-4"><input class="form-control form-control-sm" name="owner_reference" value="{{ row.owner_reference }}" placeholder="Eigentümer"></div><div class="col-4"><input class="form-control form-control-sm" name="reason" value="{{ row.classification_reason }}" placeholder="Grund" required></div><div class="col-12"><button class="btn btn-sm btn-outline-primary">Klassifizieren</button></div></form>{% else %}{{ row.classification_reason ?: '–' }}{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-5">Kein Bestand vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
