{% extends 'v3/base.html.twig' %}
{% block title %}Sonderbestände | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Sonderbestände</h1><p class="text-muted mb-0">Bestände nach Eigentum, Status oder Sonderart kennzeichnen</p></div>{% if is_granted('inventory.special_stock.write') %}<a class="btn btn-primary" href="{{ path('v3_inventory_special_stock_type_new') }}"><i class="ri-add-line me-1"></i>Kennzeichen anlegen</a>{% endif %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Sonderbestandskennzeichen</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Bezeichnung</th><th>Art</th><th>Allokierbar</th><th>Status</th><th class="text-end" data-orderable="false" data-searchable="false">Aktionen</th></tr></thead><tbody>{% for type in types %}<tr><td><strong>{{ type.code }}</strong></td><td>{{ type.name }}</td><td>{{ type.classification_kind }}</td><td>{{ type.allocatable ? 'Ja':'Nein' }}</td><td><span class="badge bg-{{ type.active ? 'success':'secondary' }}-subtle text-{{ type.active ? 'success':'secondary' }}">{{ type.active ? 'Aktiv':'Inaktiv' }}</span></td><td class="text-end">{% if is_granted('inventory.special_stock.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_special_stock_type_edit',{typeId:type.id}) }}"><i class="ri-pencil-line me-1"></i>Bearbeiten</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">Keine Kennzeichen vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Bestände</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Artikel</th><th>Bestand</th><th>Dimension</th><th>Kennzeichen</th><th>Eigentümer</th><th class="text-end" data-orderable="false" data-searchable="false">Aktionen</th></tr></thead><tbody>{% for row in stock %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }} · {{ row.quantity }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small">Charge {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small">SN {{ row.serial_number }}</div>{% endif %}</td><td>{% if row.special_stock_code %}<span class="badge bg-info-subtle text-info">{{ row.special_stock_code }}</span><div class="small text-muted">{{ row.special_stock_name }}</div>{% else %}–{% endif %}</td><td>{{ row.owner_reference ?: '–' }}</td><td class="text-end">{% if is_granted('inventory.special_stock.write') and types is not empty %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_special_stock_classify_form',{product:row.product_id,location:row.location_id,stock_key:row.stock_key}) }}"><i class="ri-pencil-line me-1"></i>Klassifizieren</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-5">Kein Bestand vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
