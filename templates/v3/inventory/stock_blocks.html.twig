{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3 mb-1">Bestandssperren</h1><p class="text-muted mb-0">Bestand begründet sperren, unabhängig prüfen und kontrolliert freigeben.</p></div></div>

	<div class="row g-4 mb-4">
		<div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Sperrgrund anlegen</h2></div><div class="card-body">
			<form method="post" action="{{ path('v3_inventory_stock_block_reason_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_reason_create') }}"><div class="col-4"><label class="form-label">Code</label><input class="form-control" name="code" maxlength="30" required></div><div class="col-8"><label class="form-label">Name</label><input class="form-control" name="name" maxlength="100" required></div><div class="col-12"><label class="form-label">Beschreibung</label><textarea class="form-control" name="description" maxlength="255" rows="2"></textarea></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="active" value="1" id="block-reason-active" checked><label class="form-check-label" for="block-reason-active">Aktiv</label></div></div><div class="col-12"><button class="btn btn-primary w-100">Sperrgrund speichern</button></div></form>
		</div></div></div>
		<div class="col-xl-8"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">Sperrgründe</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Name</th><th>Beschreibung</th><th>Status</th></tr></thead><tbody>{% for reason in reasons %}<tr><td><strong>{{ reason.code }}</strong></td><td>{{ reason.name }}</td><td>{{ reason.description ?: '–' }}</td><td>{% if reason.active %}<span class="badge bg-success-subtle text-success">Aktiv</span>{% else %}<span class="badge bg-secondary-subtle text-secondary">Inaktiv</span>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Noch keine Sperrgründe vorhanden.</td></tr>{% endfor %}</tbody></table></div></div></div>
	</div>

	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Bestand sperren</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Artikel</th><th>Lagerplatz</th><th>Dimension</th><th class="text-end">Menge</th><th>Sperre</th></tr></thead><tbody>
	{% for row in stock|filter(row => row.quantity > 0 and row.stock_status != 'blocked') %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small text-muted">Charge {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small text-muted">SN {{ row.serial_number }}</div>{% endif %}{% if row.expires_at %}<div class="small text-muted">MHD {{ row.expires_at|date('d.m.Y') }}</div>{% endif %}</td><td class="text-end">{{ row.quantity }}</td><td>{% if is_granted('inventory.stock_block.write') and reasons|filter(reason => reason.active)|length > 0 %}<form method="post" action="{{ path('v3_inventory_stock_block_create') }}" class="row g-1"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_create') }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="location_id" value="{{ row.location_id }}"><input type="hidden" name="stock_status" value="{{ row.stock_status }}"><input type="hidden" name="batch_number" value="{{ row.batch_number }}"><input type="hidden" name="serial_number" value="{{ row.serial_number }}"><input type="hidden" name="expires_at" value="{{ row.expires_at }}"><div class="col-md-4"><select class="form-select form-select-sm" name="reason_id" required>{% for reason in reasons|filter(reason => reason.active) %}<option value="{{ reason.id }}">{{ reason.code }}</option>{% endfor %}</select></div><div class="col-md-2"><input class="form-control form-control-sm" type="number" name="quantity" min="1" max="{{ row.serial_number ? 1 : row.quantity }}" value="{{ row.serial_number ? 1 : row.quantity }}" required></div><div class="col-md-4"><input class="form-control form-control-sm" name="note" maxlength="255" placeholder="Begründung" required></div><div class="col-md-2"><button class="btn btn-sm btn-danger w-100">Sperren</button></div></form>{% else %}<span class="text-muted">Kein aktiver Sperrgrund</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Kein sperrbarer Bestand vorhanden.</td></tr>{% endfor %}
	</tbody></table></div></div>

	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Sperrliste</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Status</th><th>Artikel</th><th>Grund</th><th>Bestand</th><th>Bearbeitung</th><th>Journal</th></tr></thead><tbody>
	{% for block in blocks %}<tr><td>{% if block.status == 'open' %}<span class="badge bg-warning-subtle text-warning">Offen</span>{% elseif block.status == 'reviewed' %}<span class="badge bg-info-subtle text-info">Geprüft</span>{% else %}<span class="badge bg-success-subtle text-success">Freigegeben</span>{% endif %}</td><td><strong>{{ block.sku }}</strong><div class="small text-muted">{{ block.location_code }} · {{ block.quantity }} Stk.</div></td><td>{{ block.reason_code }} · {{ block.reason_name }}<div class="small text-muted">{{ block.note }}</div></td><td>{{ block.original_status }} → blocked{% if block.batch_number %}<div class="small text-muted">Charge {{ block.batch_number }}</div>{% endif %}{% if block.serial_number %}<div class="small text-muted">SN {{ block.serial_number }}</div>{% endif %}</td><td>{% if block.status == 'open' and is_granted('inventory.stock_block.review') %}<form method="post" action="{{ path('v3_inventory_stock_block_review', {blockId: block.id}) }}" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_review_' ~ block.id) }}"><input class="form-control form-control-sm" name="note" maxlength="255" placeholder="Prüfergebnis" required><button class="btn btn-sm btn-outline-primary">Prüfen</button></form>{% elseif block.status == 'reviewed' and is_granted('inventory.stock_block.release') %}<form method="post" action="{{ path('v3_inventory_stock_block_release', {blockId: block.id}) }}" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_release_' ~ block.id) }}"><input class="form-control form-control-sm" name="note" maxlength="255" placeholder="Freigabevermerk" required><button class="btn btn-sm btn-success">Freigeben</button></form>{% else %}<span class="small text-muted">{{ block.review_note ?: 'Abgeschlossen' }}</span>{% endif %}</td><td><a class="btn btn-sm btn-outline-secondary" href="{{ path('v3_inventory_stock_blocks', {block: block.id}) }}">Öffnen</a></td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">Noch keine Bestandssperre vorhanden.</td></tr>{% endfor %}
	</tbody></table></div></div>

	{% if selectedBlock %}<div class="card border-primary shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Sperrjournal</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Zeitpunkt</th><th>Ereignis</th><th>Notiz</th><th>Benutzer</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.event_type }}</td><td>{{ event.note }}</td><td>{{ event.performed_by_name }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Kein Ereignis vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>{% endif %}
{% endblock %}
