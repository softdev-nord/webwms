{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.stock_blocks.bestandssperren.e66f121'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.stock_blocks.bestand.begrundet.sperren.unabhangig.prufen.und.kontrol.7410e8b'|trans }}</p></div></div>


	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.stock_block_new.bestand.sperren.12d93ab'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</th><th>{{ 'ui.v3.inventory.special_stock.dimension.45e147a'|trans }}</th><th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th><th>{{ 'ui.v3.inventory.stock_blocks.sperre.686602f'|trans }}</th></tr></thead><tbody>
	{% for row in stock|filter(row => row.quantity > 0 and row.stock_status != 'blocked') %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small text-muted">{{ 'ui.modal.stock_in_modal.charge.d4e1aee'|trans }} {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small text-muted">{{ 'ui.v3.inventory.movements.sn.c9d50d9'|trans }} {{ row.serial_number }}</div>{% endif %}{% if row.expires_at %}<div class="small text-muted">{{ 'ui.v3.inventory.stock_blocks.mhd.47a2b13'|trans }} {{ row.expires_at|date('d.m.Y') }}</div>{% endif %}</td><td class="text-end">{{ row.quantity }}</td><td>{% if is_granted('inventory.stock_block.write') and reasons|filter(reason => reason.active)|length > 0 %}<a class="btn btn-sm btn-outline-danger" href="{{ path('v3_inventory_stock_block_new', {product:row.product_id,location:row.location_id,stock_key:row.stock_key}) }}">{{ 'ui.v3.inbound.control.sperren.1210909'|trans }}</a>{% else %}<span class="text-muted">{{ 'ui.v3.inventory.stock_blocks.kein.aktiver.sperrgrund.2f8e4c1'|trans }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.stock_blocks.kein.sperrbarer.bestand.vorhanden.4411405'|trans }}</td></tr>{% endfor %}
	</tbody></table></div></div>

	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.stock_blocks.sperrliste.2f95de8'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inventory.movements.grund.aaa19ad'|trans }}</th><th>{{ 'ui.article.index.bestand.6e8cf3e'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen.445e0c4'|trans }}</th></tr></thead><tbody>
	{% for block in blocks %}<tr><td>{% if block.status == 'open' %}<span class="badge bg-warning-subtle text-warning">{{ 'ui.customer_order.index.offen.a28e235'|trans }}</span>{% elseif block.status == 'reviewed' %}<span class="badge bg-info-subtle text-info">{{ 'ui.v3.inventory.stock_blocks.gepruft.2031348'|trans }}</span>{% else %}<span class="badge bg-success-subtle text-success">{{ 'ui.v3.inventory.stock_blocks.freigegeben.6a9b360'|trans }}</span>{% endif %}</td><td><strong>{{ block.sku }}</strong><div class="small text-muted">{{ block.location_code }} · {{ block.quantity }} {{ 'ui.v3.inventory.stock_blocks.stk.78e7040'|trans }}</div></td><td>{{ block.reason_code }} · {{ block.reason_name }}<div class="small text-muted">{{ block.note }}</div></td><td>{{ block.original_status }} {{ 'ui.v3.inventory.stock_blocks.blocked.f7d9e75'|trans }}{% if block.batch_number %}<div class="small text-muted">{{ 'ui.modal.stock_in_modal.charge.d4e1aee'|trans }} {{ block.batch_number }}</div>{% endif %}{% if block.serial_number %}<div class="small text-muted">{{ 'ui.v3.inventory.movements.sn.c9d50d9'|trans }} {{ block.serial_number }}</div>{% endif %}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_stock_block_show', {blockId:block.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.stock_blocks.noch.keine.bestandssperre.vorhanden.af97970'|trans }}</td></tr>{% endfor %}
	</tbody></table></div></div>
{% endblock %}
