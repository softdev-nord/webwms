{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3 mb-1">Bestandssperren</h1><p class="text-muted mb-0">Bestand begründet sperren, unabhängig prüfen und kontrolliert freigeben.</p></div></div>


	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Bestand sperren</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Artikel</th><th>Lagerplatz</th><th>Dimension</th><th class="text-end">Menge</th><th>Sperre</th></tr></thead><tbody>
	{% for row in stock|filter(row => row.quantity > 0 and row.stock_status != 'blocked') %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small text-muted">Charge {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small text-muted">SN {{ row.serial_number }}</div>{% endif %}{% if row.expires_at %}<div class="small text-muted">MHD {{ row.expires_at|date('d.m.Y') }}</div>{% endif %}</td><td class="text-end">{{ row.quantity }}</td><td>{% if is_granted('inventory.stock_block.write') and reasons|filter(reason => reason.active)|length > 0 %}<a class="btn btn-sm btn-outline-danger" href="{{ path('v3_inventory_stock_block_new', {product:row.product_id,location:row.location_id,stock_key:row.stock_key}) }}">Sperren</a>{% else %}<span class="text-muted">Kein aktiver Sperrgrund</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Kein sperrbarer Bestand vorhanden.</td></tr>{% endfor %}
	</tbody></table></div></div>

	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Sperrliste</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Status</th><th>Artikel</th><th>Grund</th><th>Bestand</th><th class="text-end" data-orderable="false" data-searchable="false">Aktionen</th></tr></thead><tbody>
	{% for block in blocks %}<tr><td>{% if block.status == 'open' %}<span class="badge bg-warning-subtle text-warning">Offen</span>{% elseif block.status == 'reviewed' %}<span class="badge bg-info-subtle text-info">Geprüft</span>{% else %}<span class="badge bg-success-subtle text-success">Freigegeben</span>{% endif %}</td><td><strong>{{ block.sku }}</strong><div class="small text-muted">{{ block.location_code }} · {{ block.quantity }} Stk.</div></td><td>{{ block.reason_code }} · {{ block.reason_name }}<div class="small text-muted">{{ block.note }}</div></td><td>{{ block.original_status }} → blocked{% if block.batch_number %}<div class="small text-muted">Charge {{ block.batch_number }}</div>{% endif %}{% if block.serial_number %}<div class="small text-muted">SN {{ block.serial_number }}</div>{% endif %}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_stock_block_show', {blockId:block.id}) }}"><i class="ri-pencil-line me-1"></i>Bearbeiten</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Noch keine Bestandssperre vorhanden.</td></tr>{% endfor %}
	</tbody></table></div></div>
{% endblock %}
