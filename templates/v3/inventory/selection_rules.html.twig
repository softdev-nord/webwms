{% extends 'v3/base.html.twig' %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.selection_rules.entnahmestrategien.a2a42f2'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.selection_rules.fifo.lifo.und.fefo.fur.die.automatische.bestandsselekti.7163783'|trans }}</p></div>{% if is_granted('inventory.selection_rule.write') %}<a class="btn btn-primary" href="{{ path('v3_inventory_selection_rule_new') }}"><i class="ri-add-line me-1"></i>{{ 'ui.v3.inventory.selection_rules.regel.anlegen.5a4ccce'|trans }}</a>{% endif %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.selection_rules.konfigurierte.regeln.82e1f2e'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inventory.configuration_form.prioritat.c3ae74d'|trans }}</th><th>{{ 'ui.v3.inventory.selection_rules.regel.fe56804'|trans }}</th><th>{{ 'ui.v3.inventory.configuration_form.strategie.ebf1140'|trans }}</th><th>{{ 'ui.v3.inventory.selection_rules.geltungsbereich.af96fcf'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen.445e0c4'|trans }}</th></tr></thead><tbody>{% for rule in rules %}<tr><td>{{ rule.priority }}</td><td><strong>{{ rule.code }}</strong><div class="small text-muted">{{ rule.name }}</div></td><td><span class="badge bg-primary-subtle text-primary">{{ rule.strategy|upper }}</span></td><td>{{ rule.warehouse_code ?: ('ui.v3.inventory.configuration_form.alle.lager.69e4b56'|trans) }}<div class="small text-muted">{{ rule.product_sku ?: ('ui.v3.inventory.configuration_form.alle.artikel.ff1c698'|trans) }}</div></td><td>{% if rule.enabled %}<span class="badge bg-success-subtle text-success">{{ 'ui.user.user_input_fields.aktiv.16a766c'|trans }}</span>{% else %}<span class="badge bg-secondary-subtle text-secondary">{{ 'ui.v3.inventory.selection_rules.inaktiv.cd5be11'|trans }}</span>{% endif %}</td><td class="text-end">{% if is_granted('inventory.selection_rule.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_selection_rule_edit',{ruleId:rule.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.inventory.selection_rules.noch.keine.entnahmeregel.vorhanden.0df7134'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.selection_rules.ausfuhrungsjournal.3099a07'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th><th>{{ 'ui.v3.inventory.selection_rules.regel.fe56804'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inventory.selection_rules.reservierung.46f86ee'|trans }}</th><th>{{ 'ui.v3.extensions.index.ergebnis.5fe090c'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.rule_code }} · {{ event.strategy|upper }}</td><td>{{ event.sku }}</td><td><code>{{ event.reservation_id }}</code></td><td>{{ event.allocated_quantity }} / {{ event.requested_quantity }} {{ 'ui.v3.inventory.selection_rules.aus.ff0187b'|trans }} {{ event.candidate_count }} {{ 'ui.v3.inventory.selection_rules.kandidaten.82ce9c7'|trans }}</td><td>{{ event.performed_by_name }}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'ui.v3.inventory.selection_rules.noch.keine.automatische.selektion.ausgefuhrt.d13ba4b'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
