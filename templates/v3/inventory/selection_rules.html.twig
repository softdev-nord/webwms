{% extends 'v3/base.html.twig' %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Entnahmestrategien</h1><p class="text-muted mb-0">FIFO, LIFO und FEFO für die automatische Bestandsselektion konfigurieren.</p></div>{% if is_granted('inventory.selection_rule.write') %}<a class="btn btn-primary" href="{{ path('v3_inventory_selection_rule_new') }}"><i class="ri-add-line me-1"></i>Regel anlegen</a>{% endif %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Konfigurierte Regeln</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Priorität</th><th>Regel</th><th>Strategie</th><th>Geltungsbereich</th><th>Status</th><th class="text-end" data-orderable="false" data-searchable="false">Aktionen</th></tr></thead><tbody>{% for rule in rules %}<tr><td>{{ rule.priority }}</td><td><strong>{{ rule.code }}</strong><div class="small text-muted">{{ rule.name }}</div></td><td><span class="badge bg-primary-subtle text-primary">{{ rule.strategy|upper }}</span></td><td>{{ rule.warehouse_code ?: 'Alle Lager' }}<div class="small text-muted">{{ rule.product_sku ?: 'Alle Artikel' }}</div></td><td>{% if rule.enabled %}<span class="badge bg-success-subtle text-success">Aktiv</span>{% else %}<span class="badge bg-secondary-subtle text-secondary">Inaktiv</span>{% endif %}</td><td class="text-end">{% if is_granted('inventory.selection_rule.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_selection_rule_edit',{ruleId:rule.id}) }}"><i class="ri-pencil-line me-1"></i>Bearbeiten</a>{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">Noch keine Entnahmeregel vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Ausführungsjournal</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Zeitpunkt</th><th>Regel</th><th>Artikel</th><th>Reservierung</th><th>Ergebnis</th><th>Benutzer</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.rule_code }} · {{ event.strategy|upper }}</td><td>{{ event.sku }}</td><td><code>{{ event.reservation_id }}</code></td><td>{{ event.allocated_quantity }} / {{ event.requested_quantity }} aus {{ event.candidate_count }} Kandidaten</td><td>{{ event.performed_by_name }}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">Noch keine automatische Selektion ausgeführt.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
