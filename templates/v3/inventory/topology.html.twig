{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.topology.lagertopologie'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.topology.standorte.lager.bereiche.gange.und.lagerplatze.im.uberb'|trans }}</p></div>{% if is_granted('inventory.topology.write') %}<div class="dropdown"><button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown"><i class="ri-add-line me-1"></i>{{ 'ui.v3.administration.workspace.anlegen'|trans }}</button><div class="dropdown-menu dropdown-menu-end">{% for resource,label in {site:'ui.topology.site',warehouse:'ui.topology.warehouse',area:'ui.topology.area',aisle:'ui.topology.aisle',bin:'ui.topology.bin'} %}<a class="dropdown-item" href="{{ path('v3_inventory_topology_new',{resource:resource}) }}">{{ label|trans }}</a>{% endfor %}</div></div>{% endif %}</div>
<ul class="nav nav-tabs nav-tabs-custom mb-3">{% for tab in [{target:'sites',label:'ui.topology.sites',count:topology.sites|length},{target:'warehouses',label:'ui.topology.warehouse',count:topology.warehouses|length},{target:'areas',label:'ui.topology.areas',count:topology.areas|length},{target:'aisles',label:'ui.topology.aisles',count:topology.aisles|length},{target:'bins',label:'ui.topology.bins',count:topology.bins|length}] %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active':'' }}" data-bs-toggle="tab" data-bs-target="#topology-{{ tab.target }}">{{ tab.label|trans }} <span class="badge bg-light text-body ms-1">{{ tab.count }}</span></button></li>{% endfor %}</ul>
<div class="tab-content">
{% set definitions = {
sites:{resource:'site',headers:['Code','Name','ui.topology.header.timezone','ui.topology.header.status'],fields:['code','name','timezone','status']},
warehouses:{resource:'warehouse',headers:['ui.topology.site','Code','Name','ui.topology.header.type'],fields:['site_code','code','name','warehouse_type']},
areas:{resource:'area',headers:['ui.topology.header.warehouse_id','Code','Name','ui.topology.header.type'],fields:['warehouse_id','code','name','area_type']},
aisles:{resource:'aisle',headers:['ui.topology.header.area_id','Code','Name'],fields:['area_id','code','name']},
bins:{resource:'bin',headers:['ui.topology.warehouse','ui.topology.area','ui.topology.aisle','ui.topology.header.place','ui.topology.header.level_bin','ui.topology.header.type','ui.topology.header.capacity'],fields:['warehouse_id','area_id','aisle_id','code','level_code','location_type','capacity_quantity']}
} %}
{% for key,definition in definitions %}<div class="tab-pane fade {{ loop.first ? 'show active':'' }}" id="topology-{{ key }}"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr>{% for header in definition.headers %}<th>{{ header|trans }}</th>{% endfor %}<th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen'|trans }}</th></tr></thead><tbody>{% for row in attribute(topology,key) %}<tr>{% for field in definition.fields %}<td>{% if key == 'bins' and field == 'warehouse_id' %}{% for parent in topology.warehouses|filter(parent => parent.id == row.warehouse_id) %}{{ parent.site_code }} / {{ parent.code }}{% endfor %}{% elseif key == 'bins' and field == 'area_id' %}{% for parent in topology.areas|filter(parent => parent.id == row.area_id) %}{{ parent.code }}{% endfor %}{% elseif key == 'bins' and field == 'aisle_id' %}{% for parent in topology.aisles|filter(parent => parent.id == row.aisle_id) %}{{ parent.code }}{% endfor %}{% elseif key == 'bins' and field == 'level_code' %}{{ row.level_code|default('–') }} / {{ row.bin_code|default('–') }}{% elseif field == 'capacity_quantity' %}{{ attribute(row,field) == 0 ? 'ui.common.unlimited'|trans : attribute(row,field) }}{% else %}{{ attribute(row,field)|default('–') }}{% endif %}</td>{% endfor %}<td class="text-end">{% if is_granted('inventory.topology.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_topology_edit',{resource:definition.resource,id:row.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="{{ definition.headers|length + 1 }}" class="text-center text-muted py-5">{{ 'ui.v3.extensions.configuration_index.keine.eintrage.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div>{% endfor %}
</div>
{% endblock %}
