{% extends 'v3/base.html.twig' %}
{% block title %}Lagertopologie | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Lagertopologie</h1><p class="text-muted mb-0">Standorte, Lager, Bereiche, Gänge, Ebenen und Fächer</p></div></div>

{% if is_granted('inventory.topology.write') %}
<div class="row g-3 mb-4">
    <div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Standort anlegen</h2><form method="post" action="{{ path('v3_inventory_site_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_site_create') }}"><div class="row g-2"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-12"><input class="form-control" name="timezone" value="Europe/Berlin" required></div></div><button class="btn btn-primary btn-sm mt-2">Standort speichern</button></form></div></div></div>
    <div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Lager anlegen</h2><form method="post" action="{{ path('v3_inventory_warehouse_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_warehouse_create') }}"><select class="form-select mb-2" name="site_id" required><option value="">Standort</option>{% for site in topology.sites %}<option value="{{ site.id }}">{{ site.code }} · {{ site.name }}</option>{% endfor %}</select><div class="row g-2"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div></div><select class="form-select mt-2" name="warehouse_type"><option value="standard">Standard</option><option value="high_bay">Hochregal</option><option value="block">Blocklager</option><option value="automated">Automatisiert</option></select><button class="btn btn-primary btn-sm mt-2">Lager speichern</button></form></div></div></div>
    <div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Bereich anlegen</h2><form method="post" action="{{ path('v3_inventory_area_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_area_create') }}"><select class="form-select mb-2" name="warehouse_id" required><option value="">Lager</option>{% for warehouse in topology.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }} · {{ warehouse.name }}</option>{% endfor %}</select><div class="row g-2"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div></div><select class="form-select mt-2" name="area_type"><option value="storage">Lagerung</option><option value="receiving">Wareneingang</option><option value="shipping">Versand</option><option value="quality">QS</option><option value="blocked">Sperrlager</option></select><button class="btn btn-primary btn-sm mt-2">Bereich speichern</button></form></div></div></div>
    <div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Gang anlegen</h2><form method="post" action="{{ path('v3_inventory_aisle_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_aisle_create') }}"><select class="form-select mb-2" name="area_id" required><option value="">Bereich</option>{% for area in topology.areas %}<option value="{{ area.id }}">{{ area.code }} · {{ area.name }}</option>{% endfor %}</select><div class="row g-2"><div class="col-4"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-8"><input class="form-control" name="name" placeholder="Name" required></div></div><button class="btn btn-primary btn-sm mt-2">Gang speichern</button></form></div></div></div>
    <div class="col-xl-8"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Lagerplatz anlegen</h2><form method="post" action="{{ path('v3_inventory_bin_create') }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_bin_create') }}"><div class="row g-2"><div class="col-md-4"><select class="form-select" name="warehouse_id" required><option value="">Lager</option>{% for warehouse in topology.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select></div><div class="col-md-4"><select class="form-select" name="area_id" required><option value="">Bereich</option>{% for area in topology.areas %}<option value="{{ area.id }}">{{ area.code }}</option>{% endfor %}</select></div><div class="col-md-4"><select class="form-select" name="aisle_id" required><option value="">Gang</option>{% for aisle in topology.aisles %}<option value="{{ aisle.id }}">{{ aisle.code }}</option>{% endfor %}</select></div><div class="col-md-3"><input class="form-control" name="code" placeholder="Platzcode" required></div><div class="col-md-2"><input class="form-control" name="level_code" placeholder="Ebene" required></div><div class="col-md-2"><input class="form-control" name="bin_code" placeholder="Fach" required></div><div class="col-md-3"><select class="form-select" name="location_type"><option value="storage">Lagerung</option><option value="receiving">Wareneingang</option><option value="shipping">Versand</option><option value="quality">QS</option><option value="blocked">Sperrlager</option></select></div><div class="col-md-2"><input class="form-control" type="number" min="0" name="capacity_quantity" value="0" title="Kapazität"></div></div><button class="btn btn-primary btn-sm mt-2">Lagerplatz speichern</button></form></div></div></div>
</div>
{% endif %}

<div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Topologiestruktur</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Standort / Lager</th><th>Bereich</th><th>Gang</th><th>Ebene / Fach</th><th>Platz</th><th>Typ</th><th class="text-end">Kapazität</th></tr></thead><tbody>
{% for bin in topology.bins %}<tr><td>{% for warehouse in topology.warehouses %}{% if warehouse.id == bin.warehouse_id %}<strong>{{ warehouse.site_code }} / {{ warehouse.code }}</strong><div class="small text-muted">{{ warehouse.name }}</div>{% endif %}{% endfor %}</td><td>{% for area in topology.areas %}{% if area.id == bin.area_id %}{{ area.code }} · {{ area.name }}{% endif %}{% endfor %}</td><td>{% for aisle in topology.aisles %}{% if aisle.id == bin.aisle_id %}{{ aisle.code }} · {{ aisle.name }}{% endif %}{% endfor %}</td><td>{{ bin.level_code ?: '–' }} / {{ bin.bin_code ?: '–' }}</td><td><code>{{ bin.code }}</code></td><td>{{ bin.location_type }}</td><td class="text-end">{{ bin.capacity_quantity == 0 ? 'unbegrenzt' : bin.capacity_quantity }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-5">Noch keine Lagerplätze vorhanden.</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}
