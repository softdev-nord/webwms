{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms.5de7112'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.inventory.traceability.ruckverfolgung.60c2425'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.traceability.chargen.mindesthaltbarkeit.und.seriennummern.vom.eingan.0daac9e'|trans }}</p></div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.inventory.traceability.chargen.449bc33'|trans }}</div><div class="fs-3 fw-semibold">{{ traceability.batches|length }}</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.inventory.traceability.mhd.kritisch.abgelaufen.6333a53'|trans }}</div><div class="fs-3 fw-semibold text-warning">{{ traceability.expiries|filter(row => row.expiry_status != 'ok')|length }}</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.inventory.traceability.seriennummern.79a7b4d'|trans }}</div><div class="fs-3 fw-semibold">{{ traceability.serials|length }}</div></div></div></div>
</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.chargen.449bc33'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.stock_in_modal.charge.d4e1aee'|trans }}</th><th>{{ 'ui.v3.inventory.traceability.fruhestes.mhd.ab57b66'|trans }}</th><th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th><th class="text-end">{{ 'ui.v3.inventory.overview.platze.883203f'|trans }}</th></tr></thead><tbody>{% for row in traceability.batches %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td><a href="{{ path('v3_inventory_traceability', {dimension: 'batch', value: row.batch_number}) }}"><code>{{ row.batch_number }}</code></a></td><td>{{ row.earliest_expiry ? row.earliest_expiry|date('d.m.Y') : '–' }}</td><td class="text-end">{{ row.quantity }}</td><td class="text-end">{{ row.location_count }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.keine.chargen.vorhanden.69d1def'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.mhd.uberwachung.58e2202'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inventory.stock_blocks.mhd.47a2b13'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.stock_in_modal.charge.d4e1aee'|trans }}</th><th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th></tr></thead><tbody>{% for row in traceability.expiries %}<tr><td>{{ row.expires_at|date('d.m.Y') }}</td><td>{% if row.expiry_status == 'expired' %}<span class="badge bg-danger-subtle text-danger">{{ 'ui.v3.inventory.traceability.abgelaufen.d16b832'|trans }}</span>{% elseif row.expiry_status == 'critical' %}<span class="badge bg-warning-subtle text-warning">{{ 'ui.v3.inventory.traceability.kritisch.ab4215c'|trans }}</span>{% else %}<span class="badge bg-success-subtle text-success">{{ 'ui.v3.inventory.traceability.unauffallig.9a4432d'|trans }}</span>{% endif %}</td><td>{{ row.sku }} · {{ row.product_name }}</td><td>{{ row.batch_number ?: '–' }}</td><td class="text-end">{{ row.quantity }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.keine.mhd.bestande.vorhanden.dfa325b'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.seriennummern.79a7b4d'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inbound.new.seriennummer.22b6f6b'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th>{{ 'ui.v3.inventory.stock.aktualisiert.43dd026'|trans }}</th></tr></thead><tbody>{% for row in traceability.serials %}<tr><td><a href="{{ path('v3_inventory_traceability', {dimension: 'serial', value: row.serial_number}) }}"><code>{{ row.serial_number }}</code></a></td><td>{{ row.sku }} · {{ row.product_name }}</td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}</td><td>{{ row.updated_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.keine.seriennummern.vorhanden.8a37647'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% if selectedValue %}<div class="card border-primary shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.lebenslauf.0accac9'|trans }} {{ selectedValue }}</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt.e2f9e93'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.platz.6ea3f73'|trans }}</th><th>{{ 'ui.v3.inventory.movements.bewegung.2f02389'|trans }}</th><th>{{ 'ui.v3.inventory.movements.grund.aaa19ad'|trans }}</th><th class="text-end">{{ 'ui.v3.inventory.movements.anderung.4bfa056'|trans }}</th><th class="text-end">{{ 'ui.article.index.bestand.6e8cf3e'|trans }}</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.sku }}</td><td>{{ event.location_code }}</td><td>{{ event.movement_type }}</td><td>{{ event.reason }}<div class="small text-muted">{{ event.performed_by_name }}</div></td><td class="text-end">{{ event.quantity_delta }}</td><td class="text-end">{{ event.resulting_quantity }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.noch.keine.bewegungen.vorhanden.51a08f5'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% endif %}
{% endblock %}
