{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.inventory.traceability.ruckverfolgung'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.traceability.chargen.mindesthaltbarkeit.und.seriennummern.vom.eingan'|trans }}</p></div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.inventory.traceability.chargen'|trans }}</div><div class="fs-3 fw-semibold">{{ traceability.batches|length }}</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.inventory.traceability.mhd.kritisch.abgelaufen'|trans }}</div><div class="fs-3 fw-semibold text-warning">{{ traceability.expiries|filter(row => row.expiry_status != 'ok')|length }}</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">{{ 'ui.v3.inventory.traceability.seriennummern'|trans }}</div><div class="fs-3 fw-semibold">{{ traceability.serials|length }}</div></div></div></div>
</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.chargen'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.stock_in_modal.charge'|trans }}</th><th>{{ 'ui.v3.inventory.traceability.fruhestes.mhd'|trans }}</th><th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th><th class="text-end">{{ 'ui.v3.inventory.overview.platze'|trans }}</th></tr></thead><tbody>{% for row in traceability.batches %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td><a href="{{ path('v3_inventory_traceability', {dimension: 'batch', value: row.batch_number}) }}"><code>{{ row.batch_number }}</code></a></td><td>{{ row.earliest_expiry ? row.earliest_expiry|date('d.m.Y') : '–' }}</td><td class="text-end">{{ row.quantity }}</td><td class="text-end">{{ row.location_count }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.keine.chargen.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.mhd.uberwachung'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inventory.stock_blocks.mhd'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.stock_in_modal.charge'|trans }}</th><th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th></tr></thead><tbody>{% for row in traceability.expiries %}<tr><td>{{ row.expires_at|date('d.m.Y') }}</td><td>{% if row.expiry_status == 'expired' %}<span class="badge bg-danger-subtle text-danger">{{ 'ui.v3.inventory.traceability.abgelaufen'|trans }}</span>{% elseif row.expiry_status == 'critical' %}<span class="badge bg-warning-subtle text-warning">{{ 'ui.v3.inventory.traceability.kritisch'|trans }}</span>{% else %}<span class="badge bg-success-subtle text-success">{{ 'ui.v3.inventory.traceability.unauffallig'|trans }}</span>{% endif %}</td><td>{{ row.sku }} · {{ row.product_name }}</td><td>{{ row.batch_number ?: '–' }}</td><td class="text-end">{{ row.quantity }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.keine.mhd.bestande.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.seriennummern'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.inbound.new.seriennummer'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.modal.show_article_stock_details_modal.lagerplatz'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th>{{ 'ui.v3.inventory.stock.aktualisiert'|trans }}</th></tr></thead><tbody>{% for row in traceability.serials %}<tr><td><a href="{{ path('v3_inventory_traceability', {dimension: 'serial', value: row.serial_number}) }}"><code>{{ row.serial_number }}</code></a></td><td>{{ row.sku }} · {{ row.product_name }}</td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}</td><td>{{ row.updated_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.keine.seriennummern.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% if selectedValue %}<div class="card border-primary shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.traceability.lebenslauf'|trans }} {{ selectedValue }}</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inbound.control.platz'|trans }}</th><th>{{ 'ui.v3.inventory.movements.bewegung'|trans }}</th><th>{{ 'ui.v3.inventory.movements.grund'|trans }}</th><th class="text-end">{{ 'ui.v3.inventory.movements.anderung'|trans }}</th><th class="text-end">{{ 'ui.article.index.bestand'|trans }}</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.sku }}</td><td>{{ event.location_code }}</td><td>{{ event.movement_type }}</td><td>{{ event.reason }}<div class="small text-muted">{{ event.performed_by_name }}</div></td><td class="text-end">{{ event.quantity_delta }}</td><td class="text-end">{{ event.resulting_quantity }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">{{ 'ui.v3.inventory.traceability.noch.keine.bewegungen.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{% endif %}
{% endblock %}
