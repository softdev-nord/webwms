{% extends 'v3/base.html.twig' %}
{% block title %}Rückverfolgung | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">Rückverfolgung</h1><p class="text-muted mb-0">Chargen, Mindesthaltbarkeit und Seriennummern vom Eingang bis zum Ausgang</p></div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Chargen</div><div class="fs-3 fw-semibold">{{ traceability.batches|length }}</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">MHD-kritisch / abgelaufen</div><div class="fs-3 fw-semibold text-warning">{{ traceability.expiries|filter(row => row.expiry_status != 'ok')|length }}</div></div></div></div>
    <div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted">Seriennummern</div><div class="fs-3 fw-semibold">{{ traceability.serials|length }}</div></div></div></div>
</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Chargen</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Artikel</th><th>Charge</th><th>Frühestes MHD</th><th class="text-end">Menge</th><th class="text-end">Plätze</th></tr></thead><tbody>{% for row in traceability.batches %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td><a href="{{ path('v3_inventory_traceability', {dimension: 'batch', value: row.batch_number}) }}"><code>{{ row.batch_number }}</code></a></td><td>{{ row.earliest_expiry ? row.earliest_expiry|date('d.m.Y') : '–' }}</td><td class="text-end">{{ row.quantity }}</td><td class="text-end">{{ row.location_count }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Chargen vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">MHD-Überwachung</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>MHD</th><th>Status</th><th>Artikel</th><th>Charge</th><th class="text-end">Menge</th></tr></thead><tbody>{% for row in traceability.expiries %}<tr><td>{{ row.expires_at|date('d.m.Y') }}</td><td>{% if row.expiry_status == 'expired' %}<span class="badge bg-danger-subtle text-danger">Abgelaufen</span>{% elseif row.expiry_status == 'critical' %}<span class="badge bg-warning-subtle text-warning">Kritisch</span>{% else %}<span class="badge bg-success-subtle text-success">Unauffällig</span>{% endif %}</td><td>{{ row.sku }} · {{ row.product_name }}</td><td>{{ row.batch_number ?: '–' }}</td><td class="text-end">{{ row.quantity }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine MHD-Bestände vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Seriennummern</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Seriennummer</th><th>Artikel</th><th>Lagerplatz</th><th>Status</th><th>Aktualisiert</th></tr></thead><tbody>{% for row in traceability.serials %}<tr><td><a href="{{ path('v3_inventory_traceability', {dimension: 'serial', value: row.serial_number}) }}"><code>{{ row.serial_number }}</code></a></td><td>{{ row.sku }} · {{ row.product_name }}</td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}</td><td>{{ row.updated_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Seriennummern vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% if selectedValue %}<div class="card border-primary shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Lebenslauf {{ selectedValue }}</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Zeitpunkt</th><th>Artikel</th><th>Platz</th><th>Bewegung</th><th>Grund</th><th class="text-end">Änderung</th><th class="text-end">Bestand</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.sku }}</td><td>{{ event.location_code }}</td><td>{{ event.movement_type }}</td><td>{{ event.reason }}<div class="small text-muted">{{ event.performed_by_name }}</div></td><td class="text-end">{{ event.quantity_delta }}</td><td class="text-end">{{ event.resulting_quantity }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">Noch keine Bewegungen vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>{% endif %}
{% endblock %}
