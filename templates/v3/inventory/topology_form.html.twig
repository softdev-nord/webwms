{% extends 'v3/base.html.twig' %}
{% set labels = {site:'Standort',warehouse:'Lager',area:'Lagerbereich',aisle:'Lagergang',bin:'Lagerplatz'} %}
{% set editing = entry is not null %}
{% block title %}{{ editing ? 'Bearbeiten' : 'Anlegen' }} · {{ labels[resource] }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ labels[resource] }} {{ editing ? 'bearbeiten' : 'anlegen' }}</h1><p class="text-muted mb-0">Lagertopologie strukturiert verwalten</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_inventory_topology') }}"><i class="ri-arrow-left-line me-1"></i>Zur Übersicht</a></div>
<div class="row"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body">
{% if editing %}
<form method="post" action="{{ path('v3_inventory_topology_update',{resource:resource,id:entry.id}) }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_topology_update_'~resource~'_'~entry.id) }}">
{% elseif resource == 'site' %}<form method="post" action="{{ path('v3_inventory_site_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_site_create') }}">
{% elseif resource == 'warehouse' %}<form method="post" action="{{ path('v3_inventory_warehouse_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_warehouse_create') }}">
{% elseif resource == 'area' %}<form method="post" action="{{ path('v3_inventory_area_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_area_create') }}">
{% elseif resource == 'aisle' %}<form method="post" action="{{ path('v3_inventory_aisle_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_aisle_create') }}">
{% else %}<form method="post" action="{{ path('v3_inventory_bin_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_bin_create') }}">{% endif %}
{% if resource == 'warehouse' %}<div class="col-12"><label class="form-label">Standort</label><select class="form-select" name="site_id" required>{% for row in topology.sites %}<option value="{{ row.id }}" {{ entry and entry.site_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource in ['area','bin'] %}<div class="col-12"><label class="form-label">Lager</label><select class="form-select" name="warehouse_id" required>{% for row in topology.warehouses %}<option value="{{ row.id }}" {{ entry and entry.warehouse_id == row.id ? 'selected':'' }}>{{ row.site_code }} / {{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'aisle' %}<div class="col-12"><label class="form-label">Bereich</label><select class="form-select" name="area_id" required>{% for row in topology.areas %}<option value="{{ row.id }}" {{ entry and entry.area_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'bin' %}<div class="col-md-6"><label class="form-label">Bereich</label><select class="form-select" name="area_id" required>{% for row in topology.areas %}<option value="{{ row.id }}" {{ entry and entry.area_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Gang</label><select class="form-select" name="aisle_id" required>{% for row in topology.aisles %}<option value="{{ row.id }}" {{ entry and entry.aisle_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
<div class="col-md-4"><label class="form-label">Code</label><input class="form-control" name="code" value="{{ entry.code|default('') }}" required></div>
{% if resource != 'bin' %}<div class="col-md-8"><label class="form-label">Name</label><input class="form-control" name="name" value="{{ entry.name|default('') }}" required></div>{% endif %}
{% if resource == 'site' %}<div class="col-md-8"><label class="form-label">Zeitzone</label><input class="form-control" name="timezone" value="{{ entry.timezone|default('Europe/Berlin') }}" required></div>{% if editing %}<div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status"><option value="active" {{ entry.status == 'active' ? 'selected':'' }}>Aktiv</option><option value="inactive" {{ entry.status == 'inactive' ? 'selected':'' }}>Inaktiv</option></select></div>{% endif %}{% endif %}
{% if resource == 'warehouse' %}<div class="col-12"><label class="form-label">Lagertyp</label><select class="form-select" name="warehouse_type">{% for value,label in {standard:'Standard',high_bay:'Hochregal',block:'Blocklager',automated:'Automatisiert'} %}<option value="{{ value }}" {{ entry and entry.warehouse_type == value ? 'selected':'' }}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'area' %}<div class="col-12"><label class="form-label">Bereichstyp</label><select class="form-select" name="area_type">{% for value,label in {storage:'Lagerung',receiving:'Wareneingang',shipping:'Versand',quality:'Qualität',blocked:'Sperrlager'} %}<option value="{{ value }}" {{ entry and entry.area_type == value ? 'selected':'' }}>{{ label }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'bin' %}<div class="col-md-3"><label class="form-label">Ebene</label><input class="form-control" name="level_code" value="{{ entry.level_code|default('') }}" required></div><div class="col-md-3"><label class="form-label">Fach</label><input class="form-control" name="bin_code" value="{{ entry.bin_code|default('') }}" required></div><div class="col-md-3"><label class="form-label">Typ</label><select class="form-select" name="location_type">{% for value,label in {storage:'Lagerung',receiving:'Wareneingang',shipping:'Versand',quality:'Qualität',blocked:'Gesperrt'} %}<option value="{{ value }}" {{ entry and entry.location_type == value ? 'selected':'' }}>{{ label }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Kapazität</label><input class="form-control" type="number" min="0" name="capacity_quantity" value="{{ entry.capacity_quantity|default(0) }}"></div>{% if editing %}<div class="col-md-6"><label class="form-label">Einlagerungspriorität</label><input class="form-control" type="number" min="0" name="putaway_priority" value="{{ entry.putaway_priority|default(100) }}"></div><div class="col-md-6 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="putaway_enabled" value="1" id="putaway-enabled" {{ entry.putaway_enabled ? 'checked':'' }}><label class="form-check-label" for="putaway-enabled">Einlagerung erlaubt</label></div></div>{% endif %}{% endif %}
<div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_inventory_topology') }}">Abbrechen</a><button class="btn btn-primary">{{ editing ? 'Änderungen speichern':'Anlegen' }}</button></div></form>
</div></div></div></div>
{% endblock %}
