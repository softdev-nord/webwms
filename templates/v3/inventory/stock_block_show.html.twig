{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.stock_block_show.bestandssperre.bearbeiten'|trans }}</h1><p class="text-muted mb-0">{{ block.sku }} · {{ block.location_code }} · {{ block.quantity }} {{ 'ui.v3.inventory.special_stock_classify.stuck'|trans }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_inventory_stock_blocks') }}">{{ 'ui.v3.administration.api_client_edit.zur.ubersicht'|trans }}</a></div>
<div class="row g-4"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><dl class="row mb-4"><dt class="col-5">{{ 'ui.transport_request.index.status'|trans }}</dt><dd class="col-7">{{ block.status }}</dd><dt class="col-5">{{ 'ui.v3.inventory.stock_block_new.sperrgrund'|trans }}</dt><dd class="col-7">{{ block.reason_code }} · {{ block.reason_name }}</dd><dt class="col-5">{{ 'ui.v3.inventory.stock_block_new.begrundung'|trans }}</dt><dd class="col-7">{{ block.note }}</dd></dl>{% if block.status == 'open' and is_granted('inventory.stock_block.review') %}<form method="post" action="{{ path('v3_inventory_stock_block_review',{blockId:block.id}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_review_'~block.id) }}"><label class="form-label">{{ 'ui.v3.inventory.stock_block_show.prufergebnis'|trans }}</label><textarea class="form-control" name="note" required></textarea><button class="btn btn-primary">{{ 'ui.v3.inventory.stock_block_show.sperre.prufen'|trans }}</button></form>{% elseif block.status == 'reviewed' and is_granted('inventory.stock_block.release') %}<form method="post" action="{{ path('v3_inventory_stock_block_release',{blockId:block.id}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_release_'~block.id) }}"><label class="form-label">{{ 'ui.v3.inventory.stock_block_show.freigabevermerk'|trans }}</label><textarea class="form-control" name="note" required></textarea><button class="btn btn-success">{{ 'ui.v3.inventory.stock_block_show.bestand.freigeben'|trans }}</button></form>{% else %}<div class="alert alert-light mb-0">{{ 'ui.v3.inventory.stock_block_show.fur.den.aktuellen.status.ist.keine.aktion.verfugbar'|trans }}</div>{% endif %}</div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.inventory.stock_block_show.sperrjournal'|trans }}</h2></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt'|trans }}</th><th>{{ 'ui.v3.administration.workspace.ereignis'|trans }}</th><th>{{ 'ui.v3.inventory.control.notiz'|trans }}</th><th>{{ 'nav.user.user'|trans }}</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.occurred_at|date('d.m.Y H:i:s') }}</td><td>{{ event.event_type }}</td><td>{{ event.note }}</td><td>{{ event.performed_by_name }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.inventory.stock_block_show.kein.ereignis.vorhanden'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
{% endblock %}
