{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'inventory.stock_block_new.block_stock'|trans }}</h1><p class="text-muted mb-0">{{ row.sku }} · {{ row.location_code }} · {{ row.quantity }} {{ 'inventory.special_stock_classify.piece'|trans }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_inventory_stock_blocks') }}">{{ 'administration.api_client_edit.go_to_overview'|trans }}</a></div>
<div class="row"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body"><form method="post" action="{{ path('v3_inventory_stock_block_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_create') }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="location_id" value="{{ row.location_id }}"><input type="hidden" name="stock_status" value="{{ row.stock_status }}"><input type="hidden" name="batch_number" value="{{ row.batch_number }}"><input type="hidden" name="serial_number" value="{{ row.serial_number }}"><input type="hidden" name="expires_at" value="{{ row.expires_at }}"><div class="col-md-6"><label class="form-label">{{ 'inventory.stock_block_new.blocking_reason'|trans }}</label><select class="form-select" name="reason_id" required>{% for reason in reasons|filter(reason => reason.active) %}<option value="{{ reason.id }}">{{ reason.code }} · {{ reason.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</label><input class="form-control" type="number" name="quantity" min="1" max="{{ row.serial_number ? 1:row.quantity }}" value="{{ row.serial_number ? 1:row.quantity }}" required></div><div class="col-12"><label class="form-label">{{ 'inventory.stock_block_new.reason'|trans }}</label><textarea class="form-control" name="note" rows="3" required></textarea></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_inventory_stock_blocks') }}">{{ 'common.button.cancel'|trans }}</a><button class="btn btn-danger">{{ 'inventory.stock_block_new.block_stock'|trans }}</button></div></form></div></div></div></div>
{% endblock %}
