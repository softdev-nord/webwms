{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms.5de7112'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.inventory.stock_block_reasons.sperrgrunde.dd2d572'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.stock_block_reasons.grunde.fur.bestandssperren.zentral.verwalten.e81e33e'|trans }}</p></div>{% if is_granted('inventory.stock_block.write') %}<a class="btn btn-primary" href="{{ path('v3_inventory_stock_block_reason_new') }}"><i class="ri-add-line me-1"></i>{{ 'ui.v3.inventory.stock_block_reasons.sperrgrund.anlegen.b4a9eb6'|trans }}</a>{% endif %}</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.user.user_group.index.beschreibung.b3c8def'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'ui.v3.administration.api_clients.aktionen.445e0c4'|trans }}</th></tr></thead><tbody>{% for reason in reasons %}<tr><td><strong>{{ reason.code }}</strong></td><td>{{ reason.name }}</td><td>{{ reason.description ?: '–' }}</td><td><span class="badge bg-{{ reason.active ? 'success':'secondary' }}-subtle text-{{ reason.active ? 'success':'secondary' }}">{{ (reason.active ? 'ui.user.user_input_fields.aktiv.16a766c' : 'ui.v3.inventory.selection_rules.inaktiv.cd5be11')|trans }}</span></td><td class="text-end">{% if is_granted('inventory.stock_block.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_stock_block_reason_edit',{reasonId:reason.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-5">{{ 'ui.v3.inventory.stock_block_reasons.keine.sperrgrunde.vorhanden.57c3e85'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
