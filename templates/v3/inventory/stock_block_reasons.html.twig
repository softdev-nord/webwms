{% extends 'v3/base.html.twig' %}
{% block title %}Sperrgründe | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Sperrgründe</h1><p class="text-muted mb-0">Gründe für Bestandssperren zentral verwalten</p></div>{% if is_granted('inventory.stock_block.write') %}<a class="btn btn-primary" href="{{ path('v3_inventory_stock_block_reason_new') }}"><i class="ri-add-line me-1"></i>Sperrgrund anlegen</a>{% endif %}</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Name</th><th>Beschreibung</th><th>Status</th><th class="text-end" data-orderable="false" data-searchable="false">Aktionen</th></tr></thead><tbody>{% for reason in reasons %}<tr><td><strong>{{ reason.code }}</strong></td><td>{{ reason.name }}</td><td>{{ reason.description ?: '–' }}</td><td><span class="badge bg-{{ reason.active ? 'success':'secondary' }}-subtle text-{{ reason.active ? 'success':'secondary' }}">{{ reason.active ? 'Aktiv':'Inaktiv' }}</span></td><td class="text-end">{% if is_granted('inventory.stock_block.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_stock_block_reason_edit',{reasonId:reason.id}) }}"><i class="ri-pencil-line me-1"></i>Bearbeiten</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-5">Keine Sperrgründe vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
