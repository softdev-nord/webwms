{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">{{ 'ui.article.index.bestand'|trans }}</h1>
        <p class="text-muted mb-0">{{ 'ui.v3.inventory.stock.mandantensichere.live.sicht.auf.die.v3.bestandsprojekti'|trans }}</p>
    </div>
<form method="get" class="d-flex gap-2 align-items-end">
    <div>
        <label for="warehouse" class="form-label small">{{ 'nav.master_data.submenu.headline4'|trans }}</label>
        <select id="warehouse" name="warehouse" class="form-select">
            <option value="">{{ 'ui.v3.inventory.configuration_form.alle.lager'|trans }}</option>
            {% for warehouse in warehouses %}
                <option value="{{ warehouse.id }}" {{ warehouse.id == selectedWarehouse ? 'selected' : '' }}>{{ warehouse.code }} – {{ warehouse.name }}</option>
            {% endfor %}
        </select>
    </div>
    <button class="btn btn-primary" type="submit">{{ 'ui.v3.integration.outbox.index.filtern'|trans }}</button>
</form>
</div>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>{{ 'ui.v3.inventory.stock.sku'|trans }}</th>
                <th>{{ 'ui.modal.show_article_stock_details_modal.lagerplatz'|trans }}</th>
                <th>{{ 'ui.v3.inventory.stock.topologie'|trans }}</th>
                <th>{{ 'ui.transport_request.index.status'|trans }}</th>
                <th>{{ 'ui.v3.inventory.stock.sonderbestand'|trans }}</th>
                <th>{{ 'ui.modal.stock_in_modal.charge'|trans }}</th>
                <th>{{ 'ui.v3.inbound.new.seriennummer'|trans }}</th>
                <th>{{ 'ui.v3.inventory.stock.verfall'|trans }}</th>
                <th class="text-end">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th>
                <th class="text-end">{{ 'ui.v3.inbound.new.verfugbar'|trans }}</th>
                <th>{{ 'ui.v3.inventory.stock.aktualisiert'|trans }}</th>
            </tr>
            </thead>
            <tbody>
                {% for row in stock %}
                    <tr>
                        <td class="fw-semibold">{{ row.sku }}</td>
                        <td>{{ row.location_code }}</td>
                        <td>{{ row.warehouse_code }}{% if row.area_code %} / {{ row.area_code }}{% endif %}{% if row.aisle_code %} / {{ row.aisle_code }}{% endif %}</td>
                        <td>
                            <span class="badge bg-success-subtle text-success">
                                {{ row.stock_status }}
                            </span>
                        </td>
                        <td>{% if row.special_stock_code %}<span class="badge bg-info-subtle text-info">{{ row.special_stock_code }}</span>{% if row.owner_reference %}<div class="small text-muted">{{ row.owner_reference }}</div>{% endif %}{% else %}–{% endif %}</td>
                        <td>{{ row.batch_number ?: '–' }}</td>
                        <td>{{ row.serial_number ?: '–' }}</td>
                        <td>{{ row.expires_at ?: '–' }}</td>
                        <td class="text-end">{{ row.quantity }}</td>
                        <td class="text-end fw-semibold">{{ row.available_quantity }}</td>
                        <td class="text-nowrap">{{ row.updated_at|date('d.m.Y H:i:s') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="11" class="text-center text-muted py-5">{{ 'ui.v3.inventory.stock.kein.bestand.fur.diesen.filter.vorhanden'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
