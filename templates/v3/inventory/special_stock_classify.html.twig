{% extends 'v3/base.html.twig' %}
{% block title %}Sonderbestand klassifizieren | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Sonderbestand klassifizieren</h1><p class="text-muted mb-0">{{ row.sku }} · {{ row.location_code }} · {{ row.quantity }} Stück</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_inventory_special_stock') }}">Zur Übersicht</a></div>
<div class="row"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body"><form method="post" action="{{ path('v3_inventory_special_stock_classify') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_special_stock_classify') }}"><input type="hidden" name="product_id" value="{{ row.product_id }}"><input type="hidden" name="location_id" value="{{ row.location_id }}"><input type="hidden" name="stock_key" value="{{ row.stock_key }}"><div class="col-12"><label class="form-label">Kennzeichen</label><select class="form-select" name="special_stock_type_id" required>{% for type in types %}<option value="{{ type.id }}" {{ type.id == row.special_stock_type_id ? 'selected':'' }}>{{ type.code }} · {{ type.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">Eigentümer</label><input class="form-control" name="owner_reference" value="{{ row.owner_reference }}"></div><div class="col-md-6"><label class="form-label">Grund</label><input class="form-control" name="reason" value="{{ row.classification_reason }}" required></div><div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_inventory_special_stock') }}">Abbrechen</a><button class="btn btn-primary">Klassifizierung speichern</button></div></form></div></div></div></div>
{% endblock %}
