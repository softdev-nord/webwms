{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.inventory.control.inventory.control.center'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.control.gefahrstoffe.stucklisten.ladehilfsmittel.und.inventur.z'|trans }}</p></div>
<ul class="nav nav-tabs nav-tabs-custom mb-3">{% for id,label in {hazard:'ui.inventory.tab.hazard',bom:'ui.inventory.tab.bom',carrier:'ui.inventory.tab.load_carrier',count:'ui.inventory.tab.count'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#inventory-{{ id }}">{{ label|trans }}</button></li>{% endfor %}</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="inventory-hazard"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.gefahrstoffklasse'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_hazard_class') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_hazard_class') }}"><input class="form-control" name="code" placeholder="{{ 'ui.v3.inventory.control.klasse'|trans }}" required><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung'|trans }}" required><input class="form-control" name="un_class" placeholder="{{ 'ui.v3.inventory.control.un.klasse'|trans }}" required><button class="btn btn-primary">{{ 'ui.v3.administration.workspace.anlegen'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.artikel.klassifizieren'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_hazardous_material') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_hazardous_material') }}"><select class="form-select" name="product_id">{% for product in inventory.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select><select class="form-select" name="hazard_class_id">{% for class in inventory.hazardClasses %}<option value="{{ class.id }}">{{ class.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="un_number" placeholder="{{ 'ui.v3.inventory.control.un.nummer'|trans }}" required></div><div class="col-6"><input class="form-control" name="packing_group" placeholder="{{ 'ui.v3.inventory.control.verpackungsgruppe'|trans }}"></div><input class="form-control" name="description" placeholder="{{ 'ui.user.user_group.index.beschreibung'|trans }}" required><button class="btn btn-primary">{{ 'ui.v3.inventory.control.klassifizieren'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.bereichsregel'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_storage_restriction') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_storage_restriction') }}"><select class="form-select" name="hazard_class_id">{% for class in inventory.hazardClasses %}<option value="{{ class.id }}">{{ class.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="location_prefix" placeholder="{{ 'ui.v3.inventory.control.platzprafix'|trans }}" required></div><div class="col-6"><input class="form-control" type="number" min="0" name="max_quantity" placeholder="{{ 'ui.v3.inventory.control.hochstmenge'|trans }}"></div><label><input type="checkbox" name="allowed" value="1" checked> {{ 'ui.v3.inventory.control.einlagerung.zulassig'|trans }}</label><button class="btn btn-outline-primary">{{ 'ui.v3.inventory.control.regel.speichern'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inventory.control.klasse'|trans }}</th><th>{{ 'ui.v3.inventory.control.un'|trans }}</th><th>{{ 'ui.user.user_group.index.beschreibung'|trans }}</th></tr></thead><tbody>{% for row in inventory.hazardousMaterials %}<tr><td>{{ row.sku }}</td><td>{{ row.hazard_code }}</td><td>{{ row.un_number }}</td><td>{{ row.description }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.gefahrstoffe.klassifiziert'|trans }}</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="card-body">{% for row in inventory.restrictions %}<span class="badge bg-{{ row.allowed ? 'success':'danger' }}-subtle text-{{ row.allowed ? 'success':'danger' }} me-2">{{ row.hazard_code }} · {{ row.location_prefix }} · {{ (row.allowed ? 'ui.common.allowed' : 'ui.common.blocked')|trans }}</span>{% endfor %}</div></div></div></div></div>
<div class="tab-pane fade" id="inventory-bom"><div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.stuckliste.anlegen'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_bom') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_bom') }}"><select class="form-select" name="product_id">{% for product in inventory.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select><div class="col-8"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-4"><input class="form-control" name="version" value="1" required></div><textarea class="form-control font-monospace" name="items" rows="5" required>{{ 'ui.v3.inventory.control.productid.uuid.quantity.1'|trans }}</textarea><button class="btn btn-primary">{{ 'ui.v3.inventory.control.stuckliste.speichern'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.materialbedarf.planen'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_requirement') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_requirement') }}"><select class="form-select" name="bom_id">{% for bom in inventory.boms %}<option value="{{ bom.id }}">{{ bom.code }} / {{ bom.version }}</option>{% endfor %}</select><div class="col-8"><input class="form-control" name="reference" placeholder="{{ 'ui.v3.inventory.control.produktionsreferenz'|trans }}" required></div><div class="col-4"><input class="form-control" type="number" min="1" name="production_quantity" value="1"></div><button class="btn btn-outline-primary">{{ 'ui.v3.inventory.control.bedarf.erzeugen'|trans }}</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'ui.v3.inventory.control.erzeugnis'|trans }}</th><th>{{ 'ui.v3.inventory.control.version'|trans }}</th><th>{{ 'ui.v3.inbound.control.positionen'|trans }}</th></tr></thead><tbody>{% for row in inventory.boms %}<tr><td>{{ row.code }}</td><td>{{ row.sku }}</td><td>{{ row.version }}</td><td>{{ row.item_count }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.stucklisten'|trans }}</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.stock.stock_rotation.referenz'|trans }}</th><th>{{ 'ui.v3.inventory.control.stuckliste'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th></tr></thead><tbody>{% for row in inventory.requirements %}<tr><td>{{ row.reference }}</td><td>{{ row.bom_code }}</td><td>{{ row.production_quantity }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="inventory-carrier"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.lhm.buchen'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_load_carrier') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_load_carrier') }}"><input class="form-control" name="partner_code" placeholder="{{ 'ui.v3.inventory.control.partner'|trans }}" required><input class="form-control" name="carrier_type" placeholder="{{ 'ui.v3.inventory.control.pal.klt.gitterbox'|trans }}" required><div class="col-4"><input class="form-control" type="number" name="quantity" placeholder="{{ 'ui.v3.inventory.control.menge'|trans }}" required></div><div class="col-8"><input class="form-control" name="reference" placeholder="{{ 'ui.stock.stock_rotation.referenz'|trans }}" required></div><input class="form-control" name="note" placeholder="{{ 'ui.v3.inventory.control.notiz'|trans }}"><button class="btn btn-primary">{{ 'ui.modal.put_into_storage.buchen'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inventory.control.partner'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ'|trans }}</th><th>{{ 'ui.v3.inventory.control.saldo'|trans }}</th></tr></thead><tbody>{% for row in inventory.carrierAccounts %}<tr><td>{{ row.partner_code }}</td><td>{{ row.carrier_type }}</td><td class="fw-semibold">{{ row.balance }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.lhm.konten'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="inventory-count"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.stichtagsinventur'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_count') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count') }}"><select class="form-select" name="warehouse_id">{% for warehouse in inventory.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code'|trans }}" required></div><div class="col-6"><input class="form-control" name="location_prefix" placeholder="{{ 'ui.v3.inventory.control.platzprafix'|trans }}"></div><button class="btn btn-primary">{{ 'ui.v3.inventory.control.inventur.eroffnen'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.permanente.inventur'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_cycle_plan') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_cycle_plan') }}"><select class="form-select" name="warehouse_id">{% for warehouse in inventory.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="code" placeholder="{{ 'ui.v3.inventory.control.plan.code'|trans }}" required></div><div class="col-6"><input class="form-control" name="location_prefix" placeholder="{{ 'ui.v3.administration.workspace.bereich'|trans }}"></div><div class="col-6"><input class="form-control" type="number" min="1" name="interval_days" value="30"></div><div class="col-6"><input class="form-control" type="datetime-local" name="next_due_at" required></div><button class="btn btn-outline-primary">{{ 'ui.v3.inventory.control.plan.speichern'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th>{{ 'ui.v3.inventory.control.zeilen.differenzen'|trans }}</th><th>{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for row in inventory.counts %}<tr><td>{{ row.code }}</td><td>{{ row.count_type }}</td><td>{{ row.status }}</td><td>{{ row.line_count }} / {{ row.difference_count }}</td><td>{% if row.status == 'open' %}<form method="post" action="{{ path('v3_inventory_control_submit',{countId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_submit_'~row.id) }}"><button class="btn btn-sm btn-outline-primary">{{ 'ui.v3.inventory.control.einreichen'|trans }}</button></form>{% elseif row.status == 'counted' %}<form method="post" action="{{ path('v3_inventory_control_approve',{countId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_approve_'~row.id) }}"><button class="btn btn-sm btn-primary">{{ 'ui.v3.inventory.control.freigeben.buchen'|trans }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.inventuren'|trans }}</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'nav.inventory.headline'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inventory.control.soll'|trans }}</th><th>{{ 'ui.v3.inventory.control.ist'|trans }}</th><th>{{ 'ui.v3.inventory.control.zahlen'|trans }}</th></tr></thead><tbody>{% for row in inventory.countLines %}<tr><td>{{ row.count_code }}</td><td>{{ row.sku }}</td><td>{{ row.expected_quantity }}</td><td>{{ row.counted_quantity|default('–') }}</td><td><form class="d-flex" method="post" action="{{ path('v3_inventory_control_record',{countId:row.inventory_count_id,lineId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_line_'~row.id) }}"><input class="form-control form-control-sm" type="number" name="quantity" value="{{ row.counted_quantity|default(row.expected_quantity) }}"><button class="btn btn-sm btn-outline-primary ms-2">{{ 'button.save'|trans }}</button></form></td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
</div>
{% endblock %}
