{% extends 'v3/base.html.twig' %}
{% block title %}Inventory Control Center | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">Inventory Control Center</h1><p class="text-muted mb-0">Gefahrstoffe, Stücklisten, Ladehilfsmittel und Inventur zentral steuern</p></div>
<ul class="nav nav-tabs nav-tabs-custom mb-3">{% for id,label in {hazard:'Gefahrstoffe',bom:'Stücklisten',carrier:'LHM-Konten',count:'Inventur'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#inventory-{{ id }}">{{ label }}</button></li>{% endfor %}</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="inventory-hazard"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Gefahrstoffklasse</h2><form method="post" action="{{ path('v3_inventory_control_hazard_class') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_hazard_class') }}"><input class="form-control" name="code" placeholder="Klasse" required><input class="form-control" name="name" placeholder="Bezeichnung" required><input class="form-control" name="un_class" placeholder="UN-Klasse" required><button class="btn btn-primary">Anlegen</button></form><hr><h2 class="h5">Artikel klassifizieren</h2><form method="post" action="{{ path('v3_inventory_control_hazardous_material') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_hazardous_material') }}"><select class="form-select" name="product_id">{% for product in inventory.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select><select class="form-select" name="hazard_class_id">{% for class in inventory.hazardClasses %}<option value="{{ class.id }}">{{ class.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="un_number" placeholder="UN-Nummer" required></div><div class="col-6"><input class="form-control" name="packing_group" placeholder="Verpackungsgruppe"></div><input class="form-control" name="description" placeholder="Beschreibung" required><button class="btn btn-primary">Klassifizieren</button></form><hr><h2 class="h5">Bereichsregel</h2><form method="post" action="{{ path('v3_inventory_control_storage_restriction') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_storage_restriction') }}"><select class="form-select" name="hazard_class_id">{% for class in inventory.hazardClasses %}<option value="{{ class.id }}">{{ class.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="location_prefix" placeholder="Platzpräfix" required></div><div class="col-6"><input class="form-control" type="number" min="0" name="max_quantity" placeholder="Höchstmenge"></div><label><input type="checkbox" name="allowed" value="1" checked> Einlagerung zulässig</label><button class="btn btn-outline-primary">Regel speichern</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Artikel</th><th>Klasse</th><th>UN</th><th>Beschreibung</th></tr></thead><tbody>{% for row in inventory.hazardousMaterials %}<tr><td>{{ row.sku }}</td><td>{{ row.hazard_code }}</td><td>{{ row.un_number }}</td><td>{{ row.description }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Keine Gefahrstoffe klassifiziert.</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="card-body">{% for row in inventory.restrictions %}<span class="badge bg-{{ row.allowed ? 'success':'danger' }}-subtle text-{{ row.allowed ? 'success':'danger' }} me-2">{{ row.hazard_code }} · {{ row.location_prefix }} · {{ row.allowed ? 'zulässig':'gesperrt' }}</span>{% endfor %}</div></div></div></div></div>
<div class="tab-pane fade" id="inventory-bom"><div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Stückliste anlegen</h2><form method="post" action="{{ path('v3_inventory_control_bom') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_bom') }}"><select class="form-select" name="product_id">{% for product in inventory.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select><div class="col-8"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-4"><input class="form-control" name="version" value="1" required></div><textarea class="form-control font-monospace" name="items" rows="5" required>[{"productId":"UUID","quantity":1}]</textarea><button class="btn btn-primary">Stückliste speichern</button></form><hr><h2 class="h5">Materialbedarf planen</h2><form method="post" action="{{ path('v3_inventory_control_requirement') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_requirement') }}"><select class="form-select" name="bom_id">{% for bom in inventory.boms %}<option value="{{ bom.id }}">{{ bom.code }} / {{ bom.version }}</option>{% endfor %}</select><div class="col-8"><input class="form-control" name="reference" placeholder="Produktionsreferenz" required></div><div class="col-4"><input class="form-control" type="number" min="1" name="production_quantity" value="1"></div><button class="btn btn-outline-primary">Bedarf erzeugen</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Erzeugnis</th><th>Version</th><th>Positionen</th></tr></thead><tbody>{% for row in inventory.boms %}<tr><td>{{ row.code }}</td><td>{{ row.sku }}</td><td>{{ row.version }}</td><td>{{ row.item_count }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Keine Stücklisten.</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Referenz</th><th>Stückliste</th><th>Menge</th><th>Status</th></tr></thead><tbody>{% for row in inventory.requirements %}<tr><td>{{ row.reference }}</td><td>{{ row.bom_code }}</td><td>{{ row.production_quantity }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="inventory-carrier"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">LHM buchen</h2><form method="post" action="{{ path('v3_inventory_control_load_carrier') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_load_carrier') }}"><input class="form-control" name="partner_code" placeholder="Partner" required><input class="form-control" name="carrier_type" placeholder="PAL / KLT / GITTERBOX" required><div class="col-4"><input class="form-control" type="number" name="quantity" placeholder="± Menge" required></div><div class="col-8"><input class="form-control" name="reference" placeholder="Referenz" required></div><input class="form-control" name="note" placeholder="Notiz"><button class="btn btn-primary">Buchen</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Partner</th><th>Typ</th><th>Saldo</th></tr></thead><tbody>{% for row in inventory.carrierAccounts %}<tr><td>{{ row.partner_code }}</td><td>{{ row.carrier_type }}</td><td class="fw-semibold">{{ row.balance }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">Keine LHM-Konten.</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="inventory-count"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Stichtagsinventur</h2><form method="post" action="{{ path('v3_inventory_control_count') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count') }}"><select class="form-select" name="warehouse_id">{% for warehouse in inventory.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="code" placeholder="Code" required></div><div class="col-6"><input class="form-control" name="location_prefix" placeholder="Platzpräfix"></div><button class="btn btn-primary">Inventur eröffnen</button></form><hr><h2 class="h5">Permanente Inventur</h2><form method="post" action="{{ path('v3_inventory_control_cycle_plan') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_cycle_plan') }}"><select class="form-select" name="warehouse_id">{% for warehouse in inventory.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="code" placeholder="Plan-Code" required></div><div class="col-6"><input class="form-control" name="location_prefix" placeholder="Bereich"></div><div class="col-6"><input class="form-control" type="number" min="1" name="interval_days" value="30"></div><div class="col-6"><input class="form-control" type="datetime-local" name="next_due_at" required></div><button class="btn btn-outline-primary">Plan speichern</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Code</th><th>Typ</th><th>Status</th><th>Zeilen / Differenzen</th><th>Aktion</th></tr></thead><tbody>{% for row in inventory.counts %}<tr><td>{{ row.code }}</td><td>{{ row.count_type }}</td><td>{{ row.status }}</td><td>{{ row.line_count }} / {{ row.difference_count }}</td><td>{% if row.status == 'open' %}<form method="post" action="{{ path('v3_inventory_control_submit',{countId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_submit_'~row.id) }}"><button class="btn btn-sm btn-outline-primary">Einreichen</button></form>{% elseif row.status == 'counted' %}<form method="post" action="{{ path('v3_inventory_control_approve',{countId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_approve_'~row.id) }}"><button class="btn btn-sm btn-primary">Freigeben & buchen</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Inventuren.</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Inventur</th><th>Artikel</th><th>Soll</th><th>Ist</th><th>Zählen</th></tr></thead><tbody>{% for row in inventory.countLines %}<tr><td>{{ row.count_code }}</td><td>{{ row.sku }}</td><td>{{ row.expected_quantity }}</td><td>{{ row.counted_quantity|default('–') }}</td><td><form class="d-flex" method="post" action="{{ path('v3_inventory_control_record',{countId:row.inventory_count_id,lineId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_line_'~row.id) }}"><input class="form-control form-control-sm" type="number" name="quantity" value="{{ row.counted_quantity|default(row.expected_quantity) }}"><button class="btn btn-sm btn-outline-primary ms-2">Speichern</button></form></td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
</div>
{% endblock %}
