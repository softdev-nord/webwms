{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms.5de7112'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">{{ 'ui.v3.inventory.control.inventory.control.center.dac5729'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.inventory.control.gefahrstoffe.stucklisten.ladehilfsmittel.und.inventur.z.575263a'|trans }}</p></div>
<ul class="nav nav-tabs nav-tabs-custom mb-3">{% for id,label in {hazard:'ui.inventory.tab.hazard',bom:'ui.inventory.tab.bom',carrier:'ui.inventory.tab.load_carrier',count:'ui.inventory.tab.count'} %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#inventory-{{ id }}">{{ label|trans }}</button></li>{% endfor %}</ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="inventory-hazard"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.gefahrstoffklasse.3ec989d'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_hazard_class') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_hazard_class') }}"><input class="form-control" name="code" placeholder="{{ 'ui.v3.inventory.control.klasse.f495100'|trans }}" required><input class="form-control" name="name" placeholder="{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}" required><input class="form-control" name="un_class" placeholder="{{ 'ui.v3.inventory.control.un.klasse.45b5da7'|trans }}" required><button class="btn btn-primary">{{ 'ui.v3.administration.workspace.anlegen.846460c'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.artikel.klassifizieren.309b855'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_hazardous_material') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_hazardous_material') }}"><select class="form-select" name="product_id">{% for product in inventory.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select><select class="form-select" name="hazard_class_id">{% for class in inventory.hazardClasses %}<option value="{{ class.id }}">{{ class.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="un_number" placeholder="{{ 'ui.v3.inventory.control.un.nummer.138b95a'|trans }}" required></div><div class="col-6"><input class="form-control" name="packing_group" placeholder="{{ 'ui.v3.inventory.control.verpackungsgruppe.6677e6d'|trans }}"></div><input class="form-control" name="description" placeholder="{{ 'ui.user.user_group.index.beschreibung.b3c8def'|trans }}" required><button class="btn btn-primary">{{ 'ui.v3.inventory.control.klassifizieren.1d1d52f'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.bereichsregel.60ef420'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_storage_restriction') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_storage_restriction') }}"><select class="form-select" name="hazard_class_id">{% for class in inventory.hazardClasses %}<option value="{{ class.id }}">{{ class.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="location_prefix" placeholder="{{ 'ui.v3.inventory.control.platzprafix.7044a90'|trans }}" required></div><div class="col-6"><input class="form-control" type="number" min="0" name="max_quantity" placeholder="{{ 'ui.v3.inventory.control.hochstmenge.9307bea'|trans }}"></div><label><input type="checkbox" name="allowed" value="1" checked> {{ 'ui.v3.inventory.control.einlagerung.zulassig.77a3982'|trans }}</label><button class="btn btn-outline-primary">{{ 'ui.v3.inventory.control.regel.speichern.3f98ae4'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inventory.control.klasse.f495100'|trans }}</th><th>{{ 'ui.v3.inventory.control.un.c04d888'|trans }}</th><th>{{ 'ui.user.user_group.index.beschreibung.b3c8def'|trans }}</th></tr></thead><tbody>{% for row in inventory.hazardousMaterials %}<tr><td>{{ row.sku }}</td><td>{{ row.hazard_code }}</td><td>{{ row.un_number }}</td><td>{{ row.description }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.gefahrstoffe.klassifiziert.d7bf516'|trans }}</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="card-body">{% for row in inventory.restrictions %}<span class="badge bg-{{ row.allowed ? 'success':'danger' }}-subtle text-{{ row.allowed ? 'success':'danger' }} me-2">{{ row.hazard_code }} · {{ row.location_prefix }} · {{ (row.allowed ? 'ui.common.allowed' : 'ui.common.blocked')|trans }}</span>{% endfor %}</div></div></div></div></div>
<div class="tab-pane fade" id="inventory-bom"><div class="row g-3"><div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.stuckliste.anlegen.9c2c9be'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_bom') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_bom') }}"><select class="form-select" name="product_id">{% for product in inventory.products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }}</option>{% endfor %}</select><div class="col-8"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code.adac693'|trans }}" required></div><div class="col-4"><input class="form-control" name="version" value="1" required></div><textarea class="form-control font-monospace" name="items" rows="5" required>{{ 'ui.v3.inventory.control.productid.uuid.quantity.1.981341a'|trans }}</textarea><button class="btn btn-primary">{{ 'ui.v3.inventory.control.stuckliste.speichern.345ab01'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.materialbedarf.planen.2cae7b8'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_requirement') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_requirement') }}"><select class="form-select" name="bom_id">{% for bom in inventory.boms %}<option value="{{ bom.id }}">{{ bom.code }} / {{ bom.version }}</option>{% endfor %}</select><div class="col-8"><input class="form-control" name="reference" placeholder="{{ 'ui.v3.inventory.control.produktionsreferenz.7a0a3d1'|trans }}" required></div><div class="col-4"><input class="form-control" type="number" min="1" name="production_quantity" value="1"></div><button class="btn btn-outline-primary">{{ 'ui.v3.inventory.control.bedarf.erzeugen.28b7fac'|trans }}</button></form></div></div></div><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</th><th>{{ 'ui.v3.inventory.control.erzeugnis.68aa953'|trans }}</th><th>{{ 'ui.v3.inventory.control.version.2da600b'|trans }}</th><th>{{ 'ui.v3.inbound.control.positionen.834a902'|trans }}</th></tr></thead><tbody>{% for row in inventory.boms %}<tr><td>{{ row.code }}</td><td>{{ row.sku }}</td><td>{{ row.version }}</td><td>{{ row.item_count }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.stucklisten.ee06a14'|trans }}</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.stock.stock_rotation.referenz.1ac5c0e'|trans }}</th><th>{{ 'ui.v3.inventory.control.stuckliste.7ddedbb'|trans }}</th><th>{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th></tr></thead><tbody>{% for row in inventory.requirements %}<tr><td>{{ row.reference }}</td><td>{{ row.bom_code }}</td><td>{{ row.production_quantity }}</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="inventory-carrier"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.lhm.buchen.403a309'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_load_carrier') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_load_carrier') }}"><input class="form-control" name="partner_code" placeholder="{{ 'ui.v3.inventory.control.partner.9357e0a'|trans }}" required><input class="form-control" name="carrier_type" placeholder="{{ 'ui.v3.inventory.control.pal.klt.gitterbox.b02a2a8'|trans }}" required><div class="col-4"><input class="form-control" type="number" name="quantity" placeholder="{{ 'ui.v3.inventory.control.menge.f9f9259'|trans }}" required></div><div class="col-8"><input class="form-control" name="reference" placeholder="{{ 'ui.stock.stock_rotation.referenz.1ac5c0e'|trans }}" required></div><input class="form-control" name="note" placeholder="{{ 'ui.v3.inventory.control.notiz.b6c4417'|trans }}"><button class="btn btn-primary">{{ 'ui.modal.put_into_storage.buchen.6fce96a'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>{{ 'ui.v3.inventory.control.partner.9357e0a'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ.edcaf9a'|trans }}</th><th>{{ 'ui.v3.inventory.control.saldo.8b0fcd0'|trans }}</th></tr></thead><tbody>{% for row in inventory.carrierAccounts %}<tr><td>{{ row.partner_code }}</td><td>{{ row.carrier_type }}</td><td class="fw-semibold">{{ row.balance }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.lhm.konten.eafcc18'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="inventory-count"><div class="row g-3"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ 'ui.v3.inventory.control.stichtagsinventur.f9613d5'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_count') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count') }}"><select class="form-select" name="warehouse_id">{% for warehouse in inventory.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="code" placeholder="{{ 'ui.v3.administration.role_new.code.adac693'|trans }}" required></div><div class="col-6"><input class="form-control" name="location_prefix" placeholder="{{ 'ui.v3.inventory.control.platzprafix.7044a90'|trans }}"></div><button class="btn btn-primary">{{ 'ui.v3.inventory.control.inventur.eroffnen.0c2a5fb'|trans }}</button></form><hr><h2 class="h5">{{ 'ui.v3.inventory.control.permanente.inventur.a9fe098'|trans }}</h2><form method="post" action="{{ path('v3_inventory_control_cycle_plan') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('inventory_cycle_plan') }}"><select class="form-select" name="warehouse_id">{% for warehouse in inventory.warehouses %}<option value="{{ warehouse.id }}">{{ warehouse.code }}</option>{% endfor %}</select><div class="col-6"><input class="form-control" name="code" placeholder="{{ 'ui.v3.inventory.control.plan.code.b727d0d'|trans }}" required></div><div class="col-6"><input class="form-control" name="location_prefix" placeholder="{{ 'ui.v3.administration.workspace.bereich.7a3ac9a'|trans }}"></div><div class="col-6"><input class="form-control" type="number" min="1" name="interval_days" value="30"></div><div class="col-6"><input class="form-control" type="datetime-local" name="next_due_at" required></div><button class="btn btn-outline-primary">{{ 'ui.v3.inventory.control.plan.speichern.7789519'|trans }}</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</th><th>{{ 'ui.v3.administration.workspace.typ.edcaf9a'|trans }}</th><th>{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</th><th>{{ 'ui.v3.inventory.control.zeilen.differenzen.1913336'|trans }}</th><th>{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for row in inventory.counts %}<tr><td>{{ row.code }}</td><td>{{ row.count_type }}</td><td>{{ row.status }}</td><td>{{ row.line_count }} / {{ row.difference_count }}</td><td>{% if row.status == 'open' %}<form method="post" action="{{ path('v3_inventory_control_submit',{countId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_submit_'~row.id) }}"><button class="btn btn-sm btn-outline-primary">{{ 'ui.v3.inventory.control.einreichen.262feac'|trans }}</button></form>{% elseif row.status == 'counted' %}<form method="post" action="{{ path('v3_inventory_control_approve',{countId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_approve_'~row.id) }}"><button class="btn btn-sm btn-primary">{{ 'ui.v3.inventory.control.freigeben.buchen.2bfaa3d'|trans }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.inventory.control.keine.inventuren.35e4fa7'|trans }}</td></tr>{% endfor %}</tbody></table></div></div><div class="card border-0 shadow-sm mt-3"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>{{ 'nav.inventory.headline'|trans }}</th><th>{{ 'nav.master_data.submenu.headline1'|trans }}</th><th>{{ 'ui.v3.inventory.control.soll.71afb3b'|trans }}</th><th>{{ 'ui.v3.inventory.control.ist.4594496'|trans }}</th><th>{{ 'ui.v3.inventory.control.zahlen.549a166'|trans }}</th></tr></thead><tbody>{% for row in inventory.countLines %}<tr><td>{{ row.count_code }}</td><td>{{ row.sku }}</td><td>{{ row.expected_quantity }}</td><td>{{ row.counted_quantity|default('–') }}</td><td><form class="d-flex" method="post" action="{{ path('v3_inventory_control_record',{countId:row.inventory_count_id,lineId:row.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('inventory_count_line_'~row.id) }}"><input class="form-control form-control-sm" type="number" name="quantity" value="{{ row.counted_quantity|default(row.expected_quantity) }}"><button class="btn btn-sm btn-outline-primary ms-2">{{ 'button.save'|trans }}</button></form></td></tr>{% endfor %}</tbody></table></div></div></div></div></div>
</div>
{% endblock %}
