{% extends 'v3/base.html.twig' %}
{% block title %}{{ label }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Vorgang starten</h1><p class="text-muted mb-0">{{ label }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_extension_index') }}">Zur Übersicht</a></div>
<div class="card border-0 shadow-sm"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_extension_work_item') }}"><div class="col-12"><label class="form-label">Referenz</label><input class="form-control" name="reference" maxlength="120" required></div><div class="col-12"><label class="form-label">Vorgangsdaten (JSON)</label><textarea class="form-control font-monospace" name="payload_json" rows="14" required>{}</textarea></div><div class="col-12"><button class="btn btn-primary">Vorgang anlegen</button></div></form></div></div>
{% endblock %}
