{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'ui.v3.extensions.index.erweiterte.funktionen'|trans }}</h1><p class="text-muted mb-0">{{ 'ui.v3.extensions.index.zentrale.konfigurationen.und.operative.vorgange'|trans }}</p></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">{{ 'ui.v3.extensions.index.konfigurationen'|trans }}</h2><span class="badge bg-primary-subtle text-primary">{{ workspace.configurations|length }}</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.bereich'|trans }}</th><th>{{ 'ui.v3.administration.role_new.code'|trans }}</th><th>{{ 'templates.correspondence.name'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th class="text-end">{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for item in workspace.configurations %}<tr><td>{{ workspace.resources[item.resource_type]|default(item.resource_type)|trans }}</td><td><code>{{ item.code }}</code></td><td>{{ item.name }}</td><td>{{ (item.active ? 'ui.user.user_input_fields.aktiv' : 'ui.v3.inventory.selection_rules.inaktiv')|trans }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_configuration_edit',{resource:item.resource_type,id:item.id}) }}">{{ 'button.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.extensions.index.noch.keine.konfigurationen'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-3 mb-4">{% for resource, label in workspace.resources %}<div class="col-md-6 col-xl-3"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_extension_configuration_new',{resource:resource}) }}"><div class="card-body"><strong>{{ label|trans }}</strong><div class="small text-muted mt-1">{{ 'ui.v3.extensions.index.konfiguration.anlegen'|trans }}</div></div></a></div>{% endfor %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.extensions.index.operative.vorgange'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'ui.v3.extensions.configuration_index.geandert'|trans }}</th><th>{{ 'ui.v3.extensions.index.workflow'|trans }}</th><th>{{ 'ui.stock.stock_rotation.referenz'|trans }}</th><th>{{ 'ui.transport_request.index.status'|trans }}</th><th class="text-end">{{ 'base.action'|trans }}</th></tr></thead><tbody>{% for item in workspace.workItems %}<tr><td>{{ item.changed_at }}</td><td>{{ workspace.workflows[item.workflow_type]|default(item.workflow_type)|trans }}</td><td>{{ item.reference }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ item.status }}</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_work_item_show',{id:item.id}) }}">{{ 'button.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'ui.v3.extensions.index.noch.keine.vorgange'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-3 mb-4">{% for workflow, label in workspace.workflows %}<div class="col-md-6 col-xl-3"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_extension_work_item_new',{workflow:workflow}) }}"><div class="card-body"><strong>{{ label|trans }}</strong><div class="small text-muted mt-1">{{ 'ui.v3.extensions.index.vorgang.starten'|trans }}</div></div></a></div>{% endfor %}</div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.extensions.index.login.historie'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>{{ 'ui.v3.administration.workspace.zeitpunkt'|trans }}</th><th>{{ 'ui.v3.extensions.index.kennung'|trans }}</th><th>{{ 'ui.v3.extensions.index.ergebnis'|trans }}</th><th>{{ 'ui.logging.index.ip.adresse'|trans }}</th></tr></thead><tbody>{% for event in workspace.loginEvents %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.user_identifier }}</td><td>{{ (event.successful ? 'ui.v3.extensions.index.choice.erfolgreich' : 'ui.v3.integration.automation.command-show.fehlgeschlagen')|trans }}</td><td>{{ event.client_ip|default('–') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'ui.v3.extensions.index.noch.keine.login.ereignisse'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
