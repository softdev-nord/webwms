{% extends 'v3/base.html.twig' %}
{% block title %}Erweiterte Funktionen | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Erweiterte Funktionen</h1><p class="text-muted mb-0">Zentrale Konfigurationen und operative Vorgänge</p></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Konfigurationen</h2><span class="badge bg-primary-subtle text-primary">{{ workspace.configurations|length }}</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Bereich</th><th>Code</th><th>Name</th><th>Status</th><th class="text-end">Aktion</th></tr></thead><tbody>{% for item in workspace.configurations %}<tr><td>{{ workspace.resources[item.resource_type]|default(item.resource_type) }}</td><td><code>{{ item.code }}</code></td><td>{{ item.name }}</td><td>{{ item.active ? 'Aktiv' : 'Inaktiv' }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_configuration_edit',{resource:item.resource_type,id:item.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Noch keine Konfigurationen.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-3 mb-4">{% for resource, label in workspace.resources %}<div class="col-md-6 col-xl-3"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_extension_configuration_new',{resource:resource}) }}"><div class="card-body"><strong>{{ label }}</strong><div class="small text-muted mt-1">Konfiguration anlegen</div></div></a></div>{% endfor %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">Operative Vorgänge</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Geändert</th><th>Workflow</th><th>Referenz</th><th>Status</th><th class="text-end">Aktion</th></tr></thead><tbody>{% for item in workspace.workItems %}<tr><td>{{ item.changed_at }}</td><td>{{ workspace.workflows[item.workflow_type]|default(item.workflow_type) }}</td><td>{{ item.reference }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ item.status }}</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_work_item_show',{id:item.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Noch keine Vorgänge.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-3 mb-4">{% for workflow, label in workspace.workflows %}<div class="col-md-6 col-xl-3"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_extension_work_item_new',{workflow:workflow}) }}"><div class="card-body"><strong>{{ label }}</strong><div class="small text-muted mt-1">Vorgang starten</div></div></a></div>{% endfor %}</div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">Login-Historie</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Zeitpunkt</th><th>Kennung</th><th>Ergebnis</th><th>IP-Adresse</th></tr></thead><tbody>{% for event in workspace.loginEvents %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.user_identifier }}</td><td>{{ event.successful ? 'Erfolgreich' : 'Fehlgeschlagen' }}</td><td>{{ event.client_ip|default('–') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Noch keine Login-Ereignisse.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
