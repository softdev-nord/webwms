{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms.5de7112'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ (configuration ? 'ui.v3.extensions.configuration_form.choice.konfiguration.bearbeiten.7569639' : 'ui.v3.extensions.index.konfiguration.anlegen.919f946')|trans }}</h1><p class="text-muted mb-0">{{ label|trans }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_extension_index') }}">{{ 'ui.v3.administration.api_client_edit.zur.ubersicht.90d08e2'|trans }}</a></div>
<div class="card border-0 shadow-sm"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_extension_configuration') }}"><div class="col-md-4"><label class="form-label">{{ 'ui.v3.administration.role_new.code.adac693'|trans }}</label><input class="form-control" name="code" maxlength="80" value="{{ configuration.code|default('') }}" required></div><div class="col-md-8"><label class="form-label">{{ 'templates.correspondence.name'|trans }}</label><input class="form-control" name="name" maxlength="160" value="{{ configuration.name|default('') }}" required></div><div class="col-12"><label class="form-label">{{ 'ui.v3.extensions.configuration_form.konfiguration.json.ec4bcf2'|trans }}</label><textarea class="form-control font-monospace" name="configuration_json" rows="14" required>{{ configuration ? configuration.configuration_json : '{}' }}</textarea><div class="form-text">{{ 'ui.v3.extensions.configuration_form.fachspezifische.parameter.werden.als.versionierbare.jso.fd50cd6'|trans }}</div></div><div class="col-12"><div class="form-check"><input type="checkbox" class="form-check-input" id="active" name="active" value="1" {{ configuration is null or configuration.active ? 'checked' : '' }}><label class="form-check-label" for="active">{{ 'ui.user.user_input_fields.aktiv.16a766c'|trans }}</label></div></div><div class="col-12"><button class="btn btn-primary">{{ 'button.save'|trans }}</button></div></form></div></div>
{% endblock %}
