{% extends 'v3/base.html.twig' %}
{% block title %}{{ label }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ configuration ? 'Konfiguration bearbeiten' : 'Konfiguration anlegen' }}</h1><p class="text-muted mb-0">{{ label }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_extension_index') }}">Zur Übersicht</a></div>
<div class="card border-0 shadow-sm"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_extension_configuration') }}"><div class="col-md-4"><label class="form-label">Code</label><input class="form-control" name="code" maxlength="80" value="{{ configuration.code|default('') }}" required></div><div class="col-md-8"><label class="form-label">Name</label><input class="form-control" name="name" maxlength="160" value="{{ configuration.name|default('') }}" required></div><div class="col-12"><label class="form-label">Konfiguration (JSON)</label><textarea class="form-control font-monospace" name="configuration_json" rows="14" required>{{ configuration ? configuration.configuration_json : '{}' }}</textarea><div class="form-text">Fachspezifische Parameter werden als versionierbare JSON-Konfiguration gespeichert.</div></div><div class="col-12"><div class="form-check"><input type="checkbox" class="form-check-input" id="active" name="active" value="1" {{ configuration is null or configuration.active ? 'checked' : '' }}><label class="form-check-label" for="active">Aktiv</label></div></div><div class="col-12"><button class="btn btn-primary">Speichern</button></div></form></div></div>
{% endblock %}
