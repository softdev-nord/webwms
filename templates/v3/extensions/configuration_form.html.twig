{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ (configuration ? 'extensions.configuration_form.edit_configuration' : 'extensions.index.create_configuration')|trans }}</h1><p class="text-muted mb-0">{{ label|trans }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_extension_index') }}">{{ 'administration.api_client_edit.go_to_overview'|trans }}</a></div>
<div class="card border-0 shadow-sm"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_extension_configuration') }}"><div class="col-md-4"><label class="form-label">{{ 'administration.role_new.code'|trans }}</label><input class="form-control" name="code" maxlength="80" value="{{ configuration.code|default('') }}" required></div><div class="col-md-8"><label class="form-label">{{ 'common.template.correspondence.name'|trans }}</label><input class="form-control" name="name" maxlength="160" value="{{ configuration.name|default('') }}" required></div><div class="col-12"><label class="form-label">{{ 'extensions.configuration_form.configuration_json'|trans }}</label><textarea class="form-control font-monospace" name="configuration_json" rows="14" required>{{ configuration ? configuration.configuration_json : '{}' }}</textarea><div class="form-text">{{ 'extensions.configuration_form.domain_specific_parameters_are_stored_as_versionable_json_configuration'|trans }}</div></div><div class="col-12"><div class="form-check"><input type="checkbox" class="form-check-input" id="active" name="active" value="1" {{ configuration is null or configuration.active ? 'checked' : '' }}><label class="form-check-label" for="active">{{ 'user.user_input_fields.active'|trans }}</label></div></div><div class="col-12"><button class="btn btn-primary">{{ 'common.button.save'|trans }}</button></div></form></div></div>
{% endblock %}
