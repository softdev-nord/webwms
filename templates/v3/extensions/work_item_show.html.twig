{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('ui.v3.subsections.title-meta.choice.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ item.reference }}</h1><p class="text-muted mb-0">{{ item.workflow_type }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_extension_index') }}">{{ 'ui.v3.administration.api_client_edit.zur.ubersicht'|trans }}</a></div>
<div class="row g-3"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.extensions.work_item_show.vorgangsdaten'|trans }}</h2></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">{{ 'ui.transport_request.index.status'|trans }}</dt><dd class="col-sm-9"><span class="badge bg-primary-subtle text-primary">{{ item.status }}</span></dd><dt class="col-sm-3">{{ 'ui.user.index.erstellt'|trans }}</dt><dd class="col-sm-9">{{ item.created_at }}</dd><dt class="col-sm-3">{{ 'ui.v3.extensions.configuration_index.geandert'|trans }}</dt><dd class="col-sm-9">{{ item.changed_at }}</dd><dt class="col-sm-3">{{ 'ui.v3.extensions.work_item_show.payload'|trans }}</dt><dd class="col-sm-9"><pre class="bg-light p-3 rounded mb-0"><code>{{ item.payload_json }}</code></pre></dd></dl></div></div></div><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'ui.v3.extensions.work_item_show.nachster.status'|trans }}</h2></div><div class="card-body">{% for status in transitions %}<form method="post" action="{{ path('v3_extension_work_item_transition',{id:item.id}) }}" class="mb-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_extension_transition_'~item.id) }}"><input type="hidden" name="status" value="{{ status }}"><button class="btn btn-outline-primary w-100">{{ status }}</button></form>{% else %}<p class="text-muted mb-0">{{ 'ui.v3.extensions.work_item_show.der.vorgang.befindet.sich.in.einem.endstatus'|trans }}</p>{% endfor %}</div></div></div></div>
{% endblock %}
