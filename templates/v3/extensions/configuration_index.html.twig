{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">{{ label|trans }}</h1><p class="text-muted mb-0">{{ 'extensions.configuration_index.manage_configurations'|trans }}</p></div>
    <div><a class="btn btn-outline-secondary me-2" href="{{ path('v3_extension_index') }}">{{ 'extensions.configuration_index.overall_overview'|trans }}</a>{% if is_granted('platform.extension.write') %}<a class="btn btn-primary" href="{{ path('v3_extension_configuration_new',{resource:resource}) }}">{{ 'administration.workspace.create'|trans }}</a>{% endif %}</div>
</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'administration.role_new.code'|trans }}</th><th>{{ 'common.template.correspondence.name'|trans }}</th><th>{{ 'transport_request.index.status'|trans }}</th><th>{{ 'extensions.configuration_index.modified'|trans }}</th><th class="text-end">{{ 'common.action'|trans }}</th></tr></thead><tbody>
{% for item in configurations %}<tr><td><code>{{ item.code }}</code></td><td>{{ item.name }}</td><td>{{ (item.active ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}</td><td>{{ item.updated_at }}</td><td class="text-end">{% if is_granted('platform.extension.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_configuration_edit',{resource:resource,id:item.id}) }}">{{ 'common.button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'extensions.configuration_index.no_entries_available'|trans }}</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}
