{% extends 'v3/base.html.twig' %}
{% block title %}{{ label }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">{{ label }}</h1><p class="text-muted mb-0">Konfigurationen verwalten</p></div>
    <div><a class="btn btn-outline-secondary me-2" href="{{ path('v3_extension_index') }}">Gesamtübersicht</a>{% if is_granted('platform.extension.write') %}<a class="btn btn-primary" href="{{ path('v3_extension_configuration_new',{resource:resource}) }}">Anlegen</a>{% endif %}</div>
</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Geändert</th><th class="text-end">Aktion</th></tr></thead><tbody>
{% for item in configurations %}<tr><td><code>{{ item.code }}</code></td><td>{{ item.name }}</td><td>{{ item.active ? 'Aktiv' : 'Inaktiv' }}</td><td>{{ item.updated_at }}</td><td class="text-end">{% if is_granted('platform.extension.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_configuration_edit',{resource:resource,id:item.id}) }}">Bearbeiten</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">Keine Einträge vorhanden.</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}
