{% extends 'v3/base.html.twig' %}
{% block webwms_content %}
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
		<div>
			<h1 class="h3 mb-1">{{ summary.tenant }}</h1>
			<p class="text-muted mb-0">Operativer Überblick</p>
		</div>

		{% if is_granted('inventory.stock.read') %}
			<a class="btn btn-primary" href="{{ path('v3_stock') }}">Bestand öffnen</a>
		{% endif %}
	</div>

	<div class="row g-3 mb-4">
		{% for label, value in {'Artikel': summary.products, 'Lager': summary.warehouses, 'Lagerplätze': summary.locations, 'Bestandsmenge': summary.stock} %}
			<div class="col-sm-6 col-xl-3">
				<div class="card h-100">
					<div class="card-body card-animate">
						<div class="text-muted text-uppercase small">{{ label }}</div>
						<div class="display-6 mt-2">{{ value|number_format(0, ',', '.') }}</div>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

	<div class="card border-0 shadow-sm">
		<div class="card-header">
			<h2 class="h5 mb-0">Fulfillment</h2>
		</div>

		<div class="card-body">
			<div class="row g-3 text-center">
				{% for label, value in {'Ausgangsaufträge': summary.outboundOrders, 'Picklisten': summary.pickLists, 'Packaufträge': summary.packingOrders, 'Sendungen': summary.shipments} %}
					<div class="col-6 col-lg-3">
						<div class="h3 mb-1">{{ value }}</div>
						<div class="text-muted">{{ label }}</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
{% endblock %}
