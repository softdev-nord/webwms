{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<h1 class="h3 mb-1">{{ 'ui.v3.integration.device.scan.versand'|trans }}</h1>
		<p class="text-muted mb-0">{{ 'ui.v3.shipping.index.labels.tracking.und.ubergabe.an.den.frachtfuhrer'|trans }}</p>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'ui.v3.integration.device.scan.sendung'|trans }}</th>
						<th>{{ 'ui.v3.administration.workspace.carrier'|trans }}</th>
						<th>{{ 'ui.v3.outbound.control.service'|trans }}</th>
						<th>{{ 'ui.transport_request.index.status'|trans }}</th>
						<th>{{ 'ui.v3.loading.show.tracking'|trans }}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for shipment in shipments %}
						<tr>
							<td class="fw-semibold">{{ shipment.shipment_number }}</td>
							<td>{{ shipment.carrier }}</td>
							<td>{{ shipment.service }}</td>
							<td>{{ shipment.status }}</td>
							<td>{{ shipment.tracking_number ?: '–' }}</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_shipping_show', {shipmentId: shipment.id}) }}">{{ 'ui.v3.inbound.index.offnen'|trans }}</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-5">{{ 'ui.v3.shipping.index.noch.keine.sendungen.vorhanden'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
