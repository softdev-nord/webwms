{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="mb-4"><h1 class="h3 mb-1">{{ 'inventory.overview.warehouse_overview'|trans }}</h1><p class="text-muted mb-0">{{ 'inventory.overview.storage_types_location_occupancy_and_available_capacity'|trans }}</p></div>
<div class="row g-3 mb-4">{% for warehouse in overview.warehouses %}{% set utilization = warehouse.total_capacity > 0 ? min(100, (warehouse.stock_quantity / warehouse.total_capacity * 100)|round) : 0 %}<div class="col-xl-4 col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex justify-content-between"><div><h2 class="h5 mb-1">{{ warehouse.code }}</h2><p class="text-muted mb-3">{{ warehouse.name }} · {{ warehouse.warehouse_type }}</p></div><span class="badge bg-primary-subtle text-primary align-self-start">{{ warehouse.occupied_bin_count }}/{{ warehouse.bin_count }} {{ 'inventory.overview.locations'|trans }}</span></div><div class="d-flex justify-content-between small mb-1"><span>{{ 'inventory.overview.capacity_utilization'|trans }}</span><strong>{{ utilization }} %</strong></div><div class="progress" style="height: 8px"><div class="progress-bar" style="width: {{ utilization }}%"></div></div><div class="row text-center mt-3"><div class="col"><div class="fw-semibold">{{ warehouse.stock_quantity }}</div><div class="small text-muted">{{ 'article.index.stock'|trans }}</div></div><div class="col"><div class="fw-semibold">{{ warehouse.total_capacity == 0 ? '∞' : max(0, warehouse.total_capacity - warehouse.stock_quantity) }}</div><div class="small text-muted">{{ 'dashboard.index.available'|trans }}</div></div></div></div></div></div>{% else %}<div class="col"><div class="alert alert-info">{{ 'inventory.overview.no_warehouses_exist_yet'|trans }}</div></div>{% endfor %}</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>{{ 'administration.workspace.area'|trans }}</th><th>{{ 'administration.workspace.type'|trans }}</th><th class="text-end">{{ 'inventory.overview.locations'|trans }}</th><th class="text-end">{{ 'dashboard.index.occupied'|trans }}</th><th class="text-end">{{ 'article.index.stock'|trans }}</th><th class="text-end">{{ 'inventory.overview.capacity'|trans }}</th><th class="text-end">{{ 'dashboard.index.available'|trans }}</th></tr></thead><tbody>{% for area in overview.areas %}<tr><td><strong>{{ area.code }}</strong> · {{ area.name }}</td><td>{{ area.area_type }}</td><td class="text-end">{{ area.bin_count }}</td><td class="text-end">{{ area.occupied_bin_count }}</td><td class="text-end">{{ area.stock_quantity }}</td><td class="text-end">{{ area.total_capacity == 0 ? '∞' : area.total_capacity }}</td><td class="text-end">{{ area.total_capacity == 0 ? '∞' : max(0, area.total_capacity - area.stock_quantity) }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-5">{{ 'inventory.overview.no_warehouse_areas_exist_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
