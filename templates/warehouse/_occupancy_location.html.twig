{% set utilization = location.capacity_quantity > 0 ? min(100, (location.stock_quantity / location.capacity_quantity * 100)|round) : 0 %}
{% set state = location.stock_quantity == 0 ? 'empty' : (location.blocked_quantity > 0 ? 'blocked' : (location.quality_quantity > 0 ? 'quality' : (location.capacity_quantity > 0 and location.stock_quantity >= location.capacity_quantity ? 'full' : 'occupied'))) %}

<a href="{{ path('v3_stock', {warehouse: location.warehouse_id}) }}" class="occupancy-bin occupancy-bin--{{ state }} occupancy-bin--{{ variant|default('card') }} text-decoration-none" title="{{ location.location_code }} · {{ location.product_skus ?: ('inventory.occupancy.no_stock'|trans) }}">
    <div class="d-flex justify-content-between gap-2">
        <span class="occupancy-bin-code">
            {{ location.location_code }}
        </span>

        {% if showDepth|default(false) %}
            <span class="badge bg-light text-body">
                {{ 'warehouse.topology_fields.depth'|trans }} {{ location.depth_number ?: '–' }}
            </span>
        {% endif %}
    </div>

    {% if variant|default('card') == 'card' %}
        <div class="occupancy-bin-meta mt-1">
            {{ 'warehouse.topology_fields.level'|trans }} {{ location.level_number ?: location.level_code ?: '–' }} · {{ 'warehouse.topology_fields.slot'|trans }} {{ location.slot_number ?: '–' }}
        </div>
    {% endif %}

    <div class="d-flex justify-content-between align-items-end mt-2">
        <div>
            <div class="occupancy-bin-quantity">
                {{ location.stock_quantity }}
                {% if location.capacity_quantity > 0 %}
                    / {{ location.capacity_quantity }}
                {% endif %}

            </div>
            <div class="occupancy-bin-meta">
                {{ 'article.index.stock'|trans }}
                {% if location.capacity_quantity <= 0 %}
                    {{ 'inventory.occupancy.unlimited'|trans }}
                {% endif %}
            </div>
        </div>

        {% if variant|default('card') == 'card' %}
            <div class="text-end">
                <strong>
                    {{ location.product_count }}
                </strong>
                <div class="occupancy-bin-meta">
                    {{ 'navigation.master_data.submenu.headline1.label'|trans }}
                </div>
            </div>
        {% endif %}
    </div>

    {% if location.capacity_quantity > 0 %}
        <div class="progress mt-2" style="height: 5px">
            <div class="progress-bar {{ state in ['blocked', 'full'] ? 'bg-danger' : (state == 'quality' ? 'bg-warning' : 'bg-success') }}" style="width: {{ utilization }}%">
            </div>
        </div>
    {% endif %}

    <div class="occupancy-bin-meta text-truncate mt-2">
        {{ location.product_skus ?: ('dashboard.index.available'|trans) }}
    </div>
</a>
