{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ 'inventory.selection_rules.picking_strategies'|trans }}
            </h1>
            <p class="text-muted mb-0">
                {{ 'inventory.selection_rules.configure_fifo_lifo_and_fefo_for_automatic_stock_selection'|trans }}
            </p>
        </div>

        {% if is_granted('inventory.selection_rule.write') %}

            <a class="btn btn-primary" href="{{ path('v3_inventory_selection_rule_new') }}">
                <i class="ri-add-line me-1">
                </i>
                {{ 'inventory.selection_rules.create_rule'|trans }}
            </a>

        {% endif %}

    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">
                {{ 'inventory.selection_rules.configured_rules'|trans }}
            </h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            {{ 'inventory.configuration_form.priority'|trans }}
                        </th>
                        <th>
                            {{ 'inventory.selection_rules.rule'|trans }}
                        </th>
                        <th>
                            {{ 'inventory.configuration_form.strategy'|trans }}
                        </th>
                        <th>
                            {{ 'inventory.selection_rules.scope'|trans }}
                        </th>
                        <th>
                            {{ 'transport_request.index.status'|trans }}
                        </th>
                        <th class="text-end" data-orderable="false" data-searchable="false">
                            {{ 'administration.api_clients.actions'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody>

                    {% for rule in rules %}

                        <tr>
                            <td>
                                {{ rule.priority }}
                            </td>
                            <td>
                                <strong>
                                    {{ rule.code }}
                                </strong>
                                <div class="small text-muted">
                                    {{ rule.name }}
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">
                                    {{ rule.strategy|upper }}
                                </span>
                            </td>
                            <td>
                                {{ rule.warehouse_code ?: ('inventory.configuration_form.all_warehouses'|trans) }}
                                <div class="small text-muted">
                                    {{ rule.product_sku ?: ('inventory.configuration_form.all_items'|trans) }}
                                </div>
                            </td>
                            <td>

                                {% if rule.enabled %}

                                    <span class="badge bg-success-subtle text-success">
                                        {{ 'user.user_input_fields.active'|trans }}
                                    </span>

                                {% else %}

                                    <span class="badge bg-secondary-subtle text-secondary">
                                        {{ 'inventory.selection_rules.inactive'|trans }}
                                    </span>

                                {% endif %}

                            </td>
                            <td class="text-end">

                                {% if is_granted('inventory.selection_rule.write') %}

                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_selection_rule_edit', {ruleId: rule.id}) }}">
                                        <i class="ri-pencil-line me-1">
                                        </i>
                                        {{ 'common.button.edit'|trans }}
                                    </a>

                                {% endif %}

                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                {{ 'inventory.selection_rules.no_picking_rule_exists_yet'|trans }}
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>
            </table>
        </div>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0">
                {{ 'inventory.selection_rules.execution_log'|trans }}
            </h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            {{ 'administration.workspace.time_point_in_time'|trans }}
                        </th>
                        <th>
                            {{ 'inventory.selection_rules.rule'|trans }}
                        </th>
                        <th>
                            {{ 'navigation.master_data.submenu.headline1.label'|trans }}
                        </th>
                        <th>
                            {{ 'inventory.selection_rules.reservation'|trans }}
                        </th>
                        <th>
                            {{ 'extensions.index.result'|trans }}
                        </th>
                        <th>
                            {{ 'navigation.user.user'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody>

                    {% for event in events %}

                        <tr>
                            <td>
                                {{ event.occurred_at|date('d.m.Y H:i:s') }}
                            </td>
                            <td>
                                {{ event.rule_code }} · {{ event.strategy|upper }}
                            </td>
                            <td>
                                {{ event.sku }}
                            </td>
                            <td>
                                <code>
                                    {{ event.reservation_id }}
                                </code>
                            </td>
                            <td>
                                {{ event.allocated_quantity }} / {{ event.requested_quantity }} {{ 'inventory.selection_rules.from'|trans }} {{ event.candidate_count }} {{ 'inventory.selection_rules.candidates'|trans }}
                            </td>
                            <td>
                                {{ event.performed_by_name }}
                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                {{ 'inventory.selection_rules.no_automatic_selection_performed_yet'|trans }}
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
