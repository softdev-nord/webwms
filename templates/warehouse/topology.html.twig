{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'inventory.topology.warehouse_topology'|trans }}</h1><p class="text-muted mb-0">{{ 'inventory.topology.overview_of_sites_warehouses_areas_aisles_and_storage_bins'|trans }}</p></div>{% if is_granted('inventory.topology.write') %}<div class="dropdown"><button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown"><i class="ri-add-line me-1"></i>{{ 'administration.workspace.create'|trans }}</button><div class="dropdown-menu dropdown-menu-end">{% for resource,label in {site:'topology.site.location',warehouse:'topology.warehouse.warehouse',area:'topology.area.area',aisle:'topology.aisle.aisle',bin:'topology.bin.storage_bin'} %}<a class="dropdown-item" href="{{ path('v3_inventory_topology_new',{resource:resource}) }}">{{ label|trans }}</a>{% endfor %}</div></div>{% endif %}</div>
<form method="get" class="card border-0 shadow-sm mb-3"><div class="card-body row align-items-end g-3"><div class="col-md-6"><label class="form-label" for="topology-site">{{ 'warehouse.topology.site_filter'|trans }}</label><select class="form-select" id="topology-site" name="site">{% for site in topology.sites %}<option value="{{ site.id }}" {{ site.id == selectedSiteId ? 'selected' : '' }}>{{ site.code }} – {{ site.name }}</option>{% endfor %}</select><div class="form-text">{{ 'warehouse.topology.site_scope_hint'|trans }}</div></div><div class="col-auto"><button class="btn btn-outline-primary">{{ 'common.button.apply'|trans }}</button></div></div></form>
<ul class="nav nav-tabs nav-tabs-custom mb-3">{% for tab in [{target:'sites',label:'topology.sites.locations',count:topology.sites|length},{target:'warehouses',label:'topology.warehouse.warehouse',count:topology.warehouses|length},{target:'areas',label:'topology.areas.areas',count:topology.areas|length},{target:'aisles',label:'topology.aisles.aisles',count:topology.aisles|length},{target:'bins',label:'topology.bins.storage_locations',count:topology.bins|length}] %}<li class="nav-item"><button class="nav-link {{ loop.first ? 'active':'' }}" data-bs-toggle="tab" data-bs-target="#topology-{{ tab.target }}">{{ tab.label|trans }} <span class="badge bg-light text-body ms-1">{{ tab.count }}</span></button></li>{% endfor %}</ul>
<div class="tab-content">
{% set definitions = {
sites:{resource:'site',headers:['Code','Name','topology.header.timezone.time_zone','topology.header.status.status'],fields:['code','name','timezone','status']},
warehouses:{resource:'warehouse',headers:['topology.site.location','Code','Name','topology.header.type.type'],fields:['site_code','code','name','warehouse_type']},
areas:{resource:'area',headers:['topology.site.location','topology.warehouse.warehouse','Code','Name','topology.header.type.type'],fields:['site_code','warehouse_code','code','name','area_type']},
aisles:{resource:'aisle',headers:['topology.site.location','topology.warehouse.warehouse','topology.area.area','Code','Name'],fields:['site_code','warehouse_code','area_code','code','name']},
bins:{resource:'bin',headers:['topology.warehouse.warehouse','topology.area.area','topology.aisle.aisle','warehouse.topology_fields.coordinate','warehouse.topology_fields.level','warehouse.topology_fields.slot','warehouse.topology_fields.depth','warehouse.topology_fields.zone','topology.header.type.type'],fields:['warehouse_id','area_id','aisle_id','coordinate','level_number','slot_number','depth_number','zone_code','location_type']}
} %}
{% for key,definition in definitions %}<div class="tab-pane fade {{ loop.first ? 'show active':'' }}" id="topology-{{ key }}"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr>{% for header in definition.headers %}<th>{{ header|trans }}</th>{% endfor %}<th class="text-end" data-orderable="false" data-searchable="false">{{ 'administration.api_clients.actions'|trans }}</th></tr></thead><tbody>{% for row in attribute(topology,key) %}<tr>{% for field in definition.fields %}<td>{% if key == 'bins' and field == 'warehouse_id' %}{{ row.site_code }} / {{ row.warehouse_code }}{% elseif key == 'bins' and field == 'area_id' %}{{ row.area_code|default('–') }}{% elseif key == 'bins' and field == 'aisle_id' %}{{ row.aisle_code|default('–') }}{% elseif field == 'capacity_quantity' %}{{ attribute(row,field) == 0 ? 'common.unlimited.unlimited'|trans : attribute(row,field) }}{% else %}{{ attribute(row,field)|default('–') }}{% endif %}</td>{% endfor %}<td class="text-end">{% if is_granted('inventory.topology.write') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_topology_edit',{resource:definition.resource,id:row.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'common.button.edit'|trans }}</a>{% endif %}</td></tr>{% else %}<tr><td colspan="{{ definition.headers|length + 1 }}" class="text-center text-muted py-5">{{ 'extensions.configuration_index.no_entries_available'|trans }}</td></tr>{% endfor %}</tbody></table></div></div></div>{% endfor %}
</div>
{% endblock %}
