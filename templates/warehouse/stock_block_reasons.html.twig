{% extends 'v3/base.html.twig' %}

{% block title %}
    {{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0
{% endblock %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ 'inventory.stock_block_reasons.blocking_reasons'|trans }}
            </h1>
            <p class="text-muted mb-0">
                {{ 'inventory.stock_block_reasons.centrally_manage_reasons_for_blocking_stock'|trans }}
            </p>
        </div>

        {% if is_granted('inventory.stock_block.write') %}

            <a class="btn btn-primary" href="{{ path('v3_inventory_stock_block_reason_new') }}">
                <i class="ri-add-line me-1">
                </i>
                {{ 'inventory.stock_block_reasons.create_blocking_reason'|trans }}
            </a>

        {% endif %}

    </div>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            {{ 'administration.role_new.code'|trans }}
                        </th>
                        <th>
                            {{ 'common.template.correspondence.name'|trans }}
                        </th>
                        <th>
                            {{ 'user.user_group.index.description'|trans }}
                        </th>
                        <th>
                            {{ 'transport_request.index.status'|trans }}
                        </th>
                        <th class="text-end" data-orderable="false" data-searchable="false">
                            {{ 'administration.api_clients.actions'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody>

                    {% for reason in reasons %}

                        <tr>
                            <td>
                                <strong>
                                    {{ reason.code }}
                                </strong>
                            </td>
                            <td>
                                {{ reason.name }}
                            </td>
                            <td>
                                {{ reason.description ?: '–' }}
                            </td>
                            <td>
                                <span class="badge bg-{{ reason.active ? 'success' : 'secondary' }}-subtle text-{{ reason.active ? 'success' : 'secondary' }}">
                                    {{ (reason.active ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}
                                </span>
                            </td>
                            <td class="text-end">

                                {% if is_granted('inventory.stock_block.write') %}

                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_stock_block_reason_edit', {reasonId: reason.id}) }}">
                                        <i class="ri-pencil-line me-1">
                                        </i>
                                        {{ 'common.button.edit'|trans }}
                                    </a>

                                {% endif %}

                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                {{ 'inventory.stock_block_reasons.no_blocking_reasons_available'|trans }}
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
