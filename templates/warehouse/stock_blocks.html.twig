{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><h1 class="h3 mb-1">{{ 'inventory.stock_blocks.stock_blocks'|trans }}</h1><p class="text-muted mb-0">{{ 'inventory.stock_blocks.block_stock_with_justification_inspect_independently_and_release_in_cont'|trans }}</p></div></div>


	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'inventory.stock_block_new.block_stock'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'navigation.master_data.submenu.headline1.label'|trans }}</th><th>{{ 'modal.show_article_stock_details_modal.storage_bin'|trans }}</th><th>{{ 'inventory.special_stock.dimension'|trans }}</th><th class="text-end">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</th><th>{{ 'inventory.stock_blocks.block'|trans }}</th></tr></thead><tbody>
	{% for row in stock|filter(row => row.quantity > 0 and row.stock_status != 'blocked') %}<tr><td><strong>{{ row.sku }}</strong><div class="small text-muted">{{ row.product_name }}</div></td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}{% if row.batch_number %}<div class="small text-muted">{{ 'modal.stock_in_modal.batch'|trans }} {{ row.batch_number }}</div>{% endif %}{% if row.serial_number %}<div class="small text-muted">{{ 'inventory.movements.sn'|trans }} {{ row.serial_number }}</div>{% endif %}{% if row.expires_at %}<div class="small text-muted">{{ 'inventory.stock_blocks.bbd'|trans }} {{ row.expires_at|date('d.m.Y') }}</div>{% endif %}</td><td class="text-end">{{ row.quantity }}</td><td>{% if is_granted('inventory.stock_block.write') and reasons|filter(reason => reason.active)|length > 0 %}<a class="btn btn-sm btn-outline-danger" href="{{ path('v3_inventory_stock_block_new', {product:row.product_id,location:row.location_id,stock_key:row.stock_key}) }}">{{ 'inbound.control.block'|trans }}</a>{% else %}<span class="text-muted">{{ 'inventory.stock_blocks.no_active_blocking_reason'|trans }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'inventory.stock_blocks.no_stock_available_for_blocking'|trans }}</td></tr>{% endfor %}
	</tbody></table></div></div>

	<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'inventory.stock_blocks.block_list'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'transport_request.index.status'|trans }}</th><th>{{ 'navigation.master_data.submenu.headline1.label'|trans }}</th><th>{{ 'inventory.movements.reason'|trans }}</th><th>{{ 'article.index.stock'|trans }}</th><th class="text-end" data-orderable="false" data-searchable="false">{{ 'administration.api_clients.actions'|trans }}</th></tr></thead><tbody>
	{% for block in blocks %}<tr><td>{% if block.status == 'open' %}<span class="badge bg-warning-subtle text-warning">{{ 'customer_order.index.open'|trans }}</span>{% elseif block.status == 'reviewed' %}<span class="badge bg-info-subtle text-info">{{ 'inventory.stock_blocks.inspected'|trans }}</span>{% else %}<span class="badge bg-success-subtle text-success">{{ 'inventory.stock_blocks.released'|trans }}</span>{% endif %}</td><td><strong>{{ block.sku }}</strong><div class="small text-muted">{{ block.location_code }} · {{ block.quantity }} {{ 'inventory.stock_blocks.pcs'|trans }}</div></td><td>{{ block.reason_code }} · {{ block.reason_name }}<div class="small text-muted">{{ block.note }}</div></td><td>{{ block.original_status }} {{ 'inventory.stock_blocks.blocked'|trans }}{% if block.batch_number %}<div class="small text-muted">{{ 'modal.stock_in_modal.batch'|trans }} {{ block.batch_number }}</div>{% endif %}{% if block.serial_number %}<div class="small text-muted">{{ 'inventory.movements.sn'|trans }} {{ block.serial_number }}</div>{% endif %}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_inventory_stock_block_show', {blockId:block.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'common.button.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'inventory.stock_blocks.no_stock_block_exists_yet'|trans }}</td></tr>{% endfor %}
	</tbody></table></div></div>
{% endblock %}
