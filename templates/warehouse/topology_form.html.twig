{% extends 'v3/base.html.twig' %}
{% set labels = {site:'topology.site.location',warehouse:'topology.warehouse.warehouse',area:'Lagerbereich',aisle:'Lagergang',bin:'topology.bin.storage_bin'} %}
{% set editing = entry is not null %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ labels[resource] }} {{ editing ? 'bearbeiten' : 'anlegen' }}</h1><p class="text-muted mb-0">{{ 'inventory.topology_form.manage_warehouse_topology_in_structured_way'|trans }}</p></div><a class="btn btn-outline-secondary" href="{{ path('v3_inventory_topology') }}"><i class="ri-arrow-left-line me-1"></i>{{ 'administration.api_client_edit.go_to_overview'|trans }}</a></div>
<div class="row"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body">
{% if editing %}
<form method="post" action="{{ path('v3_inventory_topology_update',{resource:resource,id:entry.id}) }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_topology_update_'~resource~'_'~entry.id) }}">
{% elseif resource == 'site' %}<form method="post" action="{{ path('v3_inventory_site_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_site_create') }}">
{% elseif resource == 'warehouse' %}<form method="post" action="{{ path('v3_inventory_warehouse_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_warehouse_create') }}">
{% elseif resource == 'area' %}<form method="post" action="{{ path('v3_inventory_area_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_area_create') }}">
{% elseif resource == 'aisle' %}<form method="post" action="{{ path('v3_inventory_aisle_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_aisle_create') }}">
{% else %}<form method="post" action="{{ path('v3_inventory_bin_create') }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_bin_create') }}">{% endif %}
{% if resource == 'warehouse' %}<div class="col-12"><label class="form-label">{{ 'administration.workspace.location'|trans }}</label><select class="form-select" name="site_id" required>{% for row in topology.sites %}<option value="{{ row.id }}" {{ entry and entry.site_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource in ['area','bin'] %}<div class="col-12"><label class="form-label">{{ 'navigation.master_data.submenu.headline4.label'|trans }}</label><select class="form-select" name="warehouse_id" required>{% for row in topology.warehouses %}<option value="{{ row.id }}" {{ entry and entry.warehouse_id == row.id ? 'selected':'' }}>{{ row.site_code }} / {{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'aisle' %}<div class="col-12"><label class="form-label">{{ 'administration.workspace.area'|trans }}</label><select class="form-select" name="area_id" required>{% for row in topology.areas %}<option value="{{ row.id }}" {{ entry and entry.area_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'bin' %}<div class="col-md-6"><label class="form-label">{{ 'administration.workspace.area'|trans }}</label><select class="form-select" name="area_id" required>{% for row in topology.areas %}<option value="{{ row.id }}" {{ entry and entry.area_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div><div class="col-md-6"><label class="form-label">{{ 'inventory.occupancy.aisle'|trans }}</label><select class="form-select" name="aisle_id" required>{% for row in topology.aisles %}<option value="{{ row.id }}" {{ entry and entry.aisle_id == row.id ? 'selected':'' }}>{{ row.code }} · {{ row.name }}</option>{% endfor %}</select></div>{% endif %}
{% if resource != 'bin' %}<div class="col-md-4"><label class="form-label">{{ 'administration.role_new.code'|trans }}</label><input class="form-control" name="code" value="{{ entry.code|default('') }}" required></div><div class="col-md-8"><label class="form-label">{{ 'common.template.correspondence.name'|trans }}</label><input class="form-control" name="name" value="{{ entry.name|default('') }}" required></div>{% endif %}
{% if resource == 'site' %}<div class="col-md-8"><label class="form-label">{{ 'inventory.topology_form.time_zone'|trans }}</label><input class="form-control" name="timezone" value="{{ entry.timezone|default('Europe/Berlin') }}" required></div>{% if editing %}<div class="col-md-4"><label class="form-label">{{ 'transport_request.index.status'|trans }}</label><select class="form-select" name="status"><option value="active" {{ entry.status == 'active' ? 'selected':'' }}>{{ 'user.user_input_fields.active'|trans }}</option><option value="inactive" {{ entry.status == 'inactive' ? 'selected':'' }}>{{ 'inventory.selection_rules.inactive'|trans }}</option></select></div>{% endif %}{% endif %}
{% if resource == 'warehouse' %}<div class="col-12"><label class="form-label">{{ 'inventory.topology_form.warehouse_type'|trans }}</label><select class="form-select" name="warehouse_type">{% for value,label in {standard:'Standard',high_bay:'Hochregal',block:'Blocklager',automated:'Automatisiert'} %}<option value="{{ value }}" {{ entry and entry.warehouse_type == value ? 'selected':'' }}>{{ label|trans }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'area' %}<div class="col-12"><label class="form-label">{{ 'inventory.topology_form.area_type'|trans }}</label><select class="form-select" name="area_type">{% for value,label in {storage:'topology.type.storage.storage',receiving:'topology.type.receiving.goods_receipt',shipping:'topology.type.shipping.shipping',quality:'topology.type.quality.quality',blocked:'topology.type.blocked_storage.blocked_stock'} %}<option value="{{ value }}" {{ entry and entry.area_type == value ? 'selected':'' }}>{{ label|trans }}</option>{% endfor %}</select></div>{% endif %}
{% if resource == 'bin' %}<div class="col-md-3"><label class="form-label">{{ 'warehouse.topology_fields.warehouse_number'|trans }}</label><input class="form-control" type="number" min="1" max="999" name="warehouse_number" value="{{ entry.warehouse_number|default('') }}" required></div><div class="col-md-3"><label class="form-label">{{ 'warehouse.topology_fields.level'|trans }}</label><input class="form-control" type="number" min="1" max="9999" name="level_number" value="{{ entry.level_number|default('') }}" required></div><div class="col-md-3"><label class="form-label">{{ 'warehouse.topology_fields.slot'|trans }}</label><input class="form-control" type="number" min="1" max="9999" name="slot_number" value="{{ entry.slot_number|default('') }}" required></div><div class="col-md-3"><label class="form-label">{{ 'warehouse.topology_fields.depth'|trans }}</label><input class="form-control" type="number" min="1" max="9999" name="depth_number" value="{{ entry.depth_number|default('') }}" required></div><div class="col-md-6"><label class="form-label">{{ 'warehouse.topology_fields.description'|trans }}</label><input class="form-control" name="description" maxlength="255" value="{{ entry.description|default('') }}" required></div><div class="col-md-3"><label class="form-label">{{ 'warehouse.topology_fields.zone'|trans }}</label><input class="form-control text-uppercase" name="zone_code" maxlength="30" value="{{ entry.zone_code|default('') }}" required></div><div class="col-md-3"><label class="form-label">{{ 'administration.workspace.type'|trans }}</label><select class="form-select" name="location_type">{% for value,label in {storage:'topology.type.storage.storage',receiving:'topology.type.receiving.goods_receipt',shipping:'topology.type.shipping.shipping',quality:'topology.type.quality.quality',blocked:'topology.type.blocked.blocked'} %}<option value="{{ value }}" {{ entry and entry.location_type == value ? 'selected':'' }}>{{ label|trans }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label">{{ 'warehouse.topology_fields.width_mm'|trans }}</label><input class="form-control" type="number" min="0" step="0.01" name="width_mm" value="{{ entry.width_mm|default(0) }}" required></div><div class="col-md-4"><label class="form-label">{{ 'warehouse.topology_fields.physical_depth_mm'|trans }}</label><input class="form-control" type="number" min="0" step="0.01" name="physical_depth_mm" value="{{ entry.physical_depth_mm|default(0) }}" required></div><div class="col-md-4"><label class="form-label">{{ 'warehouse.topology_fields.height_mm'|trans }}</label><input class="form-control" type="number" min="0" step="0.01" name="height_mm" value="{{ entry.height_mm|default(0) }}" required></div>{% if editing %}<div class="col-md-6"><label class="form-label">{{ 'inventory.topology_form.put_away_priority'|trans }}</label><input class="form-control" type="number" min="0" name="putaway_priority" value="{{ entry.putaway_priority|default(100) }}"></div><div class="col-md-6 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="putaway_enabled" value="1" id="putaway-enabled" {{ entry.putaway_enabled ? 'checked':'' }}><label class="form-check-label" for="putaway-enabled">{{ 'inventory.topology_form.put_away_allowed'|trans }}</label></div></div>{% endif %}{% endif %}
<div class="col-12 d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_inventory_topology') }}">{{ 'common.button.cancel'|trans }}</a><button class="btn btn-primary">{{ (editing ? 'administration.api_client_edit.save_changes' : 'administration.workspace.create')|trans }}</button></div></form>
</div></div></div></div>
{% endblock %}
