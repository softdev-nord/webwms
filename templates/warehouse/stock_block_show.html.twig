{% extends 'v3/base.html.twig' %}

{% block title %}
    {{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0
{% endblock %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ 'inventory.stock_block_show.edit_stock_block'|trans }}
            </h1>
            <p class="text-muted mb-0">
                {{ block.sku }} · {{ block.location_code }} · {{ block.quantity }} {{ 'inventory.special_stock_classify.piece'|trans }}
            </p>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path('v3_inventory_stock_blocks') }}">
            {{ 'administration.api_client_edit.go_to_overview'|trans }}
        </a>
    </div>
    <div class="row g-4">
        <div class="col-xl-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <dl class="row mb-4">
                        <dt class="col-5">
                            {{ 'transport_request.index.status'|trans }}
                        </dt>
                        <dd class="col-7">
                            {{ block.status }}
                        </dd>
                        <dt class="col-5">
                            {{ 'inventory.stock_block_new.blocking_reason'|trans }}
                        </dt>
                        <dd class="col-7">
                            {{ block.reason_code }} · {{ block.reason_name }}
                        </dd>
                        <dt class="col-5">
                            {{ 'inventory.stock_block_new.reason'|trans }}
                        </dt>
                        <dd class="col-7">
                            {{ block.note }}
                        </dd>
                    </dl>

                    {% if block.status == 'open' and is_granted('inventory.stock_block.review') %}

                        <form method="post" action="{{ path('v3_inventory_stock_block_review', {blockId: block.id}) }}" class="row g-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_review_' ~ block.id) }}">
                            <label class="form-label">
                                {{ 'inventory.stock_block_show.inspection_result'|trans }}
                            </label>
                            <textarea class="form-control" name="note" required>
                            </textarea>
                            <button class="btn btn-primary">
                                {{ 'inventory.stock_block_show.check_block'|trans }}
                            </button>
                        </form>

                    {% elseif block.status == 'reviewed' and is_granted('inventory.stock_block.release') %}

                        <form method="post" action="{{ path('v3_inventory_stock_block_release', {blockId: block.id}) }}" class="row g-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('v3_inventory_stock_block_release_' ~ block.id) }}">
                            <label class="form-label">
                                {{ 'inventory.stock_block_show.release_note'|trans }}
                            </label>
                            <textarea class="form-control" name="note" required>
                            </textarea>
                            <button class="btn btn-success">
                                {{ 'inventory.stock_block_show.release_stock'|trans }}
                            </button>
                        </form>

                    {% else %}

                        <div class="alert alert-light mb-0">
                            {{ 'inventory.stock_block_show.no_action_available_for_current_status'|trans }}
                        </div>

                    {% endif %}

                </div>
            </div>
        </div>
        <div class="col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header">
                    <h2 class="h5 mb-0">
                        {{ 'inventory.stock_block_show.block_log'|trans }}
                    </h2>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    {{ 'administration.workspace.time_point_in_time'|trans }}
                                </th>
                                <th>
                                    {{ 'administration.workspace.event'|trans }}
                                </th>
                                <th>
                                    {{ 'inventory.control.note'|trans }}
                                </th>
                                <th>
                                    {{ 'navigation.user.user'|trans }}
                                </th>
                            </tr>
                        </thead>
                        <tbody>

                            {% for event in events %}

                                <tr>
                                    <td>
                                        {{ event.occurred_at|date('d.m.Y H:i:s') }}
                                    </td>
                                    <td>
                                        {{ event.event_type }}
                                    </td>
                                    <td>
                                        {{ event.note }}
                                    </td>
                                    <td>
                                        {{ event.performed_by_name }}
                                    </td>
                                </tr>

                            {% else %}

                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        {{ 'inventory.stock_block_show.no_event_present'|trans }}
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
