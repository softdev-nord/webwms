{% extends 'v3/base.html.twig' %}
{% set editing = entry is not null %}
{% set overviewRoute = kind == 'selection_rule' ? 'v3_inventory_selection_rules' : (kind == 'special_stock_type' ? 'v3_inventory_special_stock' : 'v3_inventory_stock_blocks') %}

{% block title %}
    {{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0
{% endblock %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ page|trans(pageParameters|default({})) }}
            </h1>
            <p class="text-muted mb-0">
                {{ (editing ? 'inventory.configuration_form.modify_existing_entry' : 'inventory.configuration_form.create_new_entry')|trans }}
            </p>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path(overviewRoute) }}">
            <i class="ri-arrow-left-line me-1">
            </i>
            {{ 'administration.api_client_edit.go_to_overview'|trans }}
        </a>
    </div>
    <div class="row">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    {% if kind == 'selection_rule' %}
                        <form method="post" action="{{ editing ? path('v3_inventory_selection_rule_update', {ruleId: entry.id}) : path('v3_inventory_selection_rule_create') }}" class="row g-3">
                            <input type="hidden" name="_token" value="{{ csrf_token(editing ? 'v3_inventory_selection_rule_update_' ~ entry.id : 'v3_inventory_selection_rule_create') }}">
                            <div class="col-md-4">
                                <label class="form-label">
                                    {{ 'administration.role_new.code'|trans }}
                                </label>
                                <input class="form-control" name="code" value="{{ entry.code|default('') }}" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">
                                    {{ 'common.template.correspondence.name'|trans }}
                                </label>
                                <input class="form-control" name="name" value="{{ entry.name|default('') }}" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">
                                    {{ 'inventory.configuration_form.strategy'|trans }}
                                </label>
                                <select class="form-select" name="strategy">

                                    {% for value, label in {fifo: 'selection.fifo.fifo_oldest_stock_first', lifo: 'selection.lifo.lifo_newest_stock_first', fefo: 'selection.fefo.fefo_earliest_expiry_date_first'} %}

                                        <option value="{{ value }}" {{ entry and entry.strategy == value ? 'selected' : '' }}>
                                            {{ label|trans }}
                                        </option>

                                    {% endfor %}

                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">
                                    {{ 'inventory.configuration_form.priority'|trans }}
                                </label>
                                <input class="form-control" type="number" min="1" name="priority" value="{{ entry.priority|default(100) }}" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    {{ 'navigation.master_data.submenu.headline4.label'|trans }}
                                </label>
                                <select class="form-select" name="warehouse_id">
                                    <option value="">
                                        {{ 'inventory.configuration_form.all_warehouses'|trans }}
                                    </option>

                                    {% for row in warehouses %}

                                        <option value="{{ row.id }}" {{ entry and entry.warehouse_id == row.id ? 'selected' : '' }}>
                                            {{ row.code }} · {{ row.name }}
                                        </option>

                                    {% endfor %}

                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    {{ 'navigation.master_data.submenu.headline1.label'|trans }}
                                </label>
                                <select class="form-select" name="product_id">
                                    <option value="">
                                        {{ 'inventory.configuration_form.all_items'|trans }}
                                    </option>

                                    {% for row in products %}

                                        <option value="{{ row.id }}" {{ entry and entry.product_id == row.id ? 'selected' : '' }}>
                                            {{ row.sku }} · {{ row.name }}
                                        </option>

                                    {% endfor %}

                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="enabled" value="1" id="enabled" {{ not entry or entry.enabled ? 'checked' : '' }}>
                                    <label class="form-check-label" for="enabled">
                                        {{ 'user.user_input_fields.active'|trans }}
                                    </label>
                                </div>
                            </div>
                    {% elseif kind == 'special_stock_type' %}
                        <form method="post" action="{{ editing ? path('v3_inventory_special_stock_type_update', {typeId: entry.id}) : path('v3_inventory_special_stock_type_create') }}" class="row g-3">
                            <input type="hidden" name="_token" value="{{ csrf_token(editing ? 'v3_inventory_special_stock_type_update_' ~ entry.id : 'v3_inventory_special_stock_type_create') }}">
                            <div class="col-md-4">
                                <label class="form-label">
                                    {{ 'administration.role_new.code'|trans }}
                                </label>
                                <input class="form-control" name="code" value="{{ entry.code|default('') }}" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">
                                    {{ 'article.index.description'|trans }}
                                </label>
                                <input class="form-control" name="name" value="{{ entry.name|default('') }}" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    {{ 'inventory.configuration_form.type'|trans }}
                                </label>
                                <select class="form-select" name="classification_kind">

                                    {% for value, label in {owner: 'Eigentum', status: 'topology.header.status.status', special: 'Sonderart'} %}

                                        <option value="{{ value }}" {{ entry and entry.classification_kind == value ? 'selected' : '' }}>
                                            {{ label|trans }}
                                        </option>

                                    {% endfor %}

                                </select>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check mt-4">
                                    <input class="form-check-input" type="checkbox" name="allocatable" value="1" id="allocatable" {{ entry and entry.allocatable ? 'checked' : '' }}>
                                    <label class="form-check-label" for="allocatable">
                                        {{ 'inventory.configuration_form.allocatable'|trans }}
                                    </label>
                                </div>
                            </div>

                            {% if editing %}

                                <div class="col-md-3">
                                    <div class="form-check mt-4">
                                        <input class="form-check-input" type="checkbox" name="active" value="1" id="active" {{ entry.active ? 'checked' : '' }}>
                                        <label class="form-check-label" for="active">
                                            {{ 'user.user_input_fields.active'|trans }}
                                        </label>
                                    </div>
                                </div>

                            {% endif %}
                    {% else %}
                        <form method="post" action="{{ editing ? path('v3_inventory_stock_block_reason_update', {reasonId: entry.id}) : path('v3_inventory_stock_block_reason_create') }}" class="row g-3">
                            <input type="hidden" name="_token" value="{{ csrf_token(editing ? 'v3_inventory_stock_block_reason_update_' ~ entry.id : 'v3_inventory_stock_block_reason_create') }}">
                            <div class="col-md-4">
                                <label class="form-label">
                                    {{ 'administration.role_new.code'|trans }}
                                </label>
                                <input class="form-control" name="code" value="{{ entry.code|default('') }}" required>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">
                                    {{ 'common.template.correspondence.name'|trans }}
                                </label>
                                <input class="form-control" name="name" value="{{ entry.name|default('') }}" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">
                                    {{ 'user.user_group.index.description'|trans }}
                                </label>
                                <textarea class="form-control" name="description" rows="3">
                                    {{ entry.description|default('') }}
                                </textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="active" value="1" id="active" {{ not entry or entry.active ? 'checked' : '' }}>
                                    <label class="form-check-label" for="active">
                                        {{ 'user.user_input_fields.active'|trans }}
                                    </label>
                                </div>
                            </div>
                    {% endif %}
                    <div class="col-12 d-flex justify-content-end gap-2">
                        <a class="btn btn-light" href="{{ path(overviewRoute) }}">
                            {{ 'common.button.cancel'|trans }}
                        </a>
                        <button class="btn btn-primary">
                            {{ (editing ? 'administration.api_client_edit.save_changes' : 'administration.workspace.create')|trans }}
                        </button>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
