{% extends 'v3/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .occupancy-legend { display: flex; flex-wrap: wrap; gap: 1rem; }
        .occupancy-legend-item { display: inline-flex; align-items: center; gap: .4rem; }
        .occupancy-legend-swatch { width: .85rem; height: .85rem; border: 1px solid rgba(0, 0, 0, .12); border-radius: .2rem; }
        .occupancy-type-icon { display: grid; width: 3rem; height: 3rem; place-items: center; color: var(--vz-primary); background: rgba(var(--vz-primary-rgb), .1); border-radius: .5rem; font-size: 1.5rem; }
        .occupancy-visual { overflow-x: auto; padding: 1rem; background: rgba(var(--vz-light-rgb), .45); border: 1px solid var(--vz-border-color); border-radius: .5rem; }
        .occupancy-grid { display: grid; gap: .55rem; min-width: max-content; }
        .occupancy-grid--rack { grid-template-columns: repeat(var(--occupancy-columns), minmax(125px, 1fr)); align-items: stretch; padding: 0 .35rem; border-right: .35rem solid #6c757d; border-bottom: .55rem solid #6c757d; border-left: .35rem solid #6c757d; }
        .occupancy-grid--block { grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); min-width: 100%; padding: .65rem; background-image: linear-gradient(rgba(108, 117, 125, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(108, 117, 125, .08) 1px, transparent 1px); background-size: 24px 24px; border: 2px dashed #6c757d; }
        .occupancy-grid--tray { grid-template-columns: repeat(var(--occupancy-columns), minmax(145px, 1fr)); padding: 1rem; background: var(--vz-card-bg); border: .45rem solid #6c757d; }
        .occupancy-grid--flow { grid-template-columns: repeat(var(--occupancy-columns), minmax(135px, 1fr)); padding: .5rem .5rem 1.2rem; border: .3rem solid #6c757d; transform: skewX(-1deg); }
        .occupancy-grid--zone { grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); min-width: 100%; }
        .occupancy-bin { position: relative; min-height: 120px; padding: .75rem; color: inherit; background: var(--vz-card-bg); border: 1px solid var(--vz-border-color); border-top-width: 5px; border-radius: .3rem; transition: transform .15s ease, box-shadow .15s ease; }
        .occupancy-bin:hover { z-index: 2; transform: translateY(-2px); box-shadow: 0 .35rem .9rem rgba(15, 34, 58, .14); }
        .occupancy-bin--empty { border-top-color: #adb5bd; background: rgba(173, 181, 189, .08); }
        .occupancy-bin--occupied { border-top-color: #0ab39c; background: rgba(10, 179, 156, .11); }
        .occupancy-bin--quality { border-top-color: #f7b84b; background: rgba(247, 184, 75, .14); }
        .occupancy-bin--blocked, .occupancy-bin--full { border-top-color: #f06548; background: rgba(240, 101, 72, .12); }
        .occupancy-bin-code { font-size: .9rem; font-weight: 700; }
        .occupancy-bin-meta { color: var(--vz-secondary-color); font-size: .7rem; }
        .occupancy-bin-quantity { font-size: 1.25rem; font-weight: 700; line-height: 1.2; }
        .occupancy-axis { display: flex; justify-content: space-between; margin-top: .5rem; color: var(--vz-secondary-color); font-size: .7rem; }
    </style>
{% endblock %}

{% block webwms_content %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">{{ 'inventory.occupancy.graphical_location_occupancy'|trans }}</h1>

            <p class="text-muted mb-0">{{ 'inventory.occupancy.occupancy_and_utilization_of_each_storage_location_by_warehouse_and_area'|trans }}</p>
        </div>

        <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label for="warehouse" class="form-label small">{{ 'navigation.master_data.submenu.headline4.label'|trans }}</label>

                <select id="warehouse" name="warehouse" class="form-select" required>
                    {% for warehouse in warehouses %}
                        <option value="{{ warehouse.id }}" {{ warehouse.id == selectedWarehouse ? 'selected' : '' }}>{{ warehouse.code }} – {{ warehouse.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="aisle" class="form-label small">{{ 'inventory.occupancy.storage_structure'|trans({}, 'occupancy') }}</label>

                <select id="aisle" name="aisle" class="form-select" required>
                    {% for aisle in aisles %}
                        <option value="{{ aisle.id }}" {{ aisle.id == selectedAisle ? 'selected' : '' }}>{{ aisle.code }} · {{ aisle.name }} ({{ aisle.storage_type ?: ('inventory.occupancy.unclassified'|trans) }})</option>
                    {% endfor %}
                </select>
            </div>

            <button class="btn btn-primary">{{ 'inventory.occupancy.display'|trans }}</button>
        </form>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <div class="occupancy-legend small">
                <span class="occupancy-legend-item"><span class="occupancy-legend-swatch bg-light"></span>{{ 'dashboard.index.available'|trans }}</span>
                <span class="occupancy-legend-item"><span class="occupancy-legend-swatch bg-success"></span>{{ 'dashboard.index.occupied'|trans }}</span>
                <span class="occupancy-legend-item"><span class="occupancy-legend-swatch bg-warning"></span>{{ 'inventory.occupancy.qc_stock'|trans }}</span>
                <span class="occupancy-legend-item"><span class="occupancy-legend-swatch bg-danger"></span>{{ 'inventory.occupancy.blocked_or_full'|trans }}</span>
            </div>
        </div>
    </div>

    {% if locations is not empty %}
        {% set firstLocation = locations|first %}
        {% set storageType = firstLocation.location_type|upper %}
        {% set isBlock = storageType in ['BLL', 'BLOCK', 'BLOCKLAGER'] %}
        {% set isRack = storageType in ['HRL', 'FBL', 'RACK', 'REGAL', 'SHELF'] %}
        {% set isFlow = storageType in ['RGL', 'LV', 'DLK', 'FLOW'] %}
        {% set isTray = storageType in ['TAB', 'TBL', 'TRAY', 'TABLAR'] %}
        {% set presentation = isBlock ? 'block' : (isRack ? 'rack' : (isFlow ? 'flow' : (isTray ? 'tray' : 'zone'))) %}
        {% set typeKey = isBlock ? 'block' : (isRack ? 'rack' : (isFlow ? 'flow' : (isTray ? 'tray' : 'functional_zone'))) %}
        {% set typeIcon = isBlock ? 'ri-layout-grid-line' : (isRack ? 'ri-building-4-line' : (isFlow ? 'ri-arrow-right-down-line' : (isTray ? 'ri-layout-masonry-line' : 'ri-map-pin-line'))) %}
        {% set columnCount = isBlock or presentation == 'zone' ? 1 : occupancyColumns %}

        <section class="card border-0 shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="occupancy-type-icon"><i class="{{ typeIcon }}"></i></span>

                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <h2 class="h5 mb-0">{{ firstLocation.aisle_code }} · {{ firstLocation.aisle_name }}</h2>
                            <span class="badge bg-primary-subtle text-primary">{{ ('inventory.occupancy.storage_types.' ~ typeKey)|trans({}, 'occupancy') }}</span>
                            <span class="badge bg-light text-body">{{ storageType }}</span>
                        </div>

                        <p class="small text-muted mb-0 mt-1">{{ ('inventory.occupancy.presentations.' ~ presentation)|trans({}, 'occupancy') }} · {{ firstLocation.area_code }} · {{ firstLocation.area_name }}</p>
                    </div>
                </div>

                <div class="text-end">
                    <strong>{{ locations|length }}</strong>
                    <div class="small text-muted">{{ 'inventory.occupancy.storage_locations'|trans }}</div>
                </div>
            </div>

            <div class="card-body">
                <div class="occupancy-visual">
                    <div class="occupancy-grid occupancy-grid--{{ presentation }}" style="--occupancy-columns: {{ columnCount }}">
                        {% for location in locations %}
                            {% set utilization = location.capacity_quantity > 0 ? min(100, (location.stock_quantity / location.capacity_quantity * 100)|round) : 0 %}
                            {% set state = location.stock_quantity == 0 ? 'empty' : (location.blocked_quantity > 0 ? 'blocked' : (location.quality_quantity > 0 ? 'quality' : (location.capacity_quantity > 0 and location.stock_quantity >= location.capacity_quantity ? 'full' : 'occupied'))) %}

                            <a href="{{ path('v3_stock', {warehouse: location.warehouse_id}) }}" class="occupancy-bin occupancy-bin--{{ state }} text-decoration-none" title="{{ location.location_code }} · {{ location.product_skus ?: ('inventory.occupancy.no_stock'|trans) }}">
                                <div class="d-flex justify-content-between gap-2">
                                    <span class="occupancy-bin-code">{{ location.location_code }}</span>
                                    <span class="badge bg-light text-body">{{ 'warehouse.topology_fields.depth'|trans }} {{ location.depth_number ?: '–' }}</span>
                                </div>

                                <div class="occupancy-bin-meta mt-1">{{ 'warehouse.topology_fields.level'|trans }} {{ location.level_number ?: location.level_code ?: '–' }} · {{ 'warehouse.topology_fields.slot'|trans }} {{ location.slot_number ?: '–' }}</div>

                                <div class="d-flex justify-content-between align-items-end mt-3">
                                    <div>
                                        <div class="occupancy-bin-quantity">{{ location.stock_quantity }}{% if location.capacity_quantity > 0 %} / {{ location.capacity_quantity }}{% endif %}</div>
                                        <div class="occupancy-bin-meta">{{ 'article.index.stock'|trans }}{% if location.capacity_quantity <= 0 %} {{ 'inventory.occupancy.unlimited'|trans }}{% endif %}</div>
                                    </div>
                                    <div class="text-end">
                                        <strong>{{ location.product_count }}</strong>
                                        <div class="occupancy-bin-meta">{{ 'navigation.master_data.submenu.headline1.label'|trans }}</div>
                                    </div>
                                </div>

                                {% if location.capacity_quantity > 0 %}
                                    <div class="progress mt-2" style="height: 5px">
                                        <div class="progress-bar {{ state in ['blocked', 'full'] ? 'bg-danger' : (state == 'quality' ? 'bg-warning' : 'bg-success') }}" style="width: {{ utilization }}%"></div>
                                    </div>
                                {% endif %}

                                <div class="occupancy-bin-meta text-truncate mt-2">{{ location.product_skus ?: ('dashboard.index.available'|trans) }}</div>
                            </a>
                        {% endfor %}
                    </div>

                    <div class="occupancy-axis">
                        <span>{{ (isTray or isBlock ? 'inventory.occupancy.top_view' : 'inventory.occupancy.front_view')|trans({}, 'occupancy') }}</span>
                        <span>{{ isFlow ? 'inventory.occupancy.picking_side_left'|trans({}, 'occupancy') : ('inventory.occupancy.storage_model'|trans({}, 'occupancy') ~ ': ' ~ (firstLocation.storage_model ?: '–')) }}</span>
                    </div>
                </div>
            </div>
        </section>
    {% else %}
        <div class="alert alert-info">{{ 'inventory.occupancy.no_storage_locations_have_been_created_for_selected_warehouse_yet'|trans }}</div>
    {% endif %}
{% endblock %}
