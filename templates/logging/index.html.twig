{# templates/logging/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_logging_overview %}
        <div id="webwms-logging-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_logging_overview_table %}
                                    <table id="loggingTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col" style="text-align: center">{{ 'ui.logging.index.route'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.logging.index.nachricht'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'templates.correspondence.created'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'nav.user.user'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.logging.index.ip.adresse'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.logging.index.user.agent'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.logging.js') }}"></script>
{% endblock %}
