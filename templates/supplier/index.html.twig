{# templates/supplier/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_supplier_overview %}
        <div id="webWMS-supplier-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_supplier_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="supplierTable" class="table table-striped table-bordered table-hover compact">
                                                <thead>
                                                <tr>
                                                    <th scope="col">{{ 'supplier.index.supplier_no'|trans }}</th>
                                                    <th scope="col">{{ 'supplier.index.supplier_name'|trans }}</th>
                                                    <th scope="col">{{ 'customer.customer_input_fields.address_line_2'|trans }}</th>
                                                    <th scope="col">{{ 'customer.customer_input_fields.street'|trans }}</th>
                                                    <th scope="col">{{ 'customer.customer_input_fields.house_no'|trans }}</th>
                                                    <th scope="col">{{ 'customer.customer_input_fields.country'|trans }}</th>
                                                    <th scope="col">{{ 'common.template.editor.zip'|trans }}</th>
                                                    <th scope="col">{{ 'customer.customer_input_fields.city_town'|trans }}</th>
                                                </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.supplier.js') }}"></script>
{% endblock %}
