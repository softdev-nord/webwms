{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_supplier_overview %}
            <div id="webWMS-supplier-overview" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                        <div class="webwms-page">{{ page }}</div>
                    {% endif %}
                    <div class="card">
                        <div class="card-content">
                            <table id="supplierTable" class="table table-striped table-bordered table-hover compact">
                                <thead>
                                <tr>
                                    <th scope="col">Lieferanten-Nr</th>
                                    <th scope="col">Lieferanten-Name</th>
                                    <th scope="col">Anschrift Zusatz</th>
                                    <th scope="col">Straße</th>
                                    <th scope="col">Haus-Nr</th>
                                    <th scope="col">Land</th>
                                    <th scope="col">PLZ</th>
                                    <th scope="col">Ort</th>
                                    <th style="text-align: center"></th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endblock %}
    {% block bodyjs %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.supplier.js') }}"></script>
    {% endblock %}
{% endblock %}
