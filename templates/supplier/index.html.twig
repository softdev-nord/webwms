{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {{ include('header.html.twig') }}
    {{ include('submenu.html.twig') }}
    <!-- Beginn Übersicht Lieferanten -->
    <div class="wrapper-form">
        <div class="wrapper-form-content">
            <div class="card">
                <div class="card-content">
                    <!-- Beginn Tabelle Lieferanten -->
                    <table id="Table" class="table table-striped table-bordered table-hover compact">
                        <thead>
                        <tr>
                            <th scope="col">Lieferanten-Nr</th>
                            <th scope="col">Lieferanten-Name</th>
                            <th scope="col">Anschrift Zusatz</th>
                            <th scope="col">Straße</th>
                            <th scope="col">Haus-Nr</th>
                            <th scope="col">Land</th>
                            <th scope="col">PLZ</th>
                            <th scope="col">Ort</th>
                        </tr>
                        </thead>
                        <tbody id="myTable">
                        <tr>
                            {% for supplier in supplier %}
                            <td>{{ supplier.supplierNr }}</td>
                            <td>{{ supplier.supplierName }}</td>
                            <td>{{ supplier.supplierAddressAddition }}</td>
                            <td>{{ supplier.supplierAddressStreet }}</td>
                            <td>{{ supplier.supplierAddressStreetNr }}</td>
                            <td>{{ supplier.supplierAddressCountryCode }}</td>
                            <td>{{ supplier.supplierAddressZipCode }}</td>
                            <td>{{ supplier.supplierAddressCity }}</td>
                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <!-- Beginn Tabelle Kunden -->
                </div>
            </div>
        </div>
    </div>
    <!-- Ende Übersicht Kunden -->
{% endblock %}
