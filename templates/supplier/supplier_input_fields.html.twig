{# templates/supplier/supplier_input_fields.html.twig #}

{% block webwms_supplier_input_fields_form %}
    <div class="row">
        {% block webwms_supplier_input_fields_form_inner %}
            <div class="card">
                {{ form_start(supplierForm) }}
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.supplier.index.lieferanten.nr.eeaccca'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {% if editSupplier %}
                            {{ form_row(supplierForm.supplierNr) }}
                        {% else %}
                            {{ form_row(supplierForm.supplierNr, {'value' : "#{lastId.supplierNr +1}"}) }}
                        {% endif %}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.supplier.index.lieferanten.name.acd8a55'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierName) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.anschrift.zusatz.59481f7'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierAddressAddition) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.strasse.880c688'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierAddressStreet) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.haus.nr.bc8a464'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierAddressStreetNr) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.land.d9df90d'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierAddressCountryCode) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'templates.editor.zip'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierAddressZipcode) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.ort.d95f9e6'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(supplierForm.supplierAddressCity) }}
                    </div>
                </div>
                <div class="text-center">
                    {{ form_widget(supplierForm.save) }} {{ form_widget(supplierForm.abort) }}
                </div>
                {{ form_end(supplierForm) }}
            </div>
        {% endblock %}

        {% block bodyjs %}
            <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.suppliersAutofill.js') }}"></script>
            <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.itemsSupplierOrderPosAutofill.js') }}"></script>
        {% endblock %}
    </div>
{% endblock %}