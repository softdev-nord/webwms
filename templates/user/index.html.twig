{# templates/user/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_user_overview %}
        <div id="webWMS-user-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_user_overview_table_users %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="userTable" class="table table-striped table-bordered table-hover compact">
                                                <thead>
                                                <tr>
                                                    <th scope="col">{{ 'ui.security.login.benutzername'|trans }}</th>
                                                    <th scope="col">{{ 'Email'|trans }}</th>
                                                    <th scope="col">{{ 'templates.editor.firstname'|trans }}</th>
                                                    <th scope="col">{{ 'templates.editor.lastname'|trans }}</th>
                                                    <th scope="col">{{ 'ui.user.index.letzter.login'|trans }}</th>
                                                    <th scope="col">{{ 'ui.user.index.aktiviert'|trans }}</th>
                                                    <th scope="col">{{ 'ui.user.index.rollen'|trans }}</th>
                                                    <th scope="col">{{ 'ui.user.index.gruppen'|trans }}</th>
                                                    <th scope="col">{{ 'ui.user.index.erstellt'|trans }}</th>
                                                    <th scope="col">{{ 'ui.article.index.letzte.anderung'|trans }}</th>
                                                </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script>
        {% set user_role = app.user.roles.0 %}
        window.user_role = '{{ user_role }}'
    </script>
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/user/jquery.user.js') }}"></script>
{% endblock %}
