{# templates/user/user_input_fields.html.twig #}

{% block webwms_user_input_fields_form %}
    <div class="row">
        {% block webwms_user_input_fields_form_inner %}
            <div class="card">
                {{ form_start(userForm) }}
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.security.login.benutzername.99636bf'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(userForm.username) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'templates.editor.firstname'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(userForm.firstname) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'templates.editor.lastname'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(userForm.lastname) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'Email'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(userForm.email) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.user.user_input_fields.aktiv.16a766c'|trans }}</label>
                    <div class="form-check form-switch" style="margin-bottom: 5px;">
                        {{ form_row(userForm.enabled) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.user.user_input_fields.benutzerrolle.n.2c217f3'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(userForm.role) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.user.user_input_fields.benutzergruppe.n.7c6e188'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(userForm.userGroups) }}
                    </div>
                </div>
                {% if addUser %}
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.security.login.passwort.0719708'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(userForm.password.first) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.user.user_input_fields.passwort.wiederholen.3794271'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(userForm.password.second) }}
                        </div>
                    </div>
                {% endif %}
                <div class="text-center">
                    {{ form_widget(userForm.save) }} {{ form_widget(userForm.abort) }}
                </div>
                {{ form_end(userForm) }}
            </div>
        {% endblock %}
    </div>
{% endblock %}