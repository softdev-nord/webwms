{# templates/user/user_right/index.html.twig #}

{% extends 'base.html.twig' %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_user_right_overview %}
            <div id="webWMS-user-right-overview" class="wrapper-form vertical-theme">
                <div class="wrapper-form-content vertical-theme">
                    <div class="webwms-page">{{ page }}</div>
                    <div class="card">
                        <div class="card-content">
                            <table class="table table-striped table-bordered table-hover compact">
                                <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Benutzerrecht</th>
                                    <th>Beschreibung</th>
                                    <th>Erstellt am</th>
                                    <th>Bearbeitet am</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for user_right in user_rights %}
                                    <tr>
                                        <td>{{user_right.id}}</td>
                                        <td>{{user_right.userRight}}</td>
                                        <td>{{user_right.description}}</td>
                                        <td>{{user_right.createdAt|date('d.m.Y H:i:s')}}</td>
                                        <td>{{user_right.updatedAt|date('d.m.Y H:i:s')}}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endblock %}

    {% block bodyjs %}{% endblock %}

{% endblock %}
