{# templates/subsections/context-menu.html.twig #}

<div
        class="context-menu d-none"
        data-context-for="{{ id }}"
        {% if entityName is defined %} data-entity="{{ entityName }}" {% endif %}
>
    {% for group in actions|batch(3) %}
        <ul class="context-menu-list">
            {% for action in group %}
                <li class="context-menu-item">
                    <button class="context-menu-button ps-2" data-action="{{ action.action }}">
                        {% if action.icon %}
                            <span class="{{ action.icon }} fs-20 me-2"></span>
                        {% endif %}
                        <span class="fs-10">{{ action.shortcut }}</span>
                        <span class="fs-14">{{ action.label }}</span>
                    </button>
                </li>
            {% endfor %}
        </ul>
    {% endfor %}
</div>

