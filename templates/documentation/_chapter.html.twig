+                    <h1>{{ document.title }}</h1>
                    <p class="lead text-muted">{{ document.summary }}</p>

                    <div class="row g-3 mb-4" id="chapter-guidance">
                        {% for key, values in document.guidance %}
                            <div class="col-md-6">
                                <div class="border rounded h-100 p-3">
                                    <h2 class="h6 mt-0 border-0 p-0">{{ ('ui.' ~ key)|trans({}, 'handbook') }}</h2>
                                    <ul class="mb-0">
                                        {% for value in values %}<li>{{ value }}</li>{% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% for section in document.sections %}
                        <section aria-labelledby="{{ section.id }}">
                            <h2 id="{{ section.id }}">{{ section.title }}</h2>

                            {% for paragraph in section.paragraphs %}
                                <p>{{ paragraph }}</p>
                            {% endfor %}

                            {% if section.steps %}
                                <ol>
                                    {% for step in section.steps %}<li>{{ step }}</li>{% endfor %}
                                </ol>
                            {% endif %}

                            {% if section.items %}
                                <ul>
                                    {% for item in section.items %}<li>{{ item }}</li>{% endfor %}
                                </ul>
                            {% endif %}

                            {% if section.image %}
                                <figure class="handbook-figure">
                                    <img class="img-fluid rounded border" src="{{ section.image.src }}" alt="{{ section.image.alt }}" loading="lazy">
                                    <figcaption class="small text-muted mt-2">{{ section.image.alt }}</figcaption>
                                </figure>
                            {% endif %}
                        </section>
                    {% endfor %}
