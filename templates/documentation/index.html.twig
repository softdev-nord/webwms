{% extends 'documentation/base.html.twig' %}

{% block handbook_content %}
    <div class="handbook" data-handbook>
        {% include 'documentation/_header.html.twig' with {query: query} only %}
        <section class="handbook-hero">
            <div class="handbook-hero__content">
                <span class="handbook-hero__icon"><i class="ri-book-open-line" aria-hidden="true"></i></span>
                <h1>{{ 'ui.headline'|trans({}, 'handbook') }}</h1>
                <p>{{ 'ui.introduction'|trans({}, 'handbook') }}</p>
                <form class="handbook-hero__search" method="get" action="{{ path('v3_documentation_index') }}" role="search">
                    <i class="ri-search-line" aria-hidden="true"></i>
                    <input type="search" name="q" value="{{ query }}" placeholder="{{ 'ui.search'|trans({}, 'handbook') }}" aria-label="{{ 'ui.search'|trans({}, 'handbook') }}">
                    {% if query %}
                        <a href="{{ path('v3_documentation_index') }}" aria-label="{{ 'ui.reset_search'|trans({}, 'handbook') }}">
                            <i class="ri-close-line" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    <button type="submit">
                        {{ 'ui.search_action'|trans({}, 'handbook') }}
                    </button>
                </form>
            </div>
        </section>

        <main class="handbook-home" aria-label="{{ 'ui.content'|trans({}, 'handbook') }}">
            {% if groups is empty %}
                <div class="alert alert-info">{{ 'ui.no_results'|trans({'%query%': query}, 'handbook') }}</div>
            {% else %}
                {% set chapterIcons = {
                    'getting-started': 'ri-compass-3-line',
                    'navigation-and-lists': 'ri-list-check-3',
                    'users-roles-and-security': 'ri-shield-user-line',
                    'system-configuration': 'ri-settings-3-line',
                    'warehouse-and-stock': 'ri-building-4-line',
                    'inventory-counting': 'ri-clipboard-line',
                    'inbound': 'ri-download-2-line',
                    'fulfillment-and-outbound': 'ri-truck-line',
                    'integrations-and-devices': 'ri-plug-line',
                    'platform-and-extensions': 'ri-apps-2-line',
                    'api-and-automation': 'ri-code-s-slash-line',
                    'troubleshooting': 'ri-tools-line'
                } %}
                <div class="handbook-topic-grid">
                    {% for category, documents in groups %}
                        {% for document in documents %}
                            <a class="handbook-topic-card" href="{{ path('v3_documentation_show', {slug: document.slug}) }}{{ document.match and document.match.anchor ? '#' ~ document.match.anchor : '' }}">
                                <span class="handbook-topic-card__icon">
                                    <i class="{{ chapterIcons[document.slug]|default('ri-book-2-line') }}" aria-hidden="true"></i>
                                </span>
                                <span class="handbook-topic-card__content">
                                    <small>{{ category }}</small>
                                    <strong>{{ document.title }}</strong>
                                    <span>{{ document.summary }}</span>
                                    {% if document.match %}
                                        <em><b>{{ 'ui.result_for'|trans({}, 'handbook') }}:</b> {{ document.match.excerpt }}</em>
                                    {% endif %}
                                </span>
                                <i class="ri-arrow-right-line handbook-topic-card__arrow" aria-hidden="true"></i>
                            </a>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}
        </main>
    </div>
{% endblock %}
