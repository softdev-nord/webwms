{% extends 'v3/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/handbook.css') }}">
{% endblock %}

{% block webwms_content %}
    <div class="handbook" data-handbook>
        {% include 'documentation/_header.html.twig' with {query: query} only %}
        <div class="handbook-layout">
            <aside id="handbook-navigation" class="handbook-sidebar">
                {% include 'documentation/_navigation.html.twig' with {groups: navigationGroups, activeSlug: null} only %}
            </aside>
            <button class="handbook-overlay" type="button" data-handbook-menu-close aria-label="{{ 'ui.close_navigation'|trans({}, 'handbook') }}"></button>
            <main class="handbook-main" aria-label="{{ 'ui.content'|trans({}, 'handbook') }}">
                <div class="handbook-intro">
                    <span class="handbook-intro__icon"><i class="ri-book-2-line" aria-hidden="true"></i></span>
                    <div><h1>{{ 'ui.headline'|trans({}, 'handbook') }}</h1><p>{{ 'ui.introduction'|trans({}, 'handbook') }}</p></div>
                </div>
                {% if groups is empty %}<div class="alert alert-info">{{ 'ui.no_results'|trans({'%query%': query}, 'handbook') }}</div>{% endif %}
                {% for category, documents in groups %}
                    <section class="handbook-index-section" aria-labelledby="category-{{ loop.index }}">
                        <div class="handbook-index-section__heading"><h2 id="category-{{ loop.index }}">{{ category }}</h2><span>{{ documents|length }}</span></div>
                        <div class="handbook-card-grid">
                            {% for document in documents %}
                                <a class="handbook-card" href="{{ path('v3_documentation_show', {slug: document.slug}) }}{{ document.match and document.match.anchor ? '#' ~ document.match.anchor : '' }}">
                                    <div><h3>{{ document.title }}</h3><p>{{ document.summary }}</p>{% if document.match %}<small><strong>{{ 'ui.result_for'|trans({}, 'handbook') }}:</strong> {{ document.match.excerpt }}</small>{% endif %}</div>
                                    <i class="ri-arrow-right-line" aria-hidden="true"></i>
                                </a>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
            </main>
        </div>
    </div>
{% endblock %}

{% block bodyjs %}{{ parent() }}<script src="{{ asset('assets/js/handbook.js') }}" defer></script>{% endblock %}
