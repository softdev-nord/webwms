{% extends 'documentation/base.html.twig' %}

{% block handbook_content %}
    <div class="handbook" data-handbook>
        {{ include('documentation/_header.html.twig', {query: query}, false) }}
        <section class="handbook-hero">
            <div class="handbook-hero__content">
                <span class="handbook-hero__icon">
                    <i class="mdi mdi-book-open-page-variant-outline" aria-hidden="true">
                    </i>
                </span>
                <h1>
                    {{ 'ui.headline'|trans({}, 'handbook') }}
                </h1>
                <p>
                    {{ 'ui.introduction'|trans({}, 'handbook') }}
                </p>
                <form class="handbook-hero__search" method="get" action="{{ path('v3_documentation_index') }}" role="search">
                    <i class="mdi mdi-magnify" aria-hidden="true">
                    </i>
                    <input type="search" name="q" value="{{ query }}" placeholder="{{ 'ui.search'|trans({}, 'handbook') }}" aria-label="{{ 'ui.search'|trans({}, 'handbook') }}">
                    {% if query %}
                        <a href="{{ path('v3_documentation_index') }}" aria-label="{{ 'ui.reset_search'|trans({}, 'handbook') }}">
                            <i class="mdi mdi-close" aria-hidden="true">
                            </i>
                        </a>
                    {% endif %}
                    <button type="submit">
                        {{ 'ui.search_action'|trans({}, 'handbook') }}
                    </button>
                </form>
            </div>
        </section>

        <main class="handbook-home" aria-label="{{ 'ui.content'|trans({}, 'handbook') }}">
            {% if groups is empty %}
                <div class="alert alert-info">
                    {{ 'ui.no_results'|trans({'%query%': query}, 'handbook') }}
                </div>
            {% else %}
                {% set chapterIcons = {
                'getting-started': 'mdi mdi-compass-outline',
                'navigation-and-lists': 'mdi mdi-format-list-checks',
                'users-roles-and-security': 'mdi mdi-shield-account-outline',
                'system-configuration': 'mdi mdi-cog-outline',
                'warehouse-and-stock': 'mdi mdi-warehouse',
                'inventory-counting': 'mdi mdi-clipboard-list-outline',
                inbound: 'mdi mdi-truck-delivery-outline',
                'fulfillment-and-outbound': 'mdi mdi-truck-fast-outline',
                'integrations-and-devices': 'mdi mdi-connection',
                'platform-and-extensions': 'mdi mdi-apps',
                'api-and-automation': 'mdi mdi-code-json',
                troubleshooting: 'mdi mdi-tools',
                } %}
                <div class="handbook-topic-grid">
                    {% for category, documents in groups %}
                        {% for document in documents %}
                            <a class="handbook-topic-card" href="{{ path('v3_documentation_show', {slug: document.slug}) }}{{ document.match and document.match.anchor ? '#' ~ document.match.anchor : '' }}">
                                <span class="handbook-topic-card__icon">
                                    <i class="{{ chapterIcons[document.slug]|default('mdi mdi-book-open-page-variant-outline') }}" aria-hidden="true">
                                    </i>
                                </span>
                                <span class="handbook-topic-card__content">
                                    <small>
                                        {{ category }}
                                    </small>
                                    <strong>
                                        {{ document.title }}
                                    </strong>
                                    <span>
                                        {{ document.summary }}
                                    </span>
                                    {% if document.match %}
                                        <em>
                                            <b>
                                                {{ 'ui.result_for'|trans({}, 'handbook') }}:
                                            </b>
                                            {{ document.match.excerpt }}
                                        </em>
                                    {% endif %}
                                </span>
                                <i class="mdi mdi-arrow-right handbook-topic-card__arrow" aria-hidden="true">
                                </i>
                            </a>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}
        </main>
    </div>
{% endblock %}
