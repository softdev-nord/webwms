{# templates/acl/index.html.twig #}

{% extends 'base.html.twig' %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_acl_overview %}
            {{ dump() }}
            <div id="webWMS-acl-overview" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                        <div class="webwms-page">{{ page }}</div>
                        {{ dump(acl_roles) }}
                    {% endif %}
                        <div class="card-content">
                            {% block webwms_acl_overview_table %}
                                <div class="card click-me-div" id="click-me-div">
                                    <!-- Nav tabs -->
                                    <ul class="nav nav-tabs" role="tablist">
                                        <li><a href="#user-roles" class="active" aria-selected="true" role="tab" data-toggle="tab">Benutzerrollen</a></li>
                                        <li><a href="#user-groups" role="tab" data-toggle="tab">Benutzergruppen</a></li>
                                        <li><a href="#permissions" role="tab" data-toggle="tab">Berechtigungen</a></li>
                                    </ul>

                                    <!-- Tab panes -->
                                    <div class="card">
                                        <div class="card-content">
                                            <div class="card-content">
                                                <div class="tab-content">
                                                    <div class="tab-pane active" id="user-roles">
                                                        {% for role in acl_roles %}
                                                            <div>{{ role.name }}</div>
                                                        {% endfor %}
                                                        {% block webwms_permission_overview %}
                                                            {{ include('role/index.html.twig', { 'acl_permissions': permissions }) }}
                                                        {% endblock %}
                                                    </div>
                                                    <div class="tab-pane" id="javatab">The Java is an object-oriented programming language <br /> that was developed by James Gosling from the Sun Microsystems in 1995.</div>
                                                    <div class="tab-pane" id="user-groups">C# is also a programming language</div>
                                                    <div class="tab-pane" id="permissions">MySQL is a databased mostly used for web applications.</div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>








                                <div class="container-fluid">
                                    {% include('acl/navbar.html.twig') %}
                                </div>
                            {% endblock %}
                        </div>
                </div>
            </div>
        {% endblock %}
    {% endblock %}
    {% block bodyjs %}
        <script type="text/javascript" src="{{ asset('assets/js/jquery-3.6.3.js') }}"></script>
        <script type="text/javascript" src="{{ asset('doku_weblvs/assets/plugins/bootstrap/js/bootstrap.min.js') }}"></script>
        <script>
            $(document).ready(function() {
                $('.navbar li').removeClass('active');
                $('#' + newID ).addClass('active');
            });
        </script>
    {% endblock %}
{% endblock %}