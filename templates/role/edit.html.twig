{# templates/role/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row">
            <div class="col-xs-8">
                <h1>Update {{ role.name }} Role Permissions</h1>
                {{ form_start(roleForm) }}
                    {{ form_errors(roleForm) }}
                    {{ form_row(roleForm.permissions) }}
                    <button type="submit" class="btn btn-primary">Update</button>
                {{ form_end(roleForm) }}
            </div>

            {% for notice in app.flashes('success') %}
                {{ notice }}
            {% endfor %}
        </div>
    </div>
{% endblock %}