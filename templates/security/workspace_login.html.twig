<!doctype html>
<html lang="{{ app.request.locale|split('_')[0] }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>
            {{ 'security.v3_login.log_in_webwms_3_0'|trans }}
        </title>
        {{ include('v3/subsections/head-css.html.twig') }}
    </head>
    <body>
        <div class="auth-page-wrapper auth-bg-cover py-5 d-flex justify-content-center align-items-center min-vh-100">
            <div class="bg-overlay">
            </div>
            <div class="auth-page-content overflow-hidden pt-lg-5">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card overflow-hidden border-0 m-0 shadow-lg">
                                <div class="row justify-content-center g-0">
                                    <div class="col-lg-6">
                                        <div class="p-lg-5 p-4 auth-one-bg h-100">
                                            <div class="bg-overlay">
                                            </div>
                                            <div class="position-relative h-100 d-flex flex-column">
                                                <div class="mb-4">
                                                    <div class="sidebar-brand workspace-login-brand">
                                                        <a href="{{ path('homepage') }}" class="d-inline-flex align-items-baseline text-decoration-none">
                                                            <span class="text-first">
                                                                {{ 'base.web'|trans }}
                                                            </span>
                                                            <span class="text-last">
                                                                {{ 'base.wms'|trans }}
                                                            </span>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="mt-auto">
                                                    <div id="workspace-login-carousel" class="carousel slide" data-bs-ride="carousel">
                                                        <div class="carousel-indicators">
                                                            <button type="button" data-bs-target="#workspace-login-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="1">
                                                            </button>
                                                            <button type="button" data-bs-target="#workspace-login-carousel" data-bs-slide-to="1" aria-label="2">
                                                            </button>
                                                            <button type="button" data-bs-target="#workspace-login-carousel" data-bs-slide-to="2" aria-label="3">
                                                            </button>
                                                        </div>
                                                        <div class="carousel-inner workspace-login-carousel">
                                                            {# Replace the three image sources with the desired workspace images. #}
                                                            <div class="carousel-item active">
                                                                <img class="d-block w-100 rounded" src="{{ asset('bundles/dashboard/images/auth-bg.jpg') }}" alt="{{ 'security.v3_login.slide_image_alt'|trans({'%number%': 1}) }}">
                                                            </div>
                                                            <div class="carousel-item">
                                                                <img class="d-block w-100 rounded" src="{{ asset('bundles/dashboard/images/auth-bg.jpg') }}" alt="{{ 'security.v3_login.slide_image_alt'|trans({'%number%': 2}) }}">
                                                            </div>
                                                            <div class="carousel-item">
                                                                <img class="d-block w-100 rounded" src="{{ asset('bundles/dashboard/images/auth-bg.jpg') }}" alt="{{ 'security.v3_login.slide_image_alt'|trans({'%number%': 3}) }}">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="p-lg-5 p-4">
                                            <div>
                                                <h1 class="h4 text-primary">
                                                    {{ 'security.v3_login.log_in_with_email'|trans }}
                                                </h1>
                                                <p class="text-muted">
                                                    {{ 'security.v3_login.v3_workspace'|trans }}
                                                </p>
                                            </div>
                                            <div class="mt-4">
                                                {% if error %}

                                                    <div class="alert alert-danger" role="alert">
                                                        {{ error.messageKey|trans(error.messageData, 'security') }}
                                                    </div>

                                                {% endif %}
                                                {% for message in app.flashes('error') %}

                                                    <div class="alert alert-danger" role="alert">
                                                        {{ message|trans }}
                                                    </div>

                                                {% endfor %}
                                                <form method="post">
                                                    <div class="mb-3">
                                                        <label class="form-label" for="email">
                                                            {{ 'security.v3_login.email_address'|trans }}
                                                        </label>
                                                        <input id="email" type="email" name="email" class="form-control" value="{{ last_email }}" autocomplete="email" required autofocus>
                                                    </div>
                                                    <div class="mb-4">
                                                        <label class="form-label" for="password">
                                                            {{ 'security.login.password'|trans }}
                                                        </label>
                                                        <div class="position-relative auth-pass-inputgroup">
                                                            <input id="password" type="password" name="password" class="form-control pe-5" autocomplete="current-password" required>
                                                        </div>
                                                    </div>
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_v3') }}">
                                                    <button type="submit" class="btn btn-primary w-100">
                                                        {{ 'security.login.log_in'|trans }}
                                                    </button>
                                                </form>
                                                <div class="mt-4 text-center">
                                                    <div class="signin-other-title">
                                                        <h2 class="fs-13 mb-4 title text-muted">
                                                            {{ 'security.sso.or'|trans }}
                                                        </h2>
                                                    </div>
                                                    <form method="get" action="{{ path('app_v3_sso_login') }}" class="text-start">
                                                        <div class="mb-3">
                                                            <label class="form-label" for="provider">
                                                                {{ 'security.sso.provider_code'|trans }}
                                                            </label>
                                                            <input id="provider" type="text" name="provider" class="form-control" autocomplete="organization-title" required>
                                                        </div>
                                                        <button type="submit" class="btn btn-outline-primary w-100">
                                                            {{ 'security.sso.log_in'|trans }}
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <p class="mb-0 text-center">
                                {{ 'security.login.and_copy_2019'|trans|raw }}{{ 'now'|date('Y') }}
                                <a class="text-reset" href="https://softdev-nord.de">
                                    {{ 'security.login.softdev_nord_rene_irrgang'|trans }}
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
        {{ include('v3/subsections/vendor-scripts.html.twig') }}
    </body>
</html>
