{# templates/security/login.html.twig #}

{% block body %}

    <head>
        {{ include('subsections/head-css.html.twig') }}
    </head>

    <title>{% block title %}{{ 'ui.security.login.anmelden.webwms.das.webbasierte.lagerverwaltungssystem'|trans }}{% endblock %}</title>
    {% block stylesheets %}
        <link rel="shortcut icon" href="{{ asset('assets/images/favicon.ico') }}">
    {% endblock %}

    {% block webwms_login_form %}
        <div class="content-webLVS">
            <div class="signup-form">
                <form class="form-horizontal" role="form" method="post">
                {% if error %}
                    <div class="alert alert-danger">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}
                <div class="mb-3">
                    <span class="text-first">{{ 'ui.base.web'|trans }}</span><span class="text-last">{{ 'ui.base.wms'|trans }}</span>
                </div>
                <h4>{{ 'ui.base.das.webbasierte.lagerverwaltungssystem'|trans }}</h4><br>
                <div class="form-group">
                    <input
                        type="text"
                        value="{{ last_username }}"
                        name="username"
                        id="inputUsername"
                        class="form-control"
                        placeholder="{{ 'ui.security.login.benutzername'|trans }}"
                        required
                        autofocus
                    />
                </div>
                <div class="form-group">
                    <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        class="form-control"
                        placeholder="{{ 'ui.security.login.passwort'|trans }}"
                        required
                    />
                </div>
                <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                />
{#                <div class="checkbox mb-3">
                    <label>
                        <input type="checkbox" name="_remember_me"> Angemeldet bleiben
                    </label>
                </div>#}
                <input type="hidden" name="_target_path" value="{{ path('homepage') }}" />
                <div class="form-group">
                    <button type="submit" name="anmelden" class="btn btn-dark bg-gradient waves-effect waves-light">{{ 'ui.security.login.anmelden'|trans }}</button>
                </div>
                <div class="signup-form-text-info">
                    {{ 'ui.security.login.copy.2019'|trans }}{{ "now"|date("Y") }} <a href="https://softdev-nord.de"> {{ 'ui.security.login.softdev.nord.rene.irrgang'|trans }} </a><br>
                    {{ 'ui.security.login.weblvs.reg'|trans }} {{ appVersionNumber }} {{ appVersion }} <br><br>
                    {{ appLizenz }}
                </div>
                <div>
                    <i class="brands-webWMS mdi mdi-symfony"></i>
                    <i class="brands-webWMS mdi mdi-language-php"></i>
                    <i class="brands-webWMS mdi mdi-language-html5"></i>
                    <i class="brands-webWMS mdi mdi-language-css3"></i>
                    <i class="brands-webWMS mdi mdi-language-javascript"></i>
                </div>
                <div class="signup-form-text-software">
                    {{ 'ui.security.login.webserver'|trans }}   {{ webServer }} <br>
                    {{ 'ui.security.login.server.ip.adresse'|trans }} {{ serverIp }} <br>
                    {{ 'ui.security.login.server.name'|trans }} {{ serverName }} <br>
                    {{ 'ui.security.login.freier.speicherplatz'|trans }} {{ freeDiskSpace }} <br>
                    {{ 'ui.security.login.mysql.version'|trans }} {{ mySqlVersion }} <br>
                    {{ 'ui.security.login.php.version'|trans }} {{ phpVersion }}
                </div>
                </form>
            </div>
        </div>
    {% endblock %}
{% endblock %}
