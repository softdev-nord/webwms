{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_supplier_order_overview %}
            <div id="webWMS-supplier-order-overview" class="wrapper-form{% if appTheme.setTheme == 'vertical' %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if appTheme.setTheme == 'vertical' %} vertical-theme{% endif %}">
                    <div class="card">
                        <div class="card-content">
                            {% block webwms_supplier_order_overview_table_orders %}
                                <table id="bstTable" class="table table-striped table-bordered table-hover compact">
                                    <thead>
                                    <tr>
                                        <th style="text-align: center">Bestellungs-Nr</th>
                                        <th style="text-align: center">Bestellungs Referenz</th>
                                        <th style="text-align: center">Lieferanten-Nr</th>
                                        <th style="text-align: center">Lieferanten-Name</th>
                                        <th style="text-align: center">Bestellungsdatum</th>
                                        <th style="text-align: center">Benutzer</th>
                                    </thead>
                                </table>
                            {% endblock %}
                        </div>
                    </div>
                    <br><br>
                    <div class="card">
                        <div class="card-content">
                            {% block webwms_supplier_order_overview_table_orders_pos %}
                                <table id="posTable" class="table table-striped table-bordered table-hover compact">
                                    <thead>
                                    <tr>
                                        <th style="text-align: center" width="5%">Bestellungs-Nr</th>
                                        <th style="text-align: center" width="5%">Artikel-Nr</th>
                                        <th style="text-align: center" width="25%">Artikelname</th>
                                        <th style="text-align: center" width="5%">Menge</th>
                                        <th style="text-align: center" width="5%">Geliefert</th>
                                        <th style="text-align: center" width="5%">Offen</th>
                                    </thead>
                                </table>
                            {% endblock %}
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endblock %}
    {% block javascripts %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.bstTable.js') }}"></script>
    {% endblock %}
{% endblock %}