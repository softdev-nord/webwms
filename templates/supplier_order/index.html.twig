{# templates/supplier_order/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_supplier_order_overview %}
        <div id="webWMS-supplier-order-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_supplier_order_overview_table_orders %}
                                    <table id="supplierOrderTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                        <thead>
                                        <tr>
                                            <th style="text-align: center">{{ 'ui.supplier_order.index.bestellungs.nr'|trans }}</th>
                                            <th style="text-align: center">{{ 'ui.supplier_order.index.bestellungs.referenz'|trans }}</th>
                                            <th style="text-align: center">{{ 'ui.supplier.index.lieferanten.nr'|trans }}</th>
                                            <th style="text-align: center">{{ 'ui.supplier.index.lieferanten.name'|trans }}</th>
                                            <th style="text-align: center">{{ 'ui.supplier_order.index.bestellungsdatum'|trans }}</th>
                                            <th style="text-align: center">{{ 'nav.user.user'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.letzte.anderung'|trans }}</th>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                            <div class="card-body">
                                {% block webwms_supplier_order_overview_table_orders_pos %}
                                    <table id="posTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                        <thead>
                                        <tr>
                                            <th style="text-align: center" width="5%">{{ 'ui.supplier_order.index.bestellungs.nr'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'ui.article.article_input_fields.artikel.nr'|trans }}</th>
                                            <th style="text-align: center" width="25%">{{ 'ui.article.article_input_fields.artikelname'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'ui.customer_order.index.geliefert'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'ui.customer_order.index.offen'|trans }}</th>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.supplierOrder.js') }}"></script>
{% endblock %}
