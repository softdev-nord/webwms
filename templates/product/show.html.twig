{% extends 'v3/base.html.twig' %}

{% block title %}{{ 'product.page.show'|trans({}, 'product') }} | WebWMS 3.0{% endblock %}

{% block webwms_content %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2"><h1 class="h3 mb-1">{{ product.sku }} · {{ product.name }}</h1><span class="badge bg-{{ product.active ? 'success' : 'secondary' }}-subtle text-{{ product.active ? 'success' : 'secondary' }}">{{ (product.active ? 'product.status.active' : 'product.status.inactive')|trans({}, 'product') }}</span></div>
            <p class="text-muted mb-0">{{ product.short_description ?: ('product.show.description'|trans({}, 'product')) }}</p>
        </div>
        <div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="{{ path('v3_product_index') }}">{{ 'product.action.overview'|trans({}, 'product') }}</a>{% if is_granted('inventory.product.write') %}<a class="btn btn-primary" href="{{ path('v3_product_edit', {productId: product.id}) }}"><i class="ri-pencil-line me-1"></i>{{ 'product.action.edit'|trans({}, 'product') }}</a>{% endif %}</div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        {% for tab in ['master_data', 'stock', 'movements', 'inbound', 'outbound', 'boms', 'hazards', 'history'] %}
            <li class="nav-item" role="presentation"><button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#product-{{ tab }}" type="button" role="tab">{{ ('product.tab.' ~ tab)|trans({}, 'product') }}{% if attribute(context, tab)|default([]) is not empty %} <span class="badge bg-light text-body">{{ attribute(context, tab)|length }}</span>{% endif %}</button></li>
        {% endfor %}
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="product-master_data" role="tabpanel">
            <div class="row g-3">
                <div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'product.section.general'|trans({}, 'product') }}</h2></div><div class="card-body"><dl class="row mb-0">{% for field in ['sku', 'name', 'gtin', 'category', 'base_unit', 'abc_classification', 'crash_class', 'description', 'description_en'] %}<dt class="col-sm-4">{{ ('product.field.' ~ field)|trans({}, 'product') }}</dt><dd class="col-sm-8">{{ attribute(product, field) ?: '–' }}</dd>{% endfor %}</dl></div></div></div>
                <div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'product.section.dimensions'|trans({}, 'product') }}</h2></div><div class="card-body"><dl class="row mb-0">{% for field in ['length_mm', 'width_mm', 'height_mm', 'weight_grams', 'net_weight_grams', 'volume_cm3', 'nesting_factor', 'goods_value', 'goods_value_currency'] %}<dt class="col-sm-6">{{ ('product.field.' ~ field)|trans({}, 'product') }}</dt><dd class="col-sm-6">{{ attribute(product, field) is not null ? attribute(product, field) : '–' }}</dd>{% endfor %}</dl></div></div></div>
                <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'product.section.instructions'|trans({}, 'product') }}</h2></div><div class="card-body row g-3">{% for field in ['inbound_note', 'picking_note', 'transport_note', 'packing_note', 'loading_note'] %}<div class="col-md"><strong class="d-block mb-1">{{ ('product.field.' ~ field)|trans({}, 'product') }}</strong><span class="text-muted">{{ attribute(product, field) ?: '–' }}</span></div>{% endfor %}</div></div></div>
            </div>
        </div>

        <div class="tab-pane fade" id="product-stock" role="tabpanel"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0" data-table-tools="false"><thead><tr><th>{{ 'product.context.warehouse'|trans({}, 'product') }}</th><th>{{ 'product.context.location'|trans({}, 'product') }}</th><th>{{ 'product.context.status'|trans({}, 'product') }}</th><th>{{ 'product.context.batch_serial'|trans({}, 'product') }}</th><th>{{ 'product.context.expiry'|trans({}, 'product') }}</th><th class="text-end">{{ 'product.context.quantity'|trans({}, 'product') }}</th></tr></thead><tbody>{% for row in context.stock %}<tr><td>{{ row.warehouse_code }}</td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}</td><td>{{ row.batch_number ?: row.serial_number ?: '–' }}</td><td>{{ row.expires_at ?: '–' }}</td><td class="text-end">{{ row.quantity }}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'product.context.no_stock'|trans({}, 'product') }}</td></tr>{% endfor %}</tbody></table></div></div></div>

        <div class="tab-pane fade" id="product-movements" role="tabpanel"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0" data-table-tools="false"><thead><tr><th>{{ 'product.context.time'|trans({}, 'product') }}</th><th>{{ 'product.context.movement'|trans({}, 'product') }}</th><th>{{ 'product.context.location'|trans({}, 'product') }}</th><th>{{ 'product.context.status'|trans({}, 'product') }}</th><th class="text-end">{{ 'product.context.change'|trans({}, 'product') }}</th><th class="text-end">{{ 'product.context.result'|trans({}, 'product') }}</th></tr></thead><tbody>{% for row in context.movements %}<tr><td>{{ row.occurred_at }}</td><td>{{ row.movement_type }}<div class="small text-muted">{{ row.reason }}</div></td><td>{{ row.location_code }}</td><td>{{ row.stock_status }}</td><td class="text-end">{{ row.quantity_delta }}</td><td class="text-end">{{ row.resulting_quantity }}</td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-4">{{ 'product.context.no_movements'|trans({}, 'product') }}</td></tr>{% endfor %}</tbody></table></div></div></div>

        {% for type in ['inbound', 'outbound'] %}
            <div class="tab-pane fade" id="product-{{ type }}" role="tabpanel"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0" data-table-tools="false"><thead><tr><th>{{ 'product.context.order'|trans({}, 'product') }}</th><th>{{ 'product.context.status'|trans({}, 'product') }}</th><th>{{ 'product.context.time'|trans({}, 'product') }}</th><th class="text-end">{{ 'product.context.quantity'|trans({}, 'product') }}</th></tr></thead><tbody>{% for row in attribute(context, type) %}<tr><td>{{ row.code }}</td><td>{{ row.status }}</td><td>{{ row.created_at }}</td><td class="text-end">{{ type == 'inbound' ? row.ordered_quantity ~ ' / ' ~ row.received_quantity : row.requested_quantity }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ ('product.context.no_' ~ type)|trans({}, 'product') }}</td></tr>{% endfor %}</tbody></table></div></div></div>
        {% endfor %}

        <div class="tab-pane fade" id="product-boms" role="tabpanel"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0" data-table-tools="false"><thead><tr><th>{{ 'product.context.code'|trans({}, 'product') }}</th><th>{{ 'product.context.version'|trans({}, 'product') }}</th><th>{{ 'product.context.positions'|trans({}, 'product') }}</th><th>{{ 'product.context.status'|trans({}, 'product') }}</th></tr></thead><tbody>{% for row in context.boms %}<tr><td>{{ row.code }}</td><td>{{ row.version }}</td><td>{{ row.item_count }}</td><td>{{ row.active ? ('product.status.active'|trans({}, 'product')) : ('product.status.inactive'|trans({}, 'product')) }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'product.context.no_boms'|trans({}, 'product') }}</td></tr>{% endfor %}</tbody></table></div></div></div>

        <div class="tab-pane fade" id="product-hazards" role="tabpanel"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0" data-table-tools="false"><thead><tr><th>{{ 'product.context.un_number'|trans({}, 'product') }}</th><th>{{ 'product.context.hazard_class'|trans({}, 'product') }}</th><th>{{ 'product.context.packing_group'|trans({}, 'product') }}</th><th>{{ 'product.field.description'|trans({}, 'product') }}</th></tr></thead><tbody>{% for row in context.hazards %}<tr><td>{{ row.un_number }}</td><td>{{ row.hazard_class }} · {{ row.hazard_class_name }}</td><td>{{ row.packing_group ?: '–' }}</td><td>{{ row.description }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'product.context.no_hazards'|trans({}, 'product') }}</td></tr>{% endfor %}</tbody></table></div></div></div>

        <div class="tab-pane fade" id="product-history" role="tabpanel"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0" data-table-tools="false"><thead><tr><th>{{ 'product.context.time'|trans({}, 'product') }}</th><th>{{ 'product.context.event'|trans({}, 'product') }}</th><th>{{ 'product.context.user'|trans({}, 'product') }}</th></tr></thead><tbody>{% for row in context.history %}<tr><td>{{ row.occurred_at }}</td><td>{{ row.event_type }}</td><td>{{ row.performed_by_name }}</td></tr>{% else %}<tr><td colspan="3" class="text-center text-muted py-4">{{ 'product.context.no_history'|trans({}, 'product') }}</td></tr>{% endfor %}</tbody></table></div></div></div>
    </div>
{% endblock %}
