{# templates/customer/customer_input_fields.html.twig #}

{% block webwms_customer_input_fields_form %}
    <div class="row">
        {% block webwms_customer_input_fields_form_inner %}
            <div class="card">
                {{ form_start(customerForm) }}
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.kunden.nr.a844539'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {% if editCustomer %}
                                {{ form_row(customerForm.customerNr) }}
                            {% else %}
                                {{ form_row(customerForm.customerNr, {'value' : "#{lastId.customerNr +1}"}) }}
                            {% endif %}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.kunden.name.28f9c90'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerName) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.anschrift.zusatz.59481f7'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerAddressAddition) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.strasse.880c688'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerAddressStreet) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.haus.nr.bc8a464'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerAddressStreetNr) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.land.d9df90d'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerCountryCode) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'templates.editor.zip'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerZipCode) }}
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="text" class="control-label col-xs-4">{{ 'ui.customer.customer_input_fields.ort.d95f9e6'|trans }}</label>
                        <div class="col-xs-8" style="margin-bottom: 5px;">
                            {{ form_row(customerForm.customerCity) }}
                        </div>
                    </div>
                    <div class="text-center">
                        {{ form_widget(customerForm.save) }} {{ form_widget(customerForm.abort) }}
                    </div>
                {{ form_end(customerForm) }}
            </div>
        {% endblock %}

        {% block bodyjs %}
            <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.customersAutofill.js') }}"></script>
            <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.itemsCustomerOrderPosAutofill.js') }}"></script>
        {% endblock %}
    </div>
{% endblock %}
