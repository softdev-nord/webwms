{# templates/customer/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_customer_overview %}
        <div id="webWMS-customer-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_customer_overview_table %}
                                    <table id="customerTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col">{{ 'customer.customer_input_fields.customer_no'|trans }}</th>
                                            <th scope="col">{{ 'customer.customer_input_fields.customer_name'|trans }}</th>
                                            <th scope="col">{{ 'customer.customer_input_fields.address_line_2'|trans }}</th>
                                            <th scope="col">{{ 'customer.customer_input_fields.street'|trans }}</th>
                                            <th scope="col">{{ 'customer.customer_input_fields.house_no'|trans }}</th>
                                            <th scope="col">{{ 'customer.customer_input_fields.country'|trans }}</th>
                                            <th scope="col">{{ 'common.template.editor.zip'|trans }}</th>
                                            <th scope="col">{{ 'customer.customer_input_fields.city_town'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.customer.js') }}"></script>
{% endblock %}
