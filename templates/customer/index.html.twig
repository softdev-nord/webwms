{# templates/customer/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_customer_overview %}
        <div id="webwms-customer-overview" data-customer="true" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card" id="customerList">
                            <div class="card-header border-0">
                                <div class="row align-items-center gy-3">
                                    <div class="col-sm">
                                        <h5 class="card-title mb-0">{{ page }}</h5>
                                    </div>
                                    <div class="col-sm-auto">
                                        <div class="d-flex gap-1 flex-wrap">
                                            <button type="button" class="btn btn-primary add-btn" data-bs-toggle="modal" id="create-btn" data-bs-target="#showModal"><i class="ri-add-line align-bottom me-1"></i> Kunden anlegen</button>
                                            <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
                                            <button type="button" class="btn btn-danger" id="exportJsonBtn"><i class="ri-download-2-fill align-bottom me-1"></i> JSON Export</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body border border-dashed border-end-0 border-start-0">
                                <form>
                                    <div class="row g-3">
                                        <div class="col-xxl-5 col-sm-6">
                                            <div class="search-box">
                                                <input type="text" class="form-control search" placeholder="Suche nach Kunden-Nr, Kunden-Name, etc.">
                                                <i class="ri-search-line search-icon"></i>
                                            </div>
                                        </div>
                                        <!--end col-->
                                    </div>
                                    <!--end row-->
                                </form>
                            </div>
                            <div class="card-body pt-4">
                                {% block webwms_customer_overview_table %}
                                    <div>

                                        <div class="table-responsive table-card mb-1">
                                            <table class="table table-nowrap align-middle" id="orderTable">
                                                <thead class="text-muted table-light">
                                                <tr>
                                                    <th class="sort" data-sort="customerNr">Kunden-Nr</th>
                                                    <th class="sort" data-sort="customerName">Kunden-Name</th>
                                                    <th class="sort" data-sort="customerAddressAddition">Anschrift Zusatz</th>
                                                    <th class="sort" data-sort="customerAddressStreet">Straße</th>
                                                    <th class="sort" data-sort="customerAddressStreetNr">Haus-Nr</th>
                                                    <th class="sort" data-sort="customerCountryCode">Land</th>
                                                    <th class="sort" data-sort="customerZipCode">PLZ</th>
                                                    <th class="sort" data-sort="customerCity">Ort</th>
                                                    <th class="sort" data-sort="action">Action</th>
                                                </tr>
                                                </thead>
                                                <tbody class="list form-check-all"></tbody>
                                            </table>
                                        </div>
                                        <div class="d-flex justify-content-end">
                                            <div class="pagination-wrap hstack gap-2">
                                                <a class="page-item pagination-prev disabled" href="#">
                                                    Previous
                                                </a>
                                                <ul class="pagination listjs-pagination mb-0"></ul>
                                                <a class="page-item pagination-next" href="#">
                                                    Next
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <!-- list.js min js -->
    <script src="{{ asset('assets/libs/list.js/list.min.js') }}"></script>
    <!--list pagination js-->
    <script src="{{ asset('assets/libs/list.pagination.js/list.pagination.min.js') }}"></script>

    <!-- Customer Overview js -->
    <script src="{{ asset('assets/js/webWmsCoreJs/customer-overview.js') }}"></script>
{% endblock %}
