{# templates/customer/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_customer_overview %}
        <div id="webWMS-customer-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_customer_overview_table %}
                                    <table id="customerTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.kunden.nr.a844539'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.kunden.name.28f9c90'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.anschrift.zusatz.59481f7'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.strasse.880c688'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.haus.nr.bc8a464'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.land.d9df90d'|trans }}</th>
                                            <th scope="col">{{ 'templates.editor.zip'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer.customer_input_fields.ort.d95f9e6'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.customer.js') }}"></script>
{% endblock %}
