{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_submenu %}
        {{ include('submenu.html.twig') }}
    {% endblock %}

    {% block webwms_edit_customer %}
    <div id="webWMS-edit-article" class="wrapper-form">
        <div class="wrapper-form-content">
            <div class="card">
                <div class="card-content">
                    {% block webwms_edit_customer_form %}
                        <div class="card">
                            {{ form_start(editCustomerForm) }}

                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Kunden-Nr</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_nr) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Kunden-Name</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_name) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Anschrift Zusatz</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_address_addition) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Straße</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_address_street) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Haus-Nr</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_address_street_nr) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Land</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_country_code) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">PLZ</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_zip_code) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Ort</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(editCustomerForm.customer_city) }}
                                </div>
                            </div>
                            <div class="text-center">
                                {{ form_widget(editCustomerForm.save) }}
                                {{ form_widget(editCustomerForm.back_to_customer_overview) }}
                            </div>
                            {{ form_end(editCustomerForm) }}
                        </div>
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
    {% endblock %}
    {% block javascripts %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.customer.js') }}"></script>
    {% endblock %}
{% endblock %}
