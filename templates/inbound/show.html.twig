{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
    <div class="mb-4">
        <a href="{{ path('v3_inbound_index') }}" class="text-decoration-none">
            {{ 'inbound.new.goods_receipt'|trans }}
        </a>
        <h1 class="h3 mt-2">
            {{ receipt.code }}
        </h1>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">
                    {{ 'administration.workspace.supplier'|trans }}
                </dt>
                <dd class="col-sm-9">
                    {{ receipt.supplier_code }} · {{ receipt.supplier_name }}
                </dd>
                <dt class="col-sm-3">
                    {{ 'inbound.control.delivery_note'|trans }}
                </dt>
                <dd class="col-sm-9">
                    {{ receipt.delivery_note|default('–') }}
                </dd>
                <dt class="col-sm-3">
                    {{ 'transport_request.index.status'|trans }}
                </dt>
                <dd class="col-sm-9">
                    {{ receipt.status }}
                </dd>
                <dt class="col-sm-3">
                    {{ 'inbound.show.accepted'|trans }}
                </dt>
                <dd class="col-sm-9">
                    {{ receipt.accepted_at }}
                </dd>
            </dl>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            {{ 'navigation.master_data.submenu.headline1.label'|trans }}
                        </th>
                        <th>
                            {{ 'modal.show_article_stock_details_modal.storage_bin'|trans }}
                        </th>
                        <th>
                            {{ 'customer_order.customer_order_input_fields.quantity'|trans }}
                        </th>
                        <th>
                            {{ 'transport_request.index.status'|trans }}
                        </th>
                        <th>
                            {{ 'inbound.show.batch_serial'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody>

                    {% for item in receipt.items %}

                        <tr>
                            <td>
                                {{ item.sku }} · {{ item.product_name }}
                            </td>
                            <td>
                                <code>
                                    {{ item.location_code }}
                                </code>
                            </td>
                            <td>
                                {{ item.quantity }}
                            </td>
                            <td>
                                {{ item.stock_status }}
                            </td>
                            <td>
                                {{ item.batch_number|default('–') }} / {{ item.serial_number|default('–') }}
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>
            </table>
        </div>
    </div>
    {% if receipt.status == 'accepted' and is_granted('inbound.receipt.book') %}

        <form method="post" action="{{ path('v3_inbound_book', {receiptId: receipt.id}) }}" class="text-end">
            <input type="hidden" name="_token" value="{{ csrf_token('v3_inbound_book_' ~ receipt.id) }}">
            <button class="btn btn-primary">
                {{ 'inbound.show.book_into_inventory'|trans }}
            </button>
        </form>

    {% endif %}
{% endblock %}
