{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'outbound.orders.outbound_orders'|trans }}</h1><p class="text-muted mb-0">{{ 'outbound.orders.order_release_reservation_and_handover_to_picking'|trans }}</p></div>{% if is_granted('outbound.order.write') %}<a class="btn btn-primary" href="{{ path('v3_outbound_order_new') }}">{{ 'outbound.order_new.create_order'|trans }}</a>{% endif %}</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>{{ 'inbound.control.order'|trans }}</th><th>{{ 'outbound.order.customer_reference'|trans }}</th><th>{{ 'address.recipient'|trans }}</th><th>{{ 'transport_request.index.status'|trans }}</th><th class="text-end">{{ 'inbound.control.items'|trans }}</th><th class="text-end">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</th><th>{{ 'outbound.control.pick_list'|trans }}</th><th></th></tr></thead><tbody>
{% for order in orders %}<tr><td class="fw-semibold">{{ order.order_number }}</td><td>{{ order.customer_reference }}</td><td>{% if order.recipient_name %}{{ order.recipient_name }}<div class="small text-muted">{{ order.recipient_postal_code }} {{ order.recipient_city }} · {{ order.recipient_country_code }}</div>{% else %}<span class="text-muted">{{ 'address.not_recorded'|trans }}</span>{% endif %}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ order.status }}</span></td><td class="text-end">{{ order.item_count }}</td><td class="text-end">{{ order.requested_quantity }}</td><td>{{ order.pick_list_code ?: '–' }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_outbound_order', {orderId: order.id}) }}">{{ 'inbound.index.open'|trans }}</a></td></tr>{% else %}<tr><td colspan="8" class="text-center text-muted py-5">{{ 'outbound.orders.no_outbound_orders_yet'|trans }}</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}
