{# templates/article/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_article_overview %}
        <div id="webwms-article-overview" data-article="true" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_article_overview_table %}
                                    <table id="artTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.article_input_fields.artikel.nr'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.bezeichnung'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.article_input_fields.kategorie'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.gewicht.in.g'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.ean.code'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.einheit'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.tiefe.mm'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.breite.mm'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.hohe.mm'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.bestand'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.zugang'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.reserviert'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.letzte.anderung'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.article.js') }}"></script>
{% endblock %}
