{# templates/article/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_article_overview %}
        <div id="webwms-article-overview" data-article="true" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_article_overview_table %}
                                    <table id="artTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.article_input_fields.artikel.nr.b7761c6'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.article_input_fields.kategorie.3582103'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.gewicht.in.g.e6c05a8'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.ean.code.d6b4038'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.einheit.a759a4a'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.tiefe.mm.7cc9aaf'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.breite.mm.a17981c'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.hohe.mm.115c569'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.bestand.6e8cf3e'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.zugang.c4f24d7'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.reserviert.e78426b'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.letzte.anderung.1ab1b51'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.article.js') }}"></script>
{% endblock %}
