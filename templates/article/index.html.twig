{# templates/article/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_article_overview %}
        <div id="webwms-article-overview" data-article="true" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_article_overview_table %}
                                    <table id="artTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col" style="text-align: center">{{ 'article.article_input_fields.item_no'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.description'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.article_input_fields.category'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.weight_in_g'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.ean_code'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.unit'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.depth_mm'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.width_mm'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.height_mm'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.stock'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.access'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.reserved'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.last_modification'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.article.js') }}"></script>
{% endblock %}
