{# templates/article/article_input_fields.html.twig #}

{% block webwms_article_input_fields_form %}
    <div class="row">
        {% block webwms_article_input_fields_form_inner %}
            <div class="card">
                <div class="card-content">
                    {{ form_start(articleForm) }}
                    <div class="row" style="margin-bottom: 25px">
                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.allgemeine.daten'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.artikel.nr'|trans }}</label>
                                                <div class="col-xs-8">
                                                    {% if editArticle %}
                                                        {{ form_row(articleForm.articleNr) }}
                                                    {% else %}
                                                        {{ form_row(articleForm.articleNr, {'value' : "#{lastId.articleNr +1}"}) }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.artikelname'|trans }}</label>
                                                <div class="col-xs-8">
                                                    {{ form_row(articleForm.articleName) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.kategorie'|trans }}</label>
                                                <div class="col-xs-8">
                                                    {{ form_row(articleForm.articleCategory) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.artikel.details'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.gewicht'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleWeight) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.ean.nr'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleEan) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.einheit.stk.kg.etc'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleUnit) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.artikel.abmessungen'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.tiefe'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleDepth) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.breite'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleWidth) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.hohe'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleHeight) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'nav.logistics.headline'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.auslagerungsstrategie'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.stockOutStrategy) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.le.menge'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.leQuantity) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.standard.ladehilfsmittel'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.standardLoadingEquipment) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center">
                        {{ form_widget(articleForm.save) }} {{ form_widget(articleForm.abort) }}
                    </div>
                    {{ form_end(articleForm) }}
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}
