{# templates/article/article_input_fields.html.twig #}

{% block webwms_article_input_fields_form %}
    <div class="row">
        {% block webwms_article_input_fields_form_inner %}
            <div class="card">
                <div class="card-content">
                    {{ form_start(articleForm) }}
                    <div class="row" style="margin-bottom: 25px">
                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.allgemeine.daten.af159f2'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.artikel.nr.b7761c6'|trans }}</label>
                                                <div class="col-xs-8">
                                                    {% if editArticle %}
                                                        {{ form_row(articleForm.articleNr) }}
                                                    {% else %}
                                                        {{ form_row(articleForm.articleNr, {'value' : "#{lastId.articleNr +1}"}) }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.artikelname.1369a4d'|trans }}</label>
                                                <div class="col-xs-8">
                                                    {{ form_row(articleForm.articleName) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.kategorie.3582103'|trans }}</label>
                                                <div class="col-xs-8">
                                                    {{ form_row(articleForm.articleCategory) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.artikel.details.9458921'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.gewicht.b80121b'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleWeight) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.ean.nr.6f75442'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleEan) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.einheit.stk.kg.etc.905ace9'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleUnit) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.artikel.abmessungen.2af0460'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.tiefe.86a28ff'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleDepth) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.breite.861387c'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleWidth) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.hohe.f0c362a'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.articleHeight) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6" style="padding: 10px">
                            <div class="card" style="height: 100%">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-xxl-12">
                                            <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'nav.logistics.headline'|trans }}</span>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.auslagerungsstrategie.2db2a27'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.stockOutStrategy) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.le.menge.80e62b5'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.leQuantity) }}
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.standard.ladehilfsmittel.2af26c3'|trans }}</label>
                                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                                    {{ form_row(articleForm.standardLoadingEquipment) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center">
                        {{ form_widget(articleForm.save) }} {{ form_widget(articleForm.abort) }}
                    </div>
                    {{ form_end(articleForm) }}
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}
