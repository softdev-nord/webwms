{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_add_new_article %}
            <div id="webWMS-add-new-article" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                        <div class="webwms-page">{{ page }}</div>
                    {% endif %}
                    <div class="card">
                        <div class="card-content">
                            {% block webwms_add_new_article_form %}
                                <div class="card">
                                    {{ form_start(addArticleForm) }}
                                    <p class="hint-text">Hier können Sie einen neuen Artikel anlegen</p>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Artikel-Nr</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleNr, {'value' : "#{lastId.articleNr +1}"}) }}

                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Artikelname</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleName) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Kategorie</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleCategory) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Gewicht</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleWeight) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">EAN-Nr.</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleEan) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Einheit (Stk, kg, etc)</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleUnit) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Tiefe</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleDepth) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Breite</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleWidth) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Höhe</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.articleHeight) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Auslagerungsstrategie</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.stockOutStrategy) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">Standard Ladehilfsmittel</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.standardLoadingEquipment) }}
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="text" class="control-label col-xs-4">LE-Menge</label>
                                        <div class="col-xs-8" style="margin-bottom: 5px;">
                                            {{ form_row(addArticleForm.leQuantity) }}
                                        </div>
                                    </div>
                                    <div class="form-group col-md-12">
                                        {% for message in app.flashes('success') %}
                                            <div class="alert alert-success">
                                                {{ message }}
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <div class="text-center">
                                        {{ form_widget(addArticleForm.addArticle) }}
                                    </div>
                                    {{ form_end(addArticleForm) }}
                                </div>
                            {% endblock %}
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endblock %}
{% endblock %}
