{% extends 'v3/base.html.twig' %}
{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_data_exchange_index') }}">{{ 'integration.exchange.action.back'|trans }}</a><h1 class="h3 mt-2">{{ 'integration.exchange.page.import'|trans }}</h1><p class="text-muted">{{ 'integration.exchange.text.import'|trans }}</p></div>
	<form method="post" enctype="multipart/form-data" class="card border-0 shadow-sm"><div class="card-body"><input type="hidden" name="_token" value="{{ csrf_token('v3_data_exchange_import') }}"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="format">{{ 'integration.exchange.field.format'|trans }}</label><select class="form-select" id="format" name="format" required><option value="json">JSON</option><option value="xml">XML</option><option value="csv">CSV</option><option value="xlsx">XLSX</option><option value="idoc">SAP IDoc</option></select></div><div class="col-md-4"><label class="form-label" for="resource_type">{{ 'integration.exchange.field.resource'|trans }}</label><input class="form-control" id="resource_type" name="resource_type" value="product" required></div><div class="col-md-4"><label class="form-label" for="mapping_system">{{ 'integration.exchange.field.mapping_system'|trans }}</label><select class="form-select" id="mapping_system" name="mapping_system"><option value="">{{ 'integration.exchange.field.no_mapping'|trans }}</option><option value="erp">ERP</option><option value="commerce">Commerce</option></select></div><div class="col-12"><label class="form-label" for="file">{{ 'integration.exchange.field.file'|trans }}</label><input class="form-control" type="file" id="file" name="file" required></div></div></div><div class="card-footer text-end"><button class="btn btn-primary">{{ 'integration.exchange.action.import'|trans }}</button></div></form>
{% endblock %}
