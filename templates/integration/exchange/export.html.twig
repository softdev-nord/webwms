{% extends 'v3/base.html.twig' %}
{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_data_exchange_index') }}">{{ 'integration.exchange.action.back'|trans }}</a><h1 class="h3 mt-2">{{ 'integration.exchange.page.export'|trans }}</h1><p class="text-muted">{{ 'integration.exchange.text.export'|trans }}</p></div>
	<form method="post" class="card border-0 shadow-sm"><div class="card-body"><input type="hidden" name="_token" value="{{ csrf_token('v3_data_exchange_export') }}"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="format">{{ 'integration.exchange.field.format'|trans }}</label><select class="form-select" id="format" name="format" required><option value="json">JSON</option><option value="xml">XML</option><option value="csv">CSV</option><option value="xlsx">XLSX</option></select></div><div class="col-md-8"><label class="form-label" for="resource_type">{{ 'integration.exchange.field.resource'|trans }}</label><input class="form-control" id="resource_type" name="resource_type" value="product" required></div><div class="col-12"><label class="form-label" for="rows">{{ 'integration.exchange.field.data'|trans }}</label><textarea class="form-control font-monospace" id="rows" name="rows" rows="12" required>[{"sku":"A-1","name":"Article"}]</textarea></div></div></div><div class="card-footer text-end"><button class="btn btn-primary">{{ 'integration.exchange.action.export'|trans }}</button></div></form>
{% endblock %}
