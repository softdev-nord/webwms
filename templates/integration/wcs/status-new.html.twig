{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><a href="{{ path('v3_wcs_index') }}" class="text-decoration-none">{{ 'integration.wcs.command_new.wcs_mfr_and_conveyor_system'|trans }}</a><h1 class="h3 mt-2">{{ 'integration.wcs.status_new.capture_machine_status'|trans }}</h1></div>
	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_wcs_status_create') }}"><input type="hidden" name="external_event_id" value="{{ eventId }}">
			<div class="row g-3">
				<div class="col-md-6"><label class="form-label" for="connection_id">{{ 'integration.wcs.command_new.connection'|trans }}</label><select class="form-select" id="connection_id" name="connection_id" required>{% for connection in connections %}<option value="{{ connection.id }}">{{ connection.code }} · {{ connection.name }}</option>{% endfor %}</select></div>
				<div class="col-md-6"><label class="form-label" for="command_id">{{ 'integration.wcs.status_new.transport_command_optional'|trans }}</label><select class="form-select" id="command_id" name="command_id"><option value="">{{ 'integration.wcs.status_new.no_command_reference'|trans }}</option>{% for command in commands %}<option value="{{ command.id }}">{{ command.load_unit }} · {{ command.source }} → {{ command.destination }}</option>{% endfor %}</select></div>
				<div class="col-md-4"><label class="form-label" for="machine_code">{{ 'integration.wcs.status_new.machine_code'|trans }}</label><input class="form-control font-monospace text-uppercase" id="machine_code" name="machine_code" maxlength="100" required></div>
				<div class="col-md-3"><label class="form-label" for="status">{{ 'transport_request.index.status'|trans }}</label><select class="form-select" id="status" name="status"><option value="ready">{{ 'integration.wcs.status_new.ready'|trans }}</option><option value="busy">{{ 'integration.wcs.status_new.busy'|trans }}</option><option value="blocked">{{ 'transport_request.index.blocked'|trans }}</option><option value="fault">{{ 'integration.wcs.status_new.fault'|trans }}</option><option value="offline">{{ 'integration.wcs.status_new.offline'|trans }}</option></select></div>
				<div class="col-md-5"><label class="form-label" for="message">{{ 'integration.wcs.command_show.message'|trans }}</label><input class="form-control" id="message" name="message" maxlength="500"></div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2"><a class="btn btn-light" href="{{ path('v3_wcs_index') }}">{{ 'common.button.cancel'|trans }}</a><button class="btn btn-primary" {% if connections is empty %}disabled{% endif %}>{{ 'integration.wcs.index.capture_status'|trans }}</button></div>
	</form>
{% endblock %}
