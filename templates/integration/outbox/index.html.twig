{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<h1 class="h3 mb-1">{{ 'integration.erp_connection.show.integration_outbox'|trans }}</h1>
		<p class="text-muted mb-0">{{ 'integration.outbox.index.monitor_status_events_and_process_failed_deliveries'|trans }}</p>
	</div>

	<div class="card border-0 shadow-sm mb-4">
		<div class="card-body">
			<form method="get" class="row g-2 align-items-end">
				<div class="col-md-5 col-lg-3">
					<label class="form-label" for="status">{{ 'transport_request.index.status'|trans }}</label>
					<select class="form-select" id="status" name="status">
						{% for status in statuses %}
							<option value="{{ status }}" {% if status == selectedStatus %}selected{% endif %}>{{ status }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="col-auto">
					<button class="btn btn-primary">{{ 'integration.outbox.index.filter'|trans }}</button>
				</div>
			</form>
		</div>
	</div>

	<div class="card border-0 shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th>{{ 'administration.workspace.event'|trans }}</th>
						<th>{{ 'integration.outbox.index.unit'|trans }}</th>
						<th>{{ 'transport_request.index.status'|trans }}</th>
						<th class="text-end">{{ 'integration.outbox.index.attempts'|trans }}</th>
						<th>{{ 'administration.workspace.time_point_in_time'|trans }}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for message in messages %}
						<tr>
							<td class="fw-semibold">{{ message.event_name }}</td>
							<td>
								<div>{{ message.aggregate_type }}</div>
								<code>{{ message.aggregate_id }}</code>
							</td>
							<td><span class="badge bg-secondary-subtle text-secondary">{{ message.status }}</span></td>
							<td class="text-end">{{ message.attempt_count }}</td>
							<td>{{ message.occurred_at }}</td>
							<td class="text-end">
								<a class="btn btn-sm btn-outline-primary" href="{{ path('v3_outbox_show', {messageId: message.id}) }}">{{ 'inbound.index.open'|trans }}</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-5">{{ 'integration.outbox.index.no_messages_with_this_status'|trans }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>

	{% if nextCursor %}
		<div class="mt-3 text-end">
			<a class="btn btn-outline-primary" href="{{ path('v3_outbox_index', {status: selectedStatus, cursor: nextCursor}) }}">{{ 'integration.outbox.index.additional_messages'|trans }}</a>
		</div>
	{% endif %}
{% endblock %}
