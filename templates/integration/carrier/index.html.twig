{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ 'integration.carrier_connection.index.carrier_connections'|trans }}
            </h1>
            <p class="text-muted mb-0">
                {{ 'integration.carrier_connection.index.integrate_shipping_products_labels_tracking_and_manifest_handovers'|trans }}
            </p>
        </div>
        {% if is_granted('integration.carrier_connection.write') %}
            <a class="btn btn-primary" href="{{ path('v3_carrier_connection_new') }}">
                {{ 'integration.carrier_connection.index.create_carrier_connection'|trans }}
            </a>
        {% endif %}
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            {{ 'administration.workspace.carrier'|trans }}
                        </th>
                        <th>
                            {{ 'common.template.correspondence.name'|trans }}
                        </th>
                        <th>
                            {{ 'integration.carrier_connection.index.endpoint'|trans }}
                        </th>
                        <th>
                            {{ 'transport_request.index.status'|trans }}
                        </th>
                        <th>
                            {{ 'extensions.configuration_index.modified'|trans }}
                        </th>
                        <th>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for connection in connections %}
                        <tr>
                            <td>
                                <span class="badge bg-primary-subtle text-primary">
                                    {{ connection.carrier_code }}
                                </span>
                            </td>
                            <td class="fw-semibold">
                                {{ connection.name }}
                            </td>
                            <td>
                                <code>
                                    {{ connection.endpoint_url }}
                                </code>
                            </td>
                            <td>
                                {% if connection.active %}
                                    <span class="badge bg-success-subtle text-success">
                                        {{ 'user.user_input_fields.active'|trans }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        {{ 'integration.carrier_connection.index.paused'|trans }}
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {{ connection.changed_at|default(connection.created_at) }}
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('v3_carrier_connection_show', {connectionId: connection.id}) }}">
                                    {{ 'inbound.index.open'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                {{ 'integration.carrier_connection.index.no_carrier_connections_yet'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
