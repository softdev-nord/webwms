{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <a href="{{ path('v3_erp_connection_index') }}" class="text-decoration-none">
                {{ 'integration.erp_connection.new.erp_connections'|trans }}
            </a>
            <h1 class="h3 mt-2 mb-1">
                {{ connection.name }}
            </h1>
            {% if connection.active %}
                <span class="badge bg-success-subtle text-success">
                    {{ 'user.user_input_fields.active'|trans }}
                </span>
            {% else %}
                <span class="badge bg-secondary-subtle text-secondary">
                    {{ 'integration.carrier_connection.index.paused'|trans }}
                </span>
            {% endif %}
        </div>
        {% if is_granted('integration.erp_connection.write') %}
            <form method="post" action="{{ path('v3_erp_connection_status', {connectionId: connection.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('v3_erp_connection_status_' ~ connection.id) }}">
                <button class="btn {{ connection.active ? 'btn-outline-warning' : 'btn-success' }}">
                    {{ (connection.active ? 'integration.carrier_connection.show.pause_connection' : 'integration.carrier_connection.show.activate_connection')|trans }}
                </button>
            </form>
        {% endif %}
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent">
                    <h2 class="h5 mb-0">
                        {{ 'integration.carrier_connection.show.connection_details'|trans }}
                    </h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">
                            {{ 'integration.carrier_connection.new.https_base_url'|trans }}
                        </dt>
                        <dd class="col-sm-8">
                            <code>
                                {{ connection.endpoint_url }}
                            </code>
                        </dd>
                        <dt class="col-sm-4">
                            {{ 'integration.erp_connection.show.status_endpoint'|trans }}
                        </dt>
                        <dd class="col-sm-8">
                            <code>
                                {{ connection.endpoint_url }}{{ 'integration.erp_connection.new.status_events'|trans }}
                            </code>
                        </dd>
                        <dt class="col-sm-4">
                            {{ 'integration.carrier_connection.show.credential_reference'|trans }}
                        </dt>
                        <dd class="col-sm-8">
                            <code>
                                {{ connection.credential_env }}
                            </code>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent">
                    <h2 class="h5 mb-0">
                        {{ 'integration.carrier_connection.show.audit'|trans }}
                    </h2>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>
                            {{ 'integration.carrier_connection.show.created'|trans }}
                        </dt>
                        <dd>
                            {{ connection.created_at }}
                            <br>
                            <code>
                                {{ connection.created_by }}
                            </code>
                        </dd>
                        <dt>
                            {{ 'integration.carrier_connection.show.last_status_change'|trans }}
                        </dt>
                        <dd class="mb-0">
                            {% if connection.changed_at %}
                                {{ connection.changed_at }}
                                <br>
                                <code>
                                    {{ connection.changed_by }}
                                </code>
                            {% else %}
                                {{ 'integration.carrier_connection.show.no_status_change_yet'|trans }}
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4 mb-0">
        {{ 'integration.erp_connection.show.outgoing_status_messages_and_delivery_errors_can_be'|trans }}
        <a href="{{ path('v3_outbox_index') }}" class="alert-link">
            {{ 'integration.erp_connection.show.integration_outbox'|trans }}
        </a>
        {{ 'integration.erp_connection.show.monitored'|trans }}
    </div>
{% endblock %}
