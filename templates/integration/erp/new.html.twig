{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4">
		<a href="{{ path('v3_erp_connection_index') }}" class="text-decoration-none">{{ 'integration.erp_connection.new.erp_connections'|trans }}</a>
		<h1 class="h3 mt-2">{{ 'integration.erp_connection.index.create_erp_connection'|trans }}</h1>
		<p class="text-muted mb-0">{{ 'integration.erp_connection.new.signature_key_remains_in_runtime_environment_and_is_not_stored_in_webwms'|trans }}</p>
	</div>

	<form method="post" class="card border-0 shadow-sm">
		<div class="card-body">
			<input type="hidden" name="_token" value="{{ csrf_token('v3_erp_connection_create') }}">
			<div class="row g-3">
				<div class="col-md-6">
					<label class="form-label" for="name">{{ 'common.template.correspondence.name'|trans }}</label>
					<input class="form-control" id="name" name="name" maxlength="100" required placeholder="{{ 'integration.erp_connection.new.acme_erp_production'|trans }}">
				</div>
				<div class="col-md-6">
					<label class="form-label" for="credential_env">{{ 'integration.automation.device_new.credential_environment_variable'|trans }}</label>
					<input class="form-control font-monospace" id="credential_env" name="credential_env" maxlength="101" pattern="[A-Z][A-Z0-9_]{2,100}" required placeholder="{{ 'integration.erp_connection.new.erp_acme_signing_key'|trans }}">
					<div class="form-text">{{ 'integration.erp_connection.new.only_variable_name_is_stored_never_secret'|trans }}</div>
				</div>
				<div class="col-12">
					<label class="form-label" for="endpoint_url">{{ 'integration.carrier_connection.new.https_base_url'|trans }}</label>
					<input class="form-control font-monospace" type="url" id="endpoint_url" name="endpoint_url" maxlength="500" pattern="https://.*" required placeholder="{{ 'integration.erp_connection.new.https_erp_example_com_integrations_webwms'|trans }}">
					<div class="form-text">{{ 'integration.erp_connection.new.status_events_are_sent_to'|trans }} <code>{{ 'integration.erp_connection.new.status_events'|trans }}</code> {{ 'integration.erp_connection.new.this_url'|trans }}</div>
				</div>
				<div class="col-12">
					<div class="form-check form-switch">
						<input class="form-check-input" type="checkbox" role="switch" id="active" name="active" value="1" checked>
						<label class="form-check-label" for="active">{{ 'integration.carrier_connection.new.activate_connection_immediately'|trans }}</label>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-light" href="{{ path('v3_erp_connection_index') }}">{{ 'common.button.cancel'|trans }}</a>
			<button class="btn btn-primary">{{ 'integration.erp_connection.index.create_erp_connection'|trans }}</button>
		</div>
	</form>
{% endblock %}
