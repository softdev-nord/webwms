{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_submenu %}
        {{ include('submenu.html.twig') }}
    {% endblock %}

    {% block webwms_add_new_stock_location %}
    <div id="webWMS-add-new-stock-location" class="wrapper-form">
        <div class="wrapper-form-content">
            <div class="card">
                <div class="card-content">
                    {% block webwms_add_new_stock_location_form %}
                        <div class="card">
                            {{ form_start(stockLocationForm) }}
                            <p class="hint-text">Hier können Sie ein neues Lager anlegen</p>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Lagernummer</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_ln) }}

                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Fachboden</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_fb) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Fachboden</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_sp) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Tiefe</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_tf) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Beschreibung</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_desc) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Breite</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_width) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Tiefe</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_depth) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Höhe</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_height) }}
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="text" class="control-label col-xs-4">Mehrere Lagerplätze anlegen</label>
                                <div class="col-xs-8" style="margin-bottom: 5px;">
                                    {{ form_row(stockLocationForm.stock_location_check) }}
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="text-center">
                                {{ form_widget(stockLocationForm.add_stock_location) }}
                            </div>
                            {{ form_end(stockLocationForm) }}
                        </div>
                    {% endblock %}
                </div>
            </div>
        </div>
    </div>
    {% endblock %}
{% endblock %}
