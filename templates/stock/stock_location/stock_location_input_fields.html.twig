<div class="row">
    {% block webwms_stock_location_form %}
        <div class="card">
            {{ form_start(stockLocationForm) }}
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Lagernummer</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationLn) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Fachboden</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationFb) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Stellplatz</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationSp) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Tiefe</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationTf) }}
                </div>
            </div>
            {% if editStockLocation %}
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">Koordinate</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationCoordinate) }}
                    </div>
                </div>
            {% endif %}
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Bezeichnung</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationDesc) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Breite</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationWidth) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Tiefe</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationDepth) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Höhe</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationHeight) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Lager-Zone</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stockLocationZone) }}
                </div>
            </div>
            <div class="form-group">
                <label for="text" class="control-label col-xs-4">Mehrere Lagerplätze anlegen</label>
                <div class="col-xs-8" style="margin-bottom: 5px;">
                    {{ form_row(stockLocationForm.stock_location_check) }}
                </div>
            </div>
            <div class="text-center">
                {{ form_widget(stockLocationForm.save) }} {{ form_widget(stockLocationForm.back_to_stock_location_overview) }}
            </div>
            {{ form_end(stockLocationForm) }}
        </div>
    {% endblock %}
</div>
