{# templates/stock/stock_location/stock_location_input_fields.html.twig #}

{% block webwms_stock_location_input_fields_form %}
    <div class="row">
        {% block webwms_stock_location_input_fields_form_inner %}
            <div class="card">
                {{ form_start(stockLocationForm) }}
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.modal.put_into_storage.lagernummer'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationLn) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.modal.put_into_storage.fachboden'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationFb) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.modal.put_into_storage.stellplatz'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationSp) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.tiefe'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationTf) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.article.index.bezeichnung'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationDesc) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.breite'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationWidth) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.tiefe'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationDepth) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.hohe'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationHeight) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'ui.stock.stock_location.stock_location_input_fields.lager.zone'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLocationForm.stockLocationZone) }}
                    </div>
                </div>
                {{ form_row(stockLocationForm._token) }}
                <div class="text-center">
                    {{ form_widget(stockLocationForm.save) }} {{ form_widget(stockLocationForm.abort) }}
                </div>
                {{ form_end(stockLocationForm) }}
            </div>
        {% endblock %}
    </div>
{% endblock %}
