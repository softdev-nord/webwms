{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_stock_locations_overview %}
            <div id="webWMS-stock-locations-overview" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                        <div class="webwms-page">{{ page }}</div>
                    {% endif %}
                    {% block webwms_stock_locations_overview_table %}
                        <div class="card">
                            <div class="card-content">
                                <table id="stockLocationTable" class="table table-striped table-bordered table-hover compact">
                                    <thead style="text-align: center;">
                                    <tr>
                                        <th style="text-align: center" scope="col">Lagernummer</th>
                                        <th style="text-align: center" scope="col">Fachboden</th>
                                        <th style="text-align: center" scope="col">Stellplatz</th>
                                        <th style="text-align: center" scope="col">Tiefe</th>
                                        <th style="text-align: center" scope="col">Koordinate</th>
                                        <th style="text-align: center" scope="col">Bezeichnung</th>
                                        <th style="text-align: center" scope="col">Breite (mm)</th>
                                        <th style="text-align: center" scope="col">Tiefe (mm)</th>
                                        <th style="text-align: center" scope="col">Höhe (mm)</th>
                                        <th scope="col" style="text-align: center">Letzte Änderung</th>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    {% endblock %}
                </div>
            </div>
        {% endblock %}
    {% endblock %}
    {% block bodyjs %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockLocation.js') }}"></script>
    {% endblock %}
{% endblock %}
