{# templates/stock/stock_location/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_locations_overview %}
        <div id="webWMS-stock-locations-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_stock_locations_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="stockLocationTable" class="table table-striped table-bordered table-hover compact">
                                                <thead style="text-align: center;">
                                                <tr>
                                                    <th style="text-align: center" scope="col">{{ 'ui.modal.put_into_storage.lagernummer.765c756'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.modal.put_into_storage.fachboden.714a067'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.modal.put_into_storage.stellplatz.f0a25a2'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.article.article_input_fields.tiefe.86a28ff'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.modal.show_stock_details_modal.koordinate.208cdfa'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.article.index.breite.mm.a17981c'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.article.index.tiefe.mm.7cc9aaf'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.article.index.hohe.mm.115c569'|trans }}</th>
                                                    <th scope="col" style="text-align: center">{{ 'ui.article.index.letzte.anderung.1ab1b51'|trans }}</th>
                                                </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockLocation.js') }}"></script>
{% endblock %}
