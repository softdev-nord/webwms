{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_stock_movements_overview %}
            <div id="webWMS-stock-movements-overview" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                        <div class="webwms-page">{{ page }}</div>
                    {% endif %}
                    {% block webwms_stock_movements_overview_table %}
                        <div class="card">
                            <div class="card-content">
                                <table id="strTable" class="table table-striped table-bordered table-hover compact">
                                    <thead>
                                        <tr>
                                            <th scope="col">LBW ID</th>
                                            <th scope="col">BA ID</th>
                                            <th scope="col">Buchungsart</th>
                                            <th scope="col">Lagerplatz</th>
                                            <th scope="col">Lagersystem</th>
                                            <th scope="col">Artikel-Nr</th>
                                            <th scope="col">Bezeichnung</th>
                                            <th scope="col">Menge</th>
                                            <th scope="col">Benutzer</th>
                                            <th scope="col">Zugangsdatum</th>
                                            <th scope="col">Abgangsdatum</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    {% endblock %}
                </div>
            </div>
        {% endblock %}
    {% endblock %}
    {% block bodyjs %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockRotation.js') }}"></script>
    {% endblock %}
{% endblock %}
