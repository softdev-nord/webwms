{# templates/stock/stock_rotation.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_movements_overview %}
        <div id="webWMS-stock-movements-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_stock_movements_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="strTable" class="table table-striped table-bordered table-hover compact">
                                                <thead>
                                                <tr>
                                                    <th scope="col">{{ 'ui.stock.stock_rotation.lbw.id.363c83d'|trans }}</th>
                                                    <th scope="col">{{ 'ui.stock.stock_rotation.ba.id.28386b4'|trans }}</th>
                                                    <th scope="col">{{ 'ui.stock.stock_rotation.buchungsart.d7b20e4'|trans }}</th>
                                                    <th scope="col">{{ 'ui.stock.stock_rotation.referenz.1ac5c0e'|trans }}</th>
                                                    <th scope="col">{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</th>
                                                    <th scope="col">{{ 'ui.modal.put_into_storage.lagersystem.71f5620'|trans }}</th>
                                                    <th scope="col">{{ 'ui.article.article_input_fields.artikel.nr.b7761c6'|trans }}</th>
                                                    <th scope="col">{{ 'ui.article.index.bezeichnung.a0b60ec'|trans }}</th>
                                                    <th scope="col">{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</th>
                                                    <th scope="col">{{ 'nav.user.user'|trans }}</th>
                                                    <th scope="col">{{ 'ui.stock.stock_rotation.zugangsdatum.7bf3c41'|trans }}</th>
                                                    <th scope="col">{{ 'ui.stock.stock_rotation.abgangsdatum.8297c02'|trans }}</th>
                                                </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockRotation.js') }}"></script>
{% endblock %}
