{# templates/stock/stock_rotation.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_movements_overview %}
        <div id="webWMS-stock-movements-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_stock_movements_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="strTable" class="table table-striped table-bordered table-hover compact">
                                                <thead>
                                                <tr>
                                                    <th scope="col">{{ 'stock.stock_rotation.lbw_id'|trans }}</th>
                                                    <th scope="col">{{ 'stock.stock_rotation.ba_id'|trans }}</th>
                                                    <th scope="col">{{ 'stock.stock_rotation.posting_type'|trans }}</th>
                                                    <th scope="col">{{ 'stock.stock_rotation.reference'|trans }}</th>
                                                    <th scope="col">{{ 'modal.show_article_stock_details_modal.storage_bin'|trans }}</th>
                                                    <th scope="col">{{ 'modal.put_into_storage.warehouse_system'|trans }}</th>
                                                    <th scope="col">{{ 'article.article_input_fields.item_no'|trans }}</th>
                                                    <th scope="col">{{ 'article.index.description'|trans }}</th>
                                                    <th scope="col">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</th>
                                                    <th scope="col">{{ 'navigation.user.user'|trans }}</th>
                                                    <th scope="col">{{ 'stock.stock_rotation.arrival_date'|trans }}</th>
                                                    <th scope="col">{{ 'stock.stock_rotation.departure_date'|trans }}</th>
                                                </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockRotation.js') }}"></script>
{% endblock %}
