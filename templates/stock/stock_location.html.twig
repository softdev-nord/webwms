{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_submenu %}
        {{ include('submenu.html.twig') }}
    {% endblock %}

    {% block webwms_stock_locations_overview %}
        <div id="webWMS-stock-locations-overview" class="wrapper-form">
            <div class="wrapper-form-content">
                {% block webwms_stock_locations_overview_table %}
                    <div class="card">
                        <div class="card-content">
                            <table id="Table" class="table table-striped table-bordered table-hover compact">
                                <thead style="text-align: center;">
                                <tr>
                                    <th style="text-align: center" scope="col" >LPZ ID</th>
                                    <th style="text-align: center" scope="col">Lagernummer</th>
                                    <th style="text-align: center" scope="col">Fachboden</th>
                                    <th style="text-align: center" scope="col">Stellplatz</th>
                                    <th style="text-align: center" scope="col">Tiefe</th>
                                    <th style="text-align: center" scope="col">Koordinate</th>
                                    <th style="text-align: center" scope="col">Bezeichnung</th>
                                    <th style="text-align: center" scope="col">Breite (mm)</th>
                                    <th style="text-align: center" scope="col">Tiefe (mm)</th>
                                    <th style="text-align: center" scope="col">Höhe (mm)</th>
                                </thead>
                                <tbody id="myTable" style="text-align: center;">
                                <tr>
                                    {% for stockLocation in stockLocation %}
                                    <td>{{ stockLocation.id }}</td>
                                    <td>{{ stockLocation.stockLocationLn }}</td>
                                    <td>{{ stockLocation.stockLocationFb }}</td>
                                    <td>{{ stockLocation.stockLocationSp }}</td>
                                    <td>{{ stockLocation.stockLocationTf }}</td>
                                    <td>{{ stockLocation.stockLocationCoordinate }}</td>
                                    <td>{{ stockLocation.stockLocationDesc }}</td>
                                    <td>{{ stockLocation.stockLocationWidth }}</td>
                                    <td>{{ stockLocation.stockLocationDepth }}</td>
                                    <td>{{ stockLocation.stockLocationHeight }}</td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endblock %}
            </div>
        </div>
    {% endblock %}
{% endblock %}
