{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_submenu %}
        {{ include('submenu.html.twig') }}
    {% endblock %}

    {% block webwms_stock_occupancies_overview %}
        <div id="webWMS-stock-occupancies-overview" class="wrapper-form">
            <div class="wrapper-form-content">
                {% block webwms_stock_occupancies_overview_table %}
                    <div class="card">
                        <div class="card-content">
                            <span class="text-muted mb-3 lh-1 d-block text-truncate" style="float: left; padding-top: 8px;padding-right: 10px;">Lagerbereich auswählen</span>
                            <select id="selectStock" class="form-control col-md-1">
                                {% for oneStockSelected in stockSelect %}
                                    {% set selected = '' %}
                                    {% if (oneStockSelected.stock_location_ln) == stockSelect %}
                                        {% set selected = 'selected' %}
                                    {% endif %}
                                    <option value="{{oneStockSelected.stock_location_ln}}" {{ selected }}>{{oneStockSelected.stock_location_ln}}</option>
                                {% endfor %}
                            </select>
                            <div class="row" style="display: block; margin-top: 50px;">
                                <div class="col-md-12">
                                    <!-- card -->
                                    <div class="card card-h-100">
                                        <!-- card body -->
                                        <div class="card-body">
                                            <div class="header-item">
                                                <div class="row">
                                                    {% set startFb = 0 %}
                                                    {% set startSp = 0 %}
                                                    {% set startTf = 0 %}
                                                    {% set resultFb = 0 %}
                                                    {% set resultSp = 0 %}
                                                    {% set stockSystem = 'Block' %}

                                                    {% for fb, stock in stockResults %}
                                                        {% for sp, sog in stock %}
                                                            {% if stockSystem != sog.system %}
                                                                {% set stockSystem = sog.system %}

                                                                {% if stockSystem == 'Pal Regal' or stockSystem == 'Durchlaufregal' %}
                                                                    <table class="table table-striped table-bordered compact" style="width: auto; margin: auto">
                                                                        <thead class="table-header">
                                                                            <tr>
                                                                                <th style="text-align: center; width: 10%" scope="col">Fachboden</th>
                                                                                <th style="text-align: center" scope="col">Stellplatz</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody style="text-align: center;">
                                                                            <tr>
                                                                                {% for fb, stock in stockResults %}
                                                                                <td style="width: 10%; vertical-align: middle; font-size: 20px; font-weight: bold">
                                                                                    {% if startFb < fb %}
                                                                                    <div>
                                                                                        <span class="text-muted mb-3 lh-1 d-block text-truncate" style="text-align: center;">{{ fb }}</span>
                                                                                    </div>
                                                                                    {% endif %}
                                                                                </td>
                                                                                <td>
                                                                                    <div class="col-xxl-12" style="display: inline-flex">
                                                                                        {% for sp, sog in stock %}
                                                                                            {% if startSp < sog.sp %}
                                                                                                <div style="display: grid">
                                                                                                    <span class="text-muted mb-3 lh-1 d-block text-truncate" style="text-align: center;">{{ sog.sp }}</span>
                                                                                                    <a id="stockCoordinate" href="#showStockDetails" data-toggle="modal" data-target="{{ sog.koordinate }}" data-ln-komplett="{{ sog.lnKomplett }}">
                                                                                                    <span class="badge-occupancy badge-soft-success font-size-24 bg-soft-success {% if sog.belegt%}text-danger {% else %}text-success {% endif %}">
                                                                                                    <i class="mdi mdi-checkbox-blank"></i>
                                                                                                </span>
                                                                                                    </a>
                                                                                                </div>
                                                                                            {% endif %}
                                                                                        {% endfor %}
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                {% else %}
                                                                    <table class="table table-striped table-bordered compact" style="width: auto; margin: auto">
                                                                        <thead class="table-header">
                                                                        <tr>
                                                                            <th style="text-align: center; width: 10%" scope="col">Stellplatz</th>
                                                                            <th style="text-align: center" scope="col">Tiefe</th>
                                                                        </tr>
                                                                        </thead>
                                                                        <tbody style="text-align: center;">
                                                                        <tr>
                                                                            {% for sp, stock in stockResults %}
                                                                            <td style="width: 10%; vertical-align: middle; font-size: 20px; font-weight: bold">
                                                                                {% if startSp < sp %}
                                                                                    <div>
                                                                                        <span class="text-muted mb-3 lh-1 d-block text-truncate" style="text-align: center;">{{ sp }}</span>
                                                                                    </div>
                                                                                {% endif %}
                                                                            </td>
                                                                            <td>
                                                                                <div class="col-xxl-12" style="display: inline-flex">
                                                                                    {% for tf, sog in stock %}
                                                                                        {% if startTf < sog.tf %}
                                                                                            <div style="display: grid">
                                                                                                <span class="text-muted mb-3 lh-1 d-block text-truncate" style="text-align: center;">{{ sog.tf }}</span>
                                                                                                <a id="stockCoordinate" href="#showStockDetails" data-toggle="modal" data-target="{{ sog.koordinate }}" data-ln-komplett="{{ sog.lnKomplett }}">
                                                                                                    <span class="badge-occupancy badge-soft-success font-size-24 bg-soft-success {% if sog.belegt%}text-danger {% else %}text-success {% endif %}">
                                                                                                    <i class="mdi mdi-checkbox-blank"></i>
                                                                                                </span>
                                                                                                </a>
                                                                                            </div>
                                                                                        {% endif %}
                                                                                    {% endfor %}
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                        {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                {% endif %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div><!-- end card body -->
                                    </div><!-- end card -->
                                </div><!-- end col -->
                            </div><!-- end row-->
                        </div>
                    </div>
                {% endblock %}
            </div>
        </div>
    {% endblock %}

    {% block webwms_stock_occupancies_stock_detail %}
        {{ include('modal/show_stock_details_modal.html.twig', {'stockResults': stockResults}) }}
    {% endblock %}

    {% block javascripts %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockGraphicalOverview.js') }}"></script>
        <script>
            $(document).on('click','a#stockCoordinate',function(event) {
                const $el = $(event.currentTarget)
                console.log($el.attr('data-target'));

                var desc = 'Lagerplatz Details ';
                var stockComplete = $el.attr('data-ln-komplett');
                $(".modal-title").html(desc + stockComplete);
                $('#showStockDetails').modal('show');
            });
        </script>
    {% endblock %}

{% endblock %}
