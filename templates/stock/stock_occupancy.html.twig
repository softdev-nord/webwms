                                                    <th style="text-align: center" scope="col">{{ 'ui.stock.stock_occupancy.lagernr.2f2017a'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.stock.stock_occupancy.fb.42543a4'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.stock.stock_occupancy.sp.7707f68'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'ui.stock.stock_occupancy.tf.f136a6c'|trans }}</th>
