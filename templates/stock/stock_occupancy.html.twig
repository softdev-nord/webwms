{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_stock_occupancies_overview %}
        <div id="webWMS-stock-occupancies-overview" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
            <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                    <div class="webwms-page">{{ page }}</div>
                {% endif %}
                {% block webwms_stock_occupancies_overview_table %}
                    <div class="card">
                        <div class="card-content">
                            <table id="stoTable" class="table table-striped table-bordered table-hover compact">
                                <thead>
                                <tr>
                                    <th style="text-align: center" scope="col">Koordinate</th>
                                    <th style="text-align: center" scope="col">LagerNr</th>
                                    <th style="text-align: center" scope="col">FB</th>
                                    <th style="text-align: center" scope="col">SP</th>
                                    <th style="text-align: center" scope="col">TF</th>
                                    <th style="text-align: center" scope="col">Lagereinheit</th>
                                    <th style="text-align: center" scope="col">Artikel-Nr</th>
                                    <th style="text-align: center" scope="col">Bezeichnung</th>
                                    <th style="text-align: center" scope="col">Zugang</th>
                                    <th style="text-align: center" scope="col">Abgang</th>
                                    <th style="text-align: center" scope="col">LP Bestand</th>
                                    <th style="text-align: center" scope="col">Letzter Zugang</th>
                                    <th style="text-align: center" scope="col">Letzter Abgang</th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                {% endblock %}
            </div>
        </div>
    {% endblock %}
{% endblock %}
