{# templates/stock/stock_occupancy.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_occupancies_overview %}
        <div id="webWMS-stock-occupancies-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_stock_occupancies_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="stockOccupancyTable" class="table table-striped table-bordered table-hover compact">
                                                <thead>
                                                <tr>
                                                    <th style="text-align: center" scope="col">Koordinate</th>
                                                    <th style="text-align: center" scope="col">LagerNr</th>
                                                    <th style="text-align: center" scope="col">FB</th>
                                                    <th style="text-align: center" scope="col">SP</th>
