{# templates/stock/stock_occupancy.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_occupancies_overview %}
        <div id="webWMS-stock-occupancies-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_stock_occupancies_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="stockOccupancyTable" class="table table-striped table-bordered table-hover compact">
                                                <thead>
                                                <tr>
                                                    <th style="text-align: center" scope="col">{{ 'modal.show_stock_details_modal.coordinate'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_occupancy.warehouse_no'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_occupancy.fb'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_occupancy.sp'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_occupancy.tf'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'article.article_input_fields.item_no'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'article.index.description'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'article.index.stock'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'article.index.access'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'modal.show_article_stock_details_modal.outbound_movement'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'modal.show_article_stock_details_modal.last_inbound_movement'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'modal.show_article_stock_details_modal.last_outbound_movement'|trans }}</th>
                                                </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockOccupancy.js') }}"></script>
{% endblock %}
