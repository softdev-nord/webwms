{# templates/stock/stock_layout/stock_layout_input_fields.html.twig #}

{% block webwms_stock_layout_input_fields_form %}
    <div class="row">
        {% block webwms_stock_layout_input_fields_form_inner %}
            <div class="card">
                {{ form_start(stockLayoutForm) }}
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'modal.put_into_storage.warehouse_number'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockNr) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'modal.put_into_storage.shelf'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockDescription) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'modal.put_into_storage.shelf'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockLevel1) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'modal.put_into_storage.storage_location'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockLevel2) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'article.article_input_fields.depth'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockLevel3) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'stock.stock_layout.stock_layout_input_fields.x_coordinate'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockLevel4) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'stock.stock_layout.stock_layout_input_fields.warehouse_model'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockModel) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'stock.stock_layout.index.warehouse_type'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockTyp) }}
                    </div>
                </div>
                <div class="form-group">
                    <label for="text" class="control-label col-xs-4">{{ 'stock.stock_layout.index.long_description'|trans }}</label>
                    <div class="col-xs-8" style="margin-bottom: 5px;">
                        {{ form_row(stockLayoutForm.stockLongDescription) }}
                    </div>
                </div>

                <div class="text-center">
                    {{ form_widget(stockLayoutForm.save) }} {{ form_widget(stockLayoutForm.abort) }}
                </div>
                {{ form_end(stockLayoutForm) }}
            </div>
        {% endblock %}
    </div>
{% endblock %}
