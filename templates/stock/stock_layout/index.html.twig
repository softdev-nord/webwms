{# templates/stock/stock_layout/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_stock_layout_overview %}
        <div id="webWMS-stock-layout-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_stock_layout_overview_table %}
                                    <div class="card">
                                        <div class="card-content">
                                            <table id="stockLayoutTable" class="table table-striped table-bordered table-hover compact">
                                                <thead style="text-align: center;">
                                                <tr>
                                                    <th style="text-align: center" scope="col">{{ 'modal.put_into_storage.warehouse_number'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'article.index.description'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'modal.put_into_storage.shelf'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'modal.put_into_storage.storage_location'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'article.article_input_fields.depth'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_layout.index.warehouse_model'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_layout.index.warehouse_type'|trans }}</th>
                                                    <th style="text-align: center" scope="col">{{ 'stock.stock_layout.index.long_description'|trans }}</th>
                                                    <th scope="col" style="text-align: center">{{ 'article.index.last_modification'|trans }}</th>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.stockLayout.js') }}"></script>
{% endblock %}
