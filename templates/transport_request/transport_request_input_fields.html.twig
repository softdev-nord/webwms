{# templates/transport_request/transport_request_input_fields.html.twig #}

{% block webwms_transport_request_input_fields_form %}
    <div class="row">
        {% block webwms_transport_request_input_fields_form_inner %}
            <div class="card">
                {{ form_start(transportRequestForm) }}
{#                <div class="form-group">#}
{#                    <label for="text" class="control-label col-xs-4">TA-Nr</label>#}
{#                    <div class="col-xs-8" style="margin-bottom: 5px;">#}
{#                        {% if editTransportRequest %}#}
{#                            {{ form_row(transportRequestForm.trNr) }}#}
{#                        {% else %}#}
{#                            {{ form_row(transportRequestForm.trNr, {'value' : "#{lastId.trNr +1}"}) }}#}
{#                        {% endif %}#}
{#                    </div>#}
{#                </div>#}
                <div class="row" style="margin-bottom: 25px">
                    <div class="col-xl-6 col-md-6" style="padding: 10px">
                        <div class="card" style="height: 100%">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-xxl-12">
                                        <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.allgemeine.daten.af159f2'|trans }}</span>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.transport_request_input_fields.ta.nr.656f9bd'|trans }}</label>
                                            <div class="col-xs-8">
                                                {% if editTransportRequest %}
                                                    {{ form_row(transportRequestForm.trNr) }}
                                                {% else %}
                                                    {{ form_row(transportRequestForm.trNr, {'value' : "#{lastId.trNr +1}"}) }}
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.transport_request_input_fields.ta.position.8e4ec39'|trans }}</label>
                                            <div class="col-xs-8">
                                                {{ form_row(transportRequestForm.trPos) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.transport_request_input_fields.ta.prioritat.c2917de'|trans }}</label>
                                            <div class="col-xs-8">
                                                {{ form_row(transportRequestForm.trPrio) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.index.buchungsmethode.88b8700'|trans }}</label>
                                            <div class="col-xs-8">
                                                {{ form_row(transportRequestForm.bookingMethod) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.transport_request_input_fields.anlagedatum.64f06bb'|trans }}</label>
                                            <div class="col-xs-8">
                                                {{ form_row(transportRequestForm.createdAt) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.index.status.bae7d5b'|trans }}</label>
                                            <div class="col-xs-8">
                                                {{ form_row(transportRequestForm.trState) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.transport_request.index.ta.typ.7083d10'|trans }}</label>
                                            <div class="col-xs-8">
                                                {{ form_row(transportRequestForm.trType) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6 col-md-6" style="padding: 10px">
                        <div class="card" style="height: 100%">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-xxl-12">
                                        <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.transport_request.transport_request_input_fields.ta.position.details.e9eb465'|trans }}</span>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'nav.master_data.submenu.headline1'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
                                                {{ form_row(transportRequestForm.articleNr) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.customer_order.customer_order_input_fields.menge.ec3e620'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
                                                {{ form_row(transportRequestForm.trQuantity) }}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.modal.show_article_stock_details_modal.lagerplatz.467f59d'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
                                                {% set stockLocation = transportRequest.stockNr ~ '-' ~ transportRequest.stockLevel1 ~ '-' ~ transportRequest.stockLevel2 ~ '-' ~ transportRequest.stockLevel3 %}
                                                <input
                                                        type="text"
                                                        id="edit_transport_request_stockLocation"
                                                        name="edit_transport_request[stockLocation]"
                                                        class="form-control"
                                                        style="background-color: transparent"
                                                        readonly="readonly"
                                                        value="{{ stockLocation }}">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.modal.show_stock_details_modal.koordinate.208cdfa'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
                                                {{ form_row(transportRequestForm.stockCoordinate) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-6 col-md-6" style="padding: 10px">
                        <div class="card" style="height: 100%">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-xxl-12">
                                        <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'ui.article.article_input_fields.artikel.abmessungen.2af0460'|trans }}</span>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.tiefe.86a28ff'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
{#                                                {{ form_row(articleForm.articleDepth) }}#}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.breite.861387c'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
{#                                                {{ form_row(articleForm.articleWidth) }}#}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.hohe.f0c362a'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
{#                                                {{ form_row(articleForm.articleHeight) }}#}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6 col-md-6" style="padding: 10px">
                        <div class="card" style="height: 100%">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-xxl-12">
                                        <span class="mb-3 lh-1 text-truncate" style="font-weight: bold; font-size: 16px;">{{ 'nav.logistics.headline'|trans }}</span>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.auslagerungsstrategie.2db2a27'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
{#                                                {{ form_row(articleForm.stockOutStrategy) }}#}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.le.menge.80e62b5'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
{#                                                {{ form_row(articleForm.leQuantity) }}#}
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label for="text" class="control-label col-xs-4">{{ 'ui.article.article_input_fields.standard.ladehilfsmittel.2af26c3'|trans }}</label>
                                            <div class="col-xs-8" style="margin-bottom: 5px;">
{#                                                {{ form_row(articleForm.standardLoadingEquipment) }}#}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    {{ form_widget(transportRequestForm.save) }} {{ form_widget(transportRequestForm.abort) }}
                </div>

                {{ form_end(transportRequestForm) }}
        {% endblock %}

        {% block bodyjs %}
            <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.suppliersAutofill.js') }}"></script>
            <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.itemsSupplierOrderPosAutofill.js') }}"></script>
        {% endblock %}
    </div>
{% endblock %}