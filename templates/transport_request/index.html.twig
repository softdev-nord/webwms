{# templates/transport_request/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_transport_request_overview %}
        <div id="webWMS-transport-request-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_transport_request_overview_table %}
                                    <table id="transportRequestTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col">{{ 'modal.put_into_storage.storage_unit'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.task_no'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.task_item'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.priority'|trans }}</th>
                                            <th scope="col">{{ 'navigation.master_data.submenu.headline1.label'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.task_type'|trans }}</th>
                                            <th scope="col">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</th>
                                            <th scope="col">{{ 'modal.show_stock_details_modal.coordinate'|trans }}</th>
                                            <th scope="col">{{ 'modal.show_article_stock_details_modal.storage_bin'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.status'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.created_by'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.posting_method'|trans }}</th>
                                            <th scope="col">{{ 'stock.stock_rotation.reference'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.lhu'|trans }}</th>
                                            <th scope="col">{{ 'customer_order.customer_order_input_fields.processor'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.ip_address'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.blocked'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.start_processing'|trans }}</th>
                                            <th scope="col">{{ 'transport_request.index.task_processed'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.transportRequest.js') }}"></script>
{% endblock %}
