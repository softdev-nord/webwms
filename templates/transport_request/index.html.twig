{# templates/transport_request/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_transport_request_overview %}
        <div id="webWMS-transport-request-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_transport_request_overview_table %}
                                    <table id="transportRequestTable" class="table table-striped table-bordered table-hover compact">
                                        <thead>
                                        <tr>
                                            <th scope="col">{{ 'ui.modal.put_into_storage.lagereinheit'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.ta.nr'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.ta.pos'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.prio'|trans }}</th>
                                            <th scope="col">{{ 'nav.master_data.submenu.headline1'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.ta.typ'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer_order.customer_order_input_fields.menge'|trans }}</th>
                                            <th scope="col">{{ 'ui.modal.show_stock_details_modal.koordinate'|trans }}</th>
                                            <th scope="col">{{ 'ui.modal.show_article_stock_details_modal.lagerplatz'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.status'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.erstellt.von'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.buchungsmethode'|trans }}</th>
                                            <th scope="col">{{ 'ui.stock.stock_rotation.referenz'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.lhm'|trans }}</th>
                                            <th scope="col">{{ 'ui.customer_order.customer_order_input_fields.bearbeiter'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.ip.adresse'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.blockiert'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.start.bearbeitung'|trans }}</th>
                                            <th scope="col">{{ 'ui.transport_request.index.ta.bearbeitet'|trans }}</th>
                                        </tr>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.transportRequest.js') }}"></script>
{% endblock %}
