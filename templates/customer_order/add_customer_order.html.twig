{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_add_customer_order_form %}
            {{ form_start(customerForm) }}
                <div id="webWMS-add-new-customer-order" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                        {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                            <div class="webwms-page">{{ page }}</div>
                        {% endif %}
                        {% block webwms_add_order_form_order %}
                            <div class="card">
                                <div class="card-content">
                                    <div class="row col-md-6">
                                        <div class="form-row col-md-12">
                                            <div class="form-group col-md-8">
                                                <label for="inputKunde">Kunden suchen</label>
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_nr" name="inputKdNr" id="customer_nr_1" placeholder="Über Kunden-Nr suchen"></br></br>
                                            </div>
                                            <div class="form-group col-md-8">
                                                <label for="inputKunde">Kunde</label>
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_name" name="inputKdName" id="customer_name_1" placeholder="Über Kunden-Namen suchen">
                                                {{ form_row(customerForm.customer_id) }}
                                            </div>
                                            <div class="form-group col-md-8">
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_address_addition" name="inputKdAnsZu" id="customer_address_addition_1" placeholder="Anschrift Zusatz">
                                            </div>
                                            <div class="form-group col-md-6">
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_address_street" name="inputKdStr" id="customer_address_street_1" placeholder="Straße">
                                            </div>
                                            <div class="form-group col-md-2">
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_address_street_nr" name="inputKdHnr" id="customer_address_street_nr_1" placeholder="Haus-Nr">
                                            </div>
                                            <div class="form-group col-md-4"></div>
                                            <div class="form-group col-md-1">
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_country_code" name="inputKdLandKrz" id="customer_country_code_1" placeholder="Land">
                                            </div>
                                            <div class="form-group col-md-2">
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_zip_code" name="inputKdPlz" id="customer_zip_code_1" placeholder="PLZ">
                                            </div>
                                            <div class="form-group col-md-5">
                                                <input type="text" class="form-control autocomplete_customers" data-type="customer_city" name="inputKdOrt" id="customer_city_1" placeholder="Ort">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row col-md-6">
                                        <div class="form-row col-md-12">
                                            <div class="form-group col-md-6">
                                                {% set newOrderId = lastId.customerOrderId +1 %}
                                                {% set newOrderNr =  "VLS-01-#{newOrderId}" %}
                                                {{ form_row(customerForm.customer_order_nr, {'value' : newOrderNr }) }}
                                                {{ form_row(customerForm.customer_order_id, {'value' : newOrderId }) }}
                                                {{ form_row(customerForm.usr_id, {'value' : app.user.id }) }}
                                            </div>
                                            <div class="form-group col-md-6">
                                                {{ form_row(customerForm.customer_order_reference) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row col-md-6">
                                        <div class="form-row col-md-12">
                                            <div class="form-group col-md-4">
                                                {{ form_row(customerForm.customer_order_order_date) }}
                                            </div>
                                            <div class="form-group col-md-2"></div>
                                            <div class="form-group col-md-4">
                                                {{ form_row(customerForm.customer_order_date, {'value' : "now"|date("d.m.Y")}) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row col-md-6">
                                        <div class="form-row col-md-12">
                                            <div class="form-group col-md-4">
                                                <label for="inputBstDat">Bearbeiter</label>
                                                <input class="form-control" type="text" placeholder="{{ app.user.firstname }} {{ app.user.lastname }}" readonly="" style="background-color: transparent;">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-12"></div>
                                    {% block webwms_add_customer_order_form_customer_order_message %}
                                        <div class="form-group col-md-12">
                                            {% for message in app.flashes('success') %}
                                                <div class="alert alert-success">
                                                    {{ message }}
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endblock %}
                                    <div class="form-group col-md-12"></div>
                                    {% block webwms_add_customer_order_form_customer_order_pos %}
                                        <div class="col-md-12">
                                            {{ form_start(customerOrderPosForm) }}
                                                <div class="table-responsive">
                                                    <table id="autocomplete_table" class="table table-hover">
                                                        <thead class="thead-dark">
                                                        <tr>
                                                            <th width="1%" style="text-align:center;">#</th>
                                                            <th width="15%" scope="col">Artikel-Nr</th>
                                                            <th width="35%" style="text-align:center;">Artikel Bezeichnung</th>
                                                            <th width="10%" style="text-align:center;">Menge</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        <tr id="row_1">
                                                            <th id="delete_1" scope="row" class="delete_row"><span class="glyphicon glyphicon-minus-sign"></span></th>
                                                            <td>
                                                                <input id="art_nr_1" type="text" data-type="art_nr" name="inputArtNr[]" class="form-control autocomplete_items" autocomplete="off">
                                                                {{ form_row(customerOrderPosForm.article_id) }}
                                                            </td>
                                                            <td>
                                                                <input id="art_name_1" type="text" data-type="art_name" name="inputArtName[]" class="form-control autocomplete_items" autocomplete="off">
                                                            </td>
                                                            <td>
                                                                {{ form_row(customerOrderPosForm.customer_order_pos_quantity) }}
                                                            </td>
                                                        </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            {{ form_end(customerOrderPosForm) }}

                                            <div class="btn-container">
                                                <input id="addNewButton" class="btn btn-sm" value="Neue Position">
                                            </div>

                                        </div>
                                    {% endblock %}
                                </div>

                                <div class="row" style="margin-left: auto; margin-right: auto;">
                                {{ form_widget(customerForm.add_customer_order) }}
                                </div>
                            </div>
                        {% endblock %}
                    </div>
                </div>
            {{ form_end(customerForm) }}
        {% endblock %}
    {% endblock %}

    {% block bodyjs %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/customersAutofill.js') }}"></script>
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/itemsAftAutofill.js') }}"></script>
    {% endblock %}
{% endblock %}