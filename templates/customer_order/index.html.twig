{# templates/customer_order/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_customer_orders_overview %}
        <div id="webWMS-customer-orders-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_customer_order_overview_table_customer_orders %}
                                    <table id="customerOrderTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                        <thead>
                                        <tr>
                                            <th>{{ 'customer_order.index.order_no'|trans }}</th>
                                            <th>{{ 'customer.customer_input_fields.customer_no'|trans }}</th>
                                            <th>{{ 'customer.customer_input_fields.customer_name'|trans }}</th>
                                            <th>{{ 'customer_order.index.order_reference'|trans }}</th>
                                            <th>{{ 'customer_order.index.order_date'|trans }}</th>
                                            <th>{{ 'customer_order.index.purchase_date'|trans }}</th>
                                            <th>{{ 'navigation.user.user'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'article.index.last_modification'|trans }}</th>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>

                            <div class="card-body">
                                {% block webwms_customer_order_overview_table_customer_orders_pos %}
                                    <table id="posTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                        <thead>
                                        <tr>
                                            <th style="text-align: center" width="5%">{{ 'customer_order.index.order_no'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'article.article_input_fields.item_no'|trans }}</th>
                                            <th style="text-align: center" width="25%">{{ 'article.article_input_fields.item_name'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'customer_order.customer_order_input_fields.quantity'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'customer_order.index.delivered'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'customer_order.index.open'|trans }}</th>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block bodyjs %}
    <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.customerOrder.js') }}"></script>
{% endblock %}
