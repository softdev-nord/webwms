{# templates/customer_order/index.html.twig #}

{% extends 'base.html.twig' %}

{% block webwms_content %}
    {% block webwms_customer_orders_overview %}
        <div id="webWMS-customer-orders-overview" class="wrapper-form vertical-theme">
            <div class="wrapper-form-content vertical-theme">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                {% block webwms_customer_order_overview_table_customer_orders %}
                                    <table id="customerOrderTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                        <thead>
                                        <tr>
                                            <th>{{ 'ui.customer_order.index.auftrags.nr.9331aca'|trans }}</th>
                                            <th>{{ 'ui.customer.customer_input_fields.kunden.nr.a844539'|trans }}</th>
                                            <th>{{ 'ui.customer.customer_input_fields.kunden.name.28f9c90'|trans }}</th>
                                            <th>{{ 'ui.customer_order.index.auftrags.referenz.4df26a4'|trans }}</th>
                                            <th>{{ 'ui.customer_order.index.auftragsdatum.89d3b73'|trans }}</th>
                                            <th>{{ 'ui.customer_order.index.bestelldatum.4225bdd'|trans }}</th>
                                            <th>{{ 'nav.user.user'|trans }}</th>
                                            <th scope="col" style="text-align: center">{{ 'ui.article.index.letzte.anderung.1ab1b51'|trans }}</th>
                                        </thead>
                                    </table>
                                {% endblock %}
                            </div>

                            <div class="card-body">
                                {% block webwms_customer_order_overview_table_customer_orders_pos %}
                                    <table id="posTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                        <thead>
                                        <tr>
                                            <th style="text-align: center" width="5%">{{ 'ui.customer_order.index.auftrags.nr.9331aca'|trans }}</th>
                                            <th style="text-align: center" width="5%">{{ 'ui.article.article_input_fields.artikel.nr.b7761c6'|trans }}</th>
