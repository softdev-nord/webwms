{% extends 'base.html.twig' %}

{% block title %}{{ page }}{{ appName }}{% endblock %}

{% block body %}
    {% block webwms_header %}
        {{ include('header.html.twig') }}
    {% endblock %}

    {% block webwms_content %}
        {% block webwms_customer_orders_overview %}
            <div id="webWMS-customer-orders-overview" class="wrapper-form{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                <div class="wrapper-form-content{% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %} vertical-theme{% endif %}">
                    {% if (configuration.name == 'vertical_menu') and (configuration.value == 'true') %}
                        <div class="webwms-page">{{ page }}</div>
                    {% endif %}
                    <div class="card bg-dark">
                        <div class="card-content">
                            {% block webwms_customer_order_overview_table_customer_orders %}
                                <table id="aftTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                    <thead>
                                    <tr>
                                        <th>Auftrags-Nr</th>
                                        <th>Kunden-Nr</th>
                                        <th>Kunden-Name</th>
                                        <th>Auftrags Referenz</th>
                                        <th>Auftragsdatum</th>
                                        <th>Bestelldatum</th>
                                        <th>Benutzer</th>
                                        <th style="text-align: center"></th>
                                    </thead>
                                </table>
                            {% endblock %}
                        </div>
                    </div>
                    <br><br>
                    <div class="card">
                        <div class="card-content">
                            {% block webwms_customer_order_overview_table_customer_orders_pos %}
                                <table id="posTable" class="table table-striped table-bordered table-hover compact dataTable no-footer">
                                    <thead>
                                    <tr>
                                        <th style="text-align: center" width="5%">Auftrags-Nr</th>
                                        <th style="text-align: center" width="5%">Artikel-Nr</th>
                                        <th style="text-align: center" width="25%">Artikelname</th>
                                        <th style="text-align: center" width="5%">Menge</th>
                                        <th style="text-align: center" width="5%">Geliefert</th>
                                        <th style="text-align: center" width="5%">Offen</th>
                                    </thead>
                                </table>
                            {% endblock %}
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endblock %}
    {% block bodyjs %}
        <script type="text/javascript" src="{{ asset('assets/js/webWmsCoreJs/jquery.customerOrder.js') }}"></script>
    {% endblock %}
{% endblock %}