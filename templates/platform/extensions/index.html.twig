{% extends 'v3/base.html.twig' %}
{% block title %}{{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0{% endblock %}
{% block webwms_content %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">{{ 'extensions.index.advanced_functions'|trans }}</h1><p class="text-muted mb-0">{{ 'extensions.index.central_configurations_and_operational_processes'|trans }}</p></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">{{ 'extensions.index.configurations'|trans }}</h2><span class="badge bg-primary-subtle text-primary">{{ workspace.configurations|length }}</span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'administration.workspace.area'|trans }}</th><th>{{ 'administration.role_new.code'|trans }}</th><th>{{ 'common.template.correspondence.name'|trans }}</th><th>{{ 'transport_request.index.status'|trans }}</th><th class="text-end">{{ 'common.action'|trans }}</th></tr></thead><tbody>{% for item in workspace.configurations %}<tr><td>{{ workspace.resources[item.resource_type]|default(item.resource_type)|trans }}</td><td><code>{{ item.code }}</code></td><td>{{ item.name }}</td><td>{{ (item.active ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_configuration_edit',{resource:item.resource_type,id:item.id}) }}">{{ 'common.button.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'extensions.index.no_configurations_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-3 mb-4">{% for resource, label in workspace.resources %}<div class="col-md-6 col-xl-3"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_extension_configuration_new',{resource:resource}) }}"><div class="card-body"><strong>{{ label|trans }}</strong><div class="small text-muted mt-1">{{ 'extensions.index.create_configuration'|trans }}</div></div></a></div>{% endfor %}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'extensions.index.operational_processes'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>{{ 'extensions.configuration_index.modified'|trans }}</th><th>{{ 'extensions.index.workflow'|trans }}</th><th>{{ 'stock.stock_rotation.reference'|trans }}</th><th>{{ 'transport_request.index.status'|trans }}</th><th class="text-end">{{ 'common.action'|trans }}</th></tr></thead><tbody>{% for item in workspace.workItems %}<tr><td>{{ item.changed_at }}</td><td>{{ workspace.workflows[item.workflow_type]|default(item.workflow_type)|trans }}</td><td>{{ item.reference }}</td><td><span class="badge bg-secondary-subtle text-secondary">{{ item.status }}</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('v3_extension_work_item_show',{id:item.id}) }}">{{ 'common.button.edit'|trans }}</a></td></tr>{% else %}<tr><td colspan="5" class="text-center text-muted py-4">{{ 'extensions.index.no_processes_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
<div class="row g-3 mb-4">{% for workflow, label in workspace.workflows %}<div class="col-md-6 col-xl-3"><a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_extension_work_item_new',{workflow:workflow}) }}"><div class="card-body"><strong>{{ label|trans }}</strong><div class="small text-muted mt-1">{{ 'extensions.index.start_process'|trans }}</div></div></a></div>{% endfor %}</div>
<div class="card border-0 shadow-sm"><div class="card-header"><h2 class="h5 mb-0">{{ 'extensions.index.login_history'|trans }}</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>{{ 'administration.workspace.time_point_in_time'|trans }}</th><th>{{ 'extensions.index.identifier'|trans }}</th><th>{{ 'extensions.index.result'|trans }}</th><th>{{ 'logging.index.ip_address'|trans }}</th></tr></thead><tbody>{% for event in workspace.loginEvents %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.user_identifier }}</td><td>{{ (event.successful ? 'extensions.index.successful' : 'integration.automation.command_show.failed')|trans }}</td><td>{{ event.client_ip|default('–') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">{{ 'extensions.index.no_login_events_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
