{% extends 'v3/base.html.twig' %}

{% block title %}
    {{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0
{% endblock %}

{% block webwms_content %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ 'platform.index.platform_control_center'|trans }}
            </h1>
            <p class="text-muted mb-0">
                {{ 'platform.index.shop_floor_kpis_partners_automation_billing_search_media_and_print_routi'|trans }}
            </p>
        </div>
        <form class="d-flex" method="get">
            <input class="form-control" name="q" value="{{ query }}" placeholder="{{ 'platform.index.search_system_wide'|trans }}">
            <button class="btn btn-primary ms-2">
                {{ 'documentation.index.search'|trans }}
            </button>
        </form>
    </div>
    {% if query %}

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0">
                    {{ 'platform.index.search_results_for'|trans }}{{ query }}“
                </h2>
            </div>
            <div class="list-group list-group-flush">

                {% for result in searchResults %}

                    <div class="list-group-item">
                        <strong>
                            {{ result.title }}
                        </strong>
                        <span class="badge bg-secondary-subtle text-secondary ms-2">
                            {{ result.document_type }}
                        </span>
                        <div class="small text-muted text-truncate">
                            {{ result.body }}
                        </div>
                    </div>

                {% else %}

                    <div class="list-group-item text-muted">
                        {{ 'platform.index.no_results'|trans }}
                    </div>

                {% endfor %}

            </div>
        </div>

    {% endif %}
    <ul class="nav nav-tabs nav-tabs-custom mb-3" role="tablist">

        {% for id, label in {shopfloor: 'Shopfloor', kpi: 'KPI', portal: 'Partnerportal', events: 'Eventcenter', billing: 'Abrechnung', media: 'Medien & Druck'} %}

            <li class="nav-item">
                <button class="nav-link {{ loop.first ? 'active' : '' }}" data-bs-toggle="tab" data-bs-target="#platform-{{ id }}" type="button">
                    {{ label }}
                </button>
            </li>

        {% endfor %}

    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="platform-shopfloor">
            <div class="row g-3">
                <div class="col-xl-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header">
                            <h2 class="h5 mb-0">
                                {{ 'platform.index.schedule_task'|trans }}
                            </h2>
                        </div>
                        <div class="card-body">
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'task'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_task') }}">
                                <div class="col-4">
                                    <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <input class="form-control" name="title" placeholder="{{ 'platform.index.task'|trans }}" required>
                                </div>
                                <div class="col-6">
                                    <select class="form-select" name="task_type">
                                        <option value="putaway">
                                            {{ 'platform.index.inbound_storage'|trans }}
                                        </option>
                                        <option value="retrieval">
                                            {{ 'platform.index.outbound_storage'|trans }}
                                        </option>
                                        <option value="transport">
                                            {{ 'integration.wcs.command_new.transport'|trans }}
                                        </option>
                                        <option value="inventory">
                                            {{ 'navigation.inventory.headline'|trans }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-3">
                                    <input class="form-control" type="number" name="priority" value="50" min="1" max="999">
                                </div>
                                <div class="col-3">
                                    <input class="form-control" name="reference_type" placeholder="{{ 'integration.automation.command_new.reference_type'|trans }}">
                                </div>
                                <div class="col-6">
                                    <input class="form-control" name="reference_id" placeholder="{{ 'platform.index.reference_id'|trans }}">
                                </div>
                                <div class="col-6">
                                    <input class="form-control" type="datetime-local" name="planned_for">
                                </div>
                                <div class="col-12">
                                    <select class="form-select" name="assigned_to">
                                        <option value="">
                                            {{ 'platform.index.unassigned'|trans }}
                                        </option>

                                        {% for user in platform.users %}

                                            <option value="{{ user.id }}">
                                                {{ user.email }}
                                            </option>

                                        {% endfor %}

                                    </select>
                                </div>
                                <button class="btn btn-primary">
                                    {{ 'platform.index.schedule'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-8">
                    <div class="card border-0 shadow-sm">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>
                                            {{ 'inventory.configuration_form.priority'|trans }}
                                        </th>
                                        <th>
                                            {{ 'platform.index.task'|trans }}
                                        </th>
                                        <th>
                                            {{ 'administration.workspace.type'|trans }}
                                        </th>
                                        <th>
                                            {{ 'transport_request.index.status'|trans }}
                                        </th>
                                        <th>
                                            {{ 'common.action'|trans }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>

                                    {% for task in platform.tasks %}

                                        <tr>
                                            <td>
                                                {{ task.priority }}
                                            </td>
                                            <td>
                                                <strong>
                                                    {{ task.code }}
                                                </strong>
                                                <div class="small text-muted">
                                                    {{ task.title }}
                                                </div>
                                            </td>
                                            <td>
                                                {{ task.task_type }}
                                            </td>
                                            <td>
                                                {{ task.status }}
                                            </td>
                                            <td>

                                                {% set next = task.status == 'planned' ? 'released' : (task.status == 'released' ? 'in_progress' : (task.status == 'in_progress' ? 'completed' : null)) %}

                                                {% if next %}

                                                    <form method="post" action="{{ path('v3_platform_task_status', {taskId: task.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_task_' ~ task.id) }}">
                                                        <input type="hidden" name="status" value="{{ next }}">
                                                        <button class="btn btn-sm btn-outline-primary">
                                                            {{ next }}
                                                        </button>
                                                    </form>

                                                {% endif %}

                                            </td>
                                        </tr>

                                    {% else %}

                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                {{ 'platform.index.no_shopfloor_tasks'|trans }}
                                            </td>
                                        </tr>

                                    {% endfor %}

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="platform-kpi">
            <div class="row g-3 mb-3">

                {% for kpi in platform.kpis %}

                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted">
                                    {{ kpi.name }}
                                </div>
                                <div class="fs-3 fw-semibold">
                                    {{ kpi.value|default('–') }}
                                </div>
                                <small>
                                    {{ 'platform.index.destination'|trans }} {{ kpi.target_value|default('–') }}
                                </small>
                            </div>
                        </div>
                    </div>

                {% endfor %}

            </div>
            <div class="row g-3">
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.define_kpi'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'kpi'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_kpi') }}">
                                <input type="hidden" name="active" value="1">
                                <div class="col-4">
                                    <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <select class="form-select" name="metric">
                                        <option value="open_shopfloor_tasks">
                                            {{ 'platform.index.open_shopfloor_tasks'|trans }}
                                        </option>
                                        <option value="stock_quantity">
                                            {{ 'platform.index.stock_quantity'|trans }}
                                        </option>
                                        <option value="open_outbound_orders">
                                            {{ 'platform.index.open_outbound_orders'|trans }}
                                        </option>
                                        <option value="open_inbound_deliveries">
                                            {{ 'platform.index.open_inbound_items'|trans }}
                                        </option>
                                        <option value="queued_print_jobs">
                                            {{ 'platform.index.open_print_jobs'|trans }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <select class="form-select" name="aggregation">
                                        <option value="count">
                                            {{ 'platform.index.quantity'|trans }}
                                        </option>
                                        <option value="sum">
                                            {{ 'platform.index.total'|trans }}
                                        </option>
                                        <option value="average">
                                            {{ 'platform.index.average_value'|trans }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <input class="form-control" type="number" step="0.0001" name="target_value" placeholder="{{ 'platform.index.target_value'|trans }}">
                                </div>
                                <div class="col-6">
                                    <button class="btn btn-primary w-100">
                                        {{ 'common.button.save'|trans }}
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.create_dashboard'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'dashboard'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_dashboard') }}">
                                <div class="col-4">
                                    <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required>
                                </div>
                                <div class="col-12">
                                    <textarea class="form-control font-monospace" name="layout_json" required>
                                        {{ 'platform.index.columns_4_kpis'|trans }}
                                    </textarea>
                                </div>
                                <button class="btn btn-primary">
                                    {{ 'platform.index.save_dashboard'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="platform-portal">
            <div class="row g-3">
                <div class="col-xl-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.partner_access'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'partner_account'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_partner_account') }}">
                                <input type="hidden" name="active" value="1">
                                <div>
                                    <select class="form-select" name="business_partner_id" required>

                                        {% for partner in platform.partners %}

                                            <option value="{{ partner.id }}">
                                                {{ partner.code }} · {{ partner.name }}
                                            </option>

                                        {% endfor %}

                                    </select>
                                </div>
                                <div>
                                    <select class="form-select" name="user_id" required>

                                        {% for user in platform.users %}

                                            <option value="{{ user.id }}">
                                                {{ user.email }}
                                            </option>

                                        {% endfor %}

                                    </select>
                                </div>
                                <textarea class="form-control font-monospace" name="permissions">
                                    {{ 'platform.index.billing_read_media_read'|trans }}
                                </textarea>
                                <button class="btn btn-primary">
                                    {{ 'platform.index.create_access'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-7">
                    <div class="card border-0 shadow-sm">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>
                                            {{ 'inventory.control.partner'|trans }}
                                        </th>
                                        <th>
                                            {{ 'navigation.user.user'|trans }}
                                        </th>
                                        <th>
                                            {{ 'user.user_role.index.rights'|trans }}
                                        </th>
                                        <th>
                                            {{ 'transport_request.index.status'|trans }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>

                                    {% for account in platform.partnerAccounts %}

                                        <tr>
                                            <td>
                                                {{ account.partner_code }}
                                            </td>
                                            <td>
                                                {{ account.email }}
                                            </td>
                                            <td>
                                                <code>
                                                    {{ account.permissions }}
                                                </code>
                                            </td>
                                            <td>
                                                {{ (account.active ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}
                                            </td>
                                        </tr>

                                    {% else %}

                                        <tr>
                                            <td colspan="4" class="text-muted text-center py-4">
                                                {{ 'platform.index.no_partner_access_entries'|trans }}
                                            </td>
                                        </tr>

                                    {% endfor %}

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="platform-events">
            <div class="row g-3">
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.automation_rule'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'automation_rule'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_automation_rule') }}">
                                <input type="hidden" name="active" value="1">
                                <div class="col-4">
                                    <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required>
                                </div>
                                <div>
                                    <input class="form-control" name="event_name" placeholder="{{ 'platform.index.e_g_shipment_dispatched'|trans }}" required>
                                </div>
                                <div class="col-6">
                                    <textarea class="form-control font-monospace" name="conditions_json">
                                        {}
                                    </textarea>
                                </div>
                                <div class="col-6">
                                    <select class="form-select mb-2" name="action_type">
                                        <option value="print">
                                            {{ 'platform.index.print'|trans }}
                                        </option>
                                        <option value="notification">
                                            {{ 'logging.index.message'|trans }}
                                        </option>
                                        <option value="follow_up_task">
                                            {{ 'platform.index.follow_up_order'|trans }}
                                        </option>
                                    </select>
                                    <textarea class="form-control font-monospace" name="action_config">
                                        {}
                                    </textarea>
                                </div>
                                <button class="btn btn-primary">
                                    {{ 'outbound.control.activate_rule'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.test_event'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_event') }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_event') }}">
                                <input class="form-control" name="event_name" placeholder="{{ 'platform.index.event_name'|trans }}" required>
                                <textarea class="form-control font-monospace" name="payload">
                                    {}
                                </textarea>
                                <button class="btn btn-outline-primary">
                                    {{ 'platform.index.evaluate_rules'|trans }}
                                </button>
                            </form>
                            <hr>

                            {% for rule in platform.rules %}

                                <div>
                                    <strong>
                                        {{ rule.code }}
                                    </strong>
                                    · {{ rule.event_name }} → {{ rule.action_type }}
                                </div>

                            {% endfor %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="platform-billing">
            <div class="row g-3">
                <div class="col-xl-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.storage_rate'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'storage_fee_rule'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_storage_fee_rule') }}">
                                <input type="hidden" name="active" value="1">
                                <select class="form-select" name="business_partner_id">

                                    {% for partner in platform.partners %}

                                        <option value="{{ partner.id }}">
                                            {{ partner.code }}
                                        </option>

                                    {% endfor %}

                                </select>
                                <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                <input class="form-control" name="name" placeholder="{{ 'platform.index.rate_name'|trans }}" required>
                                <div class="col-6">
                                    <input class="form-control" type="number" step="0.0001" name="price_per_unit_day" placeholder="{{ 'platform.index.price_day'|trans }}" required>
                                </div>
                                <div class="col-3">
                                    <input class="form-control" type="number" name="free_days" value="0">
                                </div>
                                <div class="col-3">
                                    <input class="form-control" name="currency" value="EUR">
                                </div>
                                <button class="btn btn-primary">
                                    {{ 'platform.index.save_rate'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.additional_service'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'service'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_service') }}">
                                <input type="hidden" name="active" value="1">
                                <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                <input class="form-control" name="name" placeholder="{{ 'platform.index.service'|trans }}" required>
                                <div class="col-4">
                                    <input class="form-control" name="unit" placeholder="{{ 'article.index.unit'|trans }}" required>
                                </div>
                                <div class="col-4">
                                    <input class="form-control" type="number" step="0.0001" name="unit_price" placeholder="{{ 'platform.index.price'|trans }}" required>
                                </div>
                                <div class="col-4">
                                    <input class="form-control" name="currency" value="EUR">
                                </div>
                                <button class="btn btn-primary">
                                    {{ 'platform.index.save_service'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.billable_item'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_bill_storage') }}" class="row g-2 mb-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_bill_storage') }}">
                                <select class="form-select" name="rule_id">

                                    {% for rule in platform.storageFeeRules %}

                                        <option value="{{ rule.id }}">
                                            {{ rule.code }}
                                        </option>

                                    {% endfor %}

                                </select>
                                <div class="col-4">
                                    <input class="form-control" name="quantity" type="number" step="0.0001" placeholder="{{ 'customer_order.customer_order_input_fields.quantity'|trans }}">
                                </div>
                                <div class="col-4">
                                    <input class="form-control" name="days" type="number" placeholder="{{ 'platform.index.days'|trans }}">
                                </div>
                                <div class="col-4">
                                    <input class="form-control" name="reference" placeholder="{{ 'stock.stock_rotation.reference'|trans }}">
                                </div>
                                <button class="btn btn-outline-primary">
                                    {{ 'navigation.evaluations.submenu.headline4'|trans }}
                                </button>
                            </form>
                            <form method="post" action="{{ path('v3_platform_bill_service') }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_bill_service') }}">
                                <select class="form-select" name="service_id">

                                    {% for service in platform.services %}

                                        <option value="{{ service.id }}">
                                            {{ service.code }}
                                        </option>

                                    {% endfor %}

                                </select>
                                <select class="form-select" name="business_partner_id">

                                    {% for partner in platform.partners %}

                                        <option value="{{ partner.id }}">
                                            {{ partner.code }}
                                        </option>

                                    {% endfor %}

                                </select>
                                <div class="col-6">
                                    <input class="form-control" name="quantity" type="number" step="0.0001" placeholder="{{ 'customer_order.customer_order_input_fields.quantity'|trans }}">
                                </div>
                                <div class="col-6">
                                    <input class="form-control" name="reference" placeholder="{{ 'stock.stock_rotation.reference'|trans }}">
                                </div>
                                <button class="btn btn-outline-primary">
                                    {{ 'platform.index.record_vas'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm mt-3">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>
                                    {{ 'common.template.correspondence.created'|trans }}
                                </th>
                                <th>
                                    {{ 'inventory.control.partner'|trans }}
                                </th>
                                <th>
                                    {{ 'platform.index.service'|trans }}
                                </th>
                                <th>
                                    {{ 'customer_order.customer_order_input_fields.quantity'|trans }}
                                </th>
                                <th>
                                    {{ 'platform.index.amount'|trans }}
                                </th>
                            </tr>
                        </thead>
                        <tbody>

                            {% for line in platform.billableLines %}

                                <tr>
                                    <td>
                                        {{ line.service_date }}
                                    </td>
                                    <td>
                                        {{ line.partner_code }}
                                    </td>
                                    <td>
                                        {{ line.description }}
                                    </td>
                                    <td>
                                        {{ line.quantity }}
                                    </td>
                                    <td>
                                        {{ line.amount }} {{ line.currency }}
                                    </td>
                                </tr>

                            {% else %}

                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        {{ 'platform.index.no_billable_items'|trans }}
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="platform-media">
            <div class="row g-3">
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.assign_camera_file'|trans }}
                            </h2>
                            <form method="post" enctype="multipart/form-data" action="{{ path('v3_platform_media') }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_media') }}">
                                <div class="col-4">
                                    <input class="form-control" name="aggregate_type" placeholder="{{ 'administration.workspace.object_type'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <input class="form-control" name="aggregate_id" placeholder="{{ 'platform.index.object_id'|trans }}" required>
                                </div>
                                <input class="form-control" type="file" name="file" accept="image/jpeg,image/png,image/webp,application/pdf" capture="environment" required>
                                <button class="btn btn-primary">
                                    {{ 'platform.index.save_recording'|trans }}
                                </button>
                            </form>
                            <div class="mt-3">

                                {% for media in platform.media %}

                                    <a class="d-block" target="_blank" href="{{ path('v3_platform_media_show', {mediaId: media.id}) }}">
                                        {{ media.filename }} · {{ media.aggregate_type }}
                                    </a>

                                {% endfor %}

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">
                                {{ 'platform.index.print_routing'|trans }}
                            </h2>
                            <form method="post" action="{{ path('v3_platform_create', {resource: 'print_route'}) }}" class="row g-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('v3_platform_create_print_route') }}">
                                <input type="hidden" name="active" value="1">
                                <div class="col-4">
                                    <input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required>
                                </div>
                                <div class="col-8">
                                    <input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required>
                                </div>
                                <div class="col-6">
                                    <input class="form-control" name="document_type" placeholder="{{ 'integration.printing.job_new.document_type'|trans }}" required>
                                </div>
                                <div class="col-6">
                                    <select class="form-select" name="printer_id">

                                        {% for printer in platform.printers %}

                                            <option value="{{ printer.id }}">
                                                {{ printer.name }}
                                            </option>

                                        {% endfor %}

                                    </select>
                                </div>
                                <div class="col-4">
                                    <select class="form-select" name="site_id">
                                        <option value="">
                                            {{ 'platform.index.all_locations'|trans }}
                                        </option>

                                        {% for site in platform.sites %}

                                            <option value="{{ site.id }}">
                                                {{ site.code }}
                                            </option>

                                        {% endfor %}

                                    </select>
                                </div>
                                <div class="col-4">
                                    <input class="form-control" name="workstation" placeholder="{{ 'platform.index.workstation'|trans }}">
                                </div>
                                <div class="col-4">
                                    <input class="form-control" name="process_key" placeholder="{{ 'integration.device.index.process'|trans }}">
                                </div>
                                <div class="col-4">
                                    <input class="form-control" name="priority" type="number" value="100">
                                </div>
                                <div class="col-8">
                                    <button class="btn btn-primary w-100">
                                        {{ 'platform.index.save_routing_rule'|trans }}
                                    </button>
                                </div>
                            </form>
                            <hr>

                            {% for route in platform.printRoutes %}

                                <div>
                                    <strong>
                                        {{ route.code }}
                                    </strong>
                                    · {{ route.document_type }} → {{ route.printer_name }}
                                </div>

                            {% endfor %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
