{# templates/bundles/WebProfilerBundle/Profiler/toolbar.html.twig #}

<!-- START of Symfony Web Debug Toolbar own template -->
<div id="sfToolbarClearer-{{ token }}" class="sf-toolbar-clearer"></div>

<div id="sfToolbarMainContent-{{ token }}" class="sf-toolbarreset notranslate clear-fix" data-no-turbolink data-turbo="false">
        {% for name, template in templates %}
            {% if block('toolbar', template) is defined %}
                {% with {
                    collector: profile ? profile.getcollector(name) : null,
                    profiler_url: profiler_url,
                    token: token ?? (profile ? profile.token : null),
                    name: name,
                    profiler_markup_version: profiler_markup_version,
                    csp_script_nonce: csp_script_nonce,
                    csp_style_nonce: csp_style_nonce
                  } %}
                    {{ block('toolbar', template) }}
                {% endwith %}
            {% endif %}
        {% endfor %}
        {% if full_stack %}
            <div class="sf-full-stack sf-toolbar-block sf-toolbar-block-full-stack sf-toolbar-status-red sf-toolbar-block-right">
                <div class="sf-toolbar-icon">
                    <span class="sf-toolbar-value">{{ 'profiler.toolbar.using_symfony_symfony_is_not_supported'|trans }}</span>
                </div>
                <div class="sf-toolbar-info sf-toolbar-status-red">
                    <p>{{ 'profiler.toolbar.this_project_is_using_symfony_via_symfony_symfony_package'|trans }}</p>
                    <p>{{ 'profiler.toolbar.this_is_not_supported_anymore_since_symfony_4_0'|trans }}</p>
                    <p>{{ 'profiler.toolbar.even_if_it_seems_to_work_well_it_has_some_important_limitations_with_no_'|trans }}</p>
                    <p>{{ 'profiler.toolbar.using_this_package_also_makes_your_project_slower'|trans }}</p>

                    <strong>{{ 'profiler.toolbar.please_stop_using_this_package_and_replace_it_with_individual_packages_i'|trans }}</strong>
                </div>
                <div></div>
            </div>
        {% endif %}

        <div class="sf-toolbar-block-dump sf-toolbar-status-red sf-toolbar-block-right" style="padding: 8px;">
            <div class="sf-toolbar-icon">
                <span class="sf-toolbar-label" style="font-size: 14px; font-weight: bold">{{ 'profiler.toolbar.environment'|trans }}  </span>
                <span class="sf-toolbar-value sf-toolbar-info-piece-additional"
                      style="font-size: 14px; font-weight: bold; padding-left: 5px; color: {% if app.environment == 'dev' %}red{% else %}orange{% endif %}"
                > {% if app.environment == 'dev' %}{{ 'profiler.toolbar.development'|trans }}{% else %}{{ 'profiler.toolbar.staging'|trans }}{% endif %}</span>
            </div>
        </div>

        <div class="sf-toolbar-block-dump sf-toolbar-logo">
            <span class="text-first-small">{{ 'base.web'|trans }}</span><span class="text-last-small">{{ 'base.wms'|trans }}</span>
        </div>

    <button class="sf-toolbar-toggle-button" type="button" id="sfToolbarToggleButton-{{ token }}" accesskey="D" aria-expanded="true" aria-controls="sfToolbarMainContent-{{ token }}" aria-label="{{ 'profiler.toolbar.toggle_symfony_toolbar'|trans }}">
        <i class="sf-toolbar-icon-opened" title="{{ 'profiler.toolbar.close_toolbar'|trans }}">{{ source('@WebProfiler/Icon/close.svg') }}</i>
        <i class="sf-toolbar-icon-closed" title="{{ 'profiler.toolbar.open_toolbar'|trans }}">{{ source('@WebProfiler/Icon/symfony.svg') }}</i>
    </button>
</div>
<!-- END of Symfony Web Debug Toolbar own template -->
