{# templates/submenu.html.twig #}

{% block submenu %}

<!-- Beginn Sub-Navigation -->
<div class="subMenu-webLVS fixed-top">
    <div class="iconMenu-webLVS-page">{{ page }}</div>
    <div class="subMenu-webLVS-wrapper" id="subMenu-webLVS-wrapper">
        <a href="{{ path('app_logout') }}" data-toggle="tooltip" data-placement="top" id="abmelden" title="Abmelden">
            <div style="display: inline-block"><span class="iconMenu-webLVS mdi mdi-power-standby"></span></div>
        </a>
        <a href="{{ path('homepage') }}" data-toggle="tooltip" data-placement="top" id="startseite" title="Startseite">
            <div style="display: inline-block"><i class="iconMenu-webLVS mdi mdi-warehouse"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="lieferanten" title="Lieferanten">
            <div style="display: inline-block;"><i class="iconMenu-webLVS mdi mdi-account-search"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="lieferanten_anlegen" title="Lieferanten anlegen">
            <div style="display: inline-block;"><i class="iconMenu-webLVS mdi mdi-account-plus"></i></div>
        </a>
        <a href="{{ path('customer') }}" data-toggle="tooltip" data-placement="top" id="kunden" title="Kunden">
            <div style="display: inline-block;"><i class="iconMenu-webLVS mdi mdi-account-search-outline"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="kunden_anlegen" title="Kunden anlegen">
            <div style="display: inline-block;"><i class="iconMenu-webLVS mdi mdi-account-plus-outline"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="bestellungen" title="Bestellungen">
            <div style="display: inline-block;"><i class="iconMenu-webLVS mdi mdi-file-search"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="bestellung_anlegen" title="Bestellung anlegen">
            <div style="display: inline-block;"><i class="iconMenu-webLVS mdi mdi-file-document-edit"></i></div>
        </a>
        <a href="{{ path('customer_orders') }}" data-toggle="tooltip" data-placement="top" id="auftraege" title="Aufträge">
            <div style="display: inline-block"><i class="iconMenu-webLVS mdi mdi-file-search-outline"></i></div>
        </a>
        <a href="{{ path('customer_orders') }}" data-toggle="tooltip" data-placement="top" id="auftrag_anlegen" title="Auftrag anlegen">
            <div style="display: inline-block"><i class="iconMenu-webLVS mdi mdi-file-document-edit-outline"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="transporteingang" title="Transporteingang">
            <div style="display: inline-block"><i class="iconMenu-webLVS mdi mdi-forklift mdi-flip-h"></i></div>
        </a>
        <a href="{{ path('orders') }}" data-toggle="tooltip" data-placement="top" id="transportausgang" title="Transportausgang">
            <div style="display: inline-block"><i class="iconMenu-webLVS mdi mdi-forklift"></i></div>
        </a>
    </div>
    <div class="iconMenu-webLVS-version">webLVS {{ appVersionNumber }} {{ appVersion }}</div>
</div>
<!-- Ende Sub-Navigation -->
{% endblock submenu %}