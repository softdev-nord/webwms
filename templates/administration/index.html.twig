{% extends 'v3/base.html.twig' %}

{% block title %}
    {{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0
{% endblock %}

{% block webwms_content %}
    <div class="mb-4">
        <h1 class="h3 mb-1">
            {{ 'administration.index.administration'|trans }}
        </h1>
        <p class="text-muted mb-0">
            {{ 'administration.index.select_administration_area'|trans }}
        </p>
    </div>
    <div class="row g-4">

        {% if is_granted('administration.user.read') %}

            <div class="col-md-4">
                <a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_administration_users') }}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h2 class="h5 text-body">
                                    {{ 'navigation.user.user'|trans }}
                                </h2>
                                <p class="text-muted mb-0">
                                    {{ 'administration.index.manage_accounts_roles_and_status'|trans }}
                                </p>
                            </div>
                            <span class="avatar-sm rounded bg-primary-subtle text-primary d-flex align-items-center justify-content-center">
                                <i class="ri-user-line fs-4">
                                </i>
                            </span>
                        </div>
                        <div class="fs-3 fw-semibold text-body mt-3">
                            {{ users|length }}
                        </div>
                    </div>
                </a>
            </div>

        {% endif %}

        {% if is_granted('administration.role.read') %}

            <div class="col-md-4">
                <a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_administration_roles') }}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h2 class="h5 text-body">
                                    {{ 'user.index.roles'|trans }}
                                </h2>
                                <p class="text-muted mb-0">
                                    {{ 'administration.index.manage_permissions_separately'|trans }}
                                </p>
                            </div>
                            <span class="avatar-sm rounded bg-success-subtle text-success d-flex align-items-center justify-content-center">
                                <i class="ri-shield-user-line fs-4">
                                </i>
                            </span>
                        </div>
                        <div class="fs-3 fw-semibold text-body mt-3">
                            {{ roles|length }}
                        </div>
                    </div>
                </a>
            </div>

        {% endif %}

        {% if is_granted('administration.api_client.read') %}

            <div class="col-md-4">
                <a class="card border-0 shadow-sm h-100 text-decoration-none" href="{{ path('v3_administration_api_clients') }}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h2 class="h5 text-body">
                                    {{ 'administration.api_clients.api_clients'|trans }}
                                </h2>
                                <p class="text-muted mb-0">
                                    {{ 'administration.index.manage_technical_access'|trans }}
                                </p>
                            </div>
                            <span class="avatar-sm rounded bg-info-subtle text-info d-flex align-items-center justify-content-center">
                                <i class="ri-key-2-line fs-4">
                                </i>
                            </span>
                        </div>
                        <div class="fs-3 fw-semibold text-body mt-3">
                            {{ apiClients|length }}
                        </div>
                    </div>
                </a>
            </div>

        {% endif %}

    </div>
{% endblock %}
