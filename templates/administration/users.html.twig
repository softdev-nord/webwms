{% extends 'v3/base.html.twig' %}

{% block title %}
    {{ (page|default('layout.title_meta.webwms'))|trans(pageParameters|default({})) }} | WebWMS 3.0
{% endblock %}

{% block webwms_content %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">
                {{ 'navigation.user.user'|trans }}
            </h1>
            <p class="text-muted mb-0">
                {{ 'administration.users.user_account_overview'|trans }}
            </p>
        </div>

        {% if is_granted('administration.user.write') %}

            <a class="btn btn-primary" href="{{ path('v3_administration_user_new') }}">
                <i class="ri-add-line me-1">
                </i>
                {{ 'navigation.user.add'|trans }}
            </a>

        {% endif %}

    </div>
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>
                            {{ 'common.template.correspondence.name'|trans }}
                        </th>
                        <th>
                            {{ 'theme.email'|trans }}
                        </th>
                        <th>
                            {{ 'user.index.roles'|trans }}
                        </th>
                        <th>
                            {{ 'transport_request.index.status'|trans }}
                        </th>
                        <th class="text-end" data-orderable="false" data-searchable="false">
                            {{ 'administration.api_clients.actions'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody>

                    {% for user in users %}

                        <tr>
                            <td>
                                {{ user.display_name }}
                            </td>
                            <td>
                                {{ user.email }}
                            </td>
                            <td>
                                {{ user.role_codes ?: '–' }}
                            </td>
                            <td>
                                <span class="badge bg-{{ user.status == 'active' ? 'success' : 'secondary' }}-subtle text-{{ user.status == 'active' ? 'success' : 'secondary' }}">
                                    {{ user.status }}
                                </span>
                            </td>
                            <td class="text-end">

                                {% if is_granted('administration.user.write') %}

                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('v3_administration_user_edit', {userId: user.id}) }}">
                                        <i class="ri-pencil-line me-1">
                                        </i>
                                        {{ 'common.button.edit'|trans }}
                                    </a>

                                {% endif %}

                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                {{ 'administration.users.no_users_available'|trans }}
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>
            </table>
        </div>
    </div>

{% endblock %}
