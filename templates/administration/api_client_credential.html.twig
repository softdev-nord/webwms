{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-warning">
                <h1 class="h4">
                    {{ 'administration.api_client_credential.secure_api_access_now'|trans }}
                </h1>
                <p>
                    {{ 'administration.api_client_credential.this_secret_is_displayed_only_once_and_cannot_be_recovered'|trans }}
                </p>

                <div class="input-group">
                    <input class="form-control font-monospace" id="api-credential" value="{{ credential }}" readonly>
                    <button
                    class="btn btn-dark"
                    type="button"
                    onclick="navigator.clipboard.writeText(document.getElementById('api-credential').value)"
                    >
                    {{ 'copy.text'|trans }}
                    </button>
                </div>
            </div>

            <a class="btn btn-primary" href="{{ path('v3_administration_index') }}">
                {{ 'administration.api_client_credential.go_to_administration'|trans }}
            </a>
        </div>
    </div>
{% endblock %}
