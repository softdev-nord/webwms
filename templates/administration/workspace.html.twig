{% extends 'v3/base.html.twig' %}

{% block webwms_content %}
	<div class="mb-4"><h1 class="h3 mb-1">{{ 'administration.workspace.client_and_amp_configuration'|trans }}</h1><p class="text-muted mb-0">{{ 'administration.workspace.centrally_manage_business_partners_data_rooms_sso_number_ranges_processe'|trans }}</p></div>

	<div class="row g-4">
		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.business_partner_and_amp_data_rooms'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}
				<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'partner'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_partner') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required></div><div class="col-md-4"><input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="partner_type"><option value="customer">{{ 'administration.workspace.customer'|trans }}</option><option value="supplier">{{ 'administration.workspace.supplier'|trans }}</option><option value="carrier">{{ 'administration.workspace.carrier'|trans }}</option><option value="owner">{{ 'administration.workspace.inventory_owner'|trans }}</option></select></div><input type="hidden" name="active" value="1"><div class="col-md-2"><button class="btn btn-primary w-100">{{ 'administration.workspace.create'|trans }}</button></div></form>
			{% endif %}
			<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>{{ 'administration.role_new.code'|trans }}</th><th>{{ 'common.template.correspondence.name'|trans }}</th><th>{{ 'administration.workspace.type'|trans }}</th><th>{{ 'transport_request.index.status'|trans }}</th></tr></thead><tbody>{% for partner in workspace.partners %}<tr><td class="fw-semibold">{{ partner.code }}</td><td>{{ partner.name }}</td><td>{{ partner.partner_type }}</td><td>{{ (partner.active ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">{{ 'administration.workspace.no_business_partners_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div>
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'context'}) }}" class="row g-2 mt-3"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_context') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'administration.workspace.data_room_code'|trans }}" required></div><div class="col-md-4"><input class="form-control" name="name" placeholder="{{ 'article.index.description'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="business_partner_id"><option value="">{{ 'administration.workspace.without_partner'|trans }}</option>{% for partner in workspace.partners %}<option value="{{ partner.id }}">{{ partner.code }}</option>{% endfor %}</select></div><input type="hidden" name="active" value="1"><div class="col-md-2"><button class="btn btn-outline-primary w-100">{{ 'administration.workspace.create'|trans }}</button></div></form>{% endif %}
			<div class="mt-3">{% for context in workspace.contexts %}<span class="badge bg-primary-subtle text-primary me-1">{{ context.code }} · {{ context.partner_code ?: ('administration.workspace.client'|trans) }}</span>{% endfor %}</div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.locations_and_amp_warehouse'|trans }}</h2></div><div class="card-body"><p class="text-muted">{{ 'administration.workspace.operational_topology_is_maintained_in_warehouse_area_organizational_assi'|trans }}</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>{{ 'administration.workspace.location'|trans }}</th><th>{{ 'navigation.master_data.submenu.headline4.label'|trans }}</th><th>{{ 'common.template.correspondence.name'|trans }}</th></tr></thead><tbody>{% for warehouse in workspace.warehouses %}<tr><td>{{ warehouse.site_code }}</td><td class="fw-semibold">{{ warehouse.code }}</td><td>{{ warehouse.name }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted">{{ 'administration.workspace.no_warehouses_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div><a class="btn btn-outline-primary" href="{{ path('v3_inventory_topology') }}">{{ 'administration.workspace.open_warehouse_topology'|trans }}</a></div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.single_sign_on'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'identity_provider'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_identity_provider') }}"><div class="col-md-4"><input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required></div><div class="col-md-8"><input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required></div><div class="col-md-3"><select class="form-select" name="protocol"><option value="oidc">{{ 'administration.workspace.openid_connect'|trans }}</option></select></div><div class="col-md-9"><input class="form-control" type="url" name="issuer_url" placeholder="{{ 'administration.workspace.issuer_metadata_url'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="client_id" placeholder="{{ 'administration.api_clients.client_id'|trans }}" required></div><div class="col-md-6"><input class="form-control" name="client_secret_env" placeholder="{{ 'administration.workspace.environment_variable_for_secret'|trans }}" required></div><div class="col-md-9"><input class="form-control" name="scopes" value="openid profile email" required></div><input type="hidden" name="enabled" value="1"><div class="col-md-3"><button class="btn btn-primary w-100">{{ 'administration.workspace.create_idp'|trans }}</button></div></form>{% endif %}
			<div class="mt-3">{% for provider in workspace.identityProviders %}<div class="d-flex justify-content-between border-top py-2"><span><strong>{{ provider.name }}</strong><small class="text-muted d-block">{{ provider.protocol|upper }} · {{ provider.issuer_url }}</small></span><span class="badge bg-{{ provider.enabled ? 'success' : 'secondary' }}-subtle text-{{ provider.enabled ? 'success' : 'secondary' }} align-self-center">{{ (provider.enabled ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}</span></div>{% else %}<span class="text-muted">{{ 'administration.workspace.no_identity_provider_configured_yet'|trans }}</span>{% endfor %}</div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.number_ranges'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'number_range'}) }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_number_range') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="{{ 'common.template.correspondence.name'|trans }}" required></div><div class="col-md-4"><input class="form-control" name="object_type" placeholder="{{ 'administration.workspace.object_type'|trans }}" required></div><div class="col-md-3"><input class="form-control" name="prefix" placeholder="{{ 'administration.workspace.prefix'|trans }}"></div><div class="col-md-2"><input class="form-control" type="number" name="padding" value="8" min="1" max="18" required></div><div class="col-md-3"><input class="form-control" type="number" name="next_value" value="1" min="1" required></div><div class="col-md-4"><input class="form-control" name="gs1_company_prefix" placeholder="{{ 'administration.workspace.gs1_company_prefix'|trans }}"></div><input type="hidden" name="suffix" value=""><input type="hidden" name="maximum_value" value=""><input type="hidden" name="enabled" value="1"><div class="col-12"><button class="btn btn-primary">{{ 'administration.workspace.create_number_range'|trans }}</button></div></form>{% endif %}
			<div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>{{ 'administration.role_new.code'|trans }}</th><th>{{ 'administration.workspace.object'|trans }}</th><th>{{ 'administration.workspace.next_value'|trans }}</th><th></th></tr></thead><tbody>{% for range in workspace.numberRanges %}<tr><td>{{ range.code }}</td><td>{{ range.object_type }}</td><td>{{ range.prefix }}{{ range.next_value }}{{ range.suffix }} <small class="text-muted">({{ range.padding }} {{ 'administration.workspace.positions'|trans }}</small></td><td class="text-end">{% if is_granted('administration.number_range.use') %}<form method="post" action="{{ path('v3_administration_number_range_next', {code: range.code}) }}"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_number_range_next_' ~ range.code) }}"><button class="btn btn-sm btn-outline-primary">{{ 'administration.workspace.test_number'|trans }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">{{ 'administration.workspace.no_number_ranges_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div>
		</div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.activatable_processes'|trans }}</h2></div><div class="card-body">{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_process_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_process_configure') }}"><div class="col-md-4"><input class="form-control" name="process_key" placeholder="{{ 'administration.workspace.e_g_inbound_quality'|trans }}" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="{{ 'article.index.description'|trans }}" required></div><div class="col-md-3"><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" name="enabled" value="1" checked><label class="form-check-label">{{ 'user.user_input_fields.active'|trans }}</label></div></div><div class="col-12"><textarea class="form-control font-monospace" name="configuration" rows="2">{}</textarea></div><div class="col-12"><button class="btn btn-primary">{{ 'administration.workspace.save_process'|trans }}</button></div></form>{% endif %}<div class="mt-3">{% for process in workspace.processes %}<div class="d-flex justify-content-between border-top py-2"><span><strong>{{ process.name }}</strong><small class="d-block text-muted">{{ process.process_key }}</small></span><span class="badge bg-{{ process.enabled ? 'success' : 'secondary' }}-subtle text-{{ process.enabled ? 'success' : 'secondary' }} align-self-center">{{ (process.enabled ? 'user.user_input_fields.active' : 'inventory.selection_rules.inactive')|trans }}</span></div>{% else %}<span class="text-muted">{{ 'administration.workspace.no_process_switches_yet'|trans }}</span>{% endfor %}</div></div></div></div>

		<div class="col-xl-6"><div class="card border-0 shadow-sm h-100"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.web_scanner_and_amp_operating_profile'|trans }}</h2></div><div class="card-body">
			{% if is_granted('administration.configuration.write') %}<form method="post" action="{{ path('v3_administration_workspace_create', {resource: 'device_profile'}) }}" class="row g-2 mb-4"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_workspace_create_device_profile') }}"><div class="col-md-3"><input class="form-control" name="code" placeholder="{{ 'administration.role_new.code'|trans }}" required></div><div class="col-md-5"><input class="form-control" name="name" placeholder="{{ 'administration.workspace.profile_name'|trans }}" required></div><div class="col-md-4"><select class="form-select" name="device_type"><option value="desktop">{{ 'administration.workspace.desktop'|trans }}</option><option value="tablet">{{ 'administration.workspace.tablet'|trans }}</option><option value="scanner">{{ 'administration.workspace.scanner_mde'|trans }}</option></select></div><div class="col-md-7"><input class="form-control" name="start_route" value="/v3" required></div><div class="col-md-3"><input class="form-control" name="scan_suffix" value="Enter" placeholder="{{ 'administration.workspace.scan_suffix'|trans }}"></div><input type="hidden" name="fullscreen" value="1"><input type="hidden" name="enabled" value="1"><div class="col-md-2"><button class="btn btn-outline-primary w-100">{{ 'administration.workspace.create'|trans }}</button></div></form>
			<div class="mb-3">{% for profile in workspace.deviceProfiles %}<span class="badge bg-info-subtle text-info me-1">{{ profile.code }} · {{ profile.device_type }}</span>{% endfor %}</div>{% set deployment = workspace.deployments|first %}<form method="post" action="{{ path('v3_administration_deployment_configure') }}" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('v3_administration_deployment_configure') }}"><div class="col-md-4"><select class="form-select" name="deployment_mode"><option value="saas" {{ deployment and deployment.deployment_mode == 'saas' ? 'selected' : '' }}>{{ 'administration.workspace.saas'|trans }}</option><option value="on_premises" {{ deployment and deployment.deployment_mode == 'on_premises' ? 'selected' : '' }}>{{ 'administration.workspace.on_premises'|trans }}</option><option value="hybrid" {{ deployment and deployment.deployment_mode == 'hybrid' ? 'selected' : '' }}>{{ 'administration.workspace.hybrid'|trans }}</option></select></div><div class="col-md-8"><input class="form-control" type="url" name="public_url" value="{{ deployment.public_url|default(app.request.schemeAndHttpHost) }}" required></div><div class="col-md-4"><select class="form-select" name="storage_driver"><option value="local" {{ deployment and deployment.storage_driver == 'local' ? 'selected' : '' }}>{{ 'administration.workspace.local_storage'|trans }}</option><option value="s3" {{ deployment and deployment.storage_driver == 's3' ? 'selected' : '' }}>{{ 'administration.workspace.s3'|trans }}</option><option value="azure" {{ deployment and deployment.storage_driver == 'azure' ? 'selected' : '' }}>{{ 'administration.workspace.azure_blob'|trans }}</option></select></div><div class="col-md-4"><select class="form-select" name="queue_transport"><option value="sync" {{ deployment and deployment.queue_transport == 'sync' ? 'selected' : '' }}>{{ 'administration.workspace.synchronous'|trans }}</option><option value="doctrine" {{ deployment and deployment.queue_transport == 'doctrine' ? 'selected' : '' }}>{{ 'administration.workspace.doctrine'|trans }}</option><option value="rabbitmq" {{ deployment and deployment.queue_transport == 'rabbitmq' ? 'selected' : '' }}>{{ 'administration.workspace.rabbitmq'|trans }}</option></select></div><div class="col-md-4"><select class="form-select" name="release_channel"><option value="stable" {{ deployment and deployment.release_channel == 'stable' ? 'selected' : '' }}>{{ 'administration.workspace.stable'|trans }}</option><option value="preview" {{ deployment and deployment.release_channel == 'preview' ? 'selected' : '' }}>{{ 'administration.workspace.preview'|trans }}</option></select></div><div class="col-12"><button class="btn btn-primary">{{ 'administration.workspace.save_operation_profile'|trans }}</button></div></form>{% endif %}
		</div></div></div>
	</div>

	<div class="card border-0 shadow-sm mt-4"><div class="card-header"><h2 class="h5 mb-0">{{ 'administration.workspace.change_log'|trans }}</h2></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>{{ 'administration.workspace.time_point_in_time'|trans }}</th><th>{{ 'administration.workspace.area'|trans }}</th><th>{{ 'administration.workspace.event'|trans }}</th><th>{{ 'navigation.user.user'|trans }}</th></tr></thead><tbody>{% for event in workspace.events %}<tr><td>{{ event.occurred_at }}</td><td>{{ event.aggregate_type }}</td><td>{{ event.event_type }}</td><td>{{ event.performed_by_email }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-3">{{ 'administration.workspace.no_changes_logged_yet'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
