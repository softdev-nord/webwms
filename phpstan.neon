includes:
    - phpstan-baseline.neon
    - ./vendor/phpstan/phpstan-symfony/extension.neon

parameters:

    #  max or choose from 10 levels (0 is the loosest, 9 is the strictest).
    level: 0

#    symfony:
#        container_xml_path: var/cache/dev/WebWMS_KernelDevDebugContainer.xml

    paths:
        - src

    reportUnmatchedIgnoredErrors: false