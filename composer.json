{
    "name": "webwms/webwms-core",
    "version": "2.1.4",
    "description": "webWMS Das webbasierte Lagerverwaltungssystem",
    "keywords": ["webWMS", "wms"],
    "homepage": "https://softdev-nord.de",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-zend-opcache": "*",
        "api-platform/doctrine-orm": "^4.0",
        "api-platform/graphql": "^4.0",
        "api-platform/symfony": "^4.0",
        "composer/composer": "^2.6",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/annotations": "^2.0",
        "doctrine/dbal": "^3",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^2.17",
        "jdorn/sql-formatter": "^1.2",
        "jms/serializer-bundle": "^5.4",
        "mpdf/mpdf": "^v8.2",
        "nelmio/cors-bundle": "^2.4",
        "nikic/php-parser": "^5.4",
        "phpdocumentor/reflection-docblock": "^5.3",
        "phpstan/phpdoc-parser": "^2.0",
        "sixlive/dotenv-editor": "^2.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "7.2.*",
        "symfony/console": "7.2.*",
        "symfony/doctrine-messenger": "7.2.*",
        "symfony/dotenv": "7.2.*",
        "symfony/expression-language": "7.2.*",
        "symfony/flex": "^2.4",
        "symfony/form": "7.2.*",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-client": "7.2.*",
        "symfony/intl": "7.2.*",
        "symfony/mailer": "7.2.*",
        "symfony/mime": "7.2.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/notifier": "7.2.*",
        "symfony/process": "7.2.*",
        "symfony/property-access": "7.2.*",
        "symfony/property-info": "7.2.*",
        "symfony/proxy-manager-bridge": "^6.4",
        "symfony/routing": "7.2.*",
        "symfony/runtime": "7.2.*",
        "symfony/security-bundle": "7.2.*",
        "symfony/serializer": "7.2.*",
        "symfony/string": "7.2.*",
        "symfony/translation": "7.2.*",
        "symfony/twig-bundle": "7.2.*",
        "symfony/ux-chartjs": "^2.9",
        "symfony/validator": "7.2.*",
        "symfony/web-link": "7.2.*",
        "symfony/webpack-encore-bundle": "^2.2",
        "symfony/yaml": "7.2.*",
        "twig/extra-bundle": "^v3.15",
        "twig/twig": "^3.15"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "WebWMS\\": "src/",
            "WebWMS\\Bundles\\": "module/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebWMS\\Tests\\": "tests/"
        }
    },
    "repositories": {
        "mission": {
            "type": "path",
            "url": "packages/test-generator"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "ecs": "vendor/bin/ecs",
        "ecs-fix": "vendor/bin/ecs --fix",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon src --error-format=table --memory-limit=1G",
        "phpmd": "vendor/bin/phpmd src ansi phpmd-rulesets.xml",
        "rector-dry": "vendor/bin/rector process --dry-run",
        "rector-refactor": "vendor/bin/rector process",
        "phpmetrics": "vendor/bin/phpmetrics --config=php-metrics-config.yml",
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.2.*"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.45",
        "php-parallel-lint/php-var-dump-check": "^0.5",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpmd/phpmd": "^2.15",
        "phpmetrics/phpmetrics": "^v3.0.0rc6",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/php-code-coverage": "^11.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "symfony/browser-kit": "7.2.*",
        "symfony/css-selector": "7.2.*",
        "symfony/debug-bundle": "7.2.*",
        "symfony/maker-bundle": "^1.52",
        "symfony/phpunit-bridge": "7.2.*",
        "symfony/stopwatch": "7.2.*",
        "symfony/web-profiler-bundle": "7.2.*",
        "symplify/easy-coding-standard": "^12.5",
        "tomasvotruba/class-leak": "^0.2.13",
        "tomasvotruba/lines": "^0.5.1",
        "twigstan/twigstan": "dev-main",
        "vincentlanglet/twig-cs-fixer": "^3.3"
    }
}
