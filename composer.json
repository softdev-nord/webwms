{
    "name": "webwms/webwms",
    "description": "webWMS Das webbasierte Lagerverwaltungssystem",
    "keywords": ["webWMS", "wms"],
    "homepage": "https://softdev-nord.de",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-zend-opcache": "*",
        "composer/package-versions-deprecated": "^1.11",
        "doctrine/annotations": "^1.0",
        "doctrine/doctrine-bundle": "^2.1",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^2.7",
        "jms/serializer-bundle": "^4.0",
        "nelmio/api-doc-bundle": "^4.8",
        "sensio/framework-extra-bundle": "^5.1",
        "sixlive/dotenv-editor": "^2.0",
        "sonata-project/admin-bundle": "^4.9",
        "sonata-project/doctrine-orm-admin-bundle": "^4.2",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "^5.3",
        "symfony/console": "5.4.*",
        "symfony/dotenv": "5.4.*",
        "symfony/expression-language": "5.4.*",
        "symfony/finder": "v6.1.0",
        "symfony/flex": "^1.19",
        "symfony/form": "5.4.*",
        "symfony/framework-bundle": "5.4.*",
        "symfony/http-client": "5.4.*",
        "symfony/intl": "5.4.*",
        "symfony/mailer": "5.4.*",
        "symfony/mime": "5.4.*",
        "symfony/monolog-bundle": "^3.1",
        "symfony/notifier": "5.4.*",
        "symfony/process": "5.4.*",
        "symfony/property-access": "5.4.*",
        "symfony/property-info": "5.4.*",
        "symfony/security-bundle": "5.4.*",
        "symfony/serializer": "5.4.*",
        "symfony/stopwatch": "5.4.*",
        "symfony/string": "5.4.*",
        "symfony/translation": "5.4.*",
        "symfony/twig-bridge": "5.4.*",
        "symfony/twig-bundle": "5.4.*",
        "symfony/ux-chartjs": "^2.2",
        "symfony/validator": "5.4.*",
        "symfony/web-profiler-bundle": "5.4.*",
        "symfony/webpack-encore-bundle": "^1.7",
        "symfony/yaml": "5.4.*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0",
        "webbamboo/material-dashboard-symfony": "^1.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.3",
        "friendsofphp/php-cs-fixer": "^v3.8.0",
        "friendsofsymfony/rest-bundle": "@dev",
        "jakub-onderka/php-var-dump-check": "^0.3.0",
        "phpmd/phpmd": "^2.12",
        "phpstan/phpstan": "^0.12.80",
        "phpstan/phpstan-doctrine": "^0.12.32",
        "phpstan/phpstan-symfony": "^0.12.20",
        "symfony/browser-kit": "^5.1",
        "symfony/css-selector": "^5.1",
        "symfony/debug-bundle": "^5.1",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "^5.1",
        "symfony/var-dumper": "^5.1"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "WebWMS\\": "src/",
            "WebWMS\\Bundles\\": "custom/plugins/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebWMS\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "inspect": "vendor/bin/phpstan clear-result-cache && vendor/bin/phpstan analyse",
        "lint": "vendor/bin/php-cs-fixer fix -vvv --dry-run --using-cache=no --show-progress=estimating",
        "lint-fix": "vendor/bin/php-cs-fixer fix -vvv --using-cache=no --show-progress=estimating",
        "test-unit": "vendor/bin/codecept run unit",
        "test-acceptance": "vendor/bin/codecept run acceptance",
        "test-unit-xml": "vendor/bin/codecept run unit --xml -vvv",
        "test-acceptance-xml": "vendor/bin/codecept run acceptance --xml -vvv",
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.4.*"
        }
    }
}
